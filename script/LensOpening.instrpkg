<?xml version="1.0" encoding="UTF-8"?>
<package>
 <id>com.zimengxiong.winmux.lens-opening.package</id><title>WinMux Lens Opening</title><owner><name>WinMux</name></owner>
 <os-signpost-interval-schema>
  <id>lens-opening-stages</id><title>Lens opening stages</title>
  <subsystem>"com.zimengxiong.winmux.debug"</subsystem><category>"lens-opening"</category><name>?stage</name>
  <column><mnemonic>stage</mnemonic><title>Stage</title><type>string</type><expression>?stage</expression></column>
 </os-signpost-interval-schema>
 <os-signpost-interval-schema>
  <id>lens-opening-gate</id><title>Recording gate</title>
  <subsystem>"com.zimengxiong.winmux.debug"</subsystem><category>"DynamicTracing"</category><name>?stage</name>
 </os-signpost-interval-schema>
 <os-signpost-interval-schema>
  <id>lens-opening-release-stages</id><title>Lens opening stages</title>
  <subsystem>"com.zimengxiong.winmux"</subsystem><category>"lens-opening"</category><name>?stage</name>
  <column><mnemonic>stage</mnemonic><title>Stage</title><type>string</type><expression>?stage</expression></column>
 </os-signpost-interval-schema>
 <os-signpost-interval-schema>
  <id>lens-opening-release-gate</id><title>Recording gate</title>
  <subsystem>"com.zimengxiong.winmux"</subsystem><category>"DynamicTracing"</category><name>?stage</name>
 </os-signpost-interval-schema>
 <instrument>
  <id>com.zimengxiong.winmux.lens-opening.instrument</id><title>Lens Opening</title><category>Behavior</category><purpose>Lens opening stages under WinMux's subsystem.</purpose>
  <icon>Blank</icon>
  <create-table><id>stages</id><schema-ref>lens-opening-stages</schema-ref></create-table>
  <create-table><id>gate</id><schema-ref>lens-opening-gate</schema-ref></create-table>
  <create-table><id>release-stages</id><schema-ref>lens-opening-release-stages</schema-ref></create-table>
  <create-table><id>release-gate</id><schema-ref>lens-opening-release-gate</schema-ref></create-table>
  <graph><title>Lens opening</title><lane><title>Stages</title><table-ref>stages</table-ref><plot><value-from>stage</value-from><label-from>stage</label-from></plot></lane></graph>
  <graph><title>Release Lens opening</title><lane><title>Stages</title><table-ref>release-stages</table-ref><plot><value-from>stage</value-from><label-from>stage</label-from></plot></lane></graph>
  <list><title>Stages</title><table-ref>stages</table-ref><column>start</column><column>duration</column><column>stage</column></list>
  <list><title>Release stages</title><table-ref>release-stages</table-ref><column>start</column><column>duration</column><column>stage</column></list>
 </instrument>
</package>
