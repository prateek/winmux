#!/usr/bin/env bash
set -euo pipefail

RUN_DIR="${1:-}"

usage() {
    cat <<EOF
Usage: $(basename "$0") <artifact-run-dir>

Writes <artifact-run-dir>/reviews/reviewer-packet.md with the filled artifact
paths, baseline media, verifier command, and slice-specific review checks for a
no-context artifact reviewer.
EOF
}

die() {
    printf '[winmux-review-packet] error: %s\n' "$*" >&2
    exit 1
}

[ -n "$RUN_DIR" ] || {
    usage >&2
    die "Missing artifact run directory"
}
[ -d "$RUN_DIR" ] || die "Artifact directory does not exist: $RUN_DIR"

LOGS_DIR="${RUN_DIR}/logs"
SCREENSHOTS_DIR="${RUN_DIR}/screenshots"
RECORDINGS_DIR="${RUN_DIR}/recordings"
REVIEWS_DIR="${RUN_DIR}/reviews"
PACKET_PATH="${REVIEWS_DIR}/reviewer-packet.md"
REVIEW_OUTPUT_PATH="${REVIEWS_DIR}/no-ctx-artifact-review.md"
CONFIG_PATH="${RUN_DIR}/config/winmux.toml"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"

require_file() {
    local path="$1"
    [ -s "$path" ] || die "Missing or empty file: $path"
}

single_match() {
    local pattern="$1"
    local path
    path="$(find "$RUN_DIR" -path "$pattern" -type f | sort | head -1)"
    printf '%s\n' "$path"
}

recording_path="$(find "$RECORDINGS_DIR" -maxdepth 1 -type f -name '*.mov' | sort | head -1)"
require_file "$recording_path"
recording_name="$(basename "$recording_path" .mov)"
raw_recording_path="${RECORDINGS_DIR}/raw/${recording_name}.raw.mov"
before_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '00-before-*.png' | sort | head -1)"
ready_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '01-ready-*.png' | sort | head -1)"
after_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '99-after-*.png' | sort | head -1)"
contact_sheet="${SCREENSHOTS_DIR}/${recording_name}.contact-sheet.jpg"
samples_dir="${SCREENSHOTS_DIR}/${recording_name}.samples"
sample_manifest="${LOGS_DIR}/${recording_name}.sample-manifest.tsv"
event_contact_sheet="${SCREENSHOTS_DIR}/${recording_name}.event-contact-sheet.jpg"
edge_crops_dir="${SCREENSHOTS_DIR}/${recording_name}.edge-crops"
edge_crops_manifest="${LOGS_DIR}/${recording_name}.edge-crops.tsv"
transport_summary="${LOGS_DIR}/guest-transport-summary.tsv"
boundary_samples_glob="${samples_dir}/caption-*-boundary-*.png"
annotation_plan="${LOGS_DIR}/${recording_name}.annotations.tsv"
annotation_log="${LOGS_DIR}/${recording_name}.annotation.log"
caption_tail="${LOGS_DIR}/${recording_name}.caption-tail.tsv"
expected_chips="${LOGS_DIR}/${recording_name}.expected-chips.txt"
proof_manifest="${LOGS_DIR}/${recording_name}.proof-manifest.tsv"
event_manifest="${LOGS_DIR}/${recording_name}.event-manifest.tsv"
mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
color_sentinel="${LOGS_DIR}/${recording_name}.color-sentinel.tsv"
overlay_sentinel="${LOGS_DIR}/${recording_name}.overlay-sentinel.tsv"
visible_geometry_board="${LOGS_DIR}/slice-11a-visible-geometry-board.txt"
proof_file="$(single_match "${RUN_DIR}/*-proof.txt")"
if [ ! -s "$visible_geometry_board" ]; then
    visible_geometry_board="not applicable"
fi
if [ -s "$proof_manifest" ] || [[ "$recording_name" == *drag* ]]; then
    proof_manifest_label="$proof_manifest"
else
    proof_manifest_label="not applicable"
fi
if [ -s "$color_sentinel" ]; then
    color_sentinel_label="$color_sentinel"
else
    color_sentinel_label="not applicable"
fi
if [ -s "$event_manifest" ]; then
    event_manifest_label="$event_manifest"
else
    event_manifest_label="not applicable"
fi
if [ -s "$mouse_events" ]; then
    mouse_events_label="$mouse_events"
else
    mouse_events_label="not applicable"
fi
if [ -s "$event_contact_sheet" ]; then
    event_contact_sheet_label="$event_contact_sheet"
else
    event_contact_sheet_label="not applicable"
fi
if [ -s "$caption_tail" ]; then
    caption_tail_label="$caption_tail"
else
    caption_tail_label="not applicable"
fi
if [ -s "$overlay_sentinel" ]; then
    overlay_sentinel_label="$overlay_sentinel"
else
    overlay_sentinel_label="not applicable"
fi
if [ -d "$edge_crops_dir" ] && [ -s "$edge_crops_manifest" ]; then
    edge_crops_label="$edge_crops_dir"
    edge_crops_manifest_label="$edge_crops_manifest"
else
    edge_crops_label="not applicable"
    edge_crops_manifest_label="not applicable"
fi

mkdir -p "$REVIEWS_DIR"

drag_screenshot_lines() {
    [ -s "$proof_manifest" ] || return 0
    /usr/bin/awk -F'\t' -v screenshots_dir="$SCREENSHOTS_DIR" '
        $1 == "drag-screenshots" {
            printf("- %s drag screenshot: %s/%s\n", $2, screenshots_dir, $3)
        }
    ' "$proof_manifest"
}

expected_chip_lines() {
    if [ -s "$expected_chips" ]; then
        /usr/bin/awk '{ printf("- `%s`\n", $0) }' "$expected_chips"
        return 0
    fi
    [ -s "$annotation_plan" ] || return 0
    /usr/bin/awk -F'\t' '$0 != "" && $1 !~ /^#/ && $5 != "" { printf("- `%s`\n", $5) }' "$annotation_plan"
}

slice_specific_checks() {
    case "$recording_name" in
        slice-2-config-zones)
            cat <<'EOF'
- Confirm three live labeled TextEdit windows are visible in Reference, Work, and Comms.
- Confirm the visual proof is more than CLI output and the captions expose the `[[zones]]` config and WinMux commands.
EOF
            ;;
        slice-3-stable-identity)
            cat <<'EOF'
- Confirm before, reload, and after beats are all visible, not just final state.
- Confirm labeled windows stay attached to left, main, and right zone ids after the config reload.
EOF
            ;;
        slice-4-zone-commands)
            cat <<'EOF'
- Confirm `list-zones`, `focus-zone Reference`, `focus-zone Work`, `move-node-to-zone Comms --fail-if-noop`, and `focus-monitor 1` are visible through captions and correlated logs.
- Reject no-op movement proofs unless strict no-op failure is shown.
EOF
            ;;
        slice-12-mouse-zone-snap-drag)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags, not a sidebar drag: first without Alt, then with Alt held.
- Confirm the no-Alt drag has visible source pickup and hover/path over the target area, but no whole-zone snap overlay and no zone move in the after-freeform logs.
- Confirm the positive drag shows source pickup, pointer/path, the whole Comms zone overlay/highlight, release/drop, and final placement.
- State whether the target is a whole zone or a window/slot inside a zone. For Slice 12, the expected answer is whole zone.
- Confirm captions expose `[mouse.zone-snap]`, `policy = 'snap-on-modifier'`, `modifier = 'alt'`, and the user action `hold Alt while dragging`.
- Name the exact media file used for each beat: freeform pickup, freeform no-overlay hover, reset-before-snap, Alt pickup, Alt path, whole-zone hover/overlay, release/final placement.
- Reject final-placement-only proof, missing negative proof, missing modifier-held positive proof, an unclear snap target, or a review that assumes the overlay appeared without inspecting action frames.
EOF
            ;;
        slice-16-mouse-snap-affordance)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags, not a sidebar drag: first without Option, then with Option held.
- Confirm the no-Option drag has visible source pickup and hover/path over the target area, but no whole-zone snap overlay and no zone move in the after-freeform logs.
- Confirm the Option-held drag shows source pickup, pointer/path, the whole Comms zone overlay/highlight, release/drop, and final placement.
- Inspect `logs/slice-16-mouse-snap-affordance.overlay-sentinel.tsv`. Confirm it names `target-semantics` as `whole-zone`, includes freeform and snap target-zone crop paths, includes `target-label` equal to `WHOLE ZONE TARGET: COMMS` when present, and reports `overlay-rmse-normalized` at or above its minimum.
- State whether the target is a whole zone or a window/slot inside a zone. For Slice 16, the expected answer is whole zone.
- Confirm captions expose `[mouse.zone-snap]`, `policy='snap-on-modifier'`, `modifier='alt'`, `target='zone'`, and the user action `hold Option while dragging: snap to Comms zone`.
- Name the exact media file used for each beat: freeform pickup, freeform no-overlay hover, reset-before-snap, Option pickup, Option path, whole-zone hover/overlay, release/final placement, and overlay sentinel crops.
- Reject final-placement-only proof, missing negative proof, missing modifier-held positive proof, missing overlay sentinel, an unclear snap target, a snap-to-window/slot claim, or a review that assumes the overlay appeared without inspecting action frames.
EOF
            ;;
        slice-13-zone-mode-bindings)
            cat <<'EOF'
- Confirm the recording shows a keyboard-led `Alt-Z` zone mode sequence, not direct CLI-only actions: `Alt-Z, L`, `Alt-Z, Shift-L`, `Alt-Z, Equal`, `Alt-Z, 0`, and two `Alt-Z, T` toggles.
- Confirm captions expose the user-facing config and commands: `alt-z = 'mode zone'`, `focus-zone next`, `move-node-to-zone --focus-follows-window next`, `resize-zone current width +10%`, `balance-zones`, and `toggle-zone current`.
- Confirm the restore beat also names the real command `toggle-zone current`; reject captions that describe only "restore current zone" without the command.
- Inspect the live state board in the video and semantic screenshots. It must show Step, Action, Target, Current, Workspace, Window id, Title, Zone, Widths, and Checkpoint.
- Confirm `Target` resolves the relative selectors: `main/Work` for focus-next, `right/Comms` for move/resize/toggle, and `all-enabled-zones` for balance.
- Confirm the Work Alpha and Work Beta windows move together as one tab group from Work/main to Comms/right after `Alt-Z, Shift-L`.
- Confirm `resize-zone current` widens Comms/right after the move, `balance-zones` returns the enabled zones to equal widths, the first `toggle-zone current` hides Comms/right, and the second restores the same Comms/right zone.
- Confirm TextEdit document copy does not contain stale labels such as `zone: Work`, `zone: Comms`, or future-state text like "right zone restored after toggle".
- Confirm semantic screenshots are fresh. Reject a screenshot whose board text is one checkpoint behind the named file.
- Reject logs-only proof, stale board screenshots, stale window-copy labels, ambiguous `current` targets, command captions that omit the user action, or a review that accepts the sequence without naming the exact media checked for each beat.
EOF
            ;;
        slice-15-node-zone-binding)
            cat <<'EOF'
- Confirm the recording starts with Work Alpha and Work Beta as one tab group in Work/main and `winmux list-zone-bindings --count` showing zero before the command.
- Sample frames around `Run: winmux bind-node-to-zone Comms`. Fail if the tab group is already in Comms/right before the command caption starts.
- Confirm the after-state media shows the same visible titles still together as a tab group in Comms/right. Use logs for internal window ids unless the ids are rendered in a visible state board.
- Confirm captions expose `alt-b = 'bind-node-to-zone Comms'`, `winmux list-zone-bindings --count`, `winmux bind-node-to-zone Comms`, and `winmux list-zone-bindings`.
- Confirm `list-zone-bindings` exposes node-id, node-type=tab-group, title, zone/right, workspace, and monitor.
- State that Slice 15 proves runtime node binding, not `[[zone-bindings]]` workspace binding or relaunch persistence.
- Reject logs-only proof, final-state-only proof, single-window binding proof, command-after-move proof, missing tab group evidence, or review without naming exact media for before/command/after/list beats.
EOF
            ;;
        slice-17-node-binding-guardrails)
            cat <<'EOF'
- Confirm the desktop starts clean and the ready state shows a visible guardrail board plus staged proof windows, not Terminal, sshd prompts, permission prompts, unrelated app windows, widgets, or setup UI.
- Confirm captions or the live board expose concrete, copyable user-facing commands for every proof beat, with no angle-bracket placeholders: `winmux list-zone-bindings --count`, `winmux bind-node-to-zone --window-id "$ESCAPED_ID" Comms`, `winmux bind-node-to-zone --window-id "$REBIND_ID" Reference`, `winmux bind-node-to-zone --window-id "$REBIND_ID" Comms`, `winmux disable-zone Comms`, `winmux bind-node-to-zone --window-id "$UNBOUND_ID" Comms`, `winmux unbind-node-zone-binding --window-id "$UNBOUND_ID"`, and `winmux close --window-id "$STALE_BETA_ID"`.
- Inspect the semantic sample manifest and named frames for `ready-guardrails`, `escaped-title-command`, `rebind-command`, `disabled-zone-failure`, `missing-unbind-failure`, `stale-prune-command`, and `final-empty-count`. Reject if any sample is missing, stale, or only shows final state.
- Confirm the escaped-title beat visibly shows a `list-zone-bindings` row where the title contains escaped separators such as `escaped\|equals\=guardrail.rtf`.
- Confirm the rebind beat shows the same window rebound from Reference to Comms while `list-zone-bindings --count` stays at one and the final row names Comms/right.
- Confirm the disabled-zone and missing-unbind beats show expected command failures on the board or captioned proof surface, with count remaining zero.
- Confirm the stale tab-group beat shows the user action that changes membership, including a concrete command such as `winmux close --window-id "$STALE_BETA_ID"`, and then shows the binding pruned to zero.
- State that this slice proves runtime node-binding guardrails and machine-safe inspection only. It does not prove relaunch persistence, app-rule bindings, launch-time rebinding, or durable tab-group identity.
- Compare caption style and content against the repo-root demo videos, screenshots, README, and linked product surfaces. Reject command text that is hidden, too generic, or styled like unrelated marketing copy.
- Reject logs-only proof, final-state-only proof, hidden command/error text, stale live-board text, a proof that omits the stale membership-change action, or any relaunch-persistence claim.
EOF
            ;;
        slice-5-sidebar-drag|*drag*)
            cat <<'EOF'
- Confirm the source sidebar item, dragged proxy, pointer/path, highlighted target zone row/section, hover hold, release, and final placement are visible in full-frame action samples or in-drag screenshots.
- Name the exact media file used to verify each drag beat: source pickup, proxy/path, hover highlight, release/drop, and final placement.
- Confirm the drag proof manifest names the source item, target zone, snap target semantics, fixed points, coordinate policy, caption beat, in-drag screenshots, and before/after state logs.
- State whether the UX snaps to a sidebar zone row or to a window within a zone. For Slice 5, the expected answer is zone row.
- Reject final-placement-only drag proof, a too-fast blur, or any review that assumes drag happened without inspecting action frames.
EOF
            ;;
        slice-6-zone-layout-presets)
            cat <<'EOF'
- Confirm the recording starts from a prepared visible balanced layout, then visibly changes after `winmux use-zone-layout focus`.
- Confirm captions expose both the `[[zone-layouts]]` config surface and the exact `use-zone-layout` command.
- Confirm the proof is a geometry change with live windows, not only CLI output, and that the same windows remain in their named zones.
EOF
            ;;
        slice-6b-zone-scenes)
            cat <<'EOF'
- Confirm the recording has a readable before/action/after transition: triage scene visible, `winmux use-zone-scene deep-work`, then deep-work scene visible.
- Sample frames around the command-caption boundary. Fail if Focus Queue/Build/Notes are visible before the `Run: winmux use-zone-scene deep-work` caption starts, or if the triage scene persists after the after-scene caption begins.
- Confirm captions expose the `[[zone-scenes]]` config surface, the exact scene switch command, and the list commands users would run to inspect zone workspaces and visible windows.
- Confirm the proof shows live TextEdit documents changing from triage workspaces to deep-work workspaces, not only a layout width change or CLI output.
EOF
            ;;
        slice-8-window-routing)
            cat <<'EOF'
- Confirm the recording starts with Reference, Work, and Comms visible, Work active, and no `route-comms.rtf` window.
- Sample frames around the `Run: open -a TextEdit route-comms.rtf` caption boundary. Fail if the routed window is already visible before the open action.
- Confirm captions expose the `[[on-window-detected]] move-node-to-zone Comms --fail-if-noop` config surface, the exact `open -a TextEdit route-comms.rtf` action, and the inspection commands `winmux list-windows --workspace visible` and `winmux list-zones`.
- Confirm the proof shows `route-comms.rtf` moving to the Comms/right zone automatically, without a manual `move-node-to-zone` proof command during the recording.
EOF
            ;;
        slice-18-zone-affinity-routing)
            cat <<'EOF'
- Confirm the recording starts with Reference, focused Work, and Comms visible, and no `affinity-comms.rtf` window.
- Sample frames around the `Run: open -a TextEdit affinity-comms.rtf` caption boundary. Fail if the routed window is already visible before the open action.
- Confirm captions expose the `[[zone-affinities]] zone = 'Comms'` config surface, the `if.window-title-regex-substring = 'affinity-comms'` matcher, the exact `open -a TextEdit affinity-comms.rtf` action, and the inspection commands `winmux list-windows --workspace visible` and `winmux list-zones`.
- Confirm the proof shows `affinity-comms.rtf` moving to Comms/right automatically, without a manual `move-node-to-zone` proof command during the recording.
- Confirm `focused-work.rtf` remains in Work/main after the route, proving the affinity used the detected window id rather than the focused window.
- Inspect the semantic sample manifest and named frames for `ready-affinity-routing`, `before-affinity-absent`, `open-affinity-command`, `after-affinity-routing`, and `inspect-affinity-windows`.
- State that Slice 18 proves durable new-window affinity routing only. It does not prove relaunch persistence, automatic rebinding of already-open windows, or durable tab-group identity.
- Reject logs-only proof, final-state-only proof, generic `[[on-window-detected]]` proof, hidden config/action captions, routed-window-before-open ordering, focused-window movement, or any persistence/tab-group-identity claim.
EOF
            ;;
        slice-10-zone-availability)
            cat <<'EOF'
- Confirm the recording starts with Reference, Work, and Comms visible and the sidebar enabled.
- Sample frames around `Run: winmux disable-zone Comms` and `Run: winmux enable-zone Comms`.
- Confirm the hidden-state screenshot and recording frames show Comms absent and Work/main expanded, not merely a log saying the command ran.
- Confirm the restored-state screenshot and visible window logs show `comms-availability.rtf` restored to Comms/right.
- Confirm captions expose the `[[zones]]` config surface, exact disable/enable commands, and inspection commands `winmux list-zones` and `winmux list-windows --workspace visible`.
- Reject final-state-only proof, a hidden state where Comms is still an active zone/sidebar target, or a restore where the parked Comms workspace comes back in the wrong zone.
EOF
            ;;
        slice-11a-zone-width-controls)
            cat <<'EOF'
- Confirm the recording starts with Reference, Work, and Comms visible, with a readable before-geometry surface on screen.
- Sample frames around `Run: winmux resize-zone Work width +10%` and `Run: winmux balance-zones`. Fail if geometry changes before either command caption appears.
- Confirm the recording shows before-resize, resize-command-start, after-resize, before-balance, balance-command-start, after-balance, and final inspection states.
- Confirm numeric geometry is visible in the media or named screenshots, not only in logs. Required values: zone id, enabled state, configured/effective/runtime width, left edge, pixel width, active workspace, and runtime override marker.
- Confirm `Work` visibly expands after resize, Reference and Comms visibly shrink, then all three zones return to equal widths after balance.
- Confirm the same windows and active workspaces stay in the same zone ids across resize and balance.
- Confirm the copied config hash is unchanged; this is runtime state, not a TOML rewrite.
- Reject logs-only sizing proof, final-state-only proof, unreadable/subtle geometry, stale labels, missing before/command/after samples, command captions that omit the target zone or amount, and captions that obscure measured zone edges.
EOF
            ;;
        slice-20-zone-snap-policy-switch)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags of `snap-demo.rtf`, not a sidebar drag and not a replay of Slice 12/16: first with config `policy = 'freeform'`, then after `winmux set-zone-snap-policy snap-to-zone`.
- Confirm the first no-modifier drag has visible source pickup and hover/path over the Comms area, but no whole-zone snap overlay and no zone move in the after-freeform logs.
- Sample the frame around `Run: winmux set-zone-snap-policy snap-to-zone` and compare it to `logs/slice-20-command-timing.log`. Fail if the snap overlay or zone move appears before this exact command caption is already visible on a clean pre-snap frame.
- Confirm the second no-modifier drag, after the runtime command, shows source pickup, pointer/path, the whole Comms zone overlay/highlight, release/drop, and final placement.
- Inspect `logs/slice-20-zone-snap-policy-switch.overlay-sentinel.tsv`. Confirm it names `target-semantics` as `whole-zone`, includes freeform and snap target-zone crop paths, includes `target-label` equal to `WHOLE ZONE TARGET: COMMS` with a readable labeled crop path, and reports `overlay-rmse-normalized` at or above its minimum.
- Confirm the exact command logs exist: `logs/slice-20-set-zone-snap-policy.log` with `winmux set-zone-snap-policy snap-to-zone`, and `logs/slice-20-cycle-zone-snap-policy.log` with `winmux cycle-zone-snap-policy freeform snap-to-zone`.
- If `logs/slice-20-zone-snap-policy-switch.event-manifest.tsv` exists, inspect it and confirm event ordering names separate command starts/ends, drag pickup/path/hover/release, first affordance, post-state inspection, and final inspection. Reject if it collapses those into one vague timing value.
- Confirm captions expose the binding-friendly commands `alt-z = 'set-zone-snap-policy snap-to-zone'` and `alt-x = 'cycle-zone-snap-policy freeform snap-to-zone'` through config/caption surfaces.
- State whether the target is a whole zone or a window/slot inside a zone. For Slice 20, the expected answer is whole zone.
- Confirm `winmux cycle-zone-snap-policy freeform snap-to-zone` runs after final placement and returns runtime policy to freeform; this is command proof, not relaunch persistence.
- Name the exact media file used for each beat: freeform pickup, freeform no-overlay hover, set-command boundary, reset-before-snap, runtime snap pickup, runtime snap path, whole-zone hover/overlay, release/final placement, cycle-command boundary, and overlay sentinel crops.
- Reject logs-only proof, final-state-only proof, a modifier-held positive drag, missing runtime set/cycle commands, unclear snap target, missing overlay/no-overlay proof, or any proof that implies snap-to-window/slot behavior.
EOF
            ;;
        slice-21-zone-mode-v2)
            cat <<'EOF'
- Confirm the recording starts with a clean Work/main proof board that names the exact `Alt-Z`, `S`, `Tab`, `A`, and `Y` key-to-command mappings, with visible Reference, Work, and Comms zones before any zone-mode V2 binding runs.
- Confirm the caption/config surface exposes `[mode.main.binding] alt-z = 'mode zone'` plus the exact zone-mode keys `s`, `tab`, `a`, and `y`.
- Sample the named semantic frames and caption boundaries for `ready-zone-mode-v2`, `snap-policy-command-start`, `after-snap-policy`, `layout-cycle-command-start`, `after-layout-focus`, `availability-focus-only-command-start`, `after-availability-focus-only`, `availability-communications-command-start`, `after-availability-communications`, `style-cycle-command-start`, and `after-style-urgent`.
- Confirm the action log proves the exact ordered binding sequence: `Alt-Z, S`, `Alt-Z, Tab`, two `Alt-Z, A` beats, then `Alt-Z, Y`, each with `winmux trigger-binding --mode main alt-z`, the matching `winmux trigger-binding --mode zone <key>`, expected command output, and return to main mode.
- Confirm `Alt-Z, S` exposes and runs `winmux cycle-zone-snap-policy freeform snap-to-zone`; reject if the proof implies a config rewrite or a mouse drag proof.
- Confirm `Alt-Z, Tab` exposes and runs `winmux cycle-zone-layout balanced focus`, and that the Work/main zone visibly/logically widens with layout id `focus`.
- Confirm the two `Alt-Z, A` beats expose and run `winmux cycle-zone-availability focus-only communications full-dashboard`: first focus-only hides Reference and Comms, then communications restores Comms/right while Reference remains hidden.
- Confirm `Alt-Z, Y` exposes and runs `winmux cycle-zone-style current urgent calm`, and that the current Work/main zone reports urgent `#D3455B`.
- Inspect `logs/slice-21-zone-mode-v2.event-manifest.tsv`; reject if it omits separate command-start and result events for snap policy, layout, both availability beats, and style.
- Reject logs-only proof, final-state-only proof, missing user-facing command captions, unreadable board text, missing event/sample manifest rows, or any claim that Slice 21 proves drag snapping, persistence, or relaunch behavior.
EOF
            ;;
        slice-22-float-unless-snap)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags of `snap-demo.rtf`, not a sidebar drag and not a replay of Slice 12/16/20: first no modifier under config `policy = 'float-unless-snap'`, then after reset with Alt held.
- Confirm the first no-Alt drag has visible source pickup and hover/path over the Comms area, but no whole-zone snap overlay. Inspect `logs/slice-22-windows-after-freeform.log` and require the same source id to have `zone=right` and `layout=floating`.
- Confirm captions expose the user actions and relevant WinMux surface: `Config: policy='float-unless-snap'; modifier='alt'; target='zone'`, `Action: drag snap-demo.rtf with no modifier`, `Run: winmux list-windows --monitor all`, `Action: reset snap-demo.rtf to Work/main tiling`, `Action: hold Alt while dragging snap-demo.rtf`, `Action: target = whole Comms zone`, and `Action: release on Comms zone`.
- Confirm the reset beat returns the same window to Work/main and non-floating layout before the Alt-held snap. Reject proof where the second drag starts from an already-floating source.
- Confirm the Alt-held drag shows source pickup, pointer/path, the whole Comms zone overlay/highlight, release/drop, and final placement of the same window id into Comms/right.
- Inspect `logs/slice-22-float-unless-snap.overlay-sentinel.tsv`. Confirm it names `target-semantics` as `whole-zone`, includes no-Alt and Alt-held target-zone crop paths, includes `target-label` equal to `WHOLE ZONE TARGET: COMMS` with a readable labeled crop path, and reports `overlay-rmse-normalized` at or above its minimum.
- Inspect `logs/slice-22-float-unless-snap.event-manifest.tsv`; reject if it omits separate float-drag start/hover/release/post-state, reset, snap pickup/path/first-affordance/hover/release/post-state events.
- Confirm the proof is config-driven and modifier-driven: there must be no `winmux set-zone-snap-policy` command in the Slice 22 action log.
- State whether each branch targets a whole zone or a window/slot inside a zone. For Slice 22, the no-Alt branch is floating/freeform placement, and the Alt-held branch targets the whole Comms zone.
- Name the exact media file used for each beat: no-Alt pickup, no-Alt no-overlay hover, floating post-state, reset-before-snap, Alt pickup, Alt path, whole-zone hover/overlay, release/final placement, and overlay sentinel crops.
- Reject logs-only proof, final-state-only proof, missing drag affordances, command captions that appear after visual changes, unclear overlay/no-overlay contrast, any target that looks like a window or slot inside a zone, or any claim about persistence, configurable gestures beyond this drag policy, or visual settings UI.
EOF
            ;;
        slice-23-product-snap-overlay-label)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags of `snap-demo.rtf`, not a sidebar drag and not a replay of Slice 22: first no modifier under config `policy = 'float-unless-snap'`, then after reset with Alt held.
- Confirm the no-Alt branch has visible source pickup and hover/path over Comms, but no whole-zone snap overlay and no product snap label. Inspect `logs/slice-23-windows-after-freeform.log` and require the same source id to have `zone=right` and `layout=floating`.
- Confirm captions expose the user actions and relevant WinMux surface: `Config: policy='float-unless-snap'; modifier='alt'; target='zone'`, `Action: drag snap-demo.rtf with no modifier`, `Run: winmux list-windows --monitor all`, `Action: reset snap-demo.rtf to Work/main tiling`, `Action: hold Alt while dragging snap-demo.rtf`, `Action: target = whole Comms zone`, and `Action: release on Comms zone`.
- Confirm the reset beat returns the same window to Work/main and non-floating layout before the Alt-held snap. Reject proof where the second drag starts from an already-floating source.
- Confirm the Alt-held drag shows source pickup, pointer/path, a whole Comms zone overlay/highlight, release/drop, and final placement of the same window id into Comms/right.
- Inspect `screenshots/07-snap-hover-comms-slice-23.png`, the full video around the Alt-held hover, and the event contact sheet. The actual product overlay must visibly read `Whole zone: Comms`. A harness-added crop label alone does not satisfy this slice.
- Inspect `logs/slice-23-product-snap-overlay-label.overlay-sentinel.tsv`. Confirm it names `target-semantics` as `whole-zone`, includes no-Alt and Alt-held target-zone crop paths, includes `target-label` equal to `WHOLE ZONE TARGET: COMMS` with a readable labeled crop path, and reports `overlay-rmse-normalized` at or above its minimum.
- Inspect `logs/slice-23-product-snap-overlay-label.event-manifest.tsv`; reject if it omits separate float-drag start/hover/release/post-state, reset, snap pickup/path/first-affordance/hover/release/post-state events.
- Confirm the proof manifest includes `visual-floor	product-overlay-label	Whole zone: Comms` and that the visual media agrees with that field.
- State whether each branch targets a whole zone or a window/slot inside a zone. For Slice 23, the no-Alt branch is floating/freeform placement with no snap target, and the Alt-held branch targets the whole Comms zone.
- Name the exact media file used for each beat: no-Alt pickup, no-Alt no-overlay hover, floating post-state, reset-before-snap, Alt pickup, Alt path, product-labeled whole-zone hover/overlay, release/final placement, and overlay sentinel crops.
- Reject logs-only proof, final-state-only proof, missing drag affordances, command captions that appear after visual changes, unclear overlay/no-overlay contrast, any product-label claim based only on logs or harness annotations, any target that looks like a window or slot inside a zone, or any claim about persistence, configurable gestures beyond this drag policy, or visual settings UI.
EOF
            ;;
        slice-11b-zone-style-controls)
            cat <<'EOF'
- Confirm the recording starts with Reference, Work, and Comms visible, with the sidebar enabled and the Comms zone row readable before any style is applied.
- Sample frames around `Run: winmux set-zone-style Comms urgent` and `Run: winmux set-zone-style Comms calm`. Fail if the row color changes before the matching command caption appears.
- Confirm the recording shows before-style, urgent-command-start, after-urgent, calm-command-start, after-calm, and final inspection states.
- Confirm `[[zone-styles]]` is visible through the caption/config surface and the exact user commands are visible: `winmux set-zone-style Comms urgent` and `winmux set-zone-style Comms calm`.
- Confirm the visual change is on the Comms zone chrome/sidebar row, including the styled row swatch/tint, not the TextEdit document content, not a layout resize, and not a workspace switch.
- Confirm Comms changes from unstyled to urgent red `#D3455B`, then to calm blue `#3EA2FF`, while Reference and Work do not receive a style.
- Confirm the same windows and active workspaces stay in the same zone ids across both style commands.
- Reject logs-only style proof, final-state-only proof, a style swatch/tint too subtle to see, missing before/command/after samples, command captions that omit the target zone or style id, and any proof where the reviewer cannot distinguish a style change from a layout/workspace change.
EOF
            ;;
        slice-19-zone-style-cycle)
            cat <<'EOF'
- Confirm the recording starts with Reference, Work, and Comms visible, with the sidebar enabled and the Comms zone row readable before any style is applied.
- Sample frames around all three `Run: winmux cycle-zone-style Comms urgent calm` captions. Fail if the row color changes before the matching command caption appears.
- Confirm the recording shows before-style, cycle-urgent-command-start, after-urgent, cycle-calm-command-start, after-calm, cycle-wrap-command-start, after-wrap, and final inspection states.
- Confirm `[[zone-styles]]` and the ergonomic binding `alt-y = 'cycle-zone-style Comms urgent calm'` are visible through the caption/config surface.
- Confirm the exact user command is `winmux cycle-zone-style Comms urgent calm` for all three command beats. Reject any proof or caption that uses `set-zone-style` for this slice.
- Confirm the visual change is on the Comms zone chrome/sidebar row, including the styled row swatch/tint, not the TextEdit document content, not a layout resize, and not a workspace switch.
- Confirm the state sequence is no style -> urgent red `#D3455B`, urgent -> calm blue `#3EA2FF`, then calm -> urgent wraparound.
- Confirm Reference and Work stay unstyled, and the same windows and active workspaces stay in the same zone ids across all three cycle commands.
- State that Slice 19 proves ergonomic runtime style cycling only. It does not prove visual zone editing, draggable dividers, snap/gesture behavior, style persistence across relaunch, or new app/tab-group binding semantics.
- Reject logs-only style proof, final-state-only proof, a missing wraparound beat, a style swatch/tint too subtle to see, command captions that omit the target zone or style ids, and any proof where the reviewer cannot distinguish cycling style chrome from layout/workspace changes.
EOF
            ;;
        slice-11c-zone-availability-sets)
            cat <<'EOF'
- Confirm the recording starts with Reference, Work, and Comms visible, with the sidebar enabled and `[[zone-availability-sets]]` exposed by a caption/config chip.
- Sample frames around `Run: winmux set-zone-style Comms urgent`, `Run: winmux use-zone-availability focus-only`, and `Run: winmux use-zone-availability communications`. Fail if Comms becomes urgent, disappears, or reappears before the matching command caption appears.
- Confirm the recording shows before-availability, urgent-command-start, before-hide-urgent, focus-only-command-start, after-focus-only, communications-command-start, during-communications-restore, and after-communications-restore states.
- Confirm `focus-only` hides both side zones and visibly expands Work/main; this must not be only a log line.
- Confirm `communications` restores Comms/right beside Work/main while Reference/left remains hidden.
- Confirm the Comms document/window and workspace return to the right zone, not a new workspace or a different zone.
- Distinguish the top sidebar `Zones` section from lower parked workspace rows: parked Reference/Comms workspace rows may remain listed while their zones are unavailable.
- Confirm the urgent red `#D3455B` style is visible before hide, during restore, and after restore. Use the color-sentinel rows and screenshots, but still inspect the media.
- Confirm captions expose exact user commands: `winmux use-zone-availability focus-only`, `winmux use-zone-availability communications`, and inspection via `winmux list-zones`.
- Reject logs-only proof, final-state-only proof, unclear availability-set labels, command captions that omit the set id, a restore where Comms returns unstyled, or any video where the viewer cannot tell whether the action is a named set versus a manual zone toggle.
EOF
            ;;
        *)
            cat <<'EOF'
- Confirm the recording visually demonstrates the stated WinMux behavior without relying only on logs.
- Confirm captions expose concrete WinMux user actions, commands, or config.
EOF
            ;;
    esac
}

