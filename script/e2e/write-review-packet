#!/usr/bin/env bash
set -euo pipefail

RUN_DIR="${1:-}"

usage() {
    cat <<EOF
Usage: $(basename "$0") <artifact-run-dir>

Writes <artifact-run-dir>/reviews/reviewer-packet.md with the filled artifact
paths, baseline media, verifier command, and slice-specific review checks for a
no-context artifact reviewer.
EOF
}

die() {
    printf '[winmux-review-packet] error: %s\n' "$*" >&2
    exit 1
}

scrub_finder_metadata() {
    find "$RUN_DIR" -name .DS_Store -delete
    if command -v xattr >/dev/null 2>&1; then
        xattr -cr "$RUN_DIR" 2>/dev/null || true
    fi
}

[ -n "$RUN_DIR" ] || {
    usage >&2
    die "Missing artifact run directory"
}
[ -d "$RUN_DIR" ] || die "Artifact directory does not exist: $RUN_DIR"
scrub_finder_metadata

LOGS_DIR="${RUN_DIR}/logs"
SCREENSHOTS_DIR="${RUN_DIR}/screenshots"
RECORDINGS_DIR="${RUN_DIR}/recordings"
REVIEWS_DIR="${RUN_DIR}/reviews"
PACKET_PATH="${REVIEWS_DIR}/reviewer-packet.md"
REVIEW_OUTPUT_PATH="${REVIEWS_DIR}/no-ctx-artifact-review.md"
REVIEW_SKELETON_PATH="${REVIEWS_DIR}/no-ctx-artifact-review.skeleton.md"
CONFIG_PATH="${RUN_DIR}/config/winmux.toml"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"

require_file() {
    local path="$1"
    [ -s "$path" ] || die "Missing or empty file: $path"
}

single_match() {
    local pattern="$1"
    local path
    path="$(find "$RUN_DIR" -path "$pattern" -type f | sort | head -1)"
    printf '%s\n' "$path"
}

recording_path="$(find "$RECORDINGS_DIR" -maxdepth 1 -type f -name '*.mov' ! -name '*.demo.mov' | sort | head -1)"
require_file "$recording_path"
recording_name="$(basename "$recording_path" .mov)"
raw_recording_path="${RECORDINGS_DIR}/raw/${recording_name}.raw.mov"
demo_recording_path="${RECORDINGS_DIR}/${recording_name}.demo.mov"
before_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '00-before-*.png' | sort | head -1)"
ready_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f \( -name '01-ready-*.png' -o -name '01-*-ready-*.png' \) | sort | head -1)"
after_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '99-after-*.png' | sort | head -1)"
contact_sheet="${SCREENSHOTS_DIR}/${recording_name}.contact-sheet.jpg"
contact_sheet_manifest="${LOGS_DIR}/${recording_name}.contact-sheet-manifest.tsv"
samples_dir="${SCREENSHOTS_DIR}/${recording_name}.samples"
sample_manifest="${LOGS_DIR}/${recording_name}.sample-manifest.tsv"
event_contact_sheet="${SCREENSHOTS_DIR}/${recording_name}.event-contact-sheet.jpg"
topology_event_manifest="${LOGS_DIR}/${recording_name}.topology-event-manifest.tsv"
topology_contact_sheet="${SCREENSHOTS_DIR}/${recording_name}.topology-contact-sheet.jpg"
edge_crops_dir="${SCREENSHOTS_DIR}/${recording_name}.edge-crops"
edge_crops_manifest="${LOGS_DIR}/${recording_name}.edge-crops.tsv"
transport_summary="${LOGS_DIR}/guest-transport-summary.tsv"
guest_script_retry_summary="${LOGS_DIR}/guest-script-retry-summary.tsv"
reviewer_attempts="${REVIEWS_DIR}/reviewer-attempts.tsv"
reviewer_citation_checklist="${REVIEWS_DIR}/reviewer-citation-checklist.tsv"
boundary_samples_glob="${samples_dir}/caption-*-boundary-*.png"
annotation_plan="${LOGS_DIR}/${recording_name}.annotations.tsv"
annotation_log="${LOGS_DIR}/${recording_name}.annotation.log"
caption_tail="${LOGS_DIR}/${recording_name}.caption-tail.tsv"
demo_cut_manifest="${LOGS_DIR}/${recording_name}.demo-cut.tsv"
expected_chips="${LOGS_DIR}/${recording_name}.expected-chips.txt"
proof_manifest="${LOGS_DIR}/${recording_name}.proof-manifest.tsv"
event_manifest="${LOGS_DIR}/${recording_name}.event-manifest.tsv"
mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
delegated_mouse_events="${LOGS_DIR}/slice-26-zone-divider-drag.mouse-events.tsv"
color_sentinel="${LOGS_DIR}/${recording_name}.color-sentinel.tsv"
overlay_sentinel="${LOGS_DIR}/${recording_name}.overlay-sentinel.tsv"
visible_geometry_board="${LOGS_DIR}/slice-11a-visible-geometry-board.txt"
proof_file="${RUN_DIR}/${recording_name}-proof.txt"
if [ ! -s "$proof_file" ]; then
    proof_file="$(single_match "${RUN_DIR}/*-proof.txt")"
fi
if [ ! -s "$visible_geometry_board" ]; then
    visible_geometry_board="not applicable"
fi
if [ -s "$proof_manifest" ] || [[ "$recording_name" == *drag* ]]; then
    proof_manifest_label="$proof_manifest"
else
    proof_manifest_label="not applicable"
fi
if [ -s "$color_sentinel" ]; then
    color_sentinel_label="$color_sentinel"
else
    color_sentinel_label="not applicable"
fi
if [ -s "$event_manifest" ]; then
    event_manifest_label="$event_manifest"
else
    event_manifest_label="not applicable"
fi
if [ -s "$contact_sheet_manifest" ]; then
    contact_sheet_manifest_label="$contact_sheet_manifest"
else
    contact_sheet_manifest_label="not applicable"
fi
if [ "$recording_name" = "slice-32-divider-save-relaunch" ] && [ -s "$delegated_mouse_events" ]; then
    mouse_events_label="$delegated_mouse_events"
elif [ -s "$mouse_events" ]; then
    mouse_events_label="$mouse_events"
else
    mouse_events_label="not applicable"
fi
if [ -s "$event_contact_sheet" ]; then
    event_contact_sheet_label="$event_contact_sheet"
else
    event_contact_sheet_label="not applicable"
fi
if [ -s "$topology_event_manifest" ]; then
    topology_event_manifest_label="$topology_event_manifest"
else
    topology_event_manifest_label="not applicable"
fi
if [ -s "$topology_contact_sheet" ]; then
    topology_contact_sheet_label="$topology_contact_sheet"
else
    topology_contact_sheet_label="not applicable"
fi
if [ -s "$caption_tail" ]; then
    caption_tail_label="$caption_tail"
else
    caption_tail_label="not applicable"
fi
demo_recording_exists=0
demo_cut_manifest_exists=0
[ ! -s "$demo_recording_path" ] || demo_recording_exists=1
[ ! -s "$demo_cut_manifest" ] || demo_cut_manifest_exists=1
if [ "$demo_recording_exists" != "$demo_cut_manifest_exists" ]; then
    die "Demo cut sidecar is incomplete; expected both $demo_recording_path and $demo_cut_manifest or neither"
fi
case "$recording_name" in
    slice-31-relaunch-saved-layout|slice-32-divider-save-relaunch)
        [ "$demo_recording_exists" = "1" ] \
            || die "${recording_name} reviewer packet requires demo sidecar evidence: $demo_recording_path and $demo_cut_manifest"
        ;;
esac
if [ "$demo_recording_exists" = "1" ] && [ "$demo_cut_manifest_exists" = "1" ]; then
    demo_recording_label="$demo_recording_path"
    demo_cut_manifest_label="$demo_cut_manifest"
else
    demo_recording_label="not applicable"
    demo_cut_manifest_label="not applicable"
fi
if [ -s "$overlay_sentinel" ]; then
    overlay_sentinel_label="$overlay_sentinel"
else
    overlay_sentinel_label="not applicable"
fi
if [ -d "$edge_crops_dir" ] && [ -s "$edge_crops_manifest" ]; then
    edge_crops_label="$edge_crops_dir"
    edge_crops_manifest_label="$edge_crops_manifest"
else
    edge_crops_label="not applicable"
    edge_crops_manifest_label="not applicable"
fi

mkdir -p "$REVIEWS_DIR"

ensure_reviewer_attempts_ledger() {
    if [ ! -e "$reviewer_attempts" ]; then
        printf '# role\tstarted_at\tfinished_at\tstatus\toutput_path\treplacement_reason\n' >"$reviewer_attempts"
    fi
}

has_post_recording_retry() {
    [ -s "$guest_script_retry_summary" ] || return 1
    /usr/bin/awk -F'\t' '
        $0 == "" || $1 ~ /^#/ { next }
        {
            before_recording = $6
            failures = $4 + 0
            if (before_recording == "no" && failures > 0) {
                found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$guest_script_retry_summary"
}

guest_retry_summary_block() {
    [ -s "$guest_script_retry_summary" ] || return 0

    if has_post_recording_retry; then
        cat <<EOF
## Guest Retry Summary

Post-recording guest retries are present. Read this before inspecting the
recording, and cite any failed post-recording row in the review:

\`\`\`tsv
$(cat "$guest_script_retry_summary")
\`\`\`

EOF
    fi
}

ensure_reviewer_attempts_ledger

drag_screenshot_lines() {
    [ -s "$proof_manifest" ] || return 0
    /usr/bin/awk -F'\t' -v screenshots_dir="$SCREENSHOTS_DIR" '
        $1 == "drag-screenshots" {
            printf("- %s drag screenshot: %s/%s\n", $2, screenshots_dir, $3)
        }
    ' "$proof_manifest"
}

expected_chip_lines() {
    if [ -s "$expected_chips" ]; then
        /usr/bin/awk '{ printf("- `%s`\n", $0) }' "$expected_chips"
        return 0
    fi
    [ -s "$annotation_plan" ] || return 0
    /usr/bin/awk -F'\t' '
        $0 == "" || $1 ~ /^#/ { next }
        {
            for (i = 5; i <= NF; i++) {
                if ($i != "") {
                    printf("- `%s`\n", $i)
                }
            }
        }
    ' "$annotation_plan"
}

semantic_sample_checklist_lines() {
    if [ ! -s "$sample_manifest" ]; then
        printf '%s\n' "- no semantic sample manifest present"
        return 0
    fi
    /usr/bin/awk -F'\t' '
        $1 == "semantic" {
            printf("- [ ] `%s` -> `%s` (%s)\n", $2, $5, $6)
            found = 1
        }
        END {
            if (!found) {
                print "- no semantic sample rows present"
            }
        }
    ' "$sample_manifest"
}

clean_checklist_cell() {
    printf '%s\n' "$1" | /usr/bin/tr '\t\r\n' '   ' | /usr/bin/sed 's/[[:space:]]\{1,\}/ /g; s/^ //; s/ $//'
}

add_citation_checklist_row() {
    local kind="$1"
    local label="$2"
    local path="$3"
    local required_citation="$4"
    printf '%s\t%s\t%s\t%s\n' \
        "$(clean_checklist_cell "$kind")" \
        "$(clean_checklist_cell "$label")" \
        "$(clean_checklist_cell "$path")" \
        "$(clean_checklist_cell "$required_citation")" >>"$reviewer_citation_checklist"
}

add_file_citation_row_if_present() {
    local kind="$1"
    local label="$2"
    local path="$3"
    [ -s "$path" ] || return 0
    add_citation_checklist_row "$kind" "$label" "$path" "cite exact artifact path"
}

add_baseline_citation_row() {
    local path="$1"
    add_citation_checklist_row "baseline" "$(basename "$path")" "$path" "compare against baseline/product surface"
}

write_reviewer_citation_checklist() {
    printf '# kind\tlabel\tpath\trequired_citation\n' >"$reviewer_citation_checklist"

    add_file_citation_row_if_present media primary-recording "$recording_path"
    add_file_citation_row_if_present media raw-recording "$raw_recording_path"
    add_file_citation_row_if_present media contact-sheet "$contact_sheet"
    add_file_citation_row_if_present media event-contact-sheet "$event_contact_sheet"
    add_file_citation_row_if_present media topology-contact-sheet "$topology_contact_sheet"
    add_file_citation_row_if_present media before-screenshot "$before_screenshot"
    add_file_citation_row_if_present media ready-screenshot "$ready_screenshot"
    add_file_citation_row_if_present media after-screenshot "$after_screenshot"
    add_file_citation_row_if_present manifest sample-manifest "$sample_manifest"
    add_file_citation_row_if_present manifest event-manifest "$event_manifest"
    add_file_citation_row_if_present manifest topology-event-manifest "$topology_event_manifest"
    add_file_citation_row_if_present manifest expected-chips "$expected_chips"
    add_file_citation_row_if_present manifest edge-crops "$edge_crops_manifest"
    add_file_citation_row_if_present manifest proof-manifest "$proof_manifest"
    add_file_citation_row_if_present manifest color-sentinel "$color_sentinel"
    add_file_citation_row_if_present manifest overlay-sentinel "$overlay_sentinel"
    add_file_citation_row_if_present log guest-retry-summary "$guest_script_retry_summary"
    add_file_citation_row_if_present log guest-transport-summary "$transport_summary"
    add_file_citation_row_if_present log clean-slate "${LOGS_DIR}/guest-clean-slate.log"
    add_file_citation_row_if_present log privacy-setup "${LOGS_DIR}/guest-privacy-setup.log"
    add_file_citation_row_if_present log reviewer-attempt-ledger "$reviewer_attempts"

    if [ -s "$sample_manifest" ]; then
        /usr/bin/awk -F'\t' '
            $1 == "semantic" {
                printf("semantic-sample\t%s\t%s\tcite label and exact sample path\n", $2, $5)
            }
        ' "$sample_manifest" >>"$reviewer_citation_checklist"
    fi

    if [ -s "$event_manifest" ]; then
        /usr/bin/awk -F'\t' '
            $0 == "" || $1 ~ /^#/ { next }
            {
                printf("event\t%s\t%s\tcite event id, caption label, path, and expected state\n", $1, $6)
            }
        ' "$event_manifest" >>"$reviewer_citation_checklist"
    fi

    if [ -s "$topology_event_manifest" ]; then
        /usr/bin/awk -F'\t' '
            $0 == "" || $1 ~ /^#/ { next }
            {
                printf("topology-event\t%s\t%s\tcite topology event id, caption label, path, and expected state\n", $1, $6)
            }
        ' "$topology_event_manifest" >>"$reviewer_citation_checklist"
    fi

    if [ -s "$expected_chips" ]; then
        # shellcheck disable=SC2094
        while IFS= read -r chip; do
            [ -n "$chip" ] || continue
            add_citation_checklist_row "expected-chip" "$chip" "$expected_chips" "cite exact caption chip"
        done <"$expected_chips"
    fi

    # shellcheck disable=SC2094
    while IFS= read -r timing_log; do
        [ -s "$timing_log" ] || continue
        while IFS='=' read -r key _value; do
            [ -n "$key" ] || continue
            add_citation_checklist_row "timing" "$key" "$timing_log" "cite timing key and value"
        done <"$timing_log"
    done < <(find "$LOGS_DIR" -maxdepth 1 -type f -name '*command-timing.log' | sort)

    if [ -s "$edge_crops_manifest" ]; then
        /usr/bin/awk -F'\t' '
            $0 == "" || $1 ~ /^#/ { next }
            {
                printf("edge-crop\t%s\t%s\tcite exact edge crop path\n", $1, $2)
            }
        ' "$edge_crops_manifest" >>"$reviewer_citation_checklist"
    fi

    if [ -s "$guest_script_retry_summary" ]; then
        /usr/bin/awk -F'\t' '
            NR == 1 {
                for (i = 1; i <= NF; i++) {
                    key = $i
                    sub(/^# /, "", key)
                    column[key] = i
                }
                next
            }
            $0 == "" || $1 ~ /^#/ { next }
            {
                phase = $column["phase"]
                failures = $(column["failures"]) + 0
                before_recording = $(column["before_recording"])
                if (before_recording == "no" && failures > 0) {
                    printf("post-recording-retry\t%s\t%s\tcite phase, log, before_recording, attempt statuses, final result, and mutation decision\n", phase, $(column["log"]))
                }
            }
        ' "$guest_script_retry_summary" >>"$reviewer_citation_checklist"
    fi

    if [ -s "$reviewer_attempts" ]; then
        /usr/bin/awk -F'\t' '
            NR == 1 { next }
            $0 == "" || $1 ~ /^#/ { next }
            {
                status = tolower($4)
                if (status != "clean" && status != "pass" && status != "passed" && status != "success" && status != "accepted") {
                    printf("reviewer-attempt\t%s:%s\t%s\tcite ledger path, role, status, output path, and replacement reason\n", $1, $4, $5)
                }
            }
        ' "$reviewer_attempts" >>"$reviewer_citation_checklist"
    fi

    for package_file in \
        "${LOGS_DIR}/package-slice-manifest.txt" \
        "${LOGS_DIR}/package-host-provenance.env" \
        "${LOGS_DIR}/package-provenance.env" \
        "${LOGS_DIR}/product-evidence-index.tsv" \
        "${LOGS_DIR}/install-proof.log" \
        "${LOGS_DIR}/launch-proof.log" \
        "${LOGS_DIR}/support-bundle-schema.log" \
        "${LOGS_DIR}/slice-50-package-stage.log" \
        "${LOGS_DIR}/slice-50-support-bundle-command.log" \
        "${RUN_DIR}/docs/release-notes.md" \
        "${RUN_DIR}/package/WinMux.app" \
        "${RUN_DIR}/bin/winmux"; do
        if [ -e "$package_file" ]; then
            add_citation_checklist_row "package" "$(basename "$package_file")" "$package_file" "cite exact package proof path"
        fi
    done
    if [ -d "${LOGS_DIR}/slice-50-zone-support-bundle" ]; then
        add_citation_checklist_row "package" "slice-50-zone-support-bundle" "${LOGS_DIR}/slice-50-zone-support-bundle" "cite support bundle directory and schema result"
    fi

    add_baseline_citation_row "${REPO_ROOT}/demo.mp4"
    add_baseline_citation_row "${REPO_ROOT}/demo2.mp4"
    add_baseline_citation_row "${REPO_ROOT}/demo3.mp4"
    add_baseline_citation_row "${REPO_ROOT}/demo-columnar-zones.mp4"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/recordings/demo-columnar-zones.mp4"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/screenshots/demo-columnar-zones.contact-sheet.jpg"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/screenshots/demo-columnar-zones.samples"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/screenshots/demo-columnar-zones.source-event-contact-sheet.jpg"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/logs/root-demo.ffprobe.json"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/logs/root-demo.source-sample-manifest.tsv"
    add_baseline_citation_row "${REPO_ROOT}/artifacts/e2e/slice-36-root-current-demo-20260701T004813Z/reviews/no-ctx-artifact-review.md"
    add_baseline_citation_row "${REPO_ROOT}/resources/screenshots/winmux-overview.png"
    add_baseline_citation_row "${REPO_ROOT}/resources/screenshots/tab-groups.png"
    add_baseline_citation_row "${REPO_ROOT}/README.md"
    add_baseline_citation_row "https://github.com/zimengxiong/winmux"
    add_baseline_citation_row "https://macoswm.com/wm/winmux"
}

write_review_skeleton() {
    {
        cat <<EOF
# No-Context Artifact Review Skeleton

This is a reviewer drafting aid, not an accepted review. Write the final review
to:

\`${REVIEW_OUTPUT_PATH}\`

The final review still has to satisfy
\`script/e2e/prompts/no-context-artifact-review.md\`.

## Output Contract

- First nonblank line: \`PASS: ...\`, \`PASS_WITH_NOTES: ...\`, or \`FAIL: ...\`.
- Include \`fork_context=false\` and state whether prior chat history was absent.
- Final line: \`next slice allowed: yes\` or \`next slice allowed: no\`.

## Visual Proof Path

Inspect these before reading implementation details:

- primary recording: \`${recording_path}\`
- before screenshot: \`${before_screenshot}\`
- ready screenshot: \`${ready_screenshot:-not present}\`
- after screenshot: \`${after_screenshot}\`
- contact sheet: \`${contact_sheet}\`
- event contact sheet: \`${event_contact_sheet_label}\`
- sample manifest: \`${sample_manifest}\`
- event manifest: \`${event_manifest_label}\`
- edge crops: \`${edge_crops_label}\`

## Required Citation Checklist

Use this checklist to make the review lintable. Keep the exact paths, labels,
timing keys, event ids, and caption chips that apply.

EOF
        /usr/bin/awk -F'\t' '
            NR == 1 { next }
            $0 == "" || $1 ~ /^#/ { next }
            {
                printf("- [ ] %s `%s`: `%s` - %s\n", $1, $2, $3, $4)
            }
        ' "$reviewer_citation_checklist"
        cat <<EOF

## Verdict Draft

Replace this section with the actual review. Do not leave unchecked boxes as a
substitute for evidence.
EOF
    } >"$REVIEW_SKELETON_PATH"
}

slice_specific_checks() {
    case "$recording_name" in
        slice-2-config-zones)
            cat <<'EOF'
- Confirm three live labeled TextEdit windows are visible in Reference, Work, and Comms.
- Confirm the visual proof is more than CLI output and the captions expose the `[[zones]]` config and WinMux commands.
EOF
            ;;
        slice-3-stable-identity)
            cat <<'EOF'
- Confirm before, reload, and after beats are all visible, not just final state.
- Confirm labeled windows stay attached to left, main, and right zone ids after the config reload.
EOF
            ;;
        slice-4-zone-commands)
            cat <<'EOF'
- Confirm `list-zones`, `focus-zone Reference`, `focus-zone Work`, `move-node-to-zone Comms --fail-if-noop`, and `focus-monitor 1` are visible through captions and correlated logs.
- Reject no-op movement proofs unless strict no-op failure is shown.
EOF
            ;;
        slice-12-mouse-zone-snap-drag)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags, not a sidebar drag: first without Alt, then with Alt held.
- Confirm the no-Alt drag has visible source pickup and hover/path over the target area, but no whole-zone snap overlay and no zone move in the after-freeform logs.
- Confirm the positive drag shows source pickup, pointer/path, the whole Comms zone overlay/highlight, release/drop, and final placement.
- State whether the target is a whole zone or a window/slot inside a zone. For Slice 12, the expected answer is whole zone.
- Confirm captions expose `[mouse.zone-snap]`, `policy = 'snap-on-modifier'`, `modifier = 'alt'`, and the user action `hold Alt while dragging`.
- Name the exact media file used for each beat: freeform pickup, freeform no-overlay hover, reset-before-snap, Alt pickup, Alt path, whole-zone hover/overlay, release/final placement.
- Reject final-placement-only proof, missing negative proof, missing modifier-held positive proof, an unclear snap target, or a review that assumes the overlay appeared without inspecting action frames.
EOF
            ;;
        slice-16-mouse-snap-affordance)
            cat <<'EOF'
- Confirm the recording shows two separate desktop window drags, not a sidebar drag: first without Option, then with Option held.
- Confirm the no-Option drag has visible source pickup and hover/path over the target area, but no whole-zone snap overlay and no zone move in the after-freeform logs.
- Confirm the Option-held drag shows source pickup, pointer/path, the whole Comms zone overlay/highlight, release/drop, and final placement.
- Inspect `logs/slice-16-mouse-snap-affordance.overlay-sentinel.tsv`. Confirm it names `target-semantics` as `whole-zone`, includes freeform and snap target-zone crop paths, includes `target-label` equal to `WHOLE ZONE TARGET: COMMS` when present, and reports `overlay-rmse-normalized` at or above its minimum.
- State whether the target is a whole zone or a window/slot inside a zone. For Slice 16, the expected answer is whole zone.
- Confirm captions expose `[mouse.zone-snap]`, `policy='snap-on-modifier'`, `modifier='alt'`, `target='zone'`, and the user action `hold Option while dragging: snap to Comms zone`.
- Name the exact media file used for each beat: freeform pickup, freeform no-overlay hover, reset-before-snap, Option pickup, Option path, whole-zone hover/overlay, release/final placement, and overlay sentinel crops.
- Reject final-placement-only proof, missing negative proof, missing modifier-held positive proof, missing overlay sentinel, an unclear snap target, a snap-to-window/slot claim, or a review that assumes the overlay appeared without inspecting action frames.
EOF
            ;;
        slice-13-zone-mode-bindings)
