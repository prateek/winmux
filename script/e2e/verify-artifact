    awk -F '\t' '$5 == "Action: drag snap-demo.rtf without Alt" { found = 1; ok = (($1 + 0) <= 8 && ($2 + 0) >= 18) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
