artifact_has_product_media() {
    local artifact_dir="$1"
    [ -d "${artifact_dir}/recordings" ] || return 1
    find "${artifact_dir}/recordings" -maxdepth 2 -type f \( -name '*.mov' -o -name '*.mp4' \) -print -quit | grep . >/dev/null
}

artifact_has_review_packet() {
    local artifact_dir="$1"
    [ -s "${artifact_dir}/reviews/reviewer-packet.md" ]
}

artifact_is_superseded() {
    local artifact_dir="$1"
    [ -s "${artifact_dir}/reviews/superseded.md" ] && [ -s "${artifact_dir}/logs/run-abort-status.txt" ]
}

require_no_stale_sibling_artifacts() {
    local run_basename parent_dir slice_prefix candidate candidate_basename offenders
    run_basename="$(basename "$RUN_DIR")"
    parent_dir="$(dirname "$RUN_DIR")"
    slice_prefix="$(printf '%s\n' "$run_basename" | /usr/bin/sed -E 's/-[0-9]{8}T[0-9]{6}Z$//')"
    [ -n "$slice_prefix" ] || return 0
    [ "$slice_prefix" != "$run_basename" ] || return 0

    offenders=""
    for candidate in "${parent_dir}/${slice_prefix}"-*; do
        [ -d "$candidate" ] || continue
        candidate_basename="$(basename "$candidate")"
        if artifact_has_product_media "$candidate" || artifact_has_review_packet "$candidate"; then
            if review_is_accepted "${candidate}/reviews/no-ctx-artifact-review.md" || artifact_is_superseded "$candidate"; then
                continue
            fi
            offenders="${offenders}${candidate_basename} "
        fi
    done

    [ -z "$offenders" ] || die "Same-slice artifact(s) have product media or reviewer packets but are neither accepted nor superseded: ${offenders}"
}

