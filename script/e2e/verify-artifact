require_review_mentions_artifact_path() {
    local review_path="$1"
    local path="$2"
    local description="$3"
    local exact="${4:-0}"
    [ -s "$path" ] || die "Required review citation target is missing: $path"

    local relative="${path#"$RUN_DIR"/}"
    local basename_path
    basename_path="$(basename "$path")"
    if [ "$exact" = "1" ]; then
        grep -F "$path" "$review_path" >/dev/null \
            || grep -F "$relative" "$review_path" >/dev/null \
            || die "Review does not cite ${description} by exact artifact path: $relative"
    else
        grep -F "$path" "$review_path" >/dev/null \
            || grep -F "$relative" "$review_path" >/dev/null \
            || grep -F "$basename_path" "$review_path" >/dev/null \
            || die "Review does not cite ${description}: $relative"
