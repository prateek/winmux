assert_numeric_gt() {
    local left="$1"
    local right="$2"
    local message="$3"
    /usr/bin/awk -v left="$left" -v right="$right" 'BEGIN { exit(left > right ? 0 : 1) }' \
        || die "$message: expected $left > $right"
}

assert_numeric_lt() {
    local left="$1"
    local right="$2"
    local message="$3"
    /usr/bin/awk -v left="$left" -v right="$right" 'BEGIN { exit(left < right ? 0 : 1) }' \
        || die "$message: expected $left < $right"
}

assert_numeric_le() {
    local left="$1"
    local right="$2"
    local message="$3"
    /usr/bin/awk -v left="$left" -v right="$right" 'BEGIN { exit(left <= right ? 0 : 1) }' \
        || die "$message: expected $left <= $right"
}

assert_numeric_approximately_equal() {
    local left="$1"
    local right="$2"
    local tolerance="$3"
    local message="$4"
    /usr/bin/awk -v left="$left" -v right="$right" -v tolerance="$tolerance" '
        function abs(x) { return x < 0 ? -x : x }
        BEGIN { exit(abs(left - right) <= tolerance ? 0 : 1) }
    ' || die "$message: expected $left ~= $right within $tolerance"
}

assert_numeric_between_inclusive() {
    local value="$1"
    local min="$2"
    local max="$3"
    local message="$4"
    /usr/bin/awk -v value="$value" -v min="$min" -v max="$max" 'BEGIN {
        exit(value >= min && value <= max ? 0 : 1)
    }' || die "$message: expected $value between $min and $max"
}

