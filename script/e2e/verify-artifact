    require_file "$ready_screenshot"
    require_file "$before_resize_screenshot"
    require_file "$after_resize_screenshot"
    require_file "$before_balance_screenshot"
    require_file "$after_balance_screenshot"

    grep -F 'PASS: resize-zone Work width +10% changes runtime zone widths; balance-zones returns enabled zones to equal widths while preserving windows and workspaces.' "$proof" >/dev/null \
        || die "Slice 11A proof does not contain the expected PASS claim"
    grep -F "alt-equal = 'resize-zone Work width +10%'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11A config missing resize grow binding"
    grep -F "alt-minus = 'resize-zone Work width -10%'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11A config missing resize shrink binding"
    grep -F "alt-0 = 'balance-zones'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11A config missing balance binding"
    grep -F "alt-tab = 'cycle-zone-layout balanced focus'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11A config missing cycle-zone-layout binding"
    grep -F 'Config: resize-zone Work width +10%, balance-zones, cycle-zone-layout balanced focus' "$setup_log" >/dev/null \
        || die "Slice 11A setup log missing command/config summary"
    grep -F 'visible-geometry-board=TextEdit zone documents' "$geometry_board_log" >/dev/null \
        || die "Slice 11A geometry board log missing visible TextEdit board marker"
    for field in zone-id enabled configured-width effective-width runtime-width override-state left-edge pixel-width active-workspace; do
        grep -F "$field" "$geometry_board_log" >/dev/null \
            || die "Slice 11A visible geometry board missing field label: $field"
    done
    for zone_id in left main right; do
        grep -F "zone-id=${zone_id}|enabled=true" "$geometry_board_log" >/dev/null \
            || die "Slice 11A visible geometry board missing enabled row for zone: $zone_id"
    done
    grep -F 'resize configured-width=0.50 effective-width=0.60 runtime-width=0.60 override-state=runtime' "$geometry_board_log" >/dev/null \
        || die "Slice 11A visible geometry board missing Work runtime resize values"
    grep -F 'balance configured-width=0.50 effective-width=0.333 runtime-width=0.333 override-state=runtime' "$geometry_board_log" >/dev/null \
        || die "Slice 11A visible geometry board missing Work runtime balance values"

    grep -F '$ winmux resize-zone Work width +10%' "$resize_log" >/dev/null \
        || die "Slice 11A resize log missing exact command"
    grep -F "Resized zone 'Work' on monitor 1 by +10%" "$resize_log" >/dev/null \
        || die "Slice 11A resize log missing success output"
    grep -F '$ winmux balance-zones' "$balance_log" >/dev/null \
        || die "Slice 11A balance log missing exact command"
    grep -F 'Balanced zones on monitor 1' "$balance_log" >/dev/null \
        || die "Slice 11A balance log missing success output"
    local resize_offset balance_offset
    resize_offset="$(value_from_log resize-command-offset-seconds "$timing_log")"
    balance_offset="$(value_from_log balance-command-offset-seconds "$timing_log")"
    [ -n "$resize_offset" ] || die "Slice 11A timing log missing resize command offset"
    [ -n "$balance_offset" ] || die "Slice 11A timing log missing balance command offset"
    assert_numeric_between_inclusive "$resize_offset" 13 24 \
        "Slice 11A resize command must happen while the resize command caption is on screen"
    assert_numeric_between_inclusive "$balance_offset" 32 40 \
        "Slice 11A balance command must happen while the balance command caption is on screen"

    require_zone_geometry_contiguous "$zones_before" "Slice 11A before geometry" 1
    require_zone_geometry_contiguous "$zones_resized" "Slice 11A resized geometry" 1
    require_zone_geometry_contiguous "$zones_balanced" "Slice 11A balanced geometry" 1
    for zone_id in left main right; do
        require_visible_board_matches_zone_log "$geometry_board_log" "$zone_id" before "$zones_before" before
        require_visible_board_matches_zone_log "$geometry_board_log" "$zone_id" resize "$zones_resized" resized
        require_visible_board_matches_zone_log "$geometry_board_log" "$zone_id" balance "$zones_balanced" balanced
    done

    local before_left before_main before_right
    local resized_left resized_main resized_right
    local balanced_left balanced_main balanced_right
    before_left="$(zone_log_value "$zones_before" left width)"
    before_main="$(zone_log_value "$zones_before" main width)"
    before_right="$(zone_log_value "$zones_before" right width)"
    resized_left="$(zone_log_value "$zones_resized" left width)"
    resized_main="$(zone_log_value "$zones_resized" main width)"
    resized_right="$(zone_log_value "$zones_resized" right width)"
    balanced_left="$(zone_log_value "$zones_balanced" left width)"
    balanced_main="$(zone_log_value "$zones_balanced" main width)"
    balanced_right="$(zone_log_value "$zones_balanced" right width)"
    [ -n "$before_left" ] && [ -n "$before_main" ] && [ -n "$before_right" ] \
        || die "Slice 11A before zones log missing widths"
    [ -n "$resized_left" ] && [ -n "$resized_main" ] && [ -n "$resized_right" ] \
        || die "Slice 11A resized zones log missing widths"
    [ -n "$balanced_left" ] && [ -n "$balanced_main" ] && [ -n "$balanced_right" ] \
        || die "Slice 11A balanced zones log missing widths"

    assert_numeric_gt "$resized_main" "$before_main" "Slice 11A Work/main width did not grow after resize-zone"
    assert_numeric_lt "$resized_left" "$before_left" "Slice 11A Reference/left width did not shrink after resize-zone"
    assert_numeric_lt "$resized_right" "$before_right" "Slice 11A Comms/right width did not shrink after resize-zone"
    assert_numeric_approximately_equal "$balanced_left" "$balanced_main" 2 "Slice 11A balanced left/main widths differ"
    assert_numeric_approximately_equal "$balanced_main" "$balanced_right" 2 "Slice 11A balanced main/right widths differ"

    grep -F 'zone=left|name=Reference|layout=balanced|enabled=true|configured=0.25|' "$zones_before" >/dev/null \
        || die "Slice 11A before zones log missing configured Reference/left row"
    grep -F 'zone=main|name=Work|layout=balanced|enabled=true|configured=0.5|' "$zones_before" >/dev/null \
        || die "Slice 11A before zones log missing configured Work/main row"
    grep -F 'zone=right|name=Comms|layout=balanced|enabled=true|configured=0.25|' "$zones_before" >/dev/null \
        || die "Slice 11A before zones log missing configured Comms/right row"
    grep -F 'zone=main|name=Work|layout=balanced|enabled=true|configured=0.5|effective=0.6|override=0.6|override-state=runtime|' "$zones_resized" >/dev/null \
        || die "Slice 11A resized zones log missing runtime Work/main width override"
    grep -F 'override-state=runtime' "$zones_balanced" >/dev/null \
        || die "Slice 11A balanced zones log missing runtime override state"

    local title expected_zone before_id resized_id balanced_id before_zone resized_zone balanced_zone
    local before_workspace resized_workspace balanced_workspace
    for title in reference-width.rtf work-width.rtf comms-width.rtf; do
        case "$title" in
            reference-width.rtf) expected_zone=left ;;
            work-width.rtf) expected_zone=main ;;
            comms-width.rtf) expected_zone=right ;;
        esac
        before_id="$(field_for_title "$windows_before" "$title" id)"
        resized_id="$(field_for_title "$windows_resized" "$title" id)"
        balanced_id="$(field_for_title "$windows_balanced" "$title" id)"
        before_zone="$(field_for_title "$windows_before" "$title" zone)"
        resized_zone="$(field_for_title "$windows_resized" "$title" zone)"
        balanced_zone="$(field_for_title "$windows_balanced" "$title" zone)"
        before_workspace="$(field_for_title "$windows_before" "$title" workspace)"
        resized_workspace="$(field_for_title "$windows_resized" "$title" workspace)"
        balanced_workspace="$(field_for_title "$windows_balanced" "$title" workspace)"
        [ -n "$before_id" ] && [ -n "$resized_id" ] && [ -n "$balanced_id" ] \
            || die "Slice 11A missing window title across logs: $title"
        [ "$before_id" = "$resized_id" ] && [ "$resized_id" = "$balanced_id" ] \
            || die "Slice 11A window id changed for $title: $before_id -> $resized_id -> $balanced_id"
        [ "$before_zone" = "$expected_zone" ] && [ "$resized_zone" = "$expected_zone" ] && [ "$balanced_zone" = "$expected_zone" ] \
            || die "Slice 11A zone changed for $title: $before_zone -> $resized_zone -> $balanced_zone"
        [ -n "$before_workspace" ] && [ "$before_workspace" = "$resized_workspace" ] && [ "$resized_workspace" = "$balanced_workspace" ] \
            || die "Slice 11A workspace changed for $title: $before_workspace -> $resized_workspace -> $balanced_workspace"
    done

    grep -F "widths-before=left:${before_left},main:${before_main},right:${before_right}" "$proof" >/dev/null \
        || die "Slice 11A proof does not copy before widths from zones log"
    grep -F "widths-resized=left:${resized_left},main:${resized_main},right:${resized_right}" "$proof" >/dev/null \
        || die "Slice 11A proof does not copy resized widths from zones log"
    grep -F "widths-balanced=left:${balanced_left},main:${balanced_main},right:${balanced_right}" "$proof" >/dev/null \
        || die "Slice 11A proof does not copy balanced widths from zones log"
    grep -F "resize-command-offset-seconds=${resize_offset}" "$proof" >/dev/null \
        || die "Slice 11A proof does not copy resize command timing"
    grep -F "balance-command-offset-seconds=${balance_offset}" "$proof" >/dev/null \
        || die "Slice 11A proof does not copy balance command timing"
    grep -F 'Visible geometry board:' "$proof" >/dev/null \
        || die "Slice 11A proof does not include the visible geometry board manifest"

    grep -F "Config: [[zones]] + width controls" "$annotation_plan" >/dev/null \
        || die "Slice 11A annotations missing width-controls config chip"
    grep -F "Run: winmux resize-zone Work width +10%" "$annotation_plan" >/dev/null \
        || die "Slice 11A annotations missing resize-zone command chip"
    grep -F "Action: Work 1688->2026px; sides 844->675px" "$annotation_plan" >/dev/null \
        || die "Slice 11A annotations missing numeric after-resize chip"
    grep -F "Run: winmux balance-zones" "$annotation_plan" >/dev/null \
        || die "Slice 11A annotations missing balance-zones command chip"
    grep -F "Action: zones return to 1125px each" "$annotation_plan" >/dev/null \
        || die "Slice 11A annotations missing numeric after-balance chip"
    grep -F "Run: winmux list-zones" "$annotation_plan" >/dev/null \
        || die "Slice 11A annotations missing list-zones chip"
    awk -F '\t' '$5 == "Run: winmux resize-zone Work width +10%" { found = 1; ok = (($1 + 0) <= 13 && ($2 + 0) >= 23) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 11A resize command caption must cover the command/action interval"
    awk -F '\t' '$5 == "Run: winmux balance-zones" { found = 1; ok = (($1 + 0) <= 32 && ($2 + 0) >= 39) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 11A balance command caption must cover the command/action interval"
}

