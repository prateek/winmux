    local zones="${LOGS_DIR}/${slice_prefix}-zones.log"
    local timing_log="${LOGS_DIR}/${slice_prefix}-command-timing.log"
    local sample_manifest
    sample_manifest="$(sample_manifest_path)"
    local expected_pass="PASS: desktop drag starts from config float-unless-snap; no-Alt drag converts the tiled source into floating/freeform placement in Comms/right without a snap overlay; resetting to Work/main and holding Alt previews a whole Comms zone target and moves the same window into Comms/right on release."
    local expected_setup_summary="Config: [mouse.zone-snap] policy = 'float-unless-snap', modifier = 'alt', target = 'zone'"
