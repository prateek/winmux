assert_numeric_gt() {
    local left="$1"
    local right="$2"
    local message="$3"
    /usr/bin/awk -v left="$left" -v right="$right" 'BEGIN { exit(left > right ? 0 : 1) }' \
        || die "$message: expected $left > $right"
}

assert_numeric_lt() {
    local left="$1"
    local right="$2"
    local message="$3"
    /usr/bin/awk -v left="$left" -v right="$right" 'BEGIN { exit(left < right ? 0 : 1) }' \
        || die "$message: expected $left < $right"
}

