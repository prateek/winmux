    require_file "${SCREENSHOTS_DIR}/09-after-quit-slice-32.png"
    require_file "${SCREENSHOTS_DIR}/10-after-relaunch-slice-32.png"
    require_file "${SCREENSHOTS_DIR}/99-after-slice-32.png"
    require_file "$(event_manifest_path)"
