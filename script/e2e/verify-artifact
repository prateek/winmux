    [ "$reset_zone" = main ] || die "${slice_label} reset did not return source to Work/main: ${reset_zone:-missing}"
    [ "$reset_layout" != floating ] || die "${slice_label} reset left source floating before ${snap_description} snap"
    [ "$after_zone" = right ] || die "${slice_label} ${snap_description} snap did not end in Comms/right: ${after_zone:-missing}"
    [ -n "$before_workspace" ] && [ -n "$freeform_workspace" ] && [ "$before_workspace" != "$freeform_workspace" ] \
        || die "${slice_label} ${float_description} float did not move to a different active workspace"
    [ -n "$before_workspace" ] && [ -n "$after_workspace" ] && [ "$before_workspace" != "$after_workspace" ] \
        || die "${slice_label} ${snap_description} snap did not move to a different active workspace"

