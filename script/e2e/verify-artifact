#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REQUIRE_REVIEW=0
CHECK_ONLY=0
RUN_DIR=""

usage() {
    cat <<EOF
Usage: $(basename "$0") [--check-only] [--require-review] <artifact-run-dir>

Checks media, guest-control logs, clean-slate logs, and optional review verdict
for a WinMux Tart e2e artifact directory.

--check-only validates existing files without generating samples or reviewer packets.
EOF
}

die() {
    printf '[winmux-verify] error: %s\n' "$*" >&2
    exit 1
}

log() {
    printf '[winmux-verify] %s\n' "$*"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --require-review)
            REQUIRE_REVIEW=1
            shift
            ;;
        --check-only)
            CHECK_ONLY=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            die "Unknown option: $1"
            ;;
        *)
            [ -z "$RUN_DIR" ] || die "Only one artifact run directory is supported"
            RUN_DIR="$1"
            shift
            ;;
    esac
done

[ -n "$RUN_DIR" ] || {
    usage >&2
    die "Missing artifact run directory"
}
[ -d "$RUN_DIR" ] || die "Artifact directory does not exist: $RUN_DIR"

LOGS_DIR="${RUN_DIR}/logs"
SCREENSHOTS_DIR="${RUN_DIR}/screenshots"
RECORDINGS_DIR="${RUN_DIR}/recordings"
CONFIG_PATH="${RUN_DIR}/config/winmux.toml"
PREFLIGHT_LOG="${LOGS_DIR}/preflight.log"

require_file() {
    local path="$1"
    [ -s "$path" ] || die "Missing or empty file: $path"
}

value_from_log() {
    local key="$1"
    local path="$2"
    /usr/bin/awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$path"
}

file_sha256() {
    shasum -a 256 "$1" | awk '{ print $1 }'
}

require_no_ds_store() {
    local found
    found="$(find "$RUN_DIR" -name .DS_Store -print -quit)"
    [ -z "$found" ] || die "Artifact contains Finder metadata: $found"
}

verify_hash_from_preflight() {
    local key="$1"
    local path="$2"
    local expected
    expected="$(value_from_log "$key" "$PREFLIGHT_LOG")"
    [ -n "$expected" ] || return 0
    require_file "$path"
    local actual
    actual="$(file_sha256 "$path")"
    [ "$actual" = "$expected" ] || die "$path hash $actual does not match preflight $key=$expected"
}

is_historical_slice_3_artifact() {
    [ "$(basename "$RUN_DIR")" = "slice-3-20260623T234421Z" ]
}

is_historical_slice_5_artifact() {
    [ "$(basename "$RUN_DIR")" = "slice-5-20260624T013034Z" ]
}

is_historical_slice_8_artifact() {
    [ "$(basename "$RUN_DIR")" = "slice-8-20260624T045815Z" ]
}

manifest_value() {
    local path="$1"
    local kind="$2"
    local key="$3"
    /usr/bin/awk -F'\t' -v kind="$kind" -v key="$key" '$1 == kind && $2 == key { print $3; exit }' "$path"
}

require_manifest_value() {
    local path="$1"
    local kind="$2"
    local key="$3"
    local value
    value="$(manifest_value "$path" "$kind" "$key")"
    [ -n "$value" ] || die "Proof manifest missing ${kind}/${key}: $path"
    printf '%s\n' "$value"
}

require_manifest_drag_screenshot() {
    local manifest_path="$1"
    local manifest_key="$2"
    local filename
    filename="$(require_manifest_value "$manifest_path" drag-screenshots "$manifest_key")"

    [[ "$filename" == *.png ]] || die "Proof manifest drag screenshot ${manifest_key} must name a PNG: $filename"
    [[ "$filename" != */* ]] || die "Proof manifest drag screenshot ${manifest_key} must be a screenshot filename, not a path: $filename"

    local path="${SCREENSHOTS_DIR}/${filename}"
    require_file "$path"

    local byte_count
    byte_count="$(wc -c <"$path" | tr -d ' ')"
    [ "$byte_count" -gt 50000 ] || die "Drag screenshot ${filename} is too small to be a full-frame proof: ${byte_count} bytes"

    local dimensions
    dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$path")" \
        || die "Drag screenshot ${filename} is not readable image media"
    local expected_dimensions="${width:-}x${height:-}"
    if [ "$expected_dimensions" != "x" ]; then
        [ "$dimensions" = "$expected_dimensions" ] \
            || die "Drag screenshot ${filename} dimensions ${dimensions} do not match recording ${expected_dimensions}"
    fi

    printf '%s\n' "$path"
}

ensure_review_packet() {
    local packet_path="${RUN_DIR}/reviews/reviewer-packet.md"
    local packet_log="${LOGS_DIR}/${recording_name}.review-packet.log"
    local absolute_run_dir
    local repo_root
    local relative_run_dir=""
    absolute_run_dir="$(cd "$RUN_DIR" && pwd -P)"
    repo_root="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
    case "$absolute_run_dir" in
        "$repo_root"/*) relative_run_dir="${absolute_run_dir#"$repo_root"/}" ;;
    esac

    if [ ! -s "$packet_path" ]; then
        [ "$CHECK_ONLY" != "1" ] || die "Missing review packet in --check-only mode: $packet_path"
        [ -x "${SCRIPT_DIR}/write-review-packet" ] || die "Missing executable review packet writer: ${SCRIPT_DIR}/write-review-packet"
        "${SCRIPT_DIR}/write-review-packet" "$RUN_DIR" >"$packet_log" 2>&1 || {
            cat "$packet_log" >&2 || true
            die "Review packet generation failed"
        }
    fi

    require_file "$packet_path"
    review_packet_contains_any "$packet_path" \
        "$recording_path" \
        "${absolute_run_dir}/recordings/${recording_name}.mov" \
        "${relative_run_dir}/recordings/${recording_name}.mov" \
        || die "Review packet missing primary recording path"
    review_packet_contains_any "$packet_path" \
        "$contact_sheet" \
        "${absolute_run_dir}/screenshots/${recording_name}.contact-sheet.jpg" \
        "${relative_run_dir}/screenshots/${recording_name}.contact-sheet.jpg" \
        || die "Review packet missing contact sheet path"
    review_packet_contains_any "$packet_path" \
        "${RUN_DIR}/reviews/no-ctx-artifact-review.md" \
        "${absolute_run_dir}/reviews/no-ctx-artifact-review.md" \
        "${relative_run_dir}/reviews/no-ctx-artifact-review.md" \
        || die "Review packet missing review output path"
    if [ -s "${LOGS_DIR}/${recording_name}.proof-manifest.tsv" ]; then
        local drag_screenshot
        while IFS= read -r drag_screenshot; do
            [ -n "$drag_screenshot" ] || continue
            review_packet_contains_any "$packet_path" \
                "${RUN_DIR}/screenshots/${drag_screenshot}" \
                "${absolute_run_dir}/screenshots/${drag_screenshot}" \
                "${relative_run_dir}/screenshots/${drag_screenshot}" \
                || die "Review packet missing manifest drag screenshot path: $drag_screenshot"
        done < <(/usr/bin/awk -F'\t' '$1 == "drag-screenshots" { print $3 }' "${LOGS_DIR}/${recording_name}.proof-manifest.tsv")
    fi
    review_packet_contains_any "$packet_path" \
        "make e2e-verify-slice RUN_DIR=${RUN_DIR} ARGS=--require-review" \
        "make e2e-verify-slice RUN_DIR=${absolute_run_dir} ARGS=--require-review" \
        "make e2e-verify-slice RUN_DIR=${relative_run_dir} ARGS=--require-review" \
        || die "Review packet missing verifier command"
    grep -F 'resources/screenshots/winmux-overview.png' "$packet_path" >/dev/null || die "Review packet missing baseline screenshots"
    grep -F 'Product-Quality Floor' "$packet_path" >/dev/null || die "Review packet missing product-quality floor"
}

review_packet_contains_any() {
    local packet_path="$1"
    shift
    local candidate
    for candidate in "$@"; do
        [ -n "$candidate" ] || continue
        if grep -F "$candidate" "$packet_path" >/dev/null; then
            return 0
        fi
    done
    return 1
}

require_drag_proof_manifest() {
    local manifest_path="$1"
    require_file "$manifest_path"

    local source_title target_zone target_name snap_target not_snap_target source_point target_point hover_seconds
    local pickup_screenshot path_screenshot hover_screenshot coordinate_policy required_frames caption_chip
    source_title="$(require_manifest_value "$manifest_path" drag-source title)"
    target_zone="$(require_manifest_value "$manifest_path" drag-target zone-id)"
    target_name="$(require_manifest_value "$manifest_path" drag-target zone-name)"
    snap_target="$(require_manifest_value "$manifest_path" drag-target snap-target)"
    not_snap_target="$(require_manifest_value "$manifest_path" drag-target not-snap-target)"
    source_point="$(require_manifest_value "$manifest_path" drag-points source)"
    target_point="$(require_manifest_value "$manifest_path" drag-points target)"
    hover_seconds="$(require_manifest_value "$manifest_path" drag-points target-hover-hold-seconds)"
    pickup_screenshot="$(require_manifest_drag_screenshot "$manifest_path" pickup)"
    path_screenshot="$(require_manifest_drag_screenshot "$manifest_path" path)"
    hover_screenshot="$(require_manifest_drag_screenshot "$manifest_path" hover)"
    coordinate_policy="$(require_manifest_value "$manifest_path" drag-points coordinate-policy)"
    required_frames="$(require_manifest_value "$manifest_path" visual-floor required-frames)"
    caption_chip="$(require_manifest_value "$manifest_path" caption chip)"

    [ -n "$source_title" ] || die "Proof manifest source title is empty"
    [ -n "$target_zone" ] || die "Proof manifest target zone is empty"
    [ -n "$target_name" ] || die "Proof manifest target zone name is empty"
    [ "$snap_target" = zone-row ] || die "Proof manifest must state snap-target=zone-row, got: ${snap_target:-missing}"
    [ "$not_snap_target" = window-within-zone ] || die "Proof manifest must state not-snap-target=window-within-zone"
    [[ "$source_point" =~ ^[0-9]+,[0-9]+$ ]] || die "Proof manifest source point is not x,y: $source_point"
    [[ "$target_point" =~ ^[0-9]+,[0-9]+$ ]] || die "Proof manifest target point is not x,y: $target_point"
    assert_numeric_gt "$hover_seconds" "2.5" "Slice 5 hover hold is too short to demonstrate the zone-row affordance"
    local pickup_hash path_hash hover_hash ready_hash
    pickup_hash="$(file_sha256 "$pickup_screenshot")"
    path_hash="$(file_sha256 "$path_screenshot")"
    hover_hash="$(file_sha256 "$hover_screenshot")"
    [ "$pickup_hash" != "$path_hash" ] || die "Drag pickup and path screenshots are identical"
    [ "$path_hash" != "$hover_hash" ] || die "Drag path and hover screenshots are identical"
    [ "$pickup_hash" != "$hover_hash" ] || die "Drag pickup and hover screenshots are identical"
    local ready_screenshot
    ready_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '01-ready-*.png' | head -1)"
    if [ -s "$ready_screenshot" ]; then
        ready_hash="$(file_sha256 "$ready_screenshot")"
        [ "$pickup_hash" != "$ready_hash" ] || die "Drag pickup screenshot duplicates the ready screenshot"
        [ "$path_hash" != "$ready_hash" ] || die "Drag path screenshot duplicates the ready screenshot"
        [ "$hover_hash" != "$ready_hash" ] || die "Drag hover screenshot duplicates the ready screenshot"
    fi
    [[ "$coordinate_policy" == fixed-with-state-and-video-assertions* ]] \
        || die "Proof manifest must justify fixed drag points with state and video assertions"
    [[ "$required_frames" == *source* && "$required_frames" == *proxy* && "$required_frames" == *highlight* && "$required_frames" == *path* ]] \
        || die "Proof manifest visual floor must require source, proxy, highlighted target, and path frames"
    if [ -s "$annotation_plan" ]; then
        grep -F "$caption_chip" "$annotation_plan" >/dev/null || die "Proof manifest caption chip is missing from annotation plan"
    fi
}

require_success_marker() {
    local path="$1"
    local label="$2"
    if is_historical_slice_3_artifact && [ "$(basename "$path")" = "slice-3-stable-identity.done" ]; then
        [ -e "$path" ] || die "Missing historical $label marker: $path"
        log "historical exception: $label marker predates result=success hardening"
        return 0
    fi
    require_file "$path"
    grep -F 'result=success' "$path" >/dev/null || die "$label marker does not contain result=success"
}

clamp_sample_time() {
    local requested="$1"
    local duration="$2"
    awk -v requested="$requested" -v duration="$duration" 'BEGIN {
        if (duration <= 0) {
            printf "0.000"
            exit
        }
        t = requested + 0
        if (t < 0.250) {
            t = 0.250
        }
        max = duration - 0.250
        if (max < 0) {
            max = 0
        }
        if (t > max) {
            t = max
        }
        printf "%.3f", t
    }'
}

sample_recording_frame() {
    local recording="$1"
    local duration="$2"
    local requested="$3"
    local output="$4"
    local seconds
    seconds="$(clamp_sample_time "$requested" "$duration")"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -ss "$seconds" \
        -i "$recording" \
        -frames:v 1 \
        "$output"
    require_file "$output"
}

generate_recording_samples() {
    local recording="$1"
    local name="$2"
    local duration="$3"
    local samples_dir="${SCREENSHOTS_DIR}/${name}.samples"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local contact_sheet="${SCREENSHOTS_DIR}/${name}.contact-sheet.jpg"

    rm -rf "$samples_dir"
    mkdir -p "$samples_dir"

    sample_recording_frame "$recording" "$duration" 0.500 "${samples_dir}/standard-00-start.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.10 }')" "${samples_dir}/standard-01-10pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.25 }')" "${samples_dir}/standard-02-25pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.50 }')" "${samples_dir}/standard-03-50pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.75 }')" "${samples_dir}/standard-04-75pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d - 1.0 }')" "${samples_dir}/standard-05-near-end.png"

    if [ -s "$captions_path" ]; then
        local caption_index=0
        local start_seconds
        local end_seconds
        while IFS=$'\t' read -r start_seconds end_seconds; do
            caption_index=$((caption_index + 1))
            local caption_label
            caption_label="$(printf '%02d' "$caption_index")"
            local sample_seconds
            sample_seconds="$(awk -v start="$start_seconds" -v end="$end_seconds" 'BEGIN {
                midpoint = (start + end) / 2
                offset = start + 0.500
                sample = offset
                if (midpoint > offset) {
                    sample = midpoint
                }
                printf "%.3f", sample
            }')"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$sample_seconds" \
                "${samples_dir}/caption-${caption_label}.png"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start - 0.500 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-before.png"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start + 0.100 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-start.png"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$(awk -v end="$end_seconds" 'BEGIN { printf "%.3f", end - 0.100 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-end.png"
        done < <(awk -F '\t' '$0 != "" && $1 !~ /^#/ { print $1 "\t" $2 }' "$captions_path")
    fi

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -framerate 1 \
        -pattern_type glob \
        -i "${samples_dir}/standard-*.png" \
        -vf "scale=860:-1,tile=3x2" \
        -frames:v 1 \
        "$contact_sheet"
    require_file "$contact_sheet"
}

ensure_recording_samples() {
    local recording="$1"
    local name="$2"
    local duration="$3"
    local samples_dir="${SCREENSHOTS_DIR}/${name}.samples"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local contact_sheet="${SCREENSHOTS_DIR}/${name}.contact-sheet.jpg"
    local standard_count=0
    local caption_count=0
    local boundary_count=0
    local caption_rows=0

    if [ -d "$samples_dir" ]; then
        standard_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'standard-*.png' | wc -l | tr -d ' ')"
        caption_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9].png' | wc -l | tr -d ' ')"
        boundary_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9]-boundary-*.png' | wc -l | tr -d ' ')"
    fi
    if [ -s "$captions_path" ]; then
        caption_rows="$(awk -F '\t' '$0 != "" && $1 !~ /^#/ { count++ } END { print count + 0 }' "$captions_path")"
    fi

    if [ "$standard_count" -lt 6 ] || [ "$caption_count" -lt "$caption_rows" ] || [ "$boundary_count" -lt $((caption_rows * 3)) ] || [ ! -s "$contact_sheet" ]; then
        [ "$CHECK_ONLY" != "1" ] || die "Recording samples/contact sheet are missing or stale in --check-only mode: $samples_dir"
        generate_recording_samples "$recording" "$name" "$duration"
    fi

    standard_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'standard-*.png' | wc -l | tr -d ' ')"
    [ "$standard_count" -ge 6 ] || die "Recording samples missing standard timeline frames"
    if [ -s "$captions_path" ]; then
        caption_rows="$(awk -F '\t' '$0 != "" && $1 !~ /^#/ { count++ } END { print count + 0 }' "$captions_path")"
        caption_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9].png' | wc -l | tr -d ' ')"
        boundary_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9]-boundary-*.png' | wc -l | tr -d ' ')"
        [ "$caption_count" -ge "$caption_rows" ] || die "Recording samples missing caption/action frames"
        [ "$boundary_count" -ge $((caption_rows * 3)) ] || die "Recording samples missing caption boundary frames"
    fi
    require_file "$contact_sheet"
}

field_for_title() {
    local path="$1"
    local title="$2"
    local field="$3"
    /usr/bin/awk -F'|' -v title="$title" -v field="$field" '$2 == title {
        if (field == "id") {
            print $1
            exit
        }
        prefix = field "="
        for (i = 1; i <= NF; i++) {
            if (index($i, prefix) == 1) {
                print substr($i, length(prefix) + 1)
                exit
            }
        }
    }' "$path"
}

field_for_id() {
    local path="$1"
    local id="$2"
    local field="$3"
    /usr/bin/awk -F'|' -v id="$id" -v field="$field" '$1 == id {
        if (field == "title") {
            print $2
            exit
        }
        prefix = field "="
        for (i = 1; i <= NF; i++) {
            if (index($i, prefix) == 1) {
                print substr($i, length(prefix) + 1)
                exit
            }
        }
    }' "$path"
}

monitor_field_for_zone() {
    local path="$1"
    local zone="$2"
    local field="$3"
    /usr/bin/awk -F'|' -v zone="zone=${zone}" -v field="$field" '$1 == zone {
        prefix = field "="
        for (i = 1; i <= NF; i++) {
            if (index($i, prefix) == 1) {
                print substr($i, length(prefix) + 1)
                exit
            }
        }
    }' "$path"
}

require_slice_3_stable_identity_proof() {
    local proof="${RUN_DIR}/slice-3-stable-identity-proof.txt"
    local done="${LOGS_DIR}/slice-3-stable-identity.done"
    local monitors_before="${LOGS_DIR}/slice-3-monitors-before.log"
    local monitors_after="${LOGS_DIR}/slice-3-monitors-after.log"
    local windows_before="${LOGS_DIR}/slice-3-windows-before.log"
    local windows_after="${LOGS_DIR}/slice-3-windows-after.log"
    local workspaces_before="${LOGS_DIR}/slice-3-workspaces-before.log"
    local workspaces_after="${LOGS_DIR}/slice-3-workspaces-after.log"

    require_file "$proof"
    require_success_marker "$done" "Slice 3"
    require_file "$monitors_before"
    require_file "$monitors_after"
    require_file "$windows_before"
    require_file "$windows_after"
    require_file "$workspaces_before"
    require_file "$workspaces_after"
    grep -F 'PASS: config reload changed zone geometry while labeled windows stayed bound to left/main/right zone ids.' "$proof" >/dev/null \
        || die "Slice 3 proof does not contain the expected PASS claim"

    for zone in left main right; do
        grep -F "zone=${zone}|" "$monitors_before" >/dev/null || die "Slice 3 before monitors missing zone=$zone"
        grep -F "zone=${zone}|" "$monitors_after" >/dev/null || die "Slice 3 after monitors missing zone=$zone"
        grep -F "zone=${zone}|" "$workspaces_before" >/dev/null || die "Slice 3 before workspaces missing zone=$zone"
        grep -F "zone=${zone}|" "$workspaces_after" >/dev/null || die "Slice 3 after workspaces missing zone=$zone"
    done

    local changed=0
    for zone in left main right; do
        for field in left width; do
            before="$(monitor_field_for_zone "$monitors_before" "$zone" "$field")"
            after="$(monitor_field_for_zone "$monitors_after" "$zone" "$field")"
            [ -n "$before" ] && [ -n "$after" ] || die "Slice 3 missing monitor $field for zone=$zone"
            if [ "$before" != "$after" ]; then
                changed=1
            fi
        done
    done
    [ "$changed" = "1" ] || die "Slice 3 monitor geometry did not change after reload"

    for title in left-reference.rtf main-work.rtf right-comms.rtf; do
        before_id="$(field_for_title "$windows_before" "$title" id)"
        after_id="$(field_for_title "$windows_after" "$title" id)"
        before_zone="$(field_for_title "$windows_before" "$title" zone)"
        after_zone="$(field_for_title "$windows_after" "$title" zone)"
        before_workspace="$(field_for_title "$windows_before" "$title" workspace)"
        after_workspace="$(field_for_title "$windows_after" "$title" workspace)"
        [ -n "$before_id" ] && [ -n "$after_id" ] || die "Slice 3 missing window title before/after: $title"
        [ "$before_id" = "$after_id" ] || die "Slice 3 window id changed for $title: $before_id -> $after_id"
        [ "$before_zone" = "$after_zone" ] || die "Slice 3 zone changed for $title: $before_zone -> $after_zone"
        [ "$before_workspace" = "$after_workspace" ] || die "Slice 3 workspace changed for $title: $before_workspace -> $after_workspace"
    done
}

require_slice_4_zone_commands_proof() {
    local proof="${RUN_DIR}/slice-4-zone-commands-proof.txt"
    local done="${LOGS_DIR}/slice-4-zone-commands.done"
    local zones="${LOGS_DIR}/slice-4-zones.log"
    local focus_zone="${LOGS_DIR}/slice-4-focus-zone.log"
    local move_zone="${LOGS_DIR}/slice-4-move-node-to-zone.log"
    local focus_monitor="${LOGS_DIR}/slice-4-focus-monitor-compat.log"
    local windows_before="${LOGS_DIR}/slice-4-windows-before.log"
    local windows_after="${LOGS_DIR}/slice-4-windows-after.log"
    local ready_screenshot="${SCREENSHOTS_DIR}/01-ready-slice-4.png"

    require_file "$proof"
    require_success_marker "$done" "Slice 4"
    require_file "$zones"
    require_file "$focus_zone"
    require_file "$move_zone"
    require_file "$focus_monitor"
    require_file "$windows_before"
    require_file "$windows_after"
    require_file "$ready_screenshot"

    grep -F 'PASS: focus-zone, move-node-to-zone, list-zones, and focus-monitor physical compatibility are visible and logged.' "$proof" >/dev/null \
        || die "Slice 4 proof does not contain the expected PASS claim"

    grep -F 'zone=left|name=Reference|' "$zones" >/dev/null || die "Slice 4 zones log missing Reference/left"
