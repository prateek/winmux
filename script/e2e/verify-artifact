    local after_resize_screenshot="${SCREENSHOTS_DIR}/03-after-resize-slice-11a.png"
    local before_balance_screenshot="${SCREENSHOTS_DIR}/04-before-balance-slice-11a.png"
    local after_balance_screenshot="${SCREENSHOTS_DIR}/05-after-balance-slice-11a.png"

    require_file "$proof"
    require_success_marker "$done" "Slice 11A"
    require_file "$setup_log"
    require_file "$windows_before"
    require_file "$windows_resized"
    require_file "$windows_balanced"
    require_file "$zones_before"
    require_file "$zones_resized"
    require_file "$zones_balanced"
    require_file "$resize_log"
    require_file "$balance_log"
    require_file "$timing_log"
    require_file "$geometry_board_log"
