    touch "${metadata_dir}/.DS_Store"
    if ( require_no_finder_metadata ) >/dev/null 2>&1; then
        die "Finder metadata self-test expected .DS_Store rejection"
    fi
    rm -f "${metadata_dir}/.DS_Store"
    printf 'artifact\n' >"${metadata_dir}/artifact.txt"
    if command -v xattr >/dev/null 2>&1 \
        && xattr -w com.winmux.test value "${metadata_dir}/artifact.txt" 2>/dev/null; then
        if ( require_no_finder_metadata ) >/dev/null 2>&1; then
            die "Finder metadata self-test expected xattr rejection"
        fi
        xattr -c "${metadata_dir}/artifact.txt" 2>/dev/null || true
    fi
    require_no_finder_metadata
    RUN_DIR="$old_run_dir"
    annotation_plan="$old_annotation_plan"
    recording_path="$old_recording_path"
    log "self-test PASS"
}

