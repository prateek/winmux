    require_slice_15_sample_manifest "$(sample_manifest_path)"

    grep -F 'PASS: bind-node-to-zone moved the focused Work tab group into Comms/right and list-zone-bindings recorded the same tab-group node id.' "$proof" >/dev/null \
        || die "Slice 15 proof does not contain the expected PASS claim"
    grep -F '[window-tabs]' "$CONFIG_PATH" >/dev/null \
        || die "Slice 15 config missing window-tabs table"
    grep -F "alt-b = 'bind-node-to-zone Comms'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 15 config missing bind-node-to-zone key binding"
    if grep -F '[[zone-bindings]]' "$CONFIG_PATH" >/dev/null; then
        die "Slice 15 config must not use workspace [[zone-bindings]]; this slice proves runtime node bindings"
    fi

    grep -F "Config: [mode.main.binding] alt-b = 'bind-node-to-zone Comms'" "$setup_log" >/dev/null \
        || die "Slice 15 setup log missing node binding config summary"
    grep -F 'Command: bind-node-to-zone Comms' "$setup_log" >/dev/null \
        || die "Slice 15 setup log missing bind command summary"
    grep -F 'ready-state=work-tab-group-visible-with-zero-bindings' "$setup_log" >/dev/null \
        || die "Slice 15 setup log does not prove the tab group was staged with zero bindings"
    grep -F 'stack-with' "$stack_log" >/dev/null \
        || die "Slice 15 stack log missing stack-with command"
    grep -F 'node-bindings=none' "$before_bindings" >/dev/null \
        || die "Slice 15 before bindings log must explicitly show zero node bindings"
    grep -F '$ winmux bind-node-to-zone Comms' "$bind_log" >/dev/null \
        || die "Slice 15 bind log missing exact command"

    local reference_id alpha_id beta_id tab_group_key tab_group_window_ids
    reference_id="$(value_from_log REFERENCE_ID "$state_file")"
    alpha_id="$(value_from_log WORK_ALPHA_ID "$state_file")"
    beta_id="$(value_from_log WORK_BETA_ID "$state_file")"
    tab_group_key="$(value_from_log TAB_GROUP_KEY "$state_file")"
    [ -n "$reference_id" ] || die "Slice 15 state file missing REFERENCE_ID"
    [ -n "$alpha_id" ] || die "Slice 15 state file missing WORK_ALPHA_ID"
    [ -n "$beta_id" ] || die "Slice 15 state file missing WORK_BETA_ID"
    [ -n "$tab_group_key" ] || die "Slice 15 state file missing TAB_GROUP_KEY"
    tab_group_window_ids="${tab_group_key#tab-group:}"
    [ "$tab_group_window_ids" != "$tab_group_key" ] \
        || die "Slice 15 binding key must identify a tab group, got ${tab_group_key}"

    grep -F "tab-group-key=${tab_group_key}" "$setup_log" >/dev/null \
        || die "Slice 15 setup log does not name the tab-group key"
    grep -F "node-id=${tab_group_key}|" "$after_bindings" >/dev/null \
        || die "Slice 15 list-zone-bindings missing ${tab_group_key}"

    local bind_offset
    bind_offset="$(value_from_log bind-command-offset-seconds "$timing_log")"
    [ -n "$bind_offset" ] || die "Slice 15 timing log missing bind command offset"
    assert_numeric_between_inclusive "$bind_offset" 18 30 \
        "Slice 15 bind command must happen while the bind-node-to-zone command caption is on screen"
    grep -F "bind-command-offset-seconds=${bind_offset}" "$proof" >/dev/null \
        || die "Slice 15 proof does not copy bind command timing"

    [ "$(binding_log_value "$after_bindings" node-id)" = "$tab_group_key" ] \
        || die "Slice 15 binding row has the wrong node id"
    [ "$(binding_log_value "$after_bindings" node-type)" = "tab-group" ] \
        || die "Slice 15 binding row must be node-type=tab-group"
    [ "$(binding_log_value "$after_bindings" window-ids)" = "$tab_group_window_ids" ] \
        || die "Slice 15 binding row has wrong window ids"
    [ "$(binding_log_value "$after_bindings" zone)" = "right" ] \
        || die "Slice 15 binding row must target zone=right"
    [ "$(binding_log_value "$after_bindings" zone-name)" = "Comms" ] \
        || die "Slice 15 binding row must expose zone-name=Comms"
    [ "$(binding_log_value "$after_bindings" monitor)" = "1" ] \
        || die "Slice 15 binding row must expose physical monitor 1"
    grep -F 'work-alpha-node-binding.rtf' "$after_bindings" >/dev/null \
        || die "Slice 15 binding title missing Work Alpha document"
    grep -F 'work-beta-node-binding.rtf' "$after_bindings" >/dev/null \
        || die "Slice 15 binding title missing Work Beta document"

    local right_workspace_after
    right_workspace_after="$(zone_log_value "$after_zones" right workspace)"
    [ -n "$right_workspace_after" ] || die "Slice 15 after zones log missing right workspace"
    [ "$(binding_log_value "$after_bindings" workspace)" = "$right_workspace_after" ] \
        || die "Slice 15 binding workspace does not match the active Comms/right workspace"

    local zone field before_value after_value
    for zone in left main right; do
        for field in name left width physical; do
            before_value="$(zone_log_value "$before_zones" "$zone" "$field")"
            after_value="$(zone_log_value "$after_zones" "$zone" "$field")"
            [ -n "$before_value" ] && [ -n "$after_value" ] \
                || die "Slice 15 missing ${field} for zone ${zone}"
            [ "$before_value" = "$after_value" ] \
                || die "Slice 15 changed ${field} for zone ${zone}: ${before_value} -> ${after_value}"
        done
    done

    local before_count after_count parent
    before_count="$(grep -c '^' "$before_windows" || true)"
    after_count="$(grep -c '^' "$after_windows" || true)"
    [ "$before_count" = 3 ] \
        || die "Slice 15 before visible TextEdit window count must be exactly 3, got ${before_count}"
    [ "$after_count" = 3 ] \
        || die "Slice 15 after visible TextEdit window count must be exactly 3, got ${after_count}"

    [ "$(field_for_title "$before_windows" 'reference-node-binding.rtf' id)" = "$reference_id" ] \
        || die "Slice 15 reference window id changed before binding"
    [ "$(field_for_title "$before_windows" 'work-alpha-node-binding.rtf' id)" = "$alpha_id" ] \
        || die "Slice 15 Work Alpha id missing before binding"
    [ "$(field_for_title "$before_windows" 'work-beta-node-binding.rtf' id)" = "$beta_id" ] \
        || die "Slice 15 Work Beta id missing before binding"
    [ "$(field_for_title "$before_windows" 'reference-node-binding.rtf' zone)" = left ] \
        || die "Slice 15 reference document is not visible in left before binding"
    [ "$(field_for_title "$before_windows" 'work-alpha-node-binding.rtf' zone)" = main ] \
        || die "Slice 15 Work Alpha is not visible in Work/main before binding"
    [ "$(field_for_title "$before_windows" 'work-beta-node-binding.rtf' zone)" = main ] \
        || die "Slice 15 Work Beta is not visible in Work/main before binding"
    for title in work-alpha-node-binding.rtf work-beta-node-binding.rtf; do
        parent="$(field_for_title "$before_windows" "$title" parent)"
        case "$parent" in
            *tab_group*) ;;
            *) die "Slice 15 ${title} must be in a tab group before binding, got parent=${parent:-missing}" ;;
        esac
    done

    [ "$(field_for_title "$after_windows" 'reference-node-binding.rtf' id)" = "$reference_id" ] \
        || die "Slice 15 reference window id changed after binding"
    [ "$(field_for_title "$after_windows" 'work-alpha-node-binding.rtf' id)" = "$alpha_id" ] \
        || die "Slice 15 Work Alpha id missing after binding"
    [ "$(field_for_title "$after_windows" 'work-beta-node-binding.rtf' id)" = "$beta_id" ] \
        || die "Slice 15 Work Beta id missing after binding"
    [ "$(field_for_title "$after_windows" 'reference-node-binding.rtf' zone)" = left ] \
        || die "Slice 15 reference document should remain in left after binding"
    [ "$(field_for_title "$after_windows" 'work-alpha-node-binding.rtf' zone)" = right ] \
        || die "Slice 15 Work Alpha is not visible in Comms/right after binding"
    [ "$(field_for_title "$after_windows" 'work-beta-node-binding.rtf' zone)" = right ] \
        || die "Slice 15 Work Beta is not visible in Comms/right after binding"
    for title in work-alpha-node-binding.rtf work-beta-node-binding.rtf; do
        parent="$(field_for_title "$after_windows" "$title" parent)"
        case "$parent" in
            *tab_group*) ;;
            *) die "Slice 15 ${title} must remain in a tab group after binding, got parent=${parent:-missing}" ;;
        esac
    done

    grep -F "Config: alt-b = 'bind-node-to-zone Comms'" "$annotation_plan" >/dev/null \
        || die "Slice 15 annotations missing bind-node-to-zone config chip"
    grep -F "Run: winmux list-zone-bindings --count" "$annotation_plan" >/dev/null \
        || die "Slice 15 annotations missing before binding count chip"
    grep -F "Run: winmux bind-node-to-zone Comms" "$annotation_plan" >/dev/null \
        || die "Slice 15 annotations missing bind-node-to-zone command chip"
    grep -F "Action: tab-group node is in Comms/right" "$annotation_plan" >/dev/null \
        || die "Slice 15 annotations missing after-state action chip"
    grep -F "Run: winmux list-zone-bindings" "$annotation_plan" >/dev/null \
        || die "Slice 15 annotations missing final list-zone-bindings chip"
    awk -F '\t' '$5 == "Run: winmux bind-node-to-zone Comms" { found = 1; ok = (($1 + 0) <= 18 && ($2 + 0) >= 30) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 15 bind command caption must cover the command/action interval"
    awk -F '\t' '$5 == "Action: tab-group node is in Comms/right" { found = 1; ok = (($1 + 0) <= 30 && ($2 + 0) >= 44) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 15 after-state caption must be long enough to inspect the moved tab group"
}

