measurement_value() {
    local path="$1"
    local phase="$2"
    local zone="$3"
    local field="$4"
    /usr/bin/awk -F'\t' -v phase="$phase" -v zone="$zone" -v field="$field" '
        BEGIN {
            column["configured"] = 4
            column["effective"] = 5
            column["pixel-width"] = 6
            column["chip"] = 7
        }
        $1 == phase && $2 == zone && column[field] {
            print $column[field]
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$path"
}

