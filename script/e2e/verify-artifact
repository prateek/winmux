#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
MOUSE_DRAG_EVENT_SPEC="${SCRIPT_DIR}/specs/mouse-drag-events.tsv"
REQUIRE_REVIEW=0
CHECK_ONLY=0
CHECK_SIBLING_ARTIFACTS=0
SELF_TEST=0
RUN_DIR=""

usage() {
    cat <<EOF
Usage: $(basename "$0") [--check-only] [--require-review] [--check-sibling-artifacts] <artifact-run-dir>
       $(basename "$0") --self-test

Checks media, guest-control logs, clean-slate logs, and optional review verdict
for a WinMux Tart e2e artifact directory.

--check-only validates existing files without generating samples or reviewer packets.
--check-sibling-artifacts rejects same-slice media artifacts that are neither accepted nor superseded.
--self-test runs verifier helper tests without requiring a Tart artifact.
EOF
}

die() {
    printf '[winmux-verify] error: %s\n' "$*" >&2
    exit 1
}

log() {
    printf '[winmux-verify] %s\n' "$*"
}

SELF_TEST_TMP_DIR=""

cleanup_self_test_tmp_dir() {
    [ -z "${SELF_TEST_TMP_DIR:-}" ] || rm -rf "$SELF_TEST_TMP_DIR"
}

zone_log_value() {
    local path="$1"
    local zone="$2"
    local key="$3"
    /usr/bin/awk -F'|' -v zone="$zone" -v key="$key" '
        $1 == "zone=" zone {
            for (i = 1; i <= NF; i++) {
                if (index($i, key "=") == 1) {
                    print substr($i, length(key) + 2)
                    exit
                }
            }
        }
    ' "$path"
}

binding_log_value() {
    local path="$1"
    local key="$2"
    /usr/bin/awk -F'|' -v key="$key" '
        /^node-id=/ {
            for (i = 1; i <= NF; i++) {
                if (index($i, key "=") == 1) {
                    print substr($i, length(key) + 2)
                    exit
                }
            }
        }
    ' "$path"
}

require_zone_fields_unchanged_across_style_phases() {
    local before_log="$1"
    local urgent_log="$2"
    local calm_log="$3"
    local slice_label="$4"
    local zone_id field fields before_value urgent_value calm_value

    fields="name enabled workspace left width physical"
    if [ -n "$(zone_log_value "$before_log" left layout)" ]; then
        fields="${fields} layout"
    fi

    for zone_id in left main right; do
        for field in $fields; do
            before_value="$(zone_log_value "$before_log" "$zone_id" "$field")"
            urgent_value="$(zone_log_value "$urgent_log" "$zone_id" "$field")"
            calm_value="$(zone_log_value "$calm_log" "$zone_id" "$field")"
            [ -n "$before_value" ] \
                || die "${slice_label} before zones log missing ${field} for ${zone_id}"
            [ "$before_value" = "$urgent_value" ] && [ "$urgent_value" = "$calm_value" ] \
                || die "${slice_label} ${field} changed for ${zone_id}: ${before_value} -> ${urgent_value:-missing} -> ${calm_value:-missing}"
        done
    done
}

visible_board_value() {
    local path="$1"
    local zone="$2"
    local phase="$3"
    local key="$4"
    /usr/bin/awk -F'|' -v zone="$zone" -v phase="$phase" -v key="$key" '
        function value_from_tokens(text,    n, parts, i, pair) {
            n = split(text, parts, " ")
            for (i = 1; i <= n; i++) {
                split(parts[i], pair, "=")
                if (pair[1] == key) {
                    print pair[2]
                    exit
                }
            }
        }
        $1 == "zone-id=" zone {
            if (phase == "base") {
                for (i = 1; i <= NF; i++) {
                    if (index($i, key "=") == 1) {
                        print substr($i, length(key) + 2)
                        exit
                    }
                }
                exit
            }
            for (i = 1; i <= NF; i++) {
                if (index($i, phase " ") == 1) {
                    value_from_tokens(substr($i, length(phase) + 2))
                }
            }
        }
    ' "$path"
}

normalize_visible_board_runtime_width() {
    local value="$1"
    case "$value" in
        "") printf 'none\n' ;;
        *) printf '%s\n' "$value" ;;
    esac
}

strip_px_suffix() {
    local value="$1"
    printf '%s\n' "${value%px}"
}

assert_string_eq() {
    local actual="$1"
    local expected="$2"
    local message="$3"
    [ "$actual" = "$expected" ] || die "$message: expected ${expected}, got ${actual:-missing}"
}

require_visible_board_matches_zone_log() {
    local board_path="$1"
    local zone="$2"
    local phase="$3"
    local zones_log="$4"
    local phase_label="$5"
    local tolerance="${6:-0.001}"

    local enabled workspace board_workspace
    enabled="$(zone_log_value "$zones_log" "$zone" enabled)"
    workspace="$(zone_log_value "$zones_log" "$zone" workspace)"
    board_workspace="$(visible_board_value "$board_path" "$zone" base active-workspace)"

    assert_string_eq "$(visible_board_value "$board_path" "$zone" base enabled)" "$enabled" \
        "Slice 11A visible board enabled state mismatch for ${zone}/${phase_label}"
    assert_string_eq "$board_workspace" "$workspace" \
        "Slice 11A visible board workspace mismatch for ${zone}/${phase_label}"

    local board_configured board_effective board_runtime board_override_state board_left board_width
    local log_configured log_effective log_runtime log_override_state log_left log_width
    board_configured="$(visible_board_value "$board_path" "$zone" "$phase" configured-width)"
    board_effective="$(visible_board_value "$board_path" "$zone" "$phase" effective-width)"
    board_runtime="$(visible_board_value "$board_path" "$zone" "$phase" runtime-width)"
    board_override_state="$(visible_board_value "$board_path" "$zone" "$phase" override-state)"
    board_left="$(strip_px_suffix "$(visible_board_value "$board_path" "$zone" "$phase" left-edge)")"
    board_width="$(strip_px_suffix "$(visible_board_value "$board_path" "$zone" "$phase" pixel-width)")"

    log_configured="$(zone_log_value "$zones_log" "$zone" configured)"
    log_effective="$(zone_log_value "$zones_log" "$zone" effective)"
    log_runtime="$(normalize_visible_board_runtime_width "$(zone_log_value "$zones_log" "$zone" override)")"
    log_override_state="$(zone_log_value "$zones_log" "$zone" override-state)"
    log_left="$(zone_log_value "$zones_log" "$zone" left)"
    log_width="$(zone_log_value "$zones_log" "$zone" width)"

    [ -n "$board_configured" ] || die "Slice 11A visible board missing configured width for ${zone}/${phase_label}"
    [ -n "$board_effective" ] || die "Slice 11A visible board missing effective width for ${zone}/${phase_label}"
    [ -n "$board_runtime" ] || die "Slice 11A visible board missing runtime width for ${zone}/${phase_label}"
    [ -n "$board_override_state" ] || die "Slice 11A visible board missing override state for ${zone}/${phase_label}"
    [ -n "$board_left" ] || die "Slice 11A visible board missing left edge for ${zone}/${phase_label}"
    [ -n "$board_width" ] || die "Slice 11A visible board missing pixel width for ${zone}/${phase_label}"

    assert_numeric_approximately_equal "$board_configured" "$log_configured" "$tolerance" \
        "Slice 11A visible board configured width mismatch for ${zone}/${phase_label}"
    assert_numeric_approximately_equal "$board_effective" "$log_effective" "$tolerance" \
        "Slice 11A visible board effective width mismatch for ${zone}/${phase_label}"
    if [ "$log_runtime" = "none" ]; then
        assert_string_eq "$board_runtime" "none" \
            "Slice 11A visible board runtime width mismatch for ${zone}/${phase_label}"
    else
        assert_numeric_approximately_equal "$board_runtime" "$log_runtime" "$tolerance" \
            "Slice 11A visible board runtime width mismatch for ${zone}/${phase_label}"
    fi
    assert_string_eq "$board_override_state" "$log_override_state" \
        "Slice 11A visible board override state mismatch for ${zone}/${phase_label}"
    assert_numeric_approximately_equal "$board_left" "$log_left" 0.2 \
        "Slice 11A visible board left edge mismatch for ${zone}/${phase_label}"
    assert_numeric_approximately_equal "$board_width" "$log_width" 0.2 \
        "Slice 11A visible board pixel width mismatch for ${zone}/${phase_label}"
}

require_zone_geometry_contiguous() {
    local path="$1"
    local label="$2"
    local min_width="${3:-1}"
    local expected_total="${4:-}"
    [ -s "$path" ] || die "Missing or empty file: $path"
    /usr/bin/awk -F'|' -v label="$label" -v min_width="$min_width" -v expected_total="$expected_total" '
        function field(key,    i) {
            for (i = 1; i <= NF; i++) {
                if (index($i, key "=") == 1) {
                    return substr($i, length(key) + 2)
                }
            }
            return ""
        }
        function fail(msg) {
            printf("%s: %s\n", label, msg) > "/dev/stderr"
            exit 1
        }
        /^zone=/ {
            enabled = field("enabled")
            if (enabled == "false") {
                next
            }
            left_raw = field("left")
            width_raw = field("width")
            if (left_raw == "" || width_raw == "") {
                fail("enabled zone is missing left or width: " $0)
            }
            left = left_raw + 0
            width = width_raw + 0
            if (width < min_width) {
                fail("zone width is below minimum: " $0)
            }
            if (count > 0 && left + 0.001 < right || count > 0 && left - 0.001 > right) {
                fail("zone left edge is not contiguous: expected " right " got " left " row=" $0)
            }
            if (count == 0) {
                start = left
            }
            right = left + width
            count += 1
        }
        END {
            if (count == 0) {
                fail("no enabled geometry rows found")
            }
            if (expected_total != "") {
                total = right - start
                if (total + 0.001 < expected_total || total - 0.001 > expected_total) {
                    fail("total width mismatch: expected " expected_total " got " total)
                }
            }
        }
    ' "$path"
}

require_existing_file_for_color_sentinel() {
    local path="$1"
    [ -s "$path" ] || die "Missing or empty file: $path"
}

hex_rgb_triplet() {
    local hex="${1#\#}"
    [[ "$hex" =~ ^[0-9A-Fa-f]{6}$ ]] || die "Color sentinel expected a #RRGGBB color, got: $1"
    printf '%d %d %d\n' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

require_color_region_matches() {
    local image_path="$1"
    local x="$2"
    local y="$3"
    local width="$4"
    local height="$5"
    local expected_hex="$6"
    local min_percent="$7"
    local max_channel_distance="$8"
    local label="$9"

    require_existing_file_for_color_sentinel "$image_path"
    command -v magick >/dev/null 2>&1 || die "Color sentinel requires ImageMagick: magick"
    [[ "$x" =~ ^[0-9]+$ ]] || die "Color sentinel ${label} has invalid x coordinate: $x"
    [[ "$y" =~ ^[0-9]+$ ]] || die "Color sentinel ${label} has invalid y coordinate: $y"
    [[ "$width" =~ ^[1-9][0-9]*$ ]] || die "Color sentinel ${label} has invalid width: $width"
    [[ "$height" =~ ^[1-9][0-9]*$ ]] || die "Color sentinel ${label} has invalid height: $height"
    [[ "$min_percent" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Color sentinel ${label} has invalid min percent: $min_percent"
    [[ "$max_channel_distance" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Color sentinel ${label} has invalid max distance: $max_channel_distance"

    local expected_r expected_g expected_b
    read -r expected_r expected_g expected_b < <(hex_rgb_triplet "$expected_hex")

    magick "$image_path" -crop "${width}x${height}+${x}+${y}" -depth 8 txt:- | \
        /usr/bin/awk \
            -v label="$label" \
            -v image="$image_path" \
            -v expected_hex="$expected_hex" \
            -v expected_r="$expected_r" \
            -v expected_g="$expected_g" \
            -v expected_b="$expected_b" \
            -v min_percent="$min_percent" \
            -v max_distance="$max_channel_distance" '
                /^[0-9]+,[0-9]+:/ {
                    pixel = $0
                    sub(/^.*\(/, "", pixel)
                    sub(/\).*$/, "", pixel)
                    n = split(pixel, channels, ",")
                    if (n < 3) {
                        next
                    }
                    r = channels[1] + 0
                    g = channels[2] + 0
                    b = channels[3] + 0
                    dr = r - expected_r
                    dg = g - expected_g
                    db = b - expected_b
                    if (dr < 0) { dr = -dr }
                    if (dg < 0) { dg = -dg }
                    if (db < 0) { db = -db }
                    distance = dr + dg + db
                    total += 1
                    if (distance <= max_distance) {
                        matching += 1
                    }
                }
                END {
                    if (total == 0) {
                        printf("%s: no pixels sampled from %s\n", label, image) > "/dev/stderr"
                        exit 1
                    }
                    percent = (matching * 100.0) / total
                    if (percent + 0.0001 < min_percent) {
                        printf("%s: expected %s in %s; only %.2f%% of %d sampled pixels matched within distance %.2f\n", label, expected_hex, image, percent, total, max_distance) > "/dev/stderr"
                        exit 1
                    }
                }
            ' || die "Color sentinel failed for ${label}"
}

require_color_sentinel_manifest() {
    local manifest_path="$1"
    local run_root="${2:-${RUN_DIR:-}}"
    local manifest_label="${3:-color sentinel}"
    local row_count=0

    require_existing_file_for_color_sentinel "$manifest_path"
    [ -n "$run_root" ] || die "Color sentinel manifest requires a run root: $manifest_path"

    local kind label relative_path x y crop_width crop_height expected_hex min_percent max_distance _note
    while IFS=$'\t' read -r kind label relative_path x y crop_width crop_height expected_hex min_percent max_distance _note || [ -n "${kind:-}" ]; do
        case "${kind:-}" in
            ""|\#*) continue ;;
        esac
        [ "$kind" = "swatch" ] || die "${manifest_label} manifest row kind must be swatch, got: $kind"
        [ -n "${label:-}" ] || die "${manifest_label} manifest row is missing a label"
        [ -n "${relative_path:-}" ] || die "${manifest_label} ${label} row is missing a screenshot path"
        case "$relative_path" in
            /*|*../*) die "${manifest_label} screenshot path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_color_region_matches \
            "${run_root}/${relative_path}" \
            "$x" "$y" "$crop_width" "$crop_height" \
            "$expected_hex" "$min_percent" "$max_distance" \
            "${manifest_label} ${label}"
        row_count=$((row_count + 1))
    done <"$manifest_path"

    [ "$row_count" -gt 0 ] || die "${manifest_label} manifest has no swatch rows: $manifest_path"
}

run_self_test() {
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    SELF_TEST_TMP_DIR="$tmp_dir"
    trap cleanup_self_test_tmp_dir EXIT

    local good_log="${tmp_dir}/zones-good.log"
    cat >"$good_log" <<'EOF'
zone=left|enabled=true|left=0|width=240|workspace=reference
zone=main|enabled=true|left=240|width=720|workspace=work
zone=right|enabled=false|left=|width=|workspace=
EOF
    require_zone_geometry_contiguous "$good_log" "self-test good geometry" 100 960
    [ "$(zone_log_value "$good_log" main width)" = "720" ] \
        || die "zone_log_value self-test failed"

    local bad_log="${tmp_dir}/zones-bad.log"
    cat >"$bad_log" <<'EOF'
zone=left|enabled=true|left=0|width=240
zone=main|enabled=true|left=300|width=720
EOF
    if require_zone_geometry_contiguous "$bad_log" "self-test bad geometry" 100 960 >/dev/null 2>&1; then
        die "Geometry self-test expected a gap failure"
    fi

    local sentinel_image="${tmp_dir}/sentinel.png"
    local sentinel_manifest="${tmp_dir}/sentinel.color-sentinel.tsv"
    local bad_sentinel_manifest="${tmp_dir}/sentinel-bad.color-sentinel.tsv"
    magick -size 20x20 xc:'#101820' -fill '#D3455B' -draw 'rectangle 4,5 13,14' "$sentinel_image"
    cat >"$sentinel_manifest" <<'EOF'
swatch	urgent	sentinel.png	4	5	10	10	#D3455B	90	8	Self-test red swatch
EOF
    require_color_sentinel_manifest "$sentinel_manifest" "$tmp_dir" "self-test color sentinel"
    cat >"$bad_sentinel_manifest" <<'EOF'
swatch	not-blue	sentinel.png	4	5	10	10	#3EA2FF	90	8	Self-test wrong color
EOF
    if ( require_color_sentinel_manifest "$bad_sentinel_manifest" "$tmp_dir" "self-test bad color sentinel" ) >/dev/null 2>&1; then
        die "Color sentinel self-test expected a wrong-color failure"
    fi

    local old_run_dir="${RUN_DIR:-}"
    local old_annotation_plan="${annotation_plan:-}"
    local old_recording_path="${recording_path:-}"
    RUN_DIR="$tmp_dir"
    annotation_plan="${tmp_dir}/annotations.tsv"
    recording_path="${tmp_dir}/recording.mov"
    printf 'annotations\n' >"$annotation_plan"
    printf 'recording\n' >"$recording_path"
    printf 'event media\n' >"${tmp_dir}/event.png"
    local event_manifest="${tmp_dir}/events.tsv"
    cat >"$event_manifest" <<'EOF'
# event-id	kind	seconds	caption-label	sample-label	path	expected
set-command-start	command	10.100	caption-02	set-policy-command-start	event.png	command caption visible
snap-first-affordance	overlay	12.200	caption-04	snap-hover-comms	event.png	overlay visible
EOF
    require_event_manifest_paths "$event_manifest"
    require_event_manifest_event "$event_manifest" set-command-start command
    require_event_manifest_event "$event_manifest" snap-first-affordance overlay
    require_event_sample_label "$event_manifest" set-command-start set-policy-command-start
    require_event_before "$event_manifest" set-command-start snap-first-affordance \
        "Event manifest self-test expected command before overlay"

    local legacy_review="${tmp_dir}/legacy-pass-review.md"
    local modern_review="${tmp_dir}/modern-pass-review.md"
    local missing_allow_review="${tmp_dir}/missing-allow-review.md"
    local fail_review="${tmp_dir}/fail-review.md"
    printf 'Reviewed legacy artifact.\nPASS\n' >"$legacy_review"
    printf 'PASS: artifact review accepted\n\nnext slice allowed: yes\n' >"$modern_review"
    printf 'PASS: artifact review accepted\n' >"$missing_allow_review"
    printf 'FAIL: artifact review rejected\n\nnext slice allowed: no\n' >"$fail_review"
    review_is_accepted "$legacy_review" \
        || die "Review verdict self-test expected legacy final-line PASS acceptance"
    review_is_accepted "$modern_review" \
        || die "Review verdict self-test expected first-line PASS plus allow-line acceptance"
    if review_is_accepted "$missing_allow_review"; then
        die "Review verdict self-test expected missing allow line rejection"
    fi
    if review_is_accepted "$fail_review"; then
        die "Review verdict self-test expected FAIL rejection"
    fi
    RUN_DIR="$old_run_dir"
    annotation_plan="$old_annotation_plan"
    recording_path="$old_recording_path"
    log "self-test PASS"
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --require-review)
            REQUIRE_REVIEW=1
            shift
            ;;
        --check-only)
            CHECK_ONLY=1
            shift
            ;;
        --check-sibling-artifacts)
            CHECK_SIBLING_ARTIFACTS=1
            shift
            ;;
        --self-test)
            SELF_TEST=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            die "Unknown option: $1"
            ;;
        *)
            [ -z "$RUN_DIR" ] || die "Only one artifact run directory is supported"
            RUN_DIR="$1"
            shift
            ;;
    esac
done

if [ "$SELF_TEST" = "1" ]; then
    RUN_DIR=""
    LOGS_DIR=""
    SCREENSHOTS_DIR=""
    RECORDINGS_DIR=""
    CONFIG_PATH=""
    PREFLIGHT_LOG=""
else
    [ -n "$RUN_DIR" ] || {
        usage >&2
        die "Missing artifact run directory"
    }
    [ -d "$RUN_DIR" ] || die "Artifact directory does not exist: $RUN_DIR"
    LOGS_DIR="${RUN_DIR}/logs"
    SCREENSHOTS_DIR="${RUN_DIR}/screenshots"
    RECORDINGS_DIR="${RUN_DIR}/recordings"
    CONFIG_PATH="${RUN_DIR}/config/winmux.toml"
    PREFLIGHT_LOG="${LOGS_DIR}/preflight.log"
fi

require_file() {
    local path="$1"
    [ -s "$path" ] || die "Missing or empty file: $path"
}

value_from_log() {
    local key="$1"
    local path="$2"
    /usr/bin/awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$path"
}

file_sha256() {
    shasum -a 256 "$1" | awk '{ print $1 }'
}

require_no_ds_store() {
    local found
    found="$(find "$RUN_DIR" -name .DS_Store -print -quit)"
    [ -z "$found" ] || die "Artifact contains Finder metadata: $found"
}

verify_hash_from_preflight() {
    local key="$1"
    local path="$2"
    local expected
    expected="$(value_from_log "$key" "$PREFLIGHT_LOG")"
    [ -n "$expected" ] || return 0
    require_file "$path"
    local actual
    actual="$(file_sha256 "$path")"
    [ "$actual" = "$expected" ] || die "$path hash $actual does not match preflight $key=$expected"
}

is_historical_slice_3_artifact() {
    [ "$(basename "$RUN_DIR")" = "slice-3-20260623T234421Z" ]
}

is_historical_slice_5_artifact() {
    [ "$(basename "$RUN_DIR")" = "slice-5-20260624T013034Z" ]
}

is_historical_slice_8_artifact() {
    [ "$(basename "$RUN_DIR")" = "slice-8-20260624T045815Z" ]
}

requires_current_artifact_contract() {
    case "$recording_name" in
        slice-15-*|slice-16-*|slice-17-*|slice-18-*|slice-19-*|slice-[2-9][0-9]-*) return 0 ;;
        *) return 1 ;;
    esac
}

manifest_value() {
    local path="$1"
    local kind="$2"
    local key="$3"
    /usr/bin/awk -F'\t' -v kind="$kind" -v key="$key" '$1 == kind && $2 == key { print $3; exit }' "$path"
}

manifest_value_or_log() {
    local manifest_path="$1"
    local kind="$2"
    local key="$3"
    local log_key="$4"
    local log_path="$5"
    local value

    value="$(manifest_value "$manifest_path" "$kind" "$key")"
    if [ -n "$value" ]; then
        printf '%s\n' "$value"
        return 0
    fi

    value_from_log "$log_key" "$log_path"
}

annotation_chip_start() {
    local path="$1"
    local chip="$2"
    /usr/bin/awk -F'\t' -v chip="$chip" '$0 != "" && $1 !~ /^#/ && $5 == chip { print $1; exit }' "$path"
}

require_annotation_chip_start() {
    local path="$1"
    local chip="$2"
    local value
    value="$(annotation_chip_start "$path" "$chip")"
    [ -n "$value" ] || die "Annotation plan missing timing for chip: $chip"
    printf '%s\n' "$value"
}

require_manifest_value() {
    local path="$1"
    local kind="$2"
    local key="$3"
    local value
    value="$(manifest_value "$path" "$kind" "$key")"
    [ -n "$value" ] || die "Proof manifest missing ${kind}/${key}: $path"
    printf '%s\n' "$value"
}

require_manifest_drag_screenshot() {
    local manifest_path="$1"
    local manifest_key="$2"
    local filename
    filename="$(require_manifest_value "$manifest_path" drag-screenshots "$manifest_key")"

    [[ "$filename" == *.png ]] || die "Proof manifest drag screenshot ${manifest_key} must name a PNG: $filename"
    [[ "$filename" != */* ]] || die "Proof manifest drag screenshot ${manifest_key} must be a screenshot filename, not a path: $filename"

    local path="${SCREENSHOTS_DIR}/${filename}"
    require_file "$path"

    local byte_count
    byte_count="$(wc -c <"$path" | tr -d ' ')"
    [ "$byte_count" -gt 50000 ] || die "Drag screenshot ${filename} is too small to be a full-frame proof: ${byte_count} bytes"

    local dimensions
    dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "$path")" \
        || die "Drag screenshot ${filename} is not readable image media"
    local expected_dimensions="${width:-}x${height:-}"
    if [ "$expected_dimensions" != "x" ]; then
        [ "$dimensions" = "$expected_dimensions" ] \
            || die "Drag screenshot ${filename} dimensions ${dimensions} do not match recording ${expected_dimensions}"
    fi

    printf '%s\n' "$path"
}

ensure_review_packet() {
    local packet_path="${RUN_DIR}/reviews/reviewer-packet.md"
    local packet_log="${LOGS_DIR}/${recording_name}.review-packet.log"
    local absolute_run_dir
    local repo_root
    local relative_run_dir=""
    absolute_run_dir="$(cd "$RUN_DIR" && pwd -P)"
    repo_root="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"
    case "$absolute_run_dir" in
        "$repo_root"/*) relative_run_dir="${absolute_run_dir#"$repo_root"/}" ;;
    esac

    if [ ! -s "$packet_path" ]; then
        [ "$CHECK_ONLY" != "1" ] || die "Missing review packet in --check-only mode: $packet_path"
        [ -x "${SCRIPT_DIR}/write-review-packet" ] || die "Missing executable review packet writer: ${SCRIPT_DIR}/write-review-packet"
        "${SCRIPT_DIR}/write-review-packet" "$RUN_DIR" >"$packet_log" 2>&1 || {
            cat "$packet_log" >&2 || true
            die "Review packet generation failed"
        }
    fi

    require_file "$packet_path"
    review_packet_contains_any "$packet_path" \
        "$recording_path" \
        "${absolute_run_dir}/recordings/${recording_name}.mov" \
        "${relative_run_dir}/recordings/${recording_name}.mov" \
        || die "Review packet missing primary recording path"
    review_packet_contains_any "$packet_path" \
        "$contact_sheet" \
        "${absolute_run_dir}/screenshots/${recording_name}.contact-sheet.jpg" \
        "${relative_run_dir}/screenshots/${recording_name}.contact-sheet.jpg" \
        || die "Review packet missing contact sheet path"
    local manifest_path
    manifest_path="$(sample_manifest_path)"
    if [ -s "$manifest_path" ]; then
        review_packet_contains_any "$packet_path" \
            "$manifest_path" \
            "${absolute_run_dir}/logs/${recording_name}.sample-manifest.tsv" \
            "${relative_run_dir}/logs/${recording_name}.sample-manifest.tsv" \
            || die "Review packet missing sample manifest path"
    fi
    if [ -s "${LOGS_DIR}/${recording_name}.expected-chips.txt" ]; then
        review_packet_contains_any "$packet_path" \
            "${LOGS_DIR}/${recording_name}.expected-chips.txt" \
            "${absolute_run_dir}/logs/${recording_name}.expected-chips.txt" \
            "${relative_run_dir}/logs/${recording_name}.expected-chips.txt" \
            || die "Review packet missing expected caption chips path"
    fi
    if [ -s "${LOGS_DIR}/${recording_name}.edge-crops.tsv" ]; then
        review_packet_contains_any "$packet_path" \
            "${LOGS_DIR}/${recording_name}.edge-crops.tsv" \
            "${absolute_run_dir}/logs/${recording_name}.edge-crops.tsv" \
            "${relative_run_dir}/logs/${recording_name}.edge-crops.tsv" \
            || die "Review packet missing edge crop manifest path"
    fi
    if [ -s "${LOGS_DIR}/${recording_name}.caption-tail.tsv" ]; then
        review_packet_contains_any "$packet_path" \
            "${LOGS_DIR}/${recording_name}.caption-tail.tsv" \
            "${absolute_run_dir}/logs/${recording_name}.caption-tail.tsv" \
            "${relative_run_dir}/logs/${recording_name}.caption-tail.tsv" \
            || die "Review packet missing caption tail manifest path"
    fi
    if [ -s "${LOGS_DIR}/${recording_name}.event-manifest.tsv" ]; then
        review_packet_contains_any "$packet_path" \
            "${LOGS_DIR}/${recording_name}.event-manifest.tsv" \
            "${absolute_run_dir}/logs/${recording_name}.event-manifest.tsv" \
            "${relative_run_dir}/logs/${recording_name}.event-manifest.tsv" \
            || die "Review packet missing event manifest path"
        if [ -s "${LOGS_DIR}/${recording_name}.mouse-events.tsv" ]; then
            review_packet_contains_any "$packet_path" \
                "${LOGS_DIR}/${recording_name}.mouse-events.tsv" \
                "${absolute_run_dir}/logs/${recording_name}.mouse-events.tsv" \
                "${relative_run_dir}/logs/${recording_name}.mouse-events.tsv" \
                || die "Review packet missing mouse event timing path"
        fi
        review_packet_contains_any "$packet_path" \
            "${SCREENSHOTS_DIR}/${recording_name}.event-contact-sheet.jpg" \
            "${absolute_run_dir}/screenshots/${recording_name}.event-contact-sheet.jpg" \
            "${relative_run_dir}/screenshots/${recording_name}.event-contact-sheet.jpg" \
            || die "Review packet missing event contact sheet path"
    fi
    local transport_summary="${LOGS_DIR}/guest-transport-summary.tsv"
    if [ -s "$transport_summary" ]; then
        review_packet_contains_any "$packet_path" \
            "$transport_summary" \
            "${absolute_run_dir}/logs/guest-transport-summary.tsv" \
            "${relative_run_dir}/logs/guest-transport-summary.tsv" \
            || die "Review packet missing guest transport summary path"
    fi
    review_packet_contains_any "$packet_path" \
        "${RUN_DIR}/reviews/no-ctx-artifact-review.md" \
        "${absolute_run_dir}/reviews/no-ctx-artifact-review.md" \
        "${relative_run_dir}/reviews/no-ctx-artifact-review.md" \
        || die "Review packet missing review output path"
    if [ -s "${LOGS_DIR}/${recording_name}.proof-manifest.tsv" ]; then
        local drag_screenshot
        while IFS= read -r drag_screenshot; do
            [ -n "$drag_screenshot" ] || continue
            review_packet_contains_any "$packet_path" \
                "${RUN_DIR}/screenshots/${drag_screenshot}" \
                "${absolute_run_dir}/screenshots/${drag_screenshot}" \
                "${relative_run_dir}/screenshots/${drag_screenshot}" \
                || die "Review packet missing manifest drag screenshot path: $drag_screenshot"
        done < <(/usr/bin/awk -F'\t' '$1 == "drag-screenshots" { print $3 }' "${LOGS_DIR}/${recording_name}.proof-manifest.tsv")
    fi
    if [ -s "${LOGS_DIR}/${recording_name}.color-sentinel.tsv" ]; then
        review_packet_contains_any "$packet_path" \
            "${LOGS_DIR}/${recording_name}.color-sentinel.tsv" \
            "${absolute_run_dir}/logs/${recording_name}.color-sentinel.tsv" \
            "${relative_run_dir}/logs/${recording_name}.color-sentinel.tsv" \
            || die "Review packet missing color sentinel manifest path"
    fi
    if [ -s "${LOGS_DIR}/${recording_name}.overlay-sentinel.tsv" ]; then
        review_packet_contains_any "$packet_path" \
            "${LOGS_DIR}/${recording_name}.overlay-sentinel.tsv" \
            "${absolute_run_dir}/logs/${recording_name}.overlay-sentinel.tsv" \
            "${relative_run_dir}/logs/${recording_name}.overlay-sentinel.tsv" \
            || die "Review packet missing overlay sentinel manifest path"
    fi
    case "$recording_name" in
        slice-15-*|slice-16-*)
            review_packet_contains_any "$packet_path" \
                "make e2e-verify-slice-check RUN_DIR=${RUN_DIR} ARGS=--require-review" \
                "make e2e-verify-slice-check RUN_DIR=${absolute_run_dir} ARGS=--require-review" \
                "make e2e-verify-slice-check RUN_DIR=${relative_run_dir} ARGS=--require-review" \
                || die "Review packet missing non-mutating verifier command"
            review_packet_contains_any "$packet_path" \
                "make e2e-slice-closeout-check RUN_DIR=${RUN_DIR}" \
                "make e2e-slice-closeout-check RUN_DIR=${absolute_run_dir}" \
                "make e2e-slice-closeout-check RUN_DIR=${relative_run_dir}" \
                || die "Review packet missing slice closeout command"
            ;;
        *)
            review_packet_contains_any "$packet_path" \
                "make e2e-verify-slice-check RUN_DIR=${RUN_DIR} ARGS=--require-review" \
                "make e2e-verify-slice-check RUN_DIR=${absolute_run_dir} ARGS=--require-review" \
                "make e2e-verify-slice-check RUN_DIR=${relative_run_dir} ARGS=--require-review" \
                "make e2e-verify-slice RUN_DIR=${RUN_DIR} ARGS=--require-review" \
                "make e2e-verify-slice RUN_DIR=${absolute_run_dir} ARGS=--require-review" \
                "make e2e-verify-slice RUN_DIR=${relative_run_dir} ARGS=--require-review" \
                || die "Review packet missing verifier command"
            ;;
    esac
    grep -F 'resources/screenshots/winmux-overview.png' "$packet_path" >/dev/null || die "Review packet missing baseline screenshots"
    grep -F 'Product-Quality Floor' "$packet_path" >/dev/null || die "Review packet missing product-quality floor"
}

review_packet_contains_any() {
    local packet_path="$1"
    shift
    local candidate
    for candidate in "$@"; do
        [ -n "$candidate" ] || continue
        if grep -F "$candidate" "$packet_path" >/dev/null; then
            return 0
        fi
    done
    return 1
}

