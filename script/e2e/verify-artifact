review_mentions_candidate() {
    local review_path="$1"
    local candidate="$2"
    local repo_root="$3"
    local exact="${4:-0}"
    local relative="$candidate"
    local basename_candidate
    local url_without_scheme="$candidate"

    case "$candidate" in
        "$repo_root"/*) relative="${candidate#"$repo_root"/}" ;;
    esac
    basename_candidate="$(basename "$candidate")"
    case "$candidate" in
        http://*)
            url_without_scheme="${candidate#http://}"
            grep -F "$candidate" "$review_path" >/dev/null \
                || grep -F "$url_without_scheme" "$review_path" >/dev/null
            return
            ;;
        https://*)
            url_without_scheme="${candidate#https://}"
            grep -F "$candidate" "$review_path" >/dev/null \
                || grep -F "$url_without_scheme" "$review_path" >/dev/null
            return
            ;;
    esac

    if [ "$exact" = "1" ]; then
        grep -F "$candidate" "$review_path" >/dev/null \
            || grep -F "$relative" "$review_path" >/dev/null
    else
        grep -F "$candidate" "$review_path" >/dev/null \
            || grep -F "$relative" "$review_path" >/dev/null \
            || grep -F "$basename_candidate" "$review_path" >/dev/null
    fi
}

require_review_mentions_packet_baselines() {
    local review_path="$1"
    local packet_path="$2"
    local repo_root
    repo_root="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"

    local required_count=0 candidate
    local candidate_path
    local exact_local_baselines=0
    case "${recording_name:-}" in
        slice-31-relaunch-saved-layout|slice-32-divider-save-relaunch|slice-37-starter-onboarding|slice-38-user-readiness|slice-39-dogfood-install-permissions|slice-40-zone-setup-assistant) exact_local_baselines=1 ;;
    esac
    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        case "$candidate" in
            http://*|https://*) ;;
            /*)
                [ -e "$candidate" ] || die "Reviewer packet baseline path does not exist: $candidate"
                ;;
            *)
                candidate_path="${repo_root}/${candidate}"
                [ -e "$candidate_path" ] || die "Reviewer packet baseline path does not exist: $candidate"
                ;;
        esac
        required_count=$((required_count + 1))
        review_mentions_candidate "$review_path" "$candidate" "$repo_root" "$exact_local_baselines" \
            || die "Review does not cite baseline from reviewer packet: $candidate"
    done < <(/usr/bin/awk '
        /^## Baseline And Product Surfaces$/ { in_section = 1; next }
        in_section && /^## / { exit }
        in_section && /^- / {
            value = substr($0, 3)
            gsub(/`/, "", value)
            if (value ~ /^https?:\/\// ||
                value ~ /\/demo[^\/]*\.mp4$/ ||
                value ~ /\/artifacts\/e2e\/slice-7-root-demo-/ ||
                value ~ /\/artifacts\/e2e\/slice-36-root-current-demo-/ ||
                value ~ /\/resources\/screenshots\// ||
                value ~ /\/README\.md$/) {
                print value
            }
        }
    ' "$packet_path")

    [ "$required_count" -gt 0 ] || die "Reviewer packet has no local baseline citations to enforce"
}

review_mentions_retry_product_action_decision() {
    local review_path="$1"
    local phase="$2"

    /usr/bin/awk -v phase="$phase" '
        {
            line = tolower($0)
            phase_value = tolower(phase)
            if (index(line, phase_value) > 0) {
                in_phase_block = 1
            } else if (in_phase_block && line ~ /^[[:space:]]*$/) {
                in_phase_block = 0
            }
            if (!in_phase_block) {
                previous_line = line
                next
            }
            joined_line = previous_line " " line
            if (index(line, "before the first visible product action") > 0 ||
                index(line, "after the first visible product action") > 0 ||
                index(line, "before the first product action") > 0 ||
                index(line, "after the first product action") > 0 ||
                index(line, "before visible product action") > 0 ||
                index(line, "after visible product action") > 0 ||
                index(joined_line, "before the first visible product action") > 0 ||
                index(joined_line, "after the first visible product action") > 0 ||
                index(joined_line, "before the first product action") > 0 ||
                index(joined_line, "after the first product action") > 0 ||
                index(joined_line, "before visible product action") > 0 ||
                index(joined_line, "after visible product action") > 0) {
                found = 1
            }
            previous_line = line
        }
        END { exit(found ? 0 : 1) }
    ' "$review_path"
}

