    fi
    grep -F '|route-comms.rtf|' "$before_windows" >/dev/null \
        && die "Slice 8 before log already contains route-comms.rtf"
    grep -F '$ open -a TextEdit route-comms.rtf' "$open_log" >/dev/null \
        || die "Slice 8 action log missing exact open command"
    grep -F '$ winmux move-node-to-zone' "$open_log" >/dev/null \
        && die "Slice 8 automatic routing proof log must not include a manual move-node-to-zone command"

    local route_id route_zone route_workspace
    route_id="$(field_for_title "$after_windows" 'route-comms.rtf' id)"
    route_zone="$(field_for_title "$after_windows" 'route-comms.rtf' zone)"
    route_workspace="$(field_for_title "$after_windows" 'route-comms.rtf' workspace)"
    [ -n "$route_id" ] || die "Slice 8 after log missing route-comms.rtf"
    [ "$route_zone" = right ] || die "Slice 8 route-comms.rtf was not in right zone: ${route_zone:-missing}"
    [ -n "$route_workspace" ] || die "Slice 8 route-comms.rtf missing workspace"
    grep -F "routed-window-id=${route_id}" "$proof" >/dev/null \
        || die "Slice 8 proof does not name routed window id from after log"
    grep -F "routed-zone=right" "$proof" >/dev/null \
        || die "Slice 8 proof does not name routed zone"
    grep -F 'zone=left|name=Reference|' "$zones" >/dev/null || die "Slice 8 zones log missing Reference/left"
    grep -F 'zone=main|name=Work|' "$zones" >/dev/null || die "Slice 8 zones log missing Work/main"
    grep -F 'zone=right|name=Comms|' "$zones" >/dev/null || die "Slice 8 zones log missing Comms/right"

    if is_historical_slice_8_artifact; then
        grep -F "Config: [[on-window-detected]] move-node-to-zone Comms" "$annotation_plan" >/dev/null \
            || die "Slice 8 annotations missing on-window-detected config chip"
        log "historical exception: accepted Slice 8 artifact predates strict caption chip hardening"
    else
        grep -F "Config: [[on-window-detected]] move-node-to-zone Comms --fail-if-noop" "$annotation_plan" >/dev/null \
            || die "Slice 8 annotations missing strict on-window-detected config chip"
    fi
    grep -F "Action: before route, Work is active" "$annotation_plan" >/dev/null \
        || die "Slice 8 annotations missing before-route action chip"
    grep -F "Run: open -a TextEdit route-comms.rtf" "$annotation_plan" >/dev/null \
        || die "Slice 8 annotations missing open command chip"
    grep -F "Action: rule moved route-comms.rtf to Comms" "$annotation_plan" >/dev/null \
        || die "Slice 8 annotations missing rule-moved action chip"
    grep -F "Run: winmux list-windows --workspace visible" "$annotation_plan" >/dev/null \
        || die "Slice 8 annotations missing list-windows chip"
    grep -F "Run: winmux list-zones" "$annotation_plan" >/dev/null \
        || die "Slice 8 annotations missing list-zones chip"
}

require_no_ds_store
require_file "$PREFLIGHT_LOG"
require_file "$CONFIG_PATH"
verify_hash_from_preflight config_sha256 "$CONFIG_PATH"
verify_hash_from_preflight reload_config_sha256 "${RUN_DIR}/config/winmux-shifted.toml"
require_file "${LOGS_DIR}/guest-control-check.log"
require_file "${LOGS_DIR}/guest-privacy-setup.log"
require_file "${LOGS_DIR}/guest-clean-slate.log"
require_file "${LOGS_DIR}/guest-capture-ready.log"

capture_mode="$(value_from_log capture_mode "$PREFLIGHT_LOG")"
require_guest_control="$(value_from_log require_guest_control "$PREFLIGHT_LOG")"
vm_display="$(value_from_log vm_display "$PREFLIGHT_LOG")"
record_seconds="$(value_from_log record_seconds "$PREFLIGHT_LOG")"
annotate_recording="$(value_from_log annotate_recording "$PREFLIGHT_LOG")"

[ "$capture_mode" = "guest" ] || die "Product artifact must use guest capture, got capture_mode=$capture_mode"
[ "$require_guest_control" = "1" ] || die "Product artifact must require guest control, got require_guest_control=$require_guest_control"

recording_count="$(find "$RECORDINGS_DIR" -maxdepth 1 -type f -name '*.mov' | wc -l | tr -d ' ')"
[ "$recording_count" = "1" ] || die "Expected exactly one .mov recording, found $recording_count"
recording_path="$(find "$RECORDINGS_DIR" -maxdepth 1 -type f -name '*.mov' | head -1)"
require_file "$recording_path"
recording_name="$(basename "$recording_path" .mov)"

before_count="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '00-before-*.png' | wc -l | tr -d ' ')"
after_count="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '99-after-*.png' | wc -l | tr -d ' ')"
[ "$before_count" -ge 1 ] || die "Missing before screenshot"
[ "$after_count" -ge 1 ] || die "Missing after screenshot"

duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$recording_path")"
width="$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$recording_path")"
height="$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "$recording_path")"
codec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$recording_path")"
frames="$(ffprobe -v error -select_streams v:0 -count_frames -show_entries stream=nb_read_frames -of default=noprint_wrappers=1:nokey=1 "$recording_path")"

awk -v duration="$duration" -v expected="$record_seconds" 'BEGIN { exit(duration + 0 >= expected * 0.80 ? 0 : 1) }' \
    || die "Recording duration ${duration}s is shorter than 80% of requested ${record_seconds}s"
[ -n "$codec" ] || die "Recording codec is missing"
[ "${frames:-0}" -gt 10 ] || die "Recording frame count is too low: ${frames:-0}"

if [[ "$vm_display" =~ ^([0-9]+)x([0-9]+)px$ ]]; then
    expected_width="${BASH_REMATCH[1]}"
    expected_height="${BASH_REMATCH[2]}"
    [ "$width" = "$expected_width" ] || die "Recording width $width does not match VM display width $expected_width"
    [ "$height" = "$expected_height" ] || die "Recording height $height does not match VM display height $expected_height"
fi

grep -F 'result=success' "${LOGS_DIR}/guest-control-check.log" >/dev/null || die "Guest control did not report success"
grep -F 'privacy_setup_done' "${LOGS_DIR}/guest-privacy-setup.log" >/dev/null || die "Privacy setup did not finish"
grep -F 'clean_slate_done' "${LOGS_DIR}/guest-clean-slate.log" >/dev/null || die "Clean-slate setup did not finish"
grep -F 'terminal_running=no' "${LOGS_DIR}/guest-clean-slate.log" >/dev/null || die "Terminal still running after clean slate"
grep -F 'system_settings_running=no' "${LOGS_DIR}/guest-clean-slate.log" >/dev/null || die "System Settings still running after clean slate"
grep -F 'textedit_running=no' "${LOGS_DIR}/guest-clean-slate.log" >/dev/null || die "TextEdit still running before scenario"
grep -F 'capture_probe_done' "${LOGS_DIR}/guest-capture-ready.log" >/dev/null || die "Guest capture readiness did not finish"

guest_capture_log="$(find "$LOGS_DIR" -maxdepth 1 -type f -name '*.guest-screencapture.log' | head -1)"
require_file "$guest_capture_log"
grep -F 'capture_mode=guest' "$guest_capture_log" >/dev/null || die "Recording log does not show guest capture"
grep -F 'result=success' "$guest_capture_log" >/dev/null || die "Recording log does not report success"
grep -F "width=${width}" "$guest_capture_log" >/dev/null || die "Recording log missing decoded width"
grep -F "height=${height}" "$guest_capture_log" >/dev/null || die "Recording log missing decoded height"

ensure_recording_samples "$recording_path" "$recording_name" "$duration"
contact_sheet="${SCREENSHOTS_DIR}/${recording_name}.contact-sheet.jpg"
ensure_review_packet

annotation_log="${LOGS_DIR}/${recording_name}.annotation.log"
annotation_plan="${LOGS_DIR}/${recording_name}.annotations.tsv"
raw_recording="${RECORDINGS_DIR}/raw/${recording_name}.raw.mov"
proof_manifest="${LOGS_DIR}/${recording_name}.proof-manifest.tsv"
if [ "$annotate_recording" = "1" ] || [ -s "$annotation_log" ] || [ -s "$annotation_plan" ]; then
    require_file "$annotation_log"
    require_file "$annotation_plan"
    require_file "$raw_recording"
    grep -F 'result=success' "$annotation_log" >/dev/null || die "Annotation log does not report success"
    skip_placeholder_check=0
    if is_historical_slice_3_artifact; then
        skip_placeholder_check=1
        log "historical exception: Slice 3 annotation predates placeholder chip hardening"
    fi
    awk -F '\t' -v skip_placeholder_check="$skip_placeholder_check" '
        $0 == "" || $1 ~ /^#/ { next }
        NF < 5 || $5 !~ /(Run|Config|Edit|Debug|Action):/ {
            printf("Annotation row %d is missing a user-facing command/config/action: %s\n", NR, $0) > "/dev/stderr"
            exit 1
        }
        skip_placeholder_check != "1" && $5 ~ /\.\.\.|<[^>]*>|winmux <command>/ {
            printf("Annotation row %d uses a placeholder command/config/action: %s\n", NR, $0) > "/dev/stderr"
            exit 1
        }
    ' "$annotation_plan" || die "Annotation plan must expose command/config/action chips"
fi

if [[ "$recording_name" == *drag* ]]; then
    if is_historical_slice_5_artifact; then
        log "historical exception: Slice 5 artifact predates drag proof manifest hardening"
    else
        require_drag_proof_manifest "$proof_manifest"
    fi
fi

case "$recording_name" in
    slice-3-stable-identity)
        require_slice_3_stable_identity_proof
        if [ -n "$(value_from_log config_sha256 "$PREFLIGHT_LOG")" ]; then
            require_file "${RUN_DIR}/config/winmux-active.toml"
        fi
        verify_hash_from_preflight reload_config_sha256 "${RUN_DIR}/config/winmux-active.toml"
        ;;
    slice-4-zone-commands)
        require_slice_4_zone_commands_proof
        ;;
    slice-5-sidebar-drag)
        require_slice_5_sidebar_drag_proof
        ;;
    slice-6-zone-layout-presets)
        require_slice_6_zone_layout_presets_proof
        ;;
    slice-6b-zone-scenes)
        require_slice_6b_zone_scene_proof
        ;;
    slice-8-window-routing)
        require_slice_8_window_routing_proof
        ;;
esac

if [ "$REQUIRE_REVIEW" = "1" ]; then
    review_path="${RUN_DIR}/reviews/no-ctx-artifact-review.md"
    require_file "$review_path"
    verdict="$(tail -n 1 "$review_path")"
    case "$verdict" in
        PASS|PASS_WITH_NOTES) ;;
        *) die "Review verdict must be PASS or PASS_WITH_NOTES, got: $verdict" ;;
    esac
    grep -F 'next slice allowed: yes' "$review_path" >/dev/null \
        || die "Review must explicitly allow the next slice"
fi

log "recording=$recording_path"
log "duration=${duration}s width=${width} height=${height} codec=${codec} frames=${frames}"
log "contact_sheet=$contact_sheet"
log "PASS"
