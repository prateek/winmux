    [ "$after_zone" = right ] || die "Slice 12 Alt snap did not end in Comms/right: ${after_zone:-missing}"
    [ -n "$before_workspace" ] && [ -n "$after_workspace" ] && [ "$before_workspace" != "$after_workspace" ] \
        || die "Slice 12 Alt snap did not move to a different active workspace"

    [ "$(field_for_title "$windows_before" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "Slice 12 before log missing snap-demo source id"
    [ "$(field_for_title "$windows_before" 'snap-demo.rtf' zone)" = main ] \
        || die "Slice 12 before log missing snap-demo in main"
    [ "$(field_for_title "$windows_freeform" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "Slice 12 freeform log missing same snap-demo id"
    [ "$(field_for_title "$windows_freeform" 'snap-demo.rtf' zone)" = main ] \
        || die "Slice 12 freeform log should keep snap-demo in main"
    [ "$(field_for_title "$windows_after" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "Slice 12 after log missing same snap-demo id"
    [ "$(field_for_title "$windows_after" 'snap-demo.rtf' zone)" = right ] \
        || die "Slice 12 after log should move snap-demo to right"

    [ "$(manifest_value "$proof_manifest" drag-target snap-target)" = whole-zone ] \
        || die "Slice 12 proof manifest must show whole-zone snap target"
    [ "$(manifest_value "$proof_manifest" drag-policy policy)" = snap-on-modifier ] \
        || die "Slice 12 proof manifest missing snap-on-modifier policy"
    [ "$(manifest_value "$proof_manifest" drag-policy modifier)" = alt ] \
        || die "Slice 12 proof manifest missing alt modifier"
    [ "$(manifest_value "$proof_manifest" drag-policy negative-proof)" = no-alt-no-zone-move ] \
        || die "Slice 12 proof manifest missing negative freeform proof"
    [ "$(manifest_value "$proof_manifest" drag-policy positive-proof)" = alt-held-whole-zone-snap ] \
        || die "Slice 12 proof manifest missing positive snap proof"
    [ "$(manifest_value "$proof_manifest" drag-result freeform-result)" = no-zone-move ] \
        || die "Slice 12 proof manifest missing freeform result"
    [ "$(manifest_value "$proof_manifest" drag-result result)" = success ] \
        || die "Slice 12 proof manifest missing final success result"

    if ! grep -F "Config: [mouse.zone-snap] policy = 'snap-on-modifier', modifier = 'alt', target = 'zone'" "$annotation_plan" >/dev/null; then
        grep -F "Config: [mouse.zone-snap] policy='snap-on-modifier'" "$annotation_plan" >/dev/null \
            || die "Slice 12 annotations missing mouse snap config chip"
    fi
    if ! grep -F "Action: drag snap-demo.rtf without Alt" "$annotation_plan" >/dev/null; then
        grep -F "Action: drag snap-demo.rtf without Option" "$annotation_plan" >/dev/null \
            || die "${slice_label} annotations missing no-modifier drag chip"
    fi
    if ! grep -F "Action: hold Alt while dragging snap-demo.rtf" "$annotation_plan" >/dev/null; then
        grep -F "Action: hold Option while dragging: snap to Comms zone" "$annotation_plan" >/dev/null \
            || die "${slice_label} annotations missing modifier-held drag chip"
    fi
    if ! grep -F "Action: target = whole Comms zone" "$annotation_plan" >/dev/null; then
        grep -F "Action: Snap to whole Comms zone, not a window" "$annotation_plan" >/dev/null \
            || die "${slice_label} annotations missing whole-zone target chip"
    fi
    grep -F "Action: release on Comms zone" "$annotation_plan" >/dev/null \
        || die "Slice 12 annotations missing release chip"
    grep -F "Run: winmux list-windows --monitor all" "$annotation_plan" >/dev/null \
        || die "Slice 12 annotations missing list-windows inspection chip"
    awk -F '\t' '$5 == "Action: drag snap-demo.rtf without Alt" { found = 1; ok = (($1 + 0) <= 8 && ($2 + 0) >= 18) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || awk -F '\t' '$5 == "Action: drag snap-demo.rtf without Option" { found = 1; ok = (($1 + 0) <= 8 && ($2 + 0) >= 18) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "${slice_label} no-modifier drag caption must cover the negative drag interval"
    awk -F '\t' '$5 == "Action: hold Alt while dragging snap-demo.rtf" { found = 1; ok = (($1 + 0) <= 35 && ($2 + 0) >= 44) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || awk -F '\t' '$5 == "Action: hold Option while dragging: snap to Comms zone" { found = 1; ok = (($1 + 0) <= 35 && ($2 + 0) >= 44) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "${slice_label} modifier-held drag caption must cover the positive drag interval"

    if [ "$require_overlay_sentinel" = "1" ]; then
        require_mouse_snap_overlay_sentinel "${LOGS_DIR}/${recording_name}.overlay-sentinel.tsv"
    fi
}

