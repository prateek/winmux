require_slice_31_product_window_log_clean() {
    local path="$1"
    local description="$2"
    require_file "$path"
    /usr/bin/awk -F'|' -v description="$description" '
        function is_expected_textedit(bundle, app, title) {
            return bundle == "com.apple.TextEdit" &&
                app == "TextEdit" &&
                (title == "research-reference.rtf" ||
                 title == "focus-draft.rtf" ||
                 title == "team-inbox.rtf")
        }
        function is_winmux_chrome(bundle, app, title) {
            bundle = tolower(bundle)
            app = tolower(app)
            return index(bundle, "winmux") > 0 ||
                index(app, "winmux") > 0
        }
        NF {
            row_count++
            if (NF != 7) {
                printf("Slice 31 %s product window row has %d fields, expected 7: %s\n", description, NF, $0) > "/dev/stderr"
                invalid = 1
                next
            }
            if (is_expected_textedit($1, $2, $3)) {
                titles[$3]++
                next
            }
            if (is_winmux_chrome($1, $2, $3)) {
                chrome_count++
                next
            }
            if ($1 == "com.apple.TextEdit") {
                printf("Slice 31 %s contains unexpected TextEdit title %s\n", description, $3) > "/dev/stderr"
            } else {
                printf("Slice 31 %s contains unrelated visible app %s (%s) title %s\n", description, $1, $2, $3) > "/dev/stderr"
            }
            invalid = 1
        }
        END {
            if (titles["research-reference.rtf"] != 1 ||
                titles["focus-draft.rtf"] != 1 ||
                titles["team-inbox.rtf"] != 1) {
                printf("Slice 31 %s product window log has wrong title set\n", description) > "/dev/stderr"
                invalid = 1
            }
            if (row_count < 3) {
                printf("Slice 31 %s product window log has %d rows, expected at least 3\n", description, row_count) > "/dev/stderr"
                invalid = 1
            }
            exit(invalid ? 1 : 0)
        }
    ' "$path" || die "Slice 31 ${description} product view contains unrelated, proof, or prompt windows: $path"
}

require_slice_31_product_windows_match_zones() {
    local product_log="$1"
    local zones_log="$2"
    local description="$3"
    require_file "$product_log"
    require_file "$zones_log"
    /usr/bin/awk -F'|' -v description="$description" '
        function field_value(prefix,   i) {
            for (i = 1; i <= NF; i++) {
                if (index($i, prefix "=") == 1) {
                    return substr($i, length(prefix) + 2)
                }
            }
            return ""
        }
        function expected_zone_for_title(title) {
            if (title == "research-reference.rtf") return "left"
            if (title == "focus-draft.rtf") return "main"
            if (title == "team-inbox.rtf") return "right"
            return ""
        }
        FNR == NR {
            zone = substr($1, length("zone=") + 1)
            left[zone] = field_value("left") + 0
            width[zone] = field_value("width") + 0
            right[zone] = left[zone] + width[zone]
            next
        }
        $1 == "com.apple.TextEdit" && $2 == "TextEdit" {
            zone = expected_zone_for_title($3)
            if (zone == "") next
            x = field_value("x") + 0
            window_width = field_value("width") + 0
            window_right = x + window_width
            tolerance = 4
            if (!(zone in left)) {
                printf("Slice 31 %s has no zone geometry for %s\n", description, zone) > "/dev/stderr"
                invalid = 1
                next
            }
            if (x < left[zone] - tolerance || window_right > right[zone] + tolerance) {
                printf("Slice 31 %s window %s is physically outside expected %s zone: x=%s right=%s zone-left=%s zone-right=%s\n", description, $3, zone, x, window_right, left[zone], right[zone]) > "/dev/stderr"
                invalid = 1
            }
            seen[$3] = 1
        }
        END {
            if (!seen["research-reference.rtf"] || !seen["focus-draft.rtf"] || !seen["team-inbox.rtf"]) {
                printf("Slice 31 %s physical zone check did not see all expected task documents\n", description) > "/dev/stderr"
                invalid = 1
            }
            exit(invalid ? 1 : 0)
        }
    ' "$zones_log" "$product_log" || die "Slice 31 ${description} product windows are not physically inside their expected zones"
}

