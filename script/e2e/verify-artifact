require_exact_line_count() {
    local path="$1"
    local expected_line="$2"
    local expected_count="$3"
    local description="$4"
    local actual_count
    actual_count="$(/usr/bin/awk -v expected="$expected_line" '$0 == expected { count++ } END { print count + 0 }' "$path")"
    [ "$actual_count" = "$expected_count" ] \
        || die "${description}: expected ${expected_count} exact line(s) '${expected_line}', got ${actual_count}"
}

require_no_command_variants() {
    local path="$1"
    local command_prefix="$2"
    local exact_line="$3"
    local description="$4"
    local variants
    if variants="$(/usr/bin/awk -v prefix="$command_prefix" -v exact="$exact_line" '
        {
            trimmed = $0
            sub(/^[ \t]+/, "", trimmed)
            sub(/[ \t]+$/, "", trimmed)
        }
        index(trimmed, prefix) == 1 && $0 != exact {
            print
            found = 1
        }
        END { exit(found ? 0 : 1) }
    ' "$path")"; then
        die "${description} contains unexpected command variant(s): ${variants}"
    fi
}

manifest_value_or_log() {
    local manifest_path="$1"
    local kind="$2"
    local key="$3"
    local log_key="$4"
    local log_path="$5"
    local value

    value="$(manifest_value "$manifest_path" "$kind" "$key")"
    if [ -n "$value" ]; then
        printf '%s\n' "$value"
        return 0
    fi

    value_from_log "$log_key" "$log_path"
}

annotation_chip_start() {
    local path="$1"
    local chip="$2"
    /usr/bin/awk -F'\t' -v chip="$chip" '$0 != "" && $1 !~ /^#/ && $5 == chip { print $1; exit }' "$path"
}

require_annotation_chip_start() {
    local path="$1"
    local chip="$2"
    local value
    value="$(annotation_chip_start "$path" "$chip")"
    [ -n "$value" ] || die "Annotation plan missing timing for chip: $chip"
    printf '%s\n' "$value"
}

require_annotation_chip_covers_offset() {
    local path="$1"
    local chip="$2"
    local offset="$3"
    local message="$4"
    /usr/bin/awk -F'\t' -v chip="$chip" -v offset="$offset" '
        $0 == "" || $1 ~ /^#/ { next }
        offset + 0 >= $1 + 0 && offset + 0 <= $2 + 0 {
            for (i = 5; i <= NF; i++) {
                if ($i == chip) {
                    found = 1
                    exit
                }
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$path" || die "$message: offset $offset is not covered by chip: $chip"
}

annotation_chip_window_by_index() {
    local path="$1"
    local chip="$2"
    local target_index="$3"
    /usr/bin/awk -F'\t' -v chip="$chip" -v target_index="$target_index" '
        $0 == "" || $1 ~ /^#/ { next }
        {
            has_chip = 0
            for (i = 5; i <= NF; i++) {
                if ($i == chip) {
                    has_chip = 1
                    break
                }
            }
            if (has_chip) {
                count += 1
                if (count == target_index) {
                    start = $1
                    end = $2
                    found = 1
                    exit
                }
            }
        }
        END {
            if (found) {
                print start "\t" end
            }
            exit(found ? 0 : 1)
        }
    ' "$path"
}

require_annotation_chip_index_covers_offset() {
    local path="$1"
    local chip="$2"
    local target_index="$3"
    local offset="$4"
    local message="$5"
    local window start end
    window="$(annotation_chip_window_by_index "$path" "$chip" "$target_index")" \
        || die "$message: missing chip occurrence ${target_index}: $chip"
    IFS=$'\t' read -r start end <<<"$window"
    /usr/bin/awk -v offset="$offset" -v start="$start" -v end="$end" 'BEGIN {
        exit((offset + 0 >= start + 0 && offset + 0 <= end + 0) ? 0 : 1)
    }' || die "$message: offset $offset is not covered by chip occurrence ${target_index}: $chip"
}

