transport_summary_value() {
    local path="$1"
    local phase="$2"
    local key="$3"
    /usr/bin/awk -F'\t' -v phase="$phase" -v key="$key" '
        BEGIN {
            column["phase"] = 1
            column["log"] = 2
            column["attempts"] = 3
            column["failures"] = 4
            column["final_result"] = 5
            column["before_recording"] = 6
        }
        $0 ~ /^#/ {
            for (i = 1; i <= NF; i++) {
                label = $i
                sub(/^# /, "", label)
                sub(/^#/, "", label)
                column[label] = i
            }
            next
        }
        {
            phase_idx = column["phase"]
        }
        $phase_idx == phase {
            if (key in column) {
                idx = column[key]
                print $idx
            }
            exit
        }
    ' "$path"
}

transport_summary_phases() {
    local path="$1"
    /usr/bin/awk -F'\t' '
        BEGIN {
            phase_idx = 1
        }
        $0 ~ /^#/ {
            for (i = 1; i <= NF; i++) {
                label = $i
                sub(/^# /, "", label)
                sub(/^#/, "", label)
                if (label == "phase") {
                    phase_idx = i
                }
            }
            next
        }
        $0 != "" {
            print $phase_idx
        }
    ' "$path"
}

require_transport_summary_phase() {
    local path="$1"
    local phase="$2"
    local expected_result="$3"
    local expected_before_recording="$4"

    local attempts failures final_result before_recording log_path attempt_statuses first_failure_reason last_failure_reason
    log_path="$(transport_summary_value "$path" "$phase" log)"
    attempts="$(transport_summary_value "$path" "$phase" attempts)"
    failures="$(transport_summary_value "$path" "$phase" failures)"
    final_result="$(transport_summary_value "$path" "$phase" final_result)"
    before_recording="$(transport_summary_value "$path" "$phase" before_recording)"
    attempt_statuses="$(transport_summary_value "$path" "$phase" attempt_statuses || true)"
    first_failure_reason="$(transport_summary_value "$path" "$phase" first_failure_reason || true)"
    last_failure_reason="$(transport_summary_value "$path" "$phase" last_failure_reason || true)"

    [ -n "$log_path" ] || die "Guest transport summary missing phase: $phase"
    [ -n "$attempts" ] || die "Guest transport summary missing attempts for phase: $phase"
    [ -n "$failures" ] || die "Guest transport summary missing failures for phase: $phase"
    assert_string_eq "$final_result" "$expected_result" \
        "Guest transport summary final result mismatch for ${phase}"
    assert_string_eq "$before_recording" "$expected_before_recording" \
        "Guest transport summary before-recording flag mismatch for ${phase}"
    if [[ "$attempts" =~ ^[0-9]+$ ]] && [ "$attempts" -gt 0 ] && [ -n "$attempt_statuses" ]; then
        [ "$attempt_statuses" != "-" ] \
            || die "Guest transport summary missing per-attempt statuses for phase: $phase"
    fi
    if [[ "$failures" =~ ^[0-9]+$ ]] && [ "$failures" -gt 0 ] \
        && { [ -n "$first_failure_reason" ] || [ -n "$last_failure_reason" ]; }; then
        [ -n "$first_failure_reason" ] && [ "$first_failure_reason" != "-" ] \
            || die "Guest transport summary missing first failure reason for phase: $phase"
        [ -n "$last_failure_reason" ] && [ "$last_failure_reason" != "-" ] \
            || die "Guest transport summary missing last failure reason for phase: $phase"
        case "$attempt_statuses" in
            *failure*) ;;
            *)
                die "Guest transport summary failures for ${phase} are not reflected in attempt_statuses: ${attempt_statuses:-missing}"
                ;;
        esac
    fi
    require_file "${RUN_DIR}/${log_path}"
}

