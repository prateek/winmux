        after_zone="$(field_for_title "$windows_after" "$title" zone)"
        before_workspace="$(field_for_title "$windows_before" "$title" workspace)"
        after_workspace="$(field_for_title "$windows_after" "$title" workspace)"
        [ -n "$before_id" ] && [ -n "$after_id" ] \
            || die "Slice 28 missing window title across logs: $title"
        [ "$before_id" = "$after_id" ] \
            || die "Slice 28 window id changed for $title: $before_id -> $after_id"
        [ "$before_zone" = "$expected_zone" ] && [ "$after_zone" = "$expected_zone" ] \
            || die "Slice 28 zone changed for $title: $before_zone -> $after_zone"
        [ -n "$before_workspace" ] && [ "$before_workspace" = "$after_workspace" ] \
            || die "Slice 28 workspace changed for $title: $before_workspace -> $after_workspace"
    done
    [ "$(field_for_title "$windows_after" 'export-zone-layout-output.rtf' zone)" = main ] \
        || die "Slice 28 export output document should be visible in Work/main"

    local before_sha after_sha
    before_sha="$(cat "$config_sha_before")"
    after_sha="$(cat "$config_sha_after")"
    [ -n "$before_sha" ] && [ "$before_sha" = "$after_sha" ] \
        || die "Slice 28 copied config hash changed or is missing: ${before_sha:-missing} -> ${after_sha:-missing}"
    grep -F "config-sha-before=${before_sha}" "$proof" >/dev/null \
        || die "Slice 28 proof does not copy before config hash"
    grep -F "config-sha-after=${after_sha}" "$proof" >/dev/null \
        || die "Slice 28 proof does not copy after config hash"

    for chip in \
        "Config: [[zone-layouts]] columns left/main/right" \
        "Run: winmux resize-zone Work width +10%" \
        "Action: Work effective width becomes 0.6" \
        "Run: winmux export-zone-layout saved-ultrawide --monitor 1" \
        "Action: emitted [[zone-layouts]] TOML is visible" \
        "Run: winmux config --check slice-28-export-zone-layout.toml" \
        "Run: shasum config/winmux.toml"; do
        grep -F "$chip" "$annotation_plan" >/dev/null \
            || die "Slice 28 annotations missing chip: $chip"
    done
    grep -F 'Result: Config OK' "$annotation_plan" >/dev/null \
        || die "Slice 28 annotations missing Config OK result cue"
    grep -F 'Result: unchanged' "$annotation_plan" >/dev/null \
        || die "Slice 28 annotations missing unchanged config result cue"

    grep -F "widths-before=left:${before_left},main:${before_main},right:${before_right}" "$proof" >/dev/null \
        || die "Slice 28 proof does not copy before widths from zones log"
    grep -F "widths-resized=left:${resized_left},main:${resized_main},right:${resized_right}" "$proof" >/dev/null \
        || die "Slice 28 proof does not copy resized widths from zones log"
}

