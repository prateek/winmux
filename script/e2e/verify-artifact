        || die "Slice 11B config missing urgent color"
    grep -F "id = 'calm'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11B config missing calm style id"
    grep -F "color = '#3EA2FF'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11B config missing calm color"
