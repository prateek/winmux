event_manifest_value() {
    local manifest_path="$1"
    local event_id="$2"
    local field="$3"
    /usr/bin/awk -F'\t' -v event_id="$event_id" -v field="$field" '
        BEGIN {
            column["kind"] = 2
            column["seconds"] = 3
            column["caption-label"] = 4
            column["sample-label"] = 5
            column["path"] = 6
            column["expected"] = 7
        }
        $0 == "" || $1 ~ /^#/ { next }
        $1 == event_id && column[field] {
            print $column[field]
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$manifest_path"
}

require_event_manifest_value() {
    local manifest_path="$1"
    local event_id="$2"
    local field="$3"
    local value
    value="$(event_manifest_value "$manifest_path" "$event_id" "$field")" \
        || die "Event manifest missing ${field} for ${event_id}: $manifest_path"
    [ -n "$value" ] || die "Event manifest has empty ${field} for ${event_id}: $manifest_path"
    printf '%s\n' "$value"
}

require_event_manifest_event() {
    local manifest_path="$1"
    local event_id="$2"
    local kind="$3"
    local actual_kind seconds
    actual_kind="$(require_event_manifest_value "$manifest_path" "$event_id" kind)"
    seconds="$(require_event_manifest_value "$manifest_path" "$event_id" seconds)"
    [ "$actual_kind" = "$kind" ] \
        || die "Event manifest ${event_id} kind mismatch: expected ${kind}, got ${actual_kind}"
    [[ "$seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] \
        || die "Event manifest ${event_id} seconds must be numeric, got: ${seconds}"
}

require_event_manifest_paths() {
    local manifest_path="$1"
    require_file "$manifest_path"
    require_fresh_derived_file "$manifest_path" "${annotation_plan:-}" "Event manifest"
    local mouse_events=""
    if [ -n "${recording_name:-}" ]; then
        mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
    fi
    if [ -n "$mouse_events" ] && [ -s "$mouse_events" ]; then
        require_fresh_derived_file "$manifest_path" "$mouse_events" "Event manifest"
    fi

    local event_id relative_path
    while IFS=$'\t' read -r event_id _kind _seconds _caption _sample relative_path _expected; do
        case "${event_id:-}" in
            ""|\#*) continue ;;
        esac
        [ -n "${relative_path:-}" ] || continue
        [ "$relative_path" != "-" ] || continue
        case "$relative_path" in
            /*|*../*) die "Event manifest path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_file "${RUN_DIR}/${relative_path}"
        case "$relative_path" in
            screenshots/*.samples/*)
                require_fresh_derived_file "${RUN_DIR}/${relative_path}" "${recording_path:-}" "Event manifest frame"
                ;;
        esac
    done <"$manifest_path"
}

require_event_before() {
