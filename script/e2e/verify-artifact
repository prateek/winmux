transport_summary_value() {
    local path="$1"
    local phase="$2"
    local key="$3"
    /usr/bin/awk -F'\t' -v phase="$phase" -v key="$key" '
        BEGIN {
            column["log"] = 2
            column["attempts"] = 3
            column["failures"] = 4
            column["final_result"] = 5
            column["before_recording"] = 6
        }
        $1 == phase {
            print $column[key]
            exit
        }
    ' "$path"
}

require_transport_summary_phase() {
    local path="$1"
    local phase="$2"
    local expected_result="$3"
    local expected_before_recording="$4"

    local attempts failures final_result before_recording log_path
    log_path="$(transport_summary_value "$path" "$phase" log)"
    attempts="$(transport_summary_value "$path" "$phase" attempts)"
    failures="$(transport_summary_value "$path" "$phase" failures)"
    final_result="$(transport_summary_value "$path" "$phase" final_result)"
    before_recording="$(transport_summary_value "$path" "$phase" before_recording)"

    [ -n "$log_path" ] || die "Guest transport summary missing phase: $phase"
    [ -n "$attempts" ] || die "Guest transport summary missing attempts for phase: $phase"
    [ -n "$failures" ] || die "Guest transport summary missing failures for phase: $phase"
    assert_string_eq "$final_result" "$expected_result" \
        "Guest transport summary final result mismatch for ${phase}"
    assert_string_eq "$before_recording" "$expected_before_recording" \
        "Guest transport summary before-recording flag mismatch for ${phase}"
    require_file "${RUN_DIR}/${log_path}"
}

require_guest_transport_summary() {
    local summary_path="$1"
    require_file "$summary_path"
    require_transport_summary_phase "$summary_path" guest-control success yes
