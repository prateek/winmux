        [ -n "$before_id" ] && [ -n "$resized_id" ] && [ -n "$balanced_id" ] \
            || die "Slice 11A missing window title across logs: $title"
        [ "$before_id" = "$resized_id" ] && [ "$resized_id" = "$balanced_id" ] \
            || die "Slice 11A window id changed for $title: $before_id -> $resized_id -> $balanced_id"
        [ "$before_zone" = "$expected_zone" ] && [ "$resized_zone" = "$expected_zone" ] && [ "$balanced_zone" = "$expected_zone" ] \
