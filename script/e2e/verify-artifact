    urgent_offset="$(value_from_log cycle-urgent-command-offset-seconds "$timing_log")"
    calm_offset="$(value_from_log cycle-calm-command-offset-seconds "$timing_log")"
    wrap_offset="$(value_from_log cycle-wrap-command-offset-seconds "$timing_log")"
    [ -n "$urgent_offset" ] || die "Slice 19 timing log missing urgent cycle command offset"
    [ -n "$calm_offset" ] || die "Slice 19 timing log missing calm cycle command offset"
    [ -n "$wrap_offset" ] || die "Slice 19 timing log missing wrap cycle command offset"
    assert_numeric_between_inclusive "$urgent_offset" 13 24 \
        "Slice 19 urgent cycle command must happen while the first cycle caption is on screen"
    assert_numeric_between_inclusive "$calm_offset" 31 42 \
        "Slice 19 calm cycle command must happen while the second cycle caption is on screen"
    assert_numeric_between_inclusive "$wrap_offset" 49 57 \
        "Slice 19 wrap cycle command must happen while the third cycle caption is on screen"

    local title expected_zone before_id urgent_id calm_id wrap_id before_zone urgent_zone calm_zone wrap_zone
    local before_workspace urgent_workspace calm_workspace wrap_workspace
    for title in reference-style-cycle.rtf work-style-cycle.rtf comms-style-cycle.rtf; do
        case "$title" in
            reference-style-cycle.rtf) expected_zone=left ;;
            work-style-cycle.rtf) expected_zone=main ;;
            comms-style-cycle.rtf) expected_zone=right ;;
        esac
        before_id="$(field_for_title "$windows_before" "$title" id)"
        urgent_id="$(field_for_title "$windows_urgent" "$title" id)"
        calm_id="$(field_for_title "$windows_calm" "$title" id)"
        wrap_id="$(field_for_title "$windows_wrap" "$title" id)"
        before_zone="$(field_for_title "$windows_before" "$title" zone)"
        urgent_zone="$(field_for_title "$windows_urgent" "$title" zone)"
        calm_zone="$(field_for_title "$windows_calm" "$title" zone)"
        wrap_zone="$(field_for_title "$windows_wrap" "$title" zone)"
        before_workspace="$(field_for_title "$windows_before" "$title" workspace)"
        urgent_workspace="$(field_for_title "$windows_urgent" "$title" workspace)"
        calm_workspace="$(field_for_title "$windows_calm" "$title" workspace)"
        wrap_workspace="$(field_for_title "$windows_wrap" "$title" workspace)"
        [ -n "$before_id" ] && [ -n "$urgent_id" ] && [ -n "$calm_id" ] && [ -n "$wrap_id" ] \
            || die "Slice 19 missing window title across logs: $title"
        [ "$before_id" = "$urgent_id" ] && [ "$urgent_id" = "$calm_id" ] && [ "$calm_id" = "$wrap_id" ] \
            || die "Slice 19 window id changed for $title: $before_id -> $urgent_id -> $calm_id -> $wrap_id"
        [ "$before_zone" = "$expected_zone" ] && [ "$urgent_zone" = "$expected_zone" ] && [ "$calm_zone" = "$expected_zone" ] && [ "$wrap_zone" = "$expected_zone" ] \
            || die "Slice 19 zone changed for $title: $before_zone -> $urgent_zone -> $calm_zone -> $wrap_zone"
        [ -n "$before_workspace" ] && [ "$before_workspace" = "$urgent_workspace" ] && [ "$urgent_workspace" = "$calm_workspace" ] && [ "$calm_workspace" = "$wrap_workspace" ] \
            || die "Slice 19 workspace changed for $title: $before_workspace -> $urgent_workspace -> $calm_workspace -> $wrap_workspace"
    done

    grep -F "cycle-urgent-command-offset-seconds=${urgent_offset}" "$proof" >/dev/null \
        || die "Slice 19 proof does not copy urgent cycle timing"
    grep -F "cycle-calm-command-offset-seconds=${calm_offset}" "$proof" >/dev/null \
        || die "Slice 19 proof does not copy calm cycle timing"
    grep -F "cycle-wrap-command-offset-seconds=${wrap_offset}" "$proof" >/dev/null \
        || die "Slice 19 proof does not copy wrap cycle timing"
    grep -F 'Before style:' "$proof" >/dev/null \
        || die "Slice 19 proof missing before-style section"
    grep -F 'Cycle 1 urgent style:' "$proof" >/dev/null \
        || die "Slice 19 proof missing cycle 1 section"
    grep -F 'Cycle 2 calm style:' "$proof" >/dev/null \
        || die "Slice 19 proof missing cycle 2 section"
    grep -F 'Cycle 3 urgent wraparound:' "$proof" >/dev/null \
        || die "Slice 19 proof missing wraparound section"

    grep -F "Config: [[zone-styles]] urgent + calm; alt-y = 'cycle-zone-style Comms urgent calm'" "$annotation_plan" >/dev/null \
        || grep -F "Config: [[zone-styles]] urgent + calm; alt-y = cycle-zone-style" "$annotation_plan" >/dev/null \
        || die "Slice 19 annotations missing zone-styles/cycle binding config chip"
    grep -F "Run: winmux cycle-zone-style Comms urgent calm" "$annotation_plan" >/dev/null \
        || die "Slice 19 annotations missing cycle command chip"
    [ "$(grep -F -c "Run: winmux cycle-zone-style Comms urgent calm" "$annotation_plan" | tr -d ' ')" -ge 3 ] \
        || die "Slice 19 annotations must show three cycle-zone-style command beats"
    grep -F "Action: no style -> urgent #D3455B" "$annotation_plan" >/dev/null \
        || die "Slice 19 annotations missing urgent visible-state chip"
    grep -F "Action: urgent -> calm #3EA2FF" "$annotation_plan" >/dev/null \
        || die "Slice 19 annotations missing calm visible-state chip"
    grep -F "Action: calm -> urgent wraparound" "$annotation_plan" >/dev/null \
        || die "Slice 19 annotations missing wraparound visible-state chip"
    grep -F 'set-zone-style' "$annotation_plan" >/dev/null \
        && die "Slice 19 annotations must not use set-zone-style"
    awk -F '\t' '$5 == "Run: winmux cycle-zone-style Comms urgent calm" && ($1 + 0) <= 13 && ($2 + 0) >= 23 { found = 1 } END { exit(found ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 19 first cycle command caption must cover the command/action interval"
    awk -F '\t' '$5 == "Run: winmux cycle-zone-style Comms urgent calm" && ($1 + 0) <= 31 && ($2 + 0) >= 41 { found = 1 } END { exit(found ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 19 second cycle command caption must cover the command/action interval"
    awk -F '\t' '$5 == "Run: winmux cycle-zone-style Comms urgent calm" && ($1 + 0) <= 49 && ($2 + 0) >= 56 { found = 1 } END { exit(found ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 19 wrap cycle command caption must cover the command/action interval"
}

