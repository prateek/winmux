    require_exact_line_count "$resize_log" '$ winmux resize-zone Work width +10%' 1 \
        "Slice 31 resize log"
    require_no_command_variants "$resize_log" '$ winmux resize-zone' '$ winmux resize-zone Work width +10%' \
        "Slice 31 resize log"
    require_exact_line_count "$save_log" '$ winmux save-zone-layout' 1 \
        "Slice 31 save log"
    require_no_command_variants "$save_log" '$ winmux save-zone-layout' '$ winmux save-zone-layout' \
        "Slice 31 save log"
    grep -F 'Saved zone layout' "$save_log" >/dev/null \
        || die "Slice 31 save log missing saved output"
    grep -F 'Backup:' "$save_log" >/dev/null \
        || die "Slice 31 save log missing backup path"
    require_exact_line_count "$relaunch_log" '$ launchctl bootout WinMux slice service' 1 \
        "Slice 31 relaunch log"
    require_no_command_variants "$relaunch_log" '$ launchctl bootout WinMux slice service' '$ launchctl bootout WinMux slice service' \
        "Slice 31 relaunch log"
    require_exact_line_count "$relaunch_log" '$ launchctl bootstrap WinMux slice service' 1 \
        "Slice 31 relaunch log"
    require_no_command_variants "$relaunch_log" '$ launchctl bootstrap WinMux slice service' '$ launchctl bootstrap WinMux slice service' \
        "Slice 31 relaunch log"
    grep -F 'stopped=yes' "$relaunch_log" >/dev/null \
        || die "Slice 31 relaunch log does not prove WinMux stopped"
    require_slice_31_startup_trace_loaded_relaunch_state "$startup_trace"
    if grep -F 'reload-config' "$relaunch_log" "$proof" "$cli_log" "$harness_setup_log" "$harness_run_log" >/dev/null; then
        die "Slice 31 relaunch proof must not use reload-config"
    fi
    if grep -F 'resize-zone' "$relaunch_log" >/dev/null; then
        die "Slice 31 relaunch log must not contain a runtime resize after launch"
    fi
    require_exact_line_count "$cli_log" '$ winmux resize-zone Work width +10%' 1 \
        "Slice 31 aggregate CLI log"
    require_no_command_variants "$cli_log" '$ winmux resize-zone' '$ winmux resize-zone Work width +10%' \
        "Slice 31 aggregate CLI log"
    require_exact_line_count "$cli_log" '$ winmux save-zone-layout' 1 \
        "Slice 31 aggregate CLI log"
    require_no_command_variants "$cli_log" '$ winmux save-zone-layout' '$ winmux save-zone-layout' \
        "Slice 31 aggregate CLI log"
    require_exact_line_count "$cli_log" '$ launchctl bootout WinMux slice service' 1 \
        "Slice 31 aggregate CLI log"
    require_no_command_variants "$cli_log" '$ launchctl bootout WinMux slice service' '$ launchctl bootout WinMux slice service' \
        "Slice 31 aggregate CLI log"
    require_exact_line_count "$cli_log" '$ launchctl bootstrap WinMux slice service' 1 \
        "Slice 31 aggregate CLI log"
    require_no_command_variants "$cli_log" '$ launchctl bootstrap WinMux slice service' '$ launchctl bootstrap WinMux slice service' \
        "Slice 31 aggregate CLI log"

    local resize_offset save_offset quit_offset relaunch_offset list_zones_offset
    resize_offset="$(value_from_log resize-command-offset-seconds "$timing_log")"
    save_offset="$(value_from_log save-command-offset-seconds "$timing_log")"
    quit_offset="$(value_from_log quit-command-offset-seconds "$timing_log")"
    relaunch_offset="$(value_from_log relaunch-command-offset-seconds "$timing_log")"
    list_zones_offset="$(value_from_log list-zones-after-relaunch-offset-seconds "$timing_log")"
    [ -n "$resize_offset" ] || die "Slice 31 timing log missing resize command offset"
    [ -n "$save_offset" ] || die "Slice 31 timing log missing save command offset"
    [ -n "$quit_offset" ] || die "Slice 31 timing log missing quit command offset"
    [ -n "$relaunch_offset" ] || die "Slice 31 timing log missing relaunch command offset"
    [ -n "$list_zones_offset" ] || die "Slice 31 timing log missing post-relaunch list-zones offset"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Run: winmux resize-zone Work width +10%" "$resize_offset" \
        "Slice 31 resize command must happen while its command caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Run: winmux save-zone-layout" "$save_offset" \
        "Slice 31 save command must happen while its command caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Action: quit WinMux" "$quit_offset" \
        "Slice 31 quit action must happen while its quit caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Action: relaunch WinMux" "$relaunch_offset" \
        "Slice 31 relaunch action must happen while its relaunch caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Run: winmux list-zones" "$list_zones_offset" \
        "Slice 31 post-relaunch list-zones command must happen while its command caption is visible"

    local before_left before_main before_right resized_left resized_main resized_right
    local saved_left saved_main saved_right relaunched_left relaunched_main relaunched_right
    before_left="$(require_measurement_value "$measurements" before left effective)"
    before_main="$(require_measurement_value "$measurements" before main effective)"
    before_right="$(require_measurement_value "$measurements" before right effective)"
    resized_left="$(require_measurement_value "$measurements" resized left effective)"
    resized_main="$(require_measurement_value "$measurements" resized main effective)"
    resized_right="$(require_measurement_value "$measurements" resized right effective)"
    saved_left="$(require_measurement_value "$measurements" saved left effective)"
    saved_main="$(require_measurement_value "$measurements" saved main effective)"
    saved_right="$(require_measurement_value "$measurements" saved right effective)"
    relaunched_left="$(require_measurement_value "$measurements" relaunched left effective)"
    relaunched_main="$(require_measurement_value "$measurements" relaunched main effective)"
    relaunched_right="$(require_measurement_value "$measurements" relaunched right effective)"

    require_slice_31_measurements_match_zone_log "$measurements" before "$zones_before"
    require_slice_31_measurements_match_zone_log "$measurements" resized "$zones_resized"
    require_slice_31_measurements_match_zone_log "$measurements" saved "$zones_after_save"
    require_slice_31_measurements_match_zone_log "$measurements" relaunched "$zones_after_relaunch"

    assert_numeric_approximately_equal "$before_left" 0.25 0.000001 \
        "Slice 31 before Reference width must be 25%"
    assert_numeric_approximately_equal "$before_main" 0.5 0.000001 \
        "Slice 31 before Work width must be 50%"
    assert_numeric_approximately_equal "$before_right" 0.25 0.000001 \
        "Slice 31 before Comms width must be 25%"
    assert_numeric_approximately_equal "$resized_left" 0.2 0.000001 \
        "Slice 31 resized Reference width must be 20%"
    assert_numeric_approximately_equal "$resized_main" 0.6 0.000001 \
        "Slice 31 resized Work width must be 60%"
    assert_numeric_approximately_equal "$resized_right" 0.2 0.000001 \
        "Slice 31 resized Comms width must be 20%"
    assert_numeric_approximately_equal "$saved_left" "$resized_left" 0.000001 \
        "Slice 31 saved Reference effective width does not match resized width"
    assert_numeric_approximately_equal "$saved_main" "$resized_main" 0.000001 \
        "Slice 31 saved Work effective width does not match resized width"
    assert_numeric_approximately_equal "$saved_right" "$resized_right" 0.000001 \
        "Slice 31 saved Comms effective width does not match resized width"
    assert_numeric_approximately_equal "$relaunched_left" "$resized_left" 0.000001 \
        "Slice 31 relaunched Reference width does not match saved width"
    assert_numeric_approximately_equal "$relaunched_main" "$resized_main" 0.000001 \
        "Slice 31 relaunched Work width does not match saved width"
    assert_numeric_approximately_equal "$relaunched_right" "$resized_right" 0.000001 \
        "Slice 31 relaunched Comms width does not match saved width"
    assert_numeric_approximately_equal "$(zone_log_value "$zones_after_relaunch" left configured)" "$resized_left" 0.000001 \
        "Slice 31 relaunched Reference configured width does not match saved width"
    assert_numeric_approximately_equal "$(zone_log_value "$zones_after_relaunch" main configured)" "$resized_main" 0.000001 \
        "Slice 31 relaunched Work configured width does not match saved width"
    assert_numeric_approximately_equal "$(zone_log_value "$zones_after_relaunch" right configured)" "$resized_right" 0.000001 \
        "Slice 31 relaunched Comms configured width does not match saved width"
    [ "$(zone_log_value "$zones_after_relaunch" left override-state)" = configured ] \
        || die "Slice 31 relaunched Reference should use configured width, not a runtime override"
    [ "$(zone_log_value "$zones_after_relaunch" main override-state)" = configured ] \
        || die "Slice 31 relaunched Work should use configured width, not a runtime override"
    [ "$(zone_log_value "$zones_after_relaunch" right override-state)" = configured ] \
        || die "Slice 31 relaunched Comms should use configured width, not a runtime override"
    require_zone_log_empty_or_none "$zones_after_relaunch" left override \
        "Slice 31 relaunched Reference runtime override value"
    require_zone_log_empty_or_none "$zones_after_relaunch" main override \
        "Slice 31 relaunched Work runtime override value"
    require_zone_log_empty_or_none "$zones_after_relaunch" right override \
        "Slice 31 relaunched Comms runtime override value"

    local before_chip resized_chip relaunched_chip
    before_chip="$(require_measurement_value "$measurements" before main chip)"
    resized_chip="$(require_measurement_value "$measurements" resized main chip)"
    relaunched_chip="$(require_measurement_value "$measurements" relaunched main chip)"
    [ "$before_chip" = 'Reference 25% | Work 50% | Comms 25%' ] \
        || die "Slice 31 before measurement chip is wrong: $before_chip"
    [ "$resized_chip" = 'Reference 20% | Work 60% | Comms 20%' ] \
        || die "Slice 31 resized measurement chip is wrong: $resized_chip"
    [ "$relaunched_chip" = 'Reference 20% | Work 60% | Comms 20%' ] \
        || die "Slice 31 relaunched measurement chip is wrong: $relaunched_chip"

    local before_sha save_sha backup_recorded_sha backup_copy_sha backup_path
    before_sha="$(cat "$config_sha_before")"
    save_sha="$(cat "$config_sha_after_save")"
    backup_recorded_sha="$(cat "$backup_sha")"
    backup_copy_sha="$(file_sha256 "$config_backup_copy")"
    backup_path="$(cat "$backup_path_log")"
    [ -n "$backup_path" ] || die "Slice 31 backup path log is empty"
    [ "$save_sha" != "$before_sha" ] \
        || die "Slice 31 save did not change config hash"
    [ "$backup_recorded_sha" = "$before_sha" ] && [ "$backup_copy_sha" = "$before_sha" ] \
        || die "Slice 31 backup does not match original config"
    [ "$(file_sha256 "$config_before_copy")" = "$before_sha" ] \
        || die "Slice 31 original config copy hash does not match before hash"
    [ "$(file_sha256 "$config_after_copy")" = "$save_sha" ] \
        || die "Slice 31 after config copy hash does not match saved hash"

    [ "$(manifest_value "$proof_manifest" target layout-id)" = balanced ] \
        || die "Slice 31 proof manifest must record target layout id"
    [ "$(manifest_value "$proof_manifest" command resize)" = 'winmux resize-zone Work width +10%' ] \
        || die "Slice 31 proof manifest must record resize command"
    [ "$(manifest_value "$proof_manifest" command save)" = 'winmux save-zone-layout' ] \
        || die "Slice 31 proof manifest must record save command"
    [ "$(manifest_value "$proof_manifest" command relaunch)" = 'launchctl bootout/bootstrap WinMux slice service' ] \
        || die "Slice 31 proof manifest must record relaunch command"
    [ "$(manifest_value "$proof_manifest" command list-zones)" = 'winmux list-zones' ] \
        || die "Slice 31 proof manifest must record list-zones command"
    [ "$(manifest_value "$proof_manifest" timing resize-command-offset-seconds)" = "$resize_offset" ] \
        || die "Slice 31 proof manifest must copy resize command offset"
    [ "$(manifest_value "$proof_manifest" timing save-command-offset-seconds)" = "$save_offset" ] \
        || die "Slice 31 proof manifest must copy save command offset"
    [ "$(manifest_value "$proof_manifest" timing quit-command-offset-seconds)" = "$quit_offset" ] \
        || die "Slice 31 proof manifest must copy quit command offset"
    [ "$(manifest_value "$proof_manifest" timing relaunch-command-offset-seconds)" = "$relaunch_offset" ] \
        || die "Slice 31 proof manifest must copy relaunch command offset"
    [ "$(manifest_value "$proof_manifest" timing list-zones-after-relaunch-offset-seconds)" = "$list_zones_offset" ] \
        || die "Slice 31 proof manifest must copy list-zones command offset"
    [ "$(manifest_value "$proof_manifest" safety backup-path)" = "$backup_path" ] \
        || die "Slice 31 proof manifest must copy backup path"
    [ "$(manifest_value "$proof_manifest" safety backup-matches-original)" = yes ] \
        || die "Slice 31 proof manifest must record backup-matches-original=yes"
    [ "$(manifest_value "$proof_manifest" relaunch app-stopped)" = yes ] \
        || die "Slice 31 proof manifest must record app-stopped=yes"
    [ "$(manifest_value "$proof_manifest" relaunch app-restarted)" = yes ] \
        || die "Slice 31 proof manifest must record app-restarted=yes"
    [ "$(manifest_value "$proof_manifest" relaunch widths-restored)" = yes ] \
        || die "Slice 31 proof manifest must record widths-restored=yes"
    [ "$(manifest_value "$proof_manifest" relaunch no-runtime-resize-after-launch)" = yes ] \
        || die "Slice 31 proof manifest must record no-runtime-resize-after-launch=yes"
    [ "$(manifest_value "$proof_manifest" relaunch runtime-override-values-cleared)" = yes ] \
        || die "Slice 31 proof manifest must record runtime-override-values-cleared=yes"
    [ "$(manifest_value "$proof_manifest" relaunch persisted-restart-state-loaded)" = yes ] \
        || die "Slice 31 proof manifest must record persisted-restart-state-loaded=yes"
    [ "$(manifest_value "$proof_manifest" continuity documents-in-same-zones)" = yes ] \
        || die "Slice 31 proof manifest must record documents-in-same-zones=yes"
    [ "$(manifest_value "$proof_manifest" continuity workspaces-preserved)" = yes ] \
        || die "Slice 31 proof manifest must record workspaces-preserved=yes"
    [ "$(manifest_value "$proof_manifest" clean-view before-visible-textedit-window-count)" = 3 ] \
        || die "Slice 31 proof manifest must record exactly three visible TextEdit windows before resize"
    [ "$(manifest_value "$proof_manifest" clean-view before-visible-textedit-title-set)" = 'research-reference.rtf,focus-draft.rtf,team-inbox.rtf' ] \
        || die "Slice 31 proof manifest must record the exact before TextEdit title set"
    [ "$(manifest_value "$proof_manifest" clean-view relaunched-visible-textedit-window-count)" = 3 ] \
        || die "Slice 31 proof manifest must record exactly three visible TextEdit windows after relaunch"
    [ "$(manifest_value "$proof_manifest" clean-view relaunched-visible-textedit-title-set)" = 'research-reference.rtf,focus-draft.rtf,team-inbox.rtf' ] \
        || die "Slice 31 proof manifest must record the exact relaunched TextEdit title set"
    [ "$(manifest_value "$proof_manifest" measurement before)" = "$before_chip" ] \
        || die "Slice 31 proof manifest before measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" measurement resized)" = "$resized_chip" ] \
        || die "Slice 31 proof manifest resized measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" measurement relaunched)" = "$relaunched_chip" ] \
        || die "Slice 31 proof manifest relaunched measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" hash config-before)" = "$before_sha" ] \
        || die "Slice 31 proof manifest before config hash does not match copied hash"
    [ "$(manifest_value "$proof_manifest" hash config-after-save)" = "$save_sha" ] \
        || die "Slice 31 proof manifest saved config hash does not match copied hash"
    [ "$(manifest_value "$proof_manifest" hash config-backup)" = "$backup_recorded_sha" ] \
        || die "Slice 31 proof manifest backup config hash does not match copied hash"
    local zone want_before want_resized want_saved want_relaunched
    for zone in left main right; do
        case "$zone" in
            left)
                want_before="$before_left"
                want_resized="$resized_left"
                want_saved="$saved_left"
                want_relaunched="$relaunched_left"
                ;;
            main)
                want_before="$before_main"
                want_resized="$resized_main"
                want_saved="$saved_main"
                want_relaunched="$relaunched_main"
                ;;
            right)
                want_before="$before_right"
                want_resized="$resized_right"
                want_saved="$saved_right"
                want_relaunched="$relaunched_right"
                ;;
            *)
                die "Unexpected Slice 31 zone id in proof manifest loop: $zone"
                ;;
        esac
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-before "$zone")" "$want_before" 0.000001 \
            "Slice 31 proof manifest width-before/${zone} does not match measurement TSV"
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-resized "$zone")" "$want_resized" 0.000001 \
            "Slice 31 proof manifest width-resized/${zone} does not match measurement TSV"
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-saved "$zone")" "$want_saved" 0.000001 \
            "Slice 31 proof manifest width-saved/${zone} does not match measurement TSV"
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-relaunched "$zone")" "$want_relaunched" 0.000001 \
            "Slice 31 proof manifest width-relaunched/${zone} does not match measurement TSV"
    done

    local title expected_zone before_zone after_zone before_workspace after_workspace
    for title in research-reference.rtf focus-draft.rtf team-inbox.rtf; do
        case "$title" in
            research-reference.rtf) expected_zone=left ;;
            focus-draft.rtf) expected_zone=main ;;
            team-inbox.rtf) expected_zone=right ;;
            *) expected_zone= ;;
        esac
        before_zone="$(field_for_title "$windows_before" "$title" zone)"
        after_zone="$(field_for_title "$windows_after_relaunch" "$title" zone)"
        before_workspace="$(field_for_title "$windows_before" "$title" workspace)"
        after_workspace="$(field_for_title "$windows_after_relaunch" "$title" workspace)"
        [ -n "$before_zone" ] && [ -n "$after_zone" ] \
            || die "Slice 31 missing title across relaunch logs: $title"
        [ "$before_zone" = "$expected_zone" ] && [ "$after_zone" = "$expected_zone" ] \
            || die "Slice 31 zone changed for $title: $before_zone -> $after_zone"
        [ -n "$before_workspace" ] && [ "$before_workspace" = "$after_workspace" ] \
            || die "Slice 31 workspace changed for $title: $before_workspace -> $after_workspace"
    done

    for chip in \
        "Config: saved layout relaunch proof" \
        "Run: winmux resize-zone Work width +10%" \
        "Result: Work 50% -> 60%" \
        "Run: winmux save-zone-layout" \
        "Result: Reference 25% | Work 50% | Comms 25%" \
        "Action: quit WinMux" \
        "Result: WinMux sidebar absent" \
        "Action: relaunch WinMux" \
        "Result: WinMux sidebar restored" \
        "Run: winmux list-zones" \
        "Result: relaunch kept Reference 20% | Work 60% | Comms 20%"; do
        grep -F "$chip" "$annotation_plan" >/dev/null \
            || die "Slice 31 annotations missing chip: $chip"
    done
    grep -F 'Result: Reference 25% | Work 50% | Comms 25%' "$annotation_plan" >/dev/null \
        || die "Slice 31 annotations missing starting measurement result"
    grep -F 'Result: Reference 20% | Work 60% | Comms 20%' "$annotation_plan" >/dev/null \
        || die "Slice 31 annotations missing resized measurement result"

    grep -F "config-sha-before=${before_sha}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy before config hash"
    grep -F "config-sha-after-save=${save_sha}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy saved config hash"
    grep -F "config-backup-sha=${backup_recorded_sha}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy backup config hash"
    grep -F "backup-path=${backup_path}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy backup path"
    grep -F "measurement-before=${before_chip}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy before measurement chip"
    grep -F "measurement-resized=${resized_chip}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy resized measurement chip"
    grep -F "measurement-relaunched=${relaunched_chip}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy relaunched measurement chip"
    grep -F "resize-command-offset-seconds=${resize_offset}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy resize command offset"
    grep -F "save-command-offset-seconds=${save_offset}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy save command offset"
    grep -F "quit-command-offset-seconds=${quit_offset}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy quit command offset"
    grep -F "relaunch-command-offset-seconds=${relaunch_offset}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy relaunch command offset"
    grep -F "list-zones-after-relaunch-offset-seconds=${list_zones_offset}" "$proof" >/dev/null \
        || die "Slice 31 proof does not copy post-relaunch list-zones offset"
}

