require_file() {
    local path="$1"
    [ -s "$path" ] || die "Missing or empty file: $path"
}

value_from_log() {
    local key="$1"
    local path="$2"
    /usr/bin/awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$path"
}

file_sha256() {
    shasum -a 256 "$1" | awk '{ print $1 }'
}

require_no_finder_metadata() {
    local found
    found="$(find "$RUN_DIR" \( -name .DS_Store -o -name '._*' -o -name .localized -o -name 'Icon?' \) -print -quit)"
    [ -z "$found" ] || die "Artifact contains Finder metadata: $found"
    if command -v xattr >/dev/null 2>&1; then
        found="$(xattr -lr "$RUN_DIR" 2>/dev/null | /usr/bin/awk -F': ' 'NF >= 2 && $2 != "com.apple.provenance" { print $1 ": " $2; exit }')"
        [ -z "$found" ] || die "Artifact contains non-portable extended attributes: $found"
    fi
}

verify_hash_from_preflight() {
    local key="$1"
    local path="$2"
    local expected
    expected="$(value_from_log "$key" "$PREFLIGHT_LOG")"
    [ -n "$expected" ] || return 0
    require_file "$path"
    local actual
    actual="$(file_sha256 "$path")"
    [ "$actual" = "$expected" ] || die "$path hash $actual does not match preflight $key=$expected"
}

