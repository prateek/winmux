        || die "${slice_label} config missing mouse zone snap table"
    grep -F "policy = 'float-unless-snap'" "$CONFIG_PATH" >/dev/null \
        || die "${slice_label} config must start with float-unless-snap policy"
    grep -F "modifier = 'alt'" "$CONFIG_PATH" >/dev/null \
        || die "${slice_label} config missing alt modifier"
    grep -F "gesture = '${expected_gesture}'" "$CONFIG_PATH" >/dev/null \
        || die "${slice_label} config missing expected gesture ${expected_gesture}"
    grep -F "target = 'zone'" "$CONFIG_PATH" >/dev/null \
        || die "${slice_label} config missing whole-zone target"
