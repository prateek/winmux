require_slice_31_baseline_comparison() {
    local review_path="$1"
    local recording_relative_path="${recording_path#"$RUN_DIR"/}"

    /usr/bin/awk \
        -v primary_recording="$recording_path" \
        -v primary_recording_relative="$recording_relative_path" '
        function cue_compared(line, cue) {
            object = "(baseline|demo-columnar-zones|root-demo|slice 7|slice-7|product surface|product screenshot|winmux-overview|tab-groups)"
            connector = "(compared to|compared with|compared against|against|than|matches|aligns with|align with|mirrors|follows|consistent with|same as|similar to|unlike|cleaner than|clearer than|more [a-z ]+ than|less [a-z ]+ than)"
            return line ~ (cue "[^.]*" connector "[^.]*" object) ||
                line ~ (object "[^.]*" connector "[^.]*" cue)
        }
        function check(block) {
            line = tolower(block)
            return index(line, "baseline comparison") > 0 &&
                (index(block, primary_recording) > 0 ||
                 index(block, primary_recording_relative) > 0) &&
                index(line, "demo-columnar-zones.mp4") > 0 &&
                index(line, "slice-7-root-demo-20260624t042021z") > 0 &&
                (index(line, "resources/screenshots/") > 0 ||
                 index(line, "winmux-overview.png") > 0 ||
                 index(line, "tab-groups.png") > 0 ||
                 index(line, "github.com/zimengxiong/winmux") > 0 ||
                 index(line, "macoswm.com/wm/winmux") > 0 ||
                 index(line, "product surface") > 0) &&
                cue_compared(line, "clean desktop") &&
                cue_compared(line, "restrained caption") &&
                cue_compared(line, "(live window|live windows|task document|task documents)") &&
                cue_compared(line, "(command/config chip|command/config chips|command[^.]*chip|config[^.]*chip)")
        }
        {
            if (index(tolower($0), "baseline comparison") > 0) {
                in_block = 1
                block = $0
                if (check(block)) {
                    found = 1
                }
                next
            }
            if (in_block && $0 ~ /^[[:space:]]*$/) {
                if (check(block)) {
                    found = 1
                }
                in_block = 0
                block = ""
                next
            }
            if (in_block) {
                block = block " " $0
                if (check(block)) {
                    found = 1
                }
            }
        }
        END {
            if (in_block && check(block)) {
                found = 1
            }
            exit(found ? 0 : 1)
        }
    ' "$review_path" \
        || die "Slice 31 review must include a substantive Baseline comparison paragraph naming the primary recording path, demo-columnar-zones.mp4, the Slice 7 package, a product surface/screenshot, and explicit comparison claims for clean desktop, restrained captions, live windows/task documents, and command/config chips"
}

