clamp_sample_time() {
    local requested="$1"
    local duration="$2"
    awk -v requested="$requested" -v duration="$duration" 'BEGIN {
        if (duration <= 0) {
            printf "0.000"
            exit
        }
        t = requested + 0
        if (t < 0.250) {
            t = 0.250
        }
        max = duration - 0.250
        if (max < 0) {
            max = 0
        }
        if (t > max) {
            t = max
        }
        printf "%.3f", t
    }'
}

sample_recording_frame() {
    local recording="$1"
    local duration="$2"
    local requested="$3"
    local output="$4"
    local seconds
    seconds="$(clamp_sample_time "$requested" "$duration")"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -ss "$seconds" \
        -i "$recording" \
        -frames:v 1 \
        "$output"
    require_file "$output"
}

