}

require_mouse_drag_event_manifest() {
    local slice="$1"
    local manifest_path="$2"
    local slice_number="${slice#slice-}"
    local _slice event_id kind time_source _caption_key sample_label _path_kind _path_value _expected after_events
    local row_count=0
    local mouse_event_ids=()
    local before_event

    require_event_manifest_paths "$manifest_path"

    while IFS=$'\t' read -r _slice event_id kind time_source _caption_key sample_label _path_kind _path_value _expected after_events; do
        require_event_manifest_event "$manifest_path" "$event_id" "$kind"
        if [ "$sample_label" != "-" ]; then
            require_event_sample_label "$manifest_path" "$event_id" "$sample_label"
        fi
        case "$time_source" in
            mouse-*) mouse_event_ids+=("$event_id") ;;
        esac
        if [ "$after_events" != "-" ]; then
            IFS=',' read -r -a before_events <<<"$after_events"
            for before_event in "${before_events[@]}"; do
                require_event_before "$manifest_path" "$before_event" "$event_id" \
                    "Slice ${slice_number} event manifest must order ${before_event} before ${event_id}"
            done
        fi
        require_event_path_kind "$manifest_path" "$slice" "$event_id" "$_path_kind" "$_path_value"
        row_count=$((row_count + 1))
    done < <(mouse_drag_event_spec_rows "$slice")

    [ "$row_count" -gt 0 ] || die "Mouse drag event spec has no rows for $slice"
    if [ "${#mouse_event_ids[@]}" -gt 0 ]; then
        require_event_manifest_matches_mouse_events "$manifest_path" "${mouse_event_ids[@]}"
    fi
    require_mouse_snap_affordance_event_paths "$manifest_path"
}

