    grep -F "widths-before=left:${before_left},main:${before_main},right:${before_right}" "$proof" >/dev/null \
        || die "Slice 11A proof does not copy before widths from zones log"
    grep -F "widths-resized=left:${resized_left},main:${resized_main},right:${resized_right}" "$proof" >/dev/null \
