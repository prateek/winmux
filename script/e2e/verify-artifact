        || die "Slice 17 stale after bindings log must show the binding was pruned"
    [ "$(field_for_title "$windows_stale_before" 'stale-alpha-guardrail.rtf' id)" = "$stale_alpha_id" ] \
        || die "Slice 17 stale alpha id missing before prune"
    [ "$(field_for_title "$windows_stale_before" 'stale-beta-guardrail.rtf' id)" = "$stale_beta_id" ] \
        || die "Slice 17 stale beta id missing before prune"
    [ "$(field_for_title "$windows_stale_after" 'stale-alpha-guardrail.rtf' zone)" = right ] \
        || die "Slice 17 stale alpha must remain in Comms/right after prune"
    [ -z "$(field_for_title "$windows_stale_after" 'stale-beta-guardrail.rtf' id)" ] \
        || die "Slice 17 stale beta should be closed before final stale-prune proof"
    grep -F 'node-bindings=none' "$final_bindings" >/dev/null \
        || die "Slice 17 final bindings log must show no runtime node bindings"

    local escaped_offset rebind_offset disabled_offset missing_offset stale_offset final_offset
    escaped_offset="$(value_from_log escaped-command-offset-seconds "$timing_log")"
    rebind_offset="$(value_from_log rebind-command-offset-seconds "$timing_log")"
    disabled_offset="$(value_from_log disabled-command-offset-seconds "$timing_log")"
    missing_offset="$(value_from_log missing-unbind-offset-seconds "$timing_log")"
    stale_offset="$(value_from_log stale-prune-offset-seconds "$timing_log")"
    final_offset="$(value_from_log final-count-offset-seconds "$timing_log")"
    assert_numeric_between_inclusive "$escaped_offset" 8 18 \
        "Slice 17 escaped title command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$rebind_offset" 18 28 \
        "Slice 17 rebind command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$disabled_offset" 28 38 \
        "Slice 17 disabled-zone command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$missing_offset" 38 48 \
        "Slice 17 missing-unbind command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$stale_offset" 48 62 \
        "Slice 17 stale-prune command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$final_offset" 62 70 \
        "Slice 17 final count command must happen while its caption is on screen"

    for chip in \
        "Run: winmux list-zone-bindings --count" \
        "Run: winmux bind-node-to-zone --window-id \"\$ESCAPED_ID\" Comms" \
        "Run: winmux bind-node-to-zone --window-id \"\$REBIND_ID\" Reference" \
        "Run: winmux disable-zone Comms && bind-node-to-zone Comms" \
        "Run: winmux unbind-node-zone-binding --window-id \"\$UNBOUND_ID\"" \
        "Run: winmux close --window-id \"\$STALE_BETA_ID\""; do
        grep -F "$chip" "$annotation_plan" >/dev/null \
            || die "Slice 17 annotations missing chip: $chip"
    done
    grep -F 'no relaunch persistence is claimed' "$annotation_plan" >/dev/null \
        || die "Slice 17 annotations must explicitly avoid a relaunch-persistence claim"
}

