    assert_numeric_lt "$resized_right" "$before_right" "Slice 28 Comms/right width did not shrink before export"
    [ "$(zone_log_value "$zones_resized" main override-state)" = runtime ] \
        || die "Slice 28 Work/main must report runtime width override before export"
    [ "$(zone_log_value "$zones_after_export" main width)" = "$resized_main" ] \
        || die "Slice 28 export command should not change Work/main width"

    local title expected_zone before_id after_id before_zone after_zone before_workspace after_workspace
    for title in reference-export.rtf work-export.rtf comms-export.rtf; do
        case "$title" in
            reference-export.rtf) expected_zone=left ;;
            work-export.rtf) expected_zone=main ;;
