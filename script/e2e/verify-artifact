        || die "${slice_label} proof manifest missing gesture ${expected_gesture}"
    [ "$(manifest_value "$proof_manifest" drag-policy proof-mode)" = "$expected_proof_mode" ] \
        || die "${slice_label} proof manifest missing ${expected_proof_mode} mode"
    require_secondary_button_input_evidence "$proof_manifest" "$slice_label"
    [ "$(manifest_value "$proof_manifest" drag-policy negative-proof)" = "$expected_negative_proof" ] \
        || die "${slice_label} proof manifest missing ${expected_negative_proof} negative proof"
    [ "$(manifest_value "$proof_manifest" drag-policy positive-proof)" = "$expected_positive_proof" ] \
        || die "${slice_label} proof manifest missing ${expected_positive_proof} positive proof"
    [ "$(manifest_value "$proof_manifest" drag-result freeform-result)" = floating-no-snap ] \
        || die "${slice_label} proof manifest missing floating no-snap result"
    [ "$(manifest_value "$proof_manifest" drag-result freeform-after-layout)" = floating ] \
        || die "${slice_label} proof manifest missing floating layout result"
    [ "$(manifest_value "$proof_manifest" drag-result result)" = success ] \
        || die "${slice_label} proof manifest missing snap success result"
