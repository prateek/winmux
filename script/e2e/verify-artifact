}

require_drag_proof_manifest() {
    local manifest_path="$1"
    require_file "$manifest_path"

    local source_title target_zone target_name snap_target not_snap_target source_point target_point hover_seconds
    local pickup_screenshot path_screenshot hover_screenshot coordinate_policy required_frames caption_chip
    source_title="$(require_manifest_value "$manifest_path" drag-source title)"
    target_zone="$(require_manifest_value "$manifest_path" drag-target zone-id)"
    target_name="$(require_manifest_value "$manifest_path" drag-target zone-name)"
    snap_target="$(require_manifest_value "$manifest_path" drag-target snap-target)"
    not_snap_target="$(require_manifest_value "$manifest_path" drag-target not-snap-target)"
    source_point="$(require_manifest_value "$manifest_path" drag-points source)"
    target_point="$(require_manifest_value "$manifest_path" drag-points target)"
    hover_seconds="$(require_manifest_value "$manifest_path" drag-points target-hover-hold-seconds)"
    pickup_screenshot="$(require_manifest_drag_screenshot "$manifest_path" pickup)"
    path_screenshot="$(require_manifest_drag_screenshot "$manifest_path" path)"
    hover_screenshot="$(require_manifest_drag_screenshot "$manifest_path" hover)"
    coordinate_policy="$(require_manifest_value "$manifest_path" drag-points coordinate-policy)"
    required_frames="$(require_manifest_value "$manifest_path" visual-floor required-frames)"
    caption_chip="$(require_manifest_value "$manifest_path" caption chip)"

    [ -n "$source_title" ] || die "Proof manifest source title is empty"
    [ -n "$target_zone" ] || die "Proof manifest target zone is empty"
    [ -n "$target_name" ] || die "Proof manifest target zone name is empty"
    case "$snap_target" in
        zone-row|whole-zone) ;;
        *) die "Proof manifest must state snap-target=zone-row or whole-zone, got: ${snap_target:-missing}" ;;
    esac
    [ "$not_snap_target" = window-within-zone ] || die "Proof manifest must state not-snap-target=window-within-zone"
    [[ "$source_point" =~ ^[0-9]+,[0-9]+$ ]] || die "Proof manifest source point is not x,y: $source_point"
    [[ "$target_point" =~ ^[0-9]+,[0-9]+$ ]] || die "Proof manifest target point is not x,y: $target_point"
    assert_numeric_gt "$hover_seconds" "2.5" "Drag hover hold is too short to demonstrate the target affordance"
    local pickup_hash path_hash hover_hash ready_hash
    pickup_hash="$(file_sha256 "$pickup_screenshot")"
    path_hash="$(file_sha256 "$path_screenshot")"
    hover_hash="$(file_sha256 "$hover_screenshot")"
    [ "$pickup_hash" != "$path_hash" ] || die "Drag pickup and path screenshots are identical"
    [ "$path_hash" != "$hover_hash" ] || die "Drag path and hover screenshots are identical"
    [ "$pickup_hash" != "$hover_hash" ] || die "Drag pickup and hover screenshots are identical"
    local ready_screenshot
    ready_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '01-ready-*.png' | head -1)"
    if [ -s "$ready_screenshot" ]; then
        ready_hash="$(file_sha256 "$ready_screenshot")"
        [ "$pickup_hash" != "$ready_hash" ] || die "Drag pickup screenshot duplicates the ready screenshot"
        [ "$path_hash" != "$ready_hash" ] || die "Drag path screenshot duplicates the ready screenshot"
        [ "$hover_hash" != "$ready_hash" ] || die "Drag hover screenshot duplicates the ready screenshot"
    fi
    [[ "$coordinate_policy" == fixed-with-state-and-video-assertions* || "$coordinate_policy" == derived-from-list-zones* ]] \
        || die "Proof manifest must justify drag points with state/video assertions or zone-derived coordinates"
    [[ "$required_frames" == *source* && "$required_frames" == *proxy* && "$required_frames" == *highlight* && "$required_frames" == *path* ]] \
        || die "Proof manifest visual floor must require source, proxy, highlighted target, and path frames"
    if [ -s "$annotation_plan" ]; then
        grep -F "$caption_chip" "$annotation_plan" >/dev/null || die "Proof manifest caption chip is missing from annotation plan"
    fi
}

require_success_marker() {
    local path="$1"
    local label="$2"
    if is_historical_slice_3_artifact && [ "$(basename "$path")" = "slice-3-stable-identity.done" ]; then
        [ -e "$path" ] || die "Missing historical $label marker: $path"
        log "historical exception: $label marker predates result=success hardening"
        return 0
    fi
    require_file "$path"
    grep -F 'result=success' "$path" >/dev/null || die "$label marker does not contain result=success"
}

clamp_sample_time() {
    local requested="$1"
    local duration="$2"
    awk -v requested="$requested" -v duration="$duration" 'BEGIN {
        if (duration <= 0) {
            printf "0.000"
            exit
        }
        t = requested + 0
        if (t < 0.250) {
            t = 0.250
        }
        max = duration - 0.250
        if (max < 0) {
            max = 0
        }
        if (t > max) {
            t = max
        }
        printf "%.3f", t
    }'
}

sample_recording_frame() {
    local recording="$1"
    local duration="$2"
    local requested="$3"
    local output="$4"
    local seconds
    seconds="$(clamp_sample_time "$requested" "$duration")"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -ss "$seconds" \
        -i "$recording" \
        -frames:v 1 \
        "$output"
    require_file "$output"
}

event_contact_sheet_image_name() {
    local index="$1"
    local label="$2"
    local safe_label
    safe_label="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9_.-' '-' | sed 's/^-//; s/-$//; s/^$/event/')"
    printf '%02d-%s.png\n' "$index" "$(printf '%s' "$safe_label" | cut -c1-96)"
}

append_event_contact_sheet_image() {
    local tmp_dir="$1"
    local index="$2"
    local label="$3"
    local relative_path="$4"
    case "$relative_path" in
        ""|-|/*|*../*) return 0 ;;
    esac

    local source_path="${RUN_DIR}/${relative_path}"
    [ -s "$source_path" ] || die "Event contact sheet source is missing: $relative_path"
    local output_path
    output_path="${tmp_dir}/$(event_contact_sheet_image_name "$index" "$label")"
    magick "$source_path" -resize '720x405>' "$output_path"
    require_file "$output_path"
}

generate_event_manifest_contact_sheet() {
    local name="$1"
    local manifest_path="${LOGS_DIR}/${name}.event-manifest.tsv"
    [ -s "$manifest_path" ] || return 0
    command -v magick >/dev/null 2>&1 || die "Event manifest contact sheet requires ImageMagick: magick"

    local contact_sheet="${SCREENSHOTS_DIR}/${name}.event-contact-sheet.jpg"
    local tmp_dir="${SCREENSHOTS_DIR}/${name}.event-contact-sheet.tmp"
    rm -rf "$tmp_dir"
    mkdir -p "$tmp_dir"

    local index=0 event_id kind seconds caption_label sample_label relative_path expected
    while IFS=$'\t' read -r event_id kind seconds caption_label sample_label relative_path expected; do
        case "${event_id:-}" in
            ""|\#*) continue ;;
        esac
        case "${relative_path:-}" in
            ""|-) continue ;;
        esac
        index=$((index + 1))
        append_event_contact_sheet_image "$tmp_dir" "$index" "${event_id}-${sample_label}" "$relative_path"
    done <"$manifest_path"

    local overlay_manifest="${LOGS_DIR}/${name}.overlay-sentinel.tsv"
    if [ -s "$overlay_manifest" ]; then
        local label value _minimum overlay_path _note
        while IFS=$'\t' read -r label value _minimum overlay_path _note; do
            case "${label:-}" in
                ""|\#*) continue ;;
            esac
            case "${overlay_path:-}" in
                screenshots/*.png)
                    index=$((index + 1))
                    append_event_contact_sheet_image "$tmp_dir" "$index" "sentinel-${label}" "$overlay_path"
                    ;;
            esac
        done <"$overlay_manifest"
    fi

    local images=()
    mapfile -t images < <(find "$tmp_dir" -maxdepth 1 -type f -name '*.png' | sort)
    [ "${#images[@]}" -gt 0 ] || die "Event manifest contact sheet has no image rows: $manifest_path"
    local label_font="${WINMUX_E2E_EVENT_CONTACT_SHEET_FONT:-/System/Library/Fonts/Supplemental/Arial.ttf}"
    [ -f "$label_font" ] || label_font="/System/Library/Fonts/Helvetica.ttc"
    magick montage \
        -font "$label_font" \
        -pointsize 22 \
        -label '%t' \
        "${images[@]}" \
        -thumbnail '720x405>' \
        -geometry '720x405+16+48' \
        -tile 2x \
        -background '#F4F2ED' \
        -fill '#101820' \
        "$contact_sheet"
    require_file "$contact_sheet"
    rm -rf "$tmp_dir"
}

generate_recording_samples() {
    local recording="$1"
    local name="$2"
    local duration="$3"
    local samples_dir="${SCREENSHOTS_DIR}/${name}.samples"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local contact_sheet="${SCREENSHOTS_DIR}/${name}.contact-sheet.jpg"

    rm -rf "$samples_dir"
    mkdir -p "$samples_dir"

    sample_recording_frame "$recording" "$duration" 0.500 "${samples_dir}/standard-00-start.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.10 }')" "${samples_dir}/standard-01-10pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.25 }')" "${samples_dir}/standard-02-25pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.50 }')" "${samples_dir}/standard-03-50pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.75 }')" "${samples_dir}/standard-04-75pct.png"
    sample_recording_frame "$recording" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d - 1.0 }')" "${samples_dir}/standard-05-near-end.png"

    if [ -s "$captions_path" ]; then
        local caption_index=0
        local start_seconds
        local end_seconds
        while IFS=$'\t' read -r start_seconds end_seconds; do
            caption_index=$((caption_index + 1))
            local caption_label
            caption_label="$(printf '%02d' "$caption_index")"
            local sample_seconds
            sample_seconds="$(awk -v start="$start_seconds" -v end="$end_seconds" 'BEGIN {
                midpoint = (start + end) / 2
                offset = start + 0.500
                sample = offset
                if (midpoint > offset) {
                    sample = midpoint
                }
                printf "%.3f", sample
            }')"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$sample_seconds" \
                "${samples_dir}/caption-${caption_label}.png"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start - 0.500 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-before.png"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start + 0.100 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-start.png"
            sample_recording_frame \
                "$recording" \
                "$duration" \
                "$(awk -v end="$end_seconds" 'BEGIN { printf "%.3f", end - 0.100 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-end.png"
        done < <(awk -F '\t' '$0 != "" && $1 !~ /^#/ { print $1 "\t" $2 }' "$captions_path")
    fi

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -framerate 1 \
        -pattern_type glob \
        -i "${samples_dir}/standard-*.png" \
        -vf "scale=860:-1,tile=3x2" \
        -frames:v 1 \
        "$contact_sheet"
    require_file "$contact_sheet"
    generate_event_manifest_contact_sheet "$name"
}

ensure_recording_samples() {
    local recording="$1"
    local name="$2"
    local duration="$3"
    local samples_dir="${SCREENSHOTS_DIR}/${name}.samples"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local contact_sheet="${SCREENSHOTS_DIR}/${name}.contact-sheet.jpg"
    local standard_count=0
    local caption_count=0
    local boundary_count=0
    local caption_rows=0
    local stale_count=0

    if [ -d "$samples_dir" ]; then
        standard_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'standard-*.png' | wc -l | tr -d ' ')"
        caption_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9].png' | wc -l | tr -d ' ')"
        boundary_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9]-boundary-*.png' | wc -l | tr -d ' ')"
        local sample_file
        while IFS= read -r sample_file; do
            [ -n "$sample_file" ] || continue
            if ! is_fresh_derived_file "$sample_file" "$recording"; then
                stale_count=$((stale_count + 1))
            fi
        done < <(find "$samples_dir" -maxdepth 1 -type f -name '*.png')
    fi
    if [ -s "$captions_path" ]; then
        caption_rows="$(awk -F '\t' '$0 != "" && $1 !~ /^#/ { count++ } END { print count + 0 }' "$captions_path")"
    fi

    if [ -s "$contact_sheet" ] && ! is_fresh_derived_file "$contact_sheet" "$recording"; then
        stale_count=$((stale_count + 1))
    fi
    local event_manifest
    event_manifest="$(event_manifest_path)"
    local event_contact_sheet
    event_contact_sheet="$(event_contact_sheet_path)"
    if [ -s "$event_manifest" ]; then
        if [ ! -s "$event_contact_sheet" ] || ! is_fresh_derived_file "$event_contact_sheet" "$event_manifest"; then
            stale_count=$((stale_count + 1))
        fi
    fi

    if [ "$standard_count" -lt 6 ] || [ "$caption_count" -lt "$caption_rows" ] || [ "$boundary_count" -lt $((caption_rows * 3)) ] || [ ! -s "$contact_sheet" ] || [ "$stale_count" -gt 0 ]; then
        [ "$CHECK_ONLY" != "1" ] || die "Recording samples/contact sheet are missing or stale in --check-only mode: $samples_dir"
        generate_recording_samples "$recording" "$name" "$duration"
    fi

    standard_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'standard-*.png' | wc -l | tr -d ' ')"
    [ "$standard_count" -ge 6 ] || die "Recording samples missing standard timeline frames"
    if [ -s "$captions_path" ]; then
        caption_rows="$(awk -F '\t' '$0 != "" && $1 !~ /^#/ { count++ } END { print count + 0 }' "$captions_path")"
        caption_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9].png' | wc -l | tr -d ' ')"
        boundary_count="$(find "$samples_dir" -maxdepth 1 -type f -name 'caption-[0-9][0-9]-boundary-*.png' | wc -l | tr -d ' ')"
        [ "$caption_count" -ge "$caption_rows" ] || die "Recording samples missing caption/action frames"
        [ "$boundary_count" -ge $((caption_rows * 3)) ] || die "Recording samples missing caption boundary frames"
    fi
    require_file "$contact_sheet"
    require_fresh_derived_file "$contact_sheet" "$recording" "Contact sheet"
    if [ -s "$event_manifest" ]; then
        require_file "$event_contact_sheet"
        require_fresh_derived_file "$event_contact_sheet" "$event_manifest" "Event contact sheet"
    fi
}

caption_tail_manifest_value() {
    local path="$1"
    local key="$2"
    /usr/bin/awk -F'\t' -v key="$key" '$1 == key { print $2; exit }' "$path"
}

require_caption_tail_manifest() {
    local name="$1"
    local duration="$2"
    local manifest_path="${LOGS_DIR}/${name}.caption-tail.tsv"
    local required
    required="$(value_from_log caption_tail_policy_required "$PREFLIGHT_LOG")"
    [ "$required" = "1" ] || [ -s "$manifest_path" ] || return 0

    require_file "$manifest_path"
    require_fresh_derived_file "$manifest_path" "$annotation_plan" "Caption tail manifest"
    local manifest_duration last_end tail max_tail intentional reason
    manifest_duration="$(caption_tail_manifest_value "$manifest_path" duration-seconds)"
    last_end="$(caption_tail_manifest_value "$manifest_path" last-caption-end-seconds)"
    tail="$(caption_tail_manifest_value "$manifest_path" tail-seconds)"
    max_tail="$(caption_tail_manifest_value "$manifest_path" max-tail-seconds)"
    intentional="$(caption_tail_manifest_value "$manifest_path" intentional-uncaptioned-tail)"
    reason="$(caption_tail_manifest_value "$manifest_path" reason)"
    [[ "$manifest_duration" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail manifest duration is not numeric"
    [[ "$last_end" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail manifest last caption end is not numeric"
    [[ "$tail" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail manifest tail is not numeric"
    [[ "$max_tail" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail manifest max tail is not numeric"
    awk -v manifest_duration="$manifest_duration" -v duration="$duration" 'BEGIN {
        delta = manifest_duration - duration
        if (delta < 0) delta = -delta
        exit(delta <= 0.500 ? 0 : 1)
    }' || die "Caption tail manifest duration does not match recording duration"
    if awk -v tail="$tail" -v max_tail="$max_tail" 'BEGIN { exit(tail + 0 > max_tail + 0 ? 0 : 1) }'; then
        [ "$intentional" = "yes" ] || die "Annotated recording has ${tail}s uncaptained tail without intentional allowance"
        [ -n "$reason" ] || die "Intentional uncaptained tail must include a reason"
    fi
}

field_for_title() {
    local path="$1"
    local title="$2"
    local field="$3"
    /usr/bin/awk -F'|' -v title="$title" -v field="$field" '$2 == title {
        if (field == "id") {
            print $1
            exit
        }
        prefix = field "="
        for (i = 1; i <= NF; i++) {
            if (index($i, prefix) == 1) {
                print substr($i, length(prefix) + 1)
                exit
            }
        }
    }' "$path"
}

