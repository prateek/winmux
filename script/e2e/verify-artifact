        || die "Slice 11C communications command caption must cover the command/action interval"
}

require_mouse_snap_overlay_sentinel() {
    local manifest_path="$1"
    require_file "$manifest_path"

    sentinel_value() {
        local label="$1"
        local column="$2"
        /usr/bin/awk -F'\t' -v label="$label" -v column="$column" '$1 == label { print $column; exit }' "$manifest_path"
    }

    local rmse minimum target_semantics freeform_crop snap_crop target_label target_label_crop crop_geometry
    rmse="$(sentinel_value overlay-rmse-normalized 2)"
    minimum="$(sentinel_value overlay-rmse-normalized 3)"
    target_semantics="$(sentinel_value target-semantics 2)"
    freeform_crop="$(sentinel_value freeform-target-zone-crop 4)"
    snap_crop="$(sentinel_value snap-target-zone-crop 4)"
    target_label="$(sentinel_value target-label 2)"
    target_label_crop="$(sentinel_value target-label 4)"
    crop_geometry="$(sentinel_value target-zone-crop 2)"

    [ -n "$rmse" ] || die "Mouse snap overlay sentinel missing overlay-rmse-normalized value"
    [ -n "$minimum" ] || die "Mouse snap overlay sentinel missing overlay-rmse-normalized minimum"
    [ "$target_semantics" = whole-zone ] \
        || die "Mouse snap overlay sentinel must declare target-semantics=whole-zone"
    [ "$target_label" = "WHOLE ZONE TARGET: COMMS" ] \
        || die "Mouse snap overlay sentinel must provide a readable whole-zone target label"
    [ -n "$crop_geometry" ] || die "Mouse snap overlay sentinel missing target-zone crop geometry"
    case "$freeform_crop" in
        /*|*../*) die "Mouse snap freeform crop path must be run-relative: $freeform_crop" ;;
    esac
    case "$snap_crop" in
        /*|*../*) die "Mouse snap snap crop path must be run-relative: $snap_crop" ;;
    esac
    case "$target_label_crop" in
        screenshots/*.overlay-sentinel/*.png) ;;
        /*|*../*) die "Mouse snap target label crop path must be run-relative: $target_label_crop" ;;
        *) die "Mouse snap overlay sentinel missing labeled target crop path" ;;
    esac
    require_file "${RUN_DIR}/${freeform_crop}"
    require_file "${RUN_DIR}/${snap_crop}"
    require_file "${RUN_DIR}/${target_label_crop}"

    local crop_size expected_dimensions freeform_dimensions snap_dimensions target_label_dimensions
    crop_size="$(printf '%s\n' "$crop_geometry" | /usr/bin/sed -n 's/^\([0-9][0-9]*\)x\([0-9][0-9]*\)+[0-9][0-9]*+[0-9][0-9]*$/\1 \2/p')"
    [ -n "$crop_size" ] || die "Mouse snap overlay sentinel has invalid crop geometry: $crop_geometry"
    # shellcheck disable=SC2086
    set -- $crop_size
    expected_dimensions="${1}x${2}"
    freeform_dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${freeform_crop}")" \
        || die "Mouse snap freeform crop is not readable image media: ${RUN_DIR}/${freeform_crop}"
    snap_dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${snap_crop}")" \
        || die "Mouse snap snap crop is not readable image media: ${RUN_DIR}/${snap_crop}"
    target_label_dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${target_label_crop}")" \
        || die "Mouse snap target label crop is not readable image media: ${RUN_DIR}/${target_label_crop}"
    [ "$freeform_dimensions" = "$expected_dimensions" ] \
        || die "Mouse snap freeform crop dimensions ${freeform_dimensions} do not match ${expected_dimensions}"
    [ "$snap_dimensions" = "$expected_dimensions" ] \
        || die "Mouse snap snap crop dimensions ${snap_dimensions} do not match ${expected_dimensions}"
    [ "$target_label_dimensions" = "$expected_dimensions" ] \
        || die "Mouse snap target label crop dimensions ${target_label_dimensions} do not match ${expected_dimensions}"

    local slice_prefix source_freeform source_snap
    case "$recording_name" in
        slice-12-*) slice_prefix="slice-12" ;;
        slice-16-*) slice_prefix="slice-16" ;;
        slice-20-*) slice_prefix="slice-20" ;;
        slice-22-*) slice_prefix="slice-22" ;;
        *) slice_prefix="" ;;
    esac
    if [ -n "$slice_prefix" ]; then
