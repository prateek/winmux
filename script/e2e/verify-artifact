require_slice_31_measurement_table() {
    local measurements_path="$1"
    require_file "$measurements_path"
    /usr/bin/awk -F'\t' '
        BEGIN {
            expected_header = "phase\tzone-id\tzone-name\tconfigured\teffective\tpixel-width\tchip"
            split("before resized saved relaunched", phases, " ")
            split("left main right", zones, " ")
            zone_name["left"] = "Reference"
            zone_name["main"] = "Work"
            zone_name["right"] = "Comms"
            phase_chip["before"] = "Reference 25% | Work 50% | Comms 25%"
            phase_chip["resized"] = "Reference 20% | Work 60% | Comms 20%"
            phase_chip["saved"] = "Reference 20% | Work 60% | Comms 20%"
            phase_chip["relaunched"] = "Reference 20% | Work 60% | Comms 20%"
            for (phase_index in phases) {
                for (zone_index in zones) {
                    expected[phases[phase_index] SUBSEP zones[zone_index]] = 1
                }
            }
        }
        NR == 1 {
            if ($0 != expected_header) {
                printf("Slice 31 measurement header mismatch: %s\n", $0) > "/dev/stderr"
                invalid = 1
            }
            next
        }
        $0 == "" {
            printf("Slice 31 measurement TSV contains a blank row\n") > "/dev/stderr"
            invalid = 1
            next
        }
        NF != 7 {
            printf("Slice 31 measurement row has %d fields, expected 7: %s\n", NF, $0) > "/dev/stderr"
            invalid = 1
            next
        }
        {
            key = $1 SUBSEP $2
            if (!(key in expected)) {
                printf("Slice 31 measurement row has unexpected phase/zone: %s/%s\n", $1, $2) > "/dev/stderr"
                invalid = 1
            }
            if (++seen[key] > 1) {
                printf("Slice 31 measurement row is duplicated: %s/%s\n", $1, $2) > "/dev/stderr"
                invalid = 1
            }
            if ($3 != zone_name[$2]) {
                printf("Slice 31 measurement row has wrong zone name for %s: %s\n", $2, $3) > "/dev/stderr"
                invalid = 1
            }
            if ($7 != phase_chip[$1]) {
                printf("Slice 31 measurement row has wrong chip for %s/%s: %s\n", $1, $2, $7) > "/dev/stderr"
                invalid = 1
            }
            for (i = 4; i <= 6; i++) {
                if ($i !~ /^[0-9]+([.][0-9]+)?$/) {
                    printf("Slice 31 measurement numeric field %d is invalid in %s/%s: %s\n", i, $1, $2, $i) > "/dev/stderr"
                    invalid = 1
                }
            }
            row_count++
        }
        END {
            if (NR == 0) {
                printf("Slice 31 measurement TSV is empty\n") > "/dev/stderr"
                invalid = 1
            }
            if (row_count != 12) {
                printf("Slice 31 measurement TSV has %d data rows, expected 12\n", row_count) > "/dev/stderr"
                invalid = 1
            }
            for (key in expected) {
                if (!(key in seen)) {
                    split(key, parts, SUBSEP)
                    printf("Slice 31 measurement TSV missing row: %s/%s\n", parts[1], parts[2]) > "/dev/stderr"
                    invalid = 1
                }
            }
            exit(invalid ? 1 : 0)
        }
    ' "$measurements_path" || die "Slice 31 measurement TSV is malformed: $measurements_path"
}

