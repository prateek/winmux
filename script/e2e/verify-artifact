                ;;
        esac
    done
}

require_edge_crop_manifest() {
    local manifest_path="$1"
    require_file "$manifest_path"
    require_fresh_derived_file "$manifest_path" "${recording_path:-}" "Edge crop manifest"

    local row_count=0
    local label relative_path _description dimensions
    while IFS=$'\t' read -r label relative_path _description; do
        case "${label:-}" in
            ""|\#*) continue ;;
        esac
        [ -n "${relative_path:-}" ] || die "Edge crop manifest row is missing a path: $manifest_path"
        case "$relative_path" in
            /*|*../*) die "Edge crop path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_file "${RUN_DIR}/${relative_path}"
        require_fresh_derived_file "${RUN_DIR}/${relative_path}" "${recording_path:-}" "Edge crop"
        dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${relative_path}")" \
            || die "Edge crop is not readable image media: ${RUN_DIR}/${relative_path}"
        [ -n "$dimensions" ] || die "Edge crop has no readable dimensions: ${RUN_DIR}/${relative_path}"
        row_count=$((row_count + 1))
    done <"$manifest_path"

    [ "$row_count" -gt 0 ] || die "Edge crop manifest has no crop rows: $manifest_path"
}

require_review_freshness() {
