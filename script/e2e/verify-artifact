    grep -F "Using zone availability 'focus-only' on monitor 1" "$focus_log" >/dev/null \
        || die "Slice 11C focus-only log missing success output"
    grep -F '$ winmux use-zone-availability communications' "$communications_log" >/dev/null \
        || die "Slice 11C communications log missing exact command"
    grep -F "Using zone availability 'communications' on monitor 1" "$communications_log" >/dev/null \
        || die "Slice 11C communications log missing success output"

    [ "$(field_for_title "$windows_before" 'reference-availability-set.rtf' zone)" = left ] \
        || die "Slice 11C before log missing Reference document in left zone"
    [ "$(field_for_title "$windows_before" 'work-availability-set.rtf' zone)" = main ] \
        || die "Slice 11C before log missing Work document in main zone"
    [ "$(field_for_title "$windows_before" 'comms-availability-set.rtf' zone)" = right ] \
        || die "Slice 11C before log missing Comms document in right zone"
    [ "$(field_for_title "$windows_focus" 'work-availability-set.rtf' zone)" = main ] \
        || die "Slice 11C focus-only log missing Work document in main zone"
    [ -z "$(field_for_title "$windows_focus" 'reference-availability-set.rtf' id)" ] \
        || die "Slice 11C focus-only log still contains Reference document"
    [ -z "$(field_for_title "$windows_focus" 'comms-availability-set.rtf' id)" ] \
