    require_file "$before_bindings"
    require_file "$after_bindings"
    require_file "$before_zones"
    require_file "$after_zones"
    require_file "$window_setup"
    require_file "$before_windows"
    require_file "$after_windows"
    require_file "$stack_log"
    require_file "$bind_log"
    require_file "$timing_log"
    require_file "$state_file"
