            if (index(line, phase_value) > 0) {
                in_phase_block = 1
            } else if (in_phase_block && line ~ /^[[:space:]]*$/) {
                in_phase_block = 0
            }
            if (!in_phase_block) {
                previous_line = line
                next
            }
            joined_line = previous_line " " line
            if (index(line, "did not mutate") > 0 ||
                (index(previous_line, "did not") > 0 && index(line, "mutate proof state") > 0) ||
                index(line, "did not change proof state") > 0 ||
                index(line, "no proof-state change") > 0 ||
                index(line, "no state mutation") > 0 ||
                index(line, "non-stateful") > 0 ||
                index(line, "stateless") > 0 ||
                index(line, "re-recorded after") > 0 ||
                index(line, "rerecorded after") > 0 ||
                index(line, "re recorded after") > 0 ||
                index(line, "re-recorded the slice") > 0 ||
                index(line, "re-recorded artifact") > 0 ||
                index(joined_line, "did not mutate") > 0 ||
                index(joined_line, "did not change proof state") > 0 ||
                index(joined_line, "no proof-state change") > 0 ||
                index(joined_line, "no state mutation") > 0 ||
                index(joined_line, "non-stateful") > 0 ||
                index(joined_line, "stateless") > 0 ||
                index(joined_line, "re-recorded after") > 0 ||
                index(joined_line, "rerecorded after") > 0 ||
                index(joined_line, "re recorded after") > 0 ||
                index(joined_line, "re-recorded the slice") > 0 ||
                index(joined_line, "re-recorded artifact") > 0) {
                found = 1
            }
            previous_line = line
        }
        END { exit(found ? 0 : 1) }
    ' "$review_path"
}

review_mentions_retry_mutation_metadata() {
    local review_path="$1"
    local phase="$2"
    local mutation_started="$3"
    local first_mutation_line="$4"

    [ -n "$mutation_started" ] || return 0
    [ "$mutation_started" != "-" ] || return 0

    grep -F "mutation_started=${mutation_started}" "$review_path" >/dev/null \
        || grep -F "mutation started: ${mutation_started}" "$review_path" >/dev/null \
        || die "Review does not cite mutation_started for post-recording retry ${phase}: ${mutation_started}"

    [ -n "$first_mutation_line" ] || return 0
    [ "$first_mutation_line" != "-" ] || return 0
    grep -F "first_mutation_line=${first_mutation_line}" "$review_path" >/dev/null \
        || grep -F "line ${first_mutation_line}" "$review_path" >/dev/null \
        || die "Review does not cite first mutation line for post-recording retry ${phase}: ${first_mutation_line}"
}

require_review_declares_no_context() {
    local review_path="$1"
    grep -Eiq 'fork_context=false|no-context posture|no chat history|without chat history|no prior (implementation )?(conversation|context)' "$review_path" \
        || die "Review does not declare no-context/no-chat-history posture"
}

require_review_mentions_post_recording_retries() {
    local review_path="$1"
    local summary_path="$2"
    [ -s "$summary_path" ] || return 0

    local phase log_path failures final_result before_recording attempt_statuses mutation_started first_mutation_line
    while IFS= read -r phase; do
        case "${phase:-}" in
            ""|\#*) continue ;;
        esac
        log_path="$(transport_summary_value "$summary_path" "$phase" log)"
        failures="$(transport_summary_value "$summary_path" "$phase" failures)"
        final_result="$(transport_summary_value "$summary_path" "$phase" final_result)"
        before_recording="$(transport_summary_value "$summary_path" "$phase" before_recording)"
        attempt_statuses="$(transport_summary_value "$summary_path" "$phase" attempt_statuses || true)"
        mutation_started="$(transport_summary_value "$summary_path" "$phase" mutation_started || true)"
        first_mutation_line="$(transport_summary_value "$summary_path" "$phase" first_mutation_line || true)"
        [ -n "$log_path" ] || die "Retry summary missing log path for phase: $phase"
        [ -n "$failures" ] || die "Retry summary missing failures for phase: $phase"
        [ -n "$final_result" ] || die "Retry summary missing final result for phase: $phase"
        [ -n "$before_recording" ] || die "Retry summary missing before-recording flag for phase: $phase"
        [ "$before_recording" = "no" ] || continue
        [[ "${failures:-0}" =~ ^[0-9]+$ ]] || die "Retry summary has non-numeric failures for ${phase}: ${failures}"
        [ "$failures" -gt 0 ] || continue
        [ -n "$attempt_statuses" ] && [ "$attempt_statuses" != "-" ] \
            || die "Retry summary missing attempt statuses for failed post-recording phase: $phase"

        grep -F "$phase" "$review_path" >/dev/null \
            || die "Review does not cite post-recording retry phase: $phase"
        grep -F "$log_path" "$review_path" >/dev/null \
            || die "Review does not cite post-recording retry log path for ${phase}: $log_path"
        grep -F "before_recording=no" "$review_path" >/dev/null \
            || grep -F "before recording: no" "$review_path" >/dev/null \
            || grep -F "after recording started" "$review_path" >/dev/null \
            || die "Review does not state that ${phase} retried after recording started"
        grep -F "$final_result" "$review_path" >/dev/null \
            || die "Review does not cite final result for post-recording retry ${phase}: $final_result"
        grep -F "$attempt_statuses" "$review_path" >/dev/null \
            || die "Review does not cite attempt statuses for post-recording retry ${phase}: $attempt_statuses"
        review_mentions_retry_mutation_metadata "$review_path" "$phase" "$mutation_started" "$first_mutation_line"
        review_mentions_retry_product_action_decision "$review_path" "$phase" \
            || die "Review does not decide whether ${phase} happened before the first visible product action"
        review_mentions_retry_mutation_decision "$review_path" "$phase" \
            || die "Review does not state mutation, re-record, or non-stateful applicability for post-recording retry ${phase}"
    done < <(transport_summary_phases "$summary_path")
}

reviewer_attempt_status_requires_citation() {
    local status
    status="$(printf '%s\n' "$1" | /usr/bin/tr '[:upper:]' '[:lower:]')"
    case "$status" in
        clean|pass|passed|success|accepted) return 1 ;;
        *) return 0 ;;
    esac
}

require_review_mentions_reviewer_attempts() {
    local review_path="$1"
    local ledger_path="$2"
    [ -s "$ledger_path" ] || return 0

    /usr/bin/awk -F'\t' 'NR == 1 { exit($0 == "# role\tstarted_at\tfinished_at\tstatus\toutput_path\treplacement_reason" ? 0 : 1) }' "$ledger_path" \
        || die "Reviewer attempt ledger has unexpected header: $ledger_path"

    local ledger_relative="${ledger_path#"$RUN_DIR"/}"
    local role _started_at _finished_at status output_path replacement_reason
    local require_any=0
    # shellcheck disable=SC2094
    while IFS=$'\t' read -r role _started_at _finished_at status output_path replacement_reason; do
        case "${role:-}" in
            ""|\#*) continue ;;
        esac
        if ! reviewer_attempt_status_requires_citation "$status"; then
            continue
        fi
        require_any=1
        grep -F "$ledger_path" "$review_path" >/dev/null \
            || grep -F "$ledger_relative" "$review_path" >/dev/null \
            || die "Review must cite reviewer attempt ledger path: $ledger_relative"
        grep -F "$role" "$review_path" >/dev/null \
            || die "Review must cite reviewer attempt role: $role"
        grep -F "$status" "$review_path" >/dev/null \
            || die "Review must cite reviewer attempt status for ${role}: $status"
        if [ -n "${output_path:-}" ] && [ "$output_path" != "-" ]; then
            grep -F "$output_path" "$review_path" >/dev/null \
                || die "Review must cite reviewer attempt output path for ${role}: $output_path"
        fi
        if [ -n "${replacement_reason:-}" ] && [ "$replacement_reason" != "-" ]; then
            grep -F "$replacement_reason" "$review_path" >/dev/null \
                || die "Review must cite reviewer attempt replacement reason for ${role}: $replacement_reason"
        fi
    done <"$ledger_path"

    [ "$require_any" = "1" ] || return 0
}

review_is_accepted() {
    local review_path="$1"
    [ -s "$review_path" ] || return 1
    local first_line last_line
    first_line="$(/usr/bin/awk 'NF { print; exit }' "$review_path")"
    last_line="$(tail -n 1 "$review_path")"
    case "$first_line" in
        PASS:*|PASS_WITH_NOTES:*) ;;
        *) return 1 ;;
    esac
    [ "$last_line" = "next slice allowed: yes" ]
}

