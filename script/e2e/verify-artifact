annotation_expected_chips() {
    local plan_path="$1"
    /usr/bin/awk -F'\t' '
        $0 == "" || $1 ~ /^#/ { next }
        {
            for (i = 5; i <= NF; i++) {
                if ($i != "") {
                    print $i
                }
            }
        }
    ' "$plan_path"
}

require_expected_caption_chips_exact() {
    local expected_path="$1"
    local plan_path="$2"
    require_file "$expected_path"
    require_file "$plan_path"
    require_fresh_derived_file "$expected_path" "$plan_path" "Expected caption chips"

    local derived_path
    derived_path="$(mktemp "${TMPDIR:-/tmp}/winmux-expected-chips.XXXXXX")"
    annotation_expected_chips "$plan_path" >"$derived_path"
    if ! cmp -s "$derived_path" "$expected_path"; then
        diff -u "$derived_path" "$expected_path" >&2 || true
        rm -f "$derived_path"
        die "Expected caption chips must exactly match annotation TSV command/config/action/result fields"
    fi
    rm -f "$derived_path"
}

require_demo_cut_sidecar_pair() {
    local name="$1"
    local demo_path="${RECORDINGS_DIR}/${name}.demo.mov"
    local manifest_path="${LOGS_DIR}/${name}.demo-cut.tsv"
    local demo_exists=0
    local manifest_exists=0

    [ ! -s "$demo_path" ] || demo_exists=1
    [ ! -s "$manifest_path" ] || manifest_exists=1
    [ "$demo_exists" = "$manifest_exists" ] \
        || die "Demo cut sidecar is incomplete; expected both ${demo_path} and ${manifest_path} or neither"
}

event_manifest_path() {
    printf '%s/%s.event-manifest.tsv\n' "$LOGS_DIR" "$recording_name"
}

event_contact_sheet_path() {
    printf '%s/%s.event-contact-sheet.jpg\n' "$SCREENSHOTS_DIR" "$recording_name"
}

event_manifest_value() {
    local manifest_path="$1"
    local event_id="$2"
    local field="$3"
    /usr/bin/awk -F'\t' -v event_id="$event_id" -v field="$field" '
        BEGIN {
            column["kind"] = 2
            column["seconds"] = 3
            column["caption-label"] = 4
            column["sample-label"] = 5
            column["path"] = 6
            column["expected"] = 7
        }
        $0 == "" || $1 ~ /^#/ { next }
        $1 == event_id && column[field] {
            print $column[field]
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$manifest_path"
}

require_event_manifest_value() {
    local manifest_path="$1"
    local event_id="$2"
    local field="$3"
    local value
    value="$(event_manifest_value "$manifest_path" "$event_id" "$field")" \
        || die "Event manifest missing ${field} for ${event_id}: $manifest_path"
    [ -n "$value" ] || die "Event manifest has empty ${field} for ${event_id}: $manifest_path"
    printf '%s\n' "$value"
}

require_event_manifest_event() {
    local manifest_path="$1"
    local event_id="$2"
    local kind="$3"
    local actual_kind seconds
    actual_kind="$(require_event_manifest_value "$manifest_path" "$event_id" kind)"
    seconds="$(require_event_manifest_value "$manifest_path" "$event_id" seconds)"
    [ "$actual_kind" = "$kind" ] \
        || die "Event manifest ${event_id} kind mismatch: expected ${kind}, got ${actual_kind}"
    [[ "$seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] \
        || die "Event manifest ${event_id} seconds must be numeric, got: ${seconds}"
}

require_event_manifest_paths() {
    local manifest_path="$1"
    require_file "$manifest_path"
    require_fresh_derived_file "$manifest_path" "${annotation_plan:-}" "Event manifest"
    local mouse_events=""
    if [ -n "${recording_name:-}" ]; then
        mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
    fi
    if [ -n "$mouse_events" ] && [ -s "$mouse_events" ]; then
        require_fresh_derived_file "$manifest_path" "$mouse_events" "Event manifest"
    fi

    local event_id relative_path
    while IFS=$'\t' read -r event_id _kind _seconds _caption _sample relative_path _expected; do
        case "${event_id:-}" in
            ""|\#*) continue ;;
        esac
        [ -n "${relative_path:-}" ] || continue
        [ "$relative_path" != "-" ] || continue
        case "$relative_path" in
            /*|*../*) die "Event manifest path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_file "${RUN_DIR}/${relative_path}"
        case "$relative_path" in
            screenshots/*.samples/*)
                require_fresh_derived_file "${RUN_DIR}/${relative_path}" "${recording_path:-}" "Event manifest frame"
                ;;
        esac
    done <"$manifest_path"
}

require_event_before() {
    local manifest_path="$1"
    local before_event="$2"
    local after_event="$3"
    local message="$4"
    local before_seconds after_seconds
    before_seconds="$(require_event_manifest_value "$manifest_path" "$before_event" seconds)"
    after_seconds="$(require_event_manifest_value "$manifest_path" "$after_event" seconds)"
    assert_numeric_lt "$before_seconds" "$after_seconds" "$message"
}

require_event_sample_label() {
    local manifest_path="$1"
    local event_id="$2"
    local expected_label="$3"
    local actual_label
    actual_label="$(require_event_manifest_value "$manifest_path" "$event_id" sample-label)"
    [ "$actual_label" = "$expected_label" ] \
        || die "Event manifest ${event_id} sample label mismatch: expected ${expected_label}, got ${actual_label}"
}

require_event_path_kind() {
    local manifest_path="$1"
    local slice="$2"
    local event_id="$3"
    local path_kind="$4"
    local path_value="$5"
    local actual_path
    actual_path="$(require_event_manifest_value "$manifest_path" "$event_id" path)"

    case "$path_kind" in
        screenshot)
            [ -n "$path_value" ] && [ "$path_value" != "-" ] \
                || die "Mouse drag event spec ${event_id} screenshot row is missing path-value"
            local expanded_path expected_path
            expanded_path="${path_value//\{slice\}/$slice}"
            case "$expanded_path" in
                screenshots/*) expected_path="$expanded_path" ;;
                *) expected_path="screenshots/${expanded_path}" ;;
            esac
            [ "$actual_path" = "$expected_path" ] \
                || die "Event manifest ${event_id} path-kind=screenshot mismatch: expected ${expected_path}, got ${actual_path}"
            ;;
        sample-start)
            case "$actual_path" in
                screenshots/*.samples/*boundary-start.png) ;;
                *) die "Event manifest ${event_id} path-kind=sample-start must cite a boundary-start sample, got: ${actual_path}" ;;
            esac
            ;;
        sample-end)
            case "$actual_path" in
                screenshots/*.samples/*boundary-end.png) ;;
                *) die "Event manifest ${event_id} path-kind=sample-end must cite a boundary-end sample, got: ${actual_path}" ;;
            esac
            ;;
        none)
            [ "$actual_path" = "-" ] \
                || die "Event manifest ${event_id} path-kind=none must use path '-', got: ${actual_path}"
            ;;
        *)
            die "Mouse drag event spec ${event_id} has unsupported path-kind: ${path_kind:-missing}"
            ;;
    esac
}

require_mouse_event_log_shape() {
    local mouse_events="$1"
    if /usr/bin/grep -F "\\n" "$mouse_events" >/dev/null; then
        die "Mouse event log contains literal backslash-n separators: $mouse_events"
    fi
    /usr/bin/awk -F'\t' '
        $0 == "" || $1 ~ /^#/ { next }
        NF != 4 {
            printf("Mouse event log row has %d fields, expected 4: %s\n", NF, $0) > "/dev/stderr"
            exit 1
        }
        $1 in seen {
            printf("Mouse event log duplicate event id: %s\n", $1) > "/dev/stderr"
            exit 1
        }
        {
            seen[$1] = 1
        }
    ' "$mouse_events" || die "Mouse event log is malformed: $mouse_events"
}

require_event_manifest_matches_mouse_events() {
    local manifest_path="$1"
    shift
    local mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
    [ -s "$mouse_events" ] || return 0
    require_event_manifest_matches_mouse_event_log "$manifest_path" "$mouse_events" "$@"
}

require_event_manifest_matches_mouse_event_log() {
    local manifest_path="$1"
    local mouse_events="$2"
    shift 2
    require_file "$mouse_events"
    require_mouse_event_log_shape "$mouse_events"

    local event_id expected_seconds actual_seconds
    for event_id in "$@"; do
        expected_seconds="$(/usr/bin/awk -F'\t' -v event_id="$event_id" '
            $0 == "" || $1 ~ /^#/ { next }
            $1 == event_id {
                print $3
                found = 1
                exit
            }
            END { exit(found ? 0 : 1) }
        ' "$mouse_events")" \
            || die "Mouse event log missing event: ${event_id}"
        actual_seconds="$(require_event_manifest_value "$manifest_path" "$event_id" seconds)"
        [ "$actual_seconds" = "$expected_seconds" ] \
            || die "Event ${event_id} seconds must come from mouse event log: manifest=${actual_seconds} mouse-events=${expected_seconds}"
    done
}

mouse_event_log_value() {
    local mouse_events="$1"
    local event_id="$2"
    local field="$3"
    /usr/bin/awk -F'\t' -v event_id="$event_id" -v field="$field" '
        BEGIN {
            column["kind"] = 2
            column["seconds"] = 3
            column["note"] = 4
        }
        $0 == "" || $1 ~ /^#/ { next }
        $1 == event_id && column[field] {
            print $column[field]
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$mouse_events"
}

require_mouse_event_log_event() {
    local mouse_events="$1"
    local event_id="$2"
    local kind="$3"
    local actual_kind seconds
    actual_kind="$(mouse_event_log_value "$mouse_events" "$event_id" kind)" \
        || die "Mouse event log missing ${event_id}: $mouse_events"
    seconds="$(mouse_event_log_value "$mouse_events" "$event_id" seconds)" \
        || die "Mouse event log missing seconds for ${event_id}: $mouse_events"
    [ "$actual_kind" = "$kind" ] \
        || die "Mouse event ${event_id} kind mismatch: expected ${kind}, got ${actual_kind}"
    [[ "$seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] \
        || die "Mouse event ${event_id} seconds must be numeric, got: ${seconds}"
}

require_mouse_event_log_order() {
    local mouse_events="$1"
    local before_event="$2"
    local after_event="$3"
    local message="$4"
    local before_seconds after_seconds
    before_seconds="$(mouse_event_log_value "$mouse_events" "$before_event" seconds)" \
        || die "Mouse event log missing ${before_event}: $mouse_events"
    after_seconds="$(mouse_event_log_value "$mouse_events" "$after_event" seconds)" \
        || die "Mouse event log missing ${after_event}: $mouse_events"
    assert_numeric_le "$before_seconds" "$after_seconds" "$message"
}

require_secondary_button_input_evidence() {
    local proof_manifest_path="$1"
    local slice_label="$2"
    local activation_input configured_modifier legacy_modifier evidence
    activation_input="$(manifest_value "$proof_manifest_path" drag-policy activation-input)"
    if [ -n "$activation_input" ] && [ "$activation_input" != "secondary-button" ]; then
        die "${slice_label} secondary-button proof must declare activation-input=secondary-button, got: $activation_input"
    fi
    configured_modifier="$(manifest_value "$proof_manifest_path" drag-policy configured-modifier)"
    if [ -n "$configured_modifier" ] && [ "$configured_modifier" != "alt" ]; then
        die "${slice_label} secondary-button proof has unexpected configured modifier: $configured_modifier"
    fi
    legacy_modifier="$(manifest_value "$proof_manifest_path" drag-policy modifier)"
    if [ -n "$activation_input" ] && [ -n "$legacy_modifier" ]; then
        die "${slice_label} secondary-button proof must not mix activation-input with legacy drag-policy modifier"
    fi
    evidence="$(manifest_value "$proof_manifest_path" drag-policy input-state-evidence)"
    [ -n "$evidence" ] || return 0
    [ "$evidence" = "secondary-button-events" ] \
        || die "${slice_label} has unsupported input-state evidence contract: $evidence"

    local mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
    require_file "$mouse_events"
    require_mouse_event_log_shape "$mouse_events"
    require_mouse_event_log_event "$mouse_events" snap-secondary-button-down input-state
    require_mouse_event_log_event "$mouse_events" snap-secondary-button-held input-state
    require_mouse_event_log_event "$mouse_events" snap-secondary-button-up input-state
    require_mouse_event_log_order "$mouse_events" snap-secondary-button-down snap-drag-start \
        "${slice_label} secondary button must be down before the snap drag starts"
    require_mouse_event_log_order "$mouse_events" snap-drag-start snap-secondary-button-held \
        "${slice_label} secondary button held proof must occur after snap pickup"
    require_mouse_event_log_order "$mouse_events" snap-secondary-button-held snap-first-affordance \
        "${slice_label} secondary button held proof must precede the first snap affordance"
    require_mouse_event_log_order "$mouse_events" snap-release snap-secondary-button-up \
        "${slice_label} secondary button must be released after the snap release event"
}

require_mouse_snap_affordance_event_paths() {
    local manifest_path="$1"
    local target_path release_path
    target_path="$(require_event_manifest_value "$manifest_path" snap-first-affordance path)"
    release_path="$(require_event_manifest_value "$manifest_path" snap-release path)"
    [ "$target_path" != "-" ] || die "Mouse snap target affordance event must cite a concrete media path"
    [ "$release_path" != "-" ] || die "Mouse snap release event must cite a concrete media path"
    case "$target_path" in
        screenshots/07-snap-hover-comms-*.png|screenshots/07-slot-hover-*.png|screenshots/*.samples/*) ;;
        *) die "Mouse snap target affordance must cite hover/affordance media, got: $target_path" ;;
    esac
    case "$release_path" in
        screenshots/*.samples/*boundary-start.png|screenshots/07-snap-hover-comms-*.png|screenshots/08-slot-release-*.png) ;;
        *) die "Mouse snap release must cite a release-boundary or target sample frame, got: $release_path" ;;
    esac
}

file_mtime_epoch() {
    local path="$1"
    local mtime
    if mtime="$(stat -f '%m' "$path" 2>/dev/null)"; then
        printf '%s\n' "$mtime"
    elif mtime="$(stat -c '%Y' "$path" 2>/dev/null)"; then
        printf '%s\n' "$mtime"
    else
        die "Could not read mtime for $path"
    fi
}

is_fresh_derived_file() {
    local path="$1"
    local source="$2"
    [ -s "$path" ] || return 1
    [ -s "$source" ] || return 0
    local path_mtime source_mtime
    path_mtime="$(file_mtime_epoch "$path")"
    source_mtime="$(file_mtime_epoch "$source")"
    [ "$path_mtime" -ge $((source_mtime - 1)) ]
}

require_fresh_derived_file() {
    local path="$1"
    local source="$2"
    local label="$3"
    is_fresh_derived_file "$path" "$source" \
        || die "${label} is stale relative to ${source}: ${path}"
}

require_sample_manifest_shape_and_timing() {
    local manifest_path="$1"
    local captions_path="${2:-}"

    /usr/bin/awk -F'\t' -v captions="$captions_path" -v manifest="$manifest_path" '
        function fail(message) {
            printf("%s\n", message) > "/dev/stderr"
            exit 1
        }

        BEGIN {
            tolerance = 0.151
            caption_count = 0
            if (captions != "") {
                while ((getline line < captions) > 0) {
                    if (line == "" || line ~ /^#/) {
                        continue
                    }
                    field_count = split(line, fields, "\t")
                    if (field_count < 2) {
                        fail("Caption annotation row has fewer than 2 fields in " captions ": " line)
                    }
                    if (fields[1] !~ /^[0-9]+([.][0-9]+)?$/ || fields[2] !~ /^[0-9]+([.][0-9]+)?$/) {
                        fail("Caption annotation row must start with numeric start/end seconds in " captions ": " line)
                    }
                    caption_count++
                    caption_start[caption_count] = fields[1] + 0
                    caption_end[caption_count] = fields[2] + 0
                    if (caption_end[caption_count] <= caption_start[caption_count]) {
                        fail("Caption annotation end must be after start in " captions ": " line)
                    }
                }
                close(captions)
            }
        }

        $0 == "" || $1 ~ /^#/ {
            next
        }

        NF != 6 {
            fail("Sample manifest row has " NF " fields, expected 6 in " manifest ": " $0)
        }

        $1 == "caption" {
            if (caption_count == 0) {
                fail("Caption sample row has no annotation plan to validate against in " manifest ": " $0)
            }
            if ($4 !~ /^[0-9]+([.][0-9]+)?$/) {
                fail("Caption sample timestamp must be decimal seconds in " manifest ", got " $4 ": " $0)
            }
            if ($3 !~ /^caption-[0-9][0-9]$/) {
                fail("Caption sample reference must look like caption-NN in " manifest ": " $0)
            }

            caption_index = $3
            sub(/^caption-0*/, "", caption_index)
            caption_index += 0
            if (caption_index < 1 || caption_index > caption_count) {
                fail("Caption sample references missing annotation " $3 " in " manifest ": " $0)
            }

            expected_label = $3
            lower = caption_start[caption_index]
            upper = caption_end[caption_index]
            if ($2 == expected_label "-boundary-before") {
                lower = caption_start[caption_index] - 0.500
                if (lower < 0) {
                    lower = 0
                }
                upper = caption_start[caption_index]
            } else if ($2 == expected_label "-boundary-start") {
                lower = caption_start[caption_index]
                upper = caption_end[caption_index]
            } else if ($2 == expected_label "-boundary-end") {
                lower = caption_start[caption_index]
                upper = caption_end[caption_index]
            } else if ($2 != expected_label) {
                fail("Caption sample label must match its caption reference or boundary suffix in " manifest ": " $0)
            }

            seconds = $4 + 0
            if (seconds + tolerance < lower || seconds - tolerance > upper) {
                fail("Caption sample timestamp " $4 " is outside " $3 " window [" lower ", " upper "] in " manifest ": " $0)
            }
        }
    ' "$manifest_path" || die "Sample manifest shape/timing validation failed: $manifest_path"
}

require_sample_manifest_paths() {
    local manifest_path="$1"
    require_file "$manifest_path"
    require_fresh_derived_file "$manifest_path" "${recording_path:-}" "Sample manifest"

    local captions_path=""
    if [ -s "${annotation_plan:-}" ]; then
        captions_path="$annotation_plan"
    elif [ -n "${LOGS_DIR:-}" ] && [ -n "${recording_name:-}" ] && [ -s "${LOGS_DIR}/${recording_name}.annotations.tsv" ]; then
        captions_path="${LOGS_DIR}/${recording_name}.annotations.tsv"
    fi
    require_sample_manifest_shape_and_timing "$manifest_path" "$captions_path"

    /usr/bin/awk -F'\t' '$0 != "" && $1 !~ /^#/ { print $5 }' "$manifest_path" | while IFS= read -r relative_path; do
        [ -n "$relative_path" ] || die "Sample manifest has a row with an empty path: $manifest_path"
        case "$relative_path" in
            /*|*../*) die "Sample manifest path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_file "${RUN_DIR}/${relative_path}"
        case "$relative_path" in
            screenshots/*.samples/*)
                require_fresh_derived_file "${RUN_DIR}/${relative_path}" "${recording_path:-}" "Sample manifest frame"
                ;;
        esac
    done
}

contact_sheet_manifest_has_label() {
    local manifest_path="$1"
    local label="$2"
    /usr/bin/awk -F'\t' -v label="$label" '$1 == "semantic" && $2 == label { found = 1 } END { exit(found ? 0 : 1) }' "$manifest_path"
}

require_contact_sheet_summary_manifest() {
    local manifest_path="$1"
    local sample_manifest="$2"
    require_file "$manifest_path"
    require_file "$sample_manifest"
    require_fresh_derived_file "$manifest_path" "$sample_manifest" "Contact sheet manifest"

    /usr/bin/awk -F'\t' '
        $0 == "" || $1 ~ /^#/ { next }
        NF != 6 {
            printf("Contact sheet manifest row has %d fields, expected 6: %s\n", NF, $0) > "/dev/stderr"
            exit 1
        }
    ' "$manifest_path" || die "Contact sheet manifest is malformed: $manifest_path"

    local label
    for label in snap-hover-comms snap-release snap-final-placement; do
        if sample_manifest_has_label "$sample_manifest" "$label"; then
            contact_sheet_manifest_has_label "$manifest_path" "$label" \
                || die "Contact sheet manifest must include semantic summary label: $label"
        fi
    done

    local row_count=0 _kind _label _caption _timestamp relative_path _expected
    while IFS=$'\t' read -r _kind _label _caption _timestamp relative_path _expected; do
        case "${_kind:-}" in
            ""|\#*) continue ;;
        esac
        [ -n "${relative_path:-}" ] || die "Contact sheet manifest has an empty path: $manifest_path"
        case "$relative_path" in
            /*|*../*) die "Contact sheet manifest path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_file "${RUN_DIR}/${relative_path}"
        row_count=$((row_count + 1))
    done <"$manifest_path"

    [ "$row_count" -gt 0 ] || die "Contact sheet manifest has no image rows: $manifest_path"
}

require_edge_crop_manifest() {
    local manifest_path="$1"
    require_file "$manifest_path"
    require_fresh_derived_file "$manifest_path" "${recording_path:-}" "Edge crop manifest"

    local row_count=0
    local label relative_path _description dimensions
    while IFS=$'\t' read -r label relative_path _description; do
        case "${label:-}" in
            ""|\#*) continue ;;
        esac
        [ -n "${relative_path:-}" ] || die "Edge crop manifest row is missing a path: $manifest_path"
        case "$relative_path" in
            /*|*../*) die "Edge crop path must be run-relative and stay inside the artifact: $relative_path" ;;
        esac
        require_file "${RUN_DIR}/${relative_path}"
        require_fresh_derived_file "${RUN_DIR}/${relative_path}" "${recording_path:-}" "Edge crop"
        dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${relative_path}")" \
            || die "Edge crop is not readable image media: ${RUN_DIR}/${relative_path}"
        [ -n "$dimensions" ] || die "Edge crop has no readable dimensions: ${RUN_DIR}/${relative_path}"
        row_count=$((row_count + 1))
    done <"$manifest_path"

    [ "$row_count" -gt 0 ] || die "Edge crop manifest has no crop rows: $manifest_path"
}

