            print $5
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$manifest_path")" || die "Sample manifest missing semantic proof path for label: $label"

    [ "$path" = "$expected_path" ] \
        || die "Sample manifest ${label} path mismatch: expected ${expected_path}, got ${path}"
}

