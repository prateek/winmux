        || die "Slice 14 annotations missing zone-bindings config chip"
    grep -F "Action: before apply-zone-bindings" "$annotation_plan" >/dev/null \
        || die "Slice 14 annotations missing before-state action chip"
    grep -F "Run: winmux apply-zone-bindings" "$annotation_plan" >/dev/null \
        || die "Slice 14 annotations missing apply-zone-bindings command chip"
    grep -F "Action: ReferenceDesk, WorkDesk, CommsDesk are active" "$annotation_plan" >/dev/null \
        || die "Slice 14 annotations missing after-state action chip"
    grep -F "Run: winmux list-zones --format '%{monitor-zone-id}|%{monitor-active-workspace}'" "$annotation_plan" >/dev/null \
        || die "Slice 14 annotations missing list-zones workspace proof chip"
    awk -F '\t' '$5 == "Run: winmux apply-zone-bindings" { found = 1; ok = (($1 + 0) <= 16 && ($2 + 0) >= 28) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
