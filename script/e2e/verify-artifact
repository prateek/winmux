        || die "Slice 11B config missing urgent binding"
    grep -F "alt-c = 'set-zone-style Comms calm'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 11B config missing calm binding"
    grep -F 'Config: [[zone-styles]] urgent=#D3455B calm=#3EA2FF' "$setup_log" >/dev/null \
        || die "Slice 11B setup log missing zone-styles summary"
    grep -F 'Command: set-zone-style Comms urgent; set-zone-style Comms calm' "$setup_log" >/dev/null \
        || die "Slice 11B setup log missing style command summary"

    grep -F '$ winmux set-zone-style Comms urgent' "$urgent_log" >/dev/null \
        || die "Slice 11B urgent log missing exact command"
    grep -F "Styled zone 'Comms' on monitor 1 as 'urgent'" "$urgent_log" >/dev/null \
        || die "Slice 11B urgent log missing success output"
    grep -F '$ winmux set-zone-style Comms calm' "$calm_log" >/dev/null \
        || die "Slice 11B calm log missing exact command"
    grep -F "Styled zone 'Comms' on monitor 1 as 'calm'" "$calm_log" >/dev/null \
        || die "Slice 11B calm log missing success output"

    [ "$(zone_log_value "$zones_before" right style)" = "" ] \
        || die "Slice 11B before zones log should not style Comms/right"
    [ "$(zone_log_value "$zones_before" right color)" = "" ] \
        || die "Slice 11B before zones log should not color Comms/right"
    [ "$(zone_log_value "$zones_urgent" right style)" = "urgent" ] \
        || die "Slice 11B urgent zones log missing urgent style for Comms/right"
    [ "$(zone_log_value "$zones_urgent" right color)" = "#D3455B" ] \
        || die "Slice 11B urgent zones log missing urgent color for Comms/right"
