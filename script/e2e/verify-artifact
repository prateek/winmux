        || die "Slice 20 action log missing freeform no-zone-move result"
    grep -F 'snap-result=success' "$action_log" >/dev/null \
        || die "Slice 20 action log missing snap success result"

    grep -F '$ winmux set-zone-snap-policy snap-to-zone' "$set_policy_log" >/dev/null \
        || die "Slice 20 set command log missing exact command"
    grep -F "Using zone snap policy 'snap-to-zone'" "$set_policy_log" >/dev/null \
        || die "Slice 20 set command log missing snap-to-zone output"
    grep -F '$ winmux cycle-zone-snap-policy freeform snap-to-zone' "$cycle_policy_log" >/dev/null \
        || die "Slice 20 cycle command log missing exact command"
    grep -F "Using zone snap policy 'freeform'" "$cycle_policy_log" >/dev/null \
        || die "Slice 20 cycle command log missing freeform output"

    local source_id freeform_id after_id before_zone freeform_zone reset_zone after_zone before_workspace after_workspace
    source_id="$(manifest_value_or_log "$proof_manifest" drag-source window-id source-window-id "$action_log")"
    freeform_id="$(manifest_value_or_log "$proof_manifest" drag-result freeform-window-id-after freeform-window-id-after "$action_log")"
    after_id="$(manifest_value_or_log "$proof_manifest" drag-result window-id-after window-id-after "$action_log")"
    before_zone="$(manifest_value_or_log "$proof_manifest" drag-source before-zone before-zone "$action_log")"
    freeform_zone="$(manifest_value_or_log "$proof_manifest" drag-result freeform-after-zone freeform-after-zone "$action_log")"
    after_zone="$(manifest_value_or_log "$proof_manifest" drag-result after-zone after-zone "$action_log")"
    before_workspace="$(manifest_value_or_log "$proof_manifest" drag-source before-workspace before-workspace "$action_log")"
    after_workspace="$(manifest_value_or_log "$proof_manifest" drag-result after-workspace after-workspace "$action_log")"
    reset_zone="$(field_for_title "$windows_reset" 'snap-demo.rtf' zone)"

    [ -n "$source_id" ] && [ "$source_id" = "$freeform_id" ] && [ "$source_id" = "$after_id" ] \
        || die "Slice 20 window id changed across drags: ${source_id:-missing} -> ${freeform_id:-missing} -> ${after_id:-missing}"
    [ "$before_zone" = main ] || die "Slice 20 source did not start in Work/main: ${before_zone:-missing}"
    [ "$freeform_zone" = main ] || die "Slice 20 freeform drag changed zone binding: ${freeform_zone:-missing}"
    [ "$reset_zone" = main ] || die "Slice 20 reset did not return source to Work/main: ${reset_zone:-missing}"
    [ "$after_zone" = right ] || die "Slice 20 runtime snap did not end in Comms/right: ${after_zone:-missing}"
    [ -n "$before_workspace" ] && [ -n "$after_workspace" ] && [ "$before_workspace" != "$after_workspace" ] \
        || die "Slice 20 runtime snap did not move to a different active workspace"

    [ "$(field_for_title "$windows_before" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "Slice 20 before log missing snap-demo source id"
    [ "$(field_for_title "$windows_before" 'snap-demo.rtf' zone)" = main ] \
        || die "Slice 20 before log missing snap-demo in main"
    [ "$(field_for_title "$windows_freeform" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "Slice 20 freeform log missing same snap-demo id"
    [ "$(field_for_title "$windows_freeform" 'snap-demo.rtf' zone)" = main ] \
        || die "Slice 20 freeform log should keep snap-demo in main"
    [ "$(field_for_title "$windows_after" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "Slice 20 after log missing same snap-demo id"
    [ "$(field_for_title "$windows_after" 'snap-demo.rtf' zone)" = right ] \
        || die "Slice 20 after log should move snap-demo to right"

    [ "$(manifest_value "$proof_manifest" drag-target snap-target)" = whole-zone ] \
        || die "Slice 20 proof manifest must show whole-zone snap target"
    [ "$(manifest_value "$proof_manifest" drag-policy policy)" = freeform ] \
        || die "Slice 20 proof manifest must show freeform config policy"
    [ "$(manifest_value "$proof_manifest" drag-policy proof-mode)" = runtime-policy ] \
        || die "Slice 20 proof manifest missing runtime-policy mode"
    [ "$(manifest_value "$proof_manifest" drag-policy positive-proof)" = runtime-set-snap-to-zone ] \
        || die "Slice 20 proof manifest missing runtime snap positive proof"
    [ "$(manifest_value "$proof_manifest" runtime-policy command)" = "set-zone-snap-policy snap-to-zone" ] \
        || die "Slice 20 proof manifest missing runtime set command"
    [ "$(manifest_value "$proof_manifest" runtime-policy after-set)" = snap-to-zone ] \
        || die "Slice 20 proof manifest missing runtime snap-to-zone state"
    [ "$(manifest_value "$proof_manifest" runtime-policy cycle-command)" = "cycle-zone-snap-policy freeform snap-to-zone" ] \
        || die "Slice 20 proof manifest missing runtime cycle command"
    [ "$(manifest_value "$proof_manifest" runtime-policy after-cycle)" = freeform ] \
        || die "Slice 20 proof manifest missing freeform cycle state"

    grep -F "Config: policy='freeform'; alt-z='set-zone-snap-policy snap-to-zone'" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing freeform config/binding chip"
    grep -F "Action: drag snap-demo.rtf with no modifier" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing freeform drag chip"
    grep -F "Run: winmux set-zone-snap-policy snap-to-zone" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing set-zone-snap-policy command chip"
    grep -F "Action: drag snap-demo.rtf with snap-to-zone active" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing runtime snap drag chip"
    grep -F "Action: target = whole Comms zone" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing whole-zone target chip"
    grep -F "Action: release on Comms zone" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing release chip"
    grep -F "Run: winmux cycle-zone-snap-policy freeform snap-to-zone" "$annotation_plan" >/dev/null \
        || die "Slice 20 annotations missing cycle-zone-snap-policy command chip"

    local freeform_drag_offset snap_drag_offset snap_end_offset cycle_offset
    local freeform_caption_start set_caption_start snap_caption_start release_caption_start cycle_caption_start
    local recording_timing_base snap_recording_start snap_recording_end cycle_recording_start set_caption_deadline
    freeform_drag_offset="$(value_from_log freeform-drag-start-offset-seconds "$timing_log")"
    snap_drag_offset="$(value_from_log snap-drag-start-offset-seconds "$timing_log")"
    snap_end_offset="$(value_from_log snap-drag-end-offset-seconds "$timing_log")"
    cycle_offset="$(value_from_log cycle-command-start-offset-seconds "$timing_log")"
    [ -n "$freeform_drag_offset" ] || die "Slice 20 timing log missing freeform drag start offset"
    [ -n "$snap_drag_offset" ] || die "Slice 20 timing log missing runtime snap drag start offset"
    [ -n "$snap_end_offset" ] || die "Slice 20 timing log missing runtime snap drag end offset"
    [ -n "$cycle_offset" ] || die "Slice 20 timing log missing cycle command start offset"
    freeform_caption_start="$(require_annotation_chip_start "$annotation_plan" "Action: drag snap-demo.rtf with no modifier")"
    set_caption_start="$(require_annotation_chip_start "$annotation_plan" "Run: winmux set-zone-snap-policy snap-to-zone")"
    snap_caption_start="$(require_annotation_chip_start "$annotation_plan" "Action: drag snap-demo.rtf with snap-to-zone active")"
    release_caption_start="$(require_annotation_chip_start "$annotation_plan" "Action: release on Comms zone")"
    cycle_caption_start="$(require_annotation_chip_start "$annotation_plan" "Run: winmux cycle-zone-snap-policy freeform snap-to-zone")"
    recording_timing_base="$(/usr/bin/awk -v caption="$freeform_caption_start" -v offset="$freeform_drag_offset" 'BEGIN { printf "%.3f", caption - offset }')"
    snap_recording_start="$(/usr/bin/awk -v base="$recording_timing_base" -v offset="$snap_drag_offset" 'BEGIN { printf "%.3f", base + offset }')"
    snap_recording_end="$(/usr/bin/awk -v base="$recording_timing_base" -v offset="$snap_end_offset" 'BEGIN { printf "%.3f", base + offset }')"
    cycle_recording_start="$(/usr/bin/awk -v base="$recording_timing_base" -v offset="$cycle_offset" 'BEGIN { printf "%.3f", base + offset }')"
    set_caption_deadline="$(/usr/bin/awk -v snap="$snap_recording_start" 'BEGIN { printf "%.3f", snap - 0.500 }')"
    assert_numeric_le "$set_caption_start" "$set_caption_deadline" \
        "Slice 20 set-policy command caption must start before the runtime snap drag can show an overlay"
    assert_numeric_le "$snap_caption_start" "$snap_recording_start" \
        "Slice 20 runtime snap drag caption must be visible when the positive drag starts"
    assert_numeric_le "$release_caption_start" "$snap_recording_end" \
        "Slice 20 release caption must be visible before the positive drag has fully completed"
    assert_numeric_le "$cycle_caption_start" "$(/usr/bin/awk -v cycle="$cycle_recording_start" 'BEGIN { printf "%.3f", cycle + 1.000 }')" \
        "Slice 20 cycle command caption must align with the cycle command"
}

require_float_unless_snap_proof() {
    local slice_prefix="$1"
    local slice_label="$2"
    local recording_artifact="$3"
    local require_product_overlay_label="${4:-0}"
    local proof="${RUN_DIR}/${slice_prefix}-mouse-zone-snap-proof.txt"
