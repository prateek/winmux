    local expected_gesture="drag"
    local expected_proof_mode="float-unless-snap"
    local expected_negative_proof="no-alt-floats-no-snap"
    local expected_positive_proof="alt-held-whole-zone-snap"
    local freeform_action_chip="Action: drag snap-demo.rtf with no modifier"
    local snap_action_chip="Action: hold Alt while dragging snap-demo.rtf"
    local float_description="no-Alt"
    local snap_description="Alt"
    if [ "$slice_prefix" = "slice-24" ] || [ "$slice_prefix" = "slice-25" ]; then
        expected_pass="PASS: desktop drag starts from config float-unless-snap with gesture secondary-button-drag; ordinary drag converts the tiled source into floating/freeform placement in Comms/right without a snap overlay; resetting to Work/main and holding the secondary mouse button previews a whole Comms zone target and moves the same window into Comms/right on release."
        expected_setup_summary="Config: [mouse.zone-snap] policy = 'float-unless-snap', configured-modifier = 'alt', gesture = 'secondary-button-drag', activation-input = 'secondary-button', target = 'zone'"
        expected_config_chip="Config: policy='float-unless-snap'; gesture='secondary-button-drag'; target='zone'"
        expected_gesture="secondary-button-drag"
        expected_proof_mode="secondary-button"
        expected_negative_proof="no-secondary-button-floats-no-snap"
        expected_positive_proof="secondary-button-whole-zone-snap"
        freeform_action_chip="Action: drag snap-demo.rtf with no secondary button"
        snap_action_chip="Action: hold secondary button while dragging snap-demo.rtf"
        float_description="ordinary"
        snap_description="secondary-button"
    fi

    require_file "$proof"
    require_success_marker "$done" "$slice_label"
    require_file "$setup_log"
    require_file "$action_log"
    require_file "$windows_before"
    require_file "$windows_freeform"
    require_file "$windows_reset"
    require_file "$windows_after"
    require_file "$zones"
    require_file "$timing_log"
    require_drag_proof_manifest "$proof_manifest"
    if [ "$slice_prefix" = "slice-23" ]; then
        require_slice_23_sample_manifest "$sample_manifest"
    elif [ "$slice_prefix" = "slice-25" ]; then
        require_slice_25_sample_manifest "$sample_manifest"
    elif [ "$slice_prefix" = "slice-24" ]; then
        require_slice_24_sample_manifest "$sample_manifest"
    else
        require_slice_22_sample_manifest "$sample_manifest"
    fi
    require_guest_transport_summary "${LOGS_DIR}/guest-transport-summary.tsv"
    require_file "${SCREENSHOTS_DIR}/01-ready-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/02-freeform-pickup-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/03-freeform-hover-no-overlay-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/04-reset-before-snap-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/05-snap-pickup-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/06-snap-path-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/07-snap-hover-comms-${slice_prefix}.png"
    require_file "${SCREENSHOTS_DIR}/99-after-${slice_prefix}.png"
