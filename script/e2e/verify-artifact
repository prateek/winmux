require_event_manifest_matches_mouse_events() {
    local manifest_path="$1"
    shift
    local mouse_events="${LOGS_DIR}/${recording_name}.mouse-events.tsv"
    [ -s "$mouse_events" ] || return 0

    local event_id expected_seconds actual_seconds
    for event_id in "$@"; do
        expected_seconds="$(/usr/bin/awk -F'\t' -v event_id="$event_id" '
            $0 == "" || $1 ~ /^#/ { next }
            $1 == event_id {
                print $3
                found = 1
                exit
            }
            END { exit(found ? 0 : 1) }
        ' "$mouse_events")" \
            || die "Mouse event log missing event: ${event_id}"
        actual_seconds="$(require_event_manifest_value "$manifest_path" "$event_id" seconds)"
        [ "$actual_seconds" = "$expected_seconds" ] \
            || die "Event ${event_id} seconds must come from mouse event log: manifest=${actual_seconds} mouse-events=${expected_seconds}"
    done
}

require_mouse_snap_affordance_event_paths() {
