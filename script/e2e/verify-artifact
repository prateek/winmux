        if [ "$expected_proof_mode" = "secondary-button" ]; then
            grep -F "Config: [mouse.zone-snap] policy = 'float-unless-snap', modifier = 'alt', gesture = 'secondary-button-drag', target = 'zone'" "$setup_log" >/dev/null \
                || die "${slice_label} setup log missing secondary-button mouse snap summary"
