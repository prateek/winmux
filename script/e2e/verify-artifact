    if grep -F -- '--config-path' "$launch_plist" >/dev/null; then
        die "Slice 38 LaunchAgent must not pass --config-path"
    fi
    if grep -F 'WINMUX_DEFAULT_CONFIG_PATH' "$launch_plist" >/dev/null; then
