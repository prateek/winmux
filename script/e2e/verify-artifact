    [ "$(field_for_title "$windows_freeform" 'snap-demo.rtf' layout)" = floating ] \
        || die "${slice_label} ${float_description} log should show snap-demo as floating"
    [ "$(field_for_title "$windows_after" 'snap-demo.rtf' id)" = "$source_id" ] \
        || die "${slice_label} after log missing same snap-demo id"
    [ "$(field_for_title "$windows_after" 'snap-demo.rtf' zone)" = right ] \
        || die "${slice_label} after log should move snap-demo to right"

