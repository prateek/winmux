    [ "$(field_for_title "$windows_before" 'comms-availability-set.rtf' zone)" = right ] \
        || die "Slice 11C before log missing Comms document in right zone"
    [ "$(field_for_title "$windows_focus" 'work-availability-set.rtf' zone)" = main ] \
        || die "Slice 11C focus-only log missing Work document in main zone"
    [ -z "$(field_for_title "$windows_focus" 'reference-availability-set.rtf' id)" ] \
        || die "Slice 11C focus-only log still contains Reference document"
    [ -z "$(field_for_title "$windows_focus" 'comms-availability-set.rtf' id)" ] \
        || die "Slice 11C focus-only log still contains Comms document"
    [ "$(field_for_title "$windows_restoring" 'comms-availability-set.rtf' zone)" = right ] \
        || die "Slice 11C restoring log missing Comms document in right zone"
    [ "$(field_for_title "$windows_restored" 'comms-availability-set.rtf' zone)" = right ] \
        || die "Slice 11C restored log missing Comms document in right zone"
    [ -z "$(field_for_title "$windows_restored" 'reference-availability-set.rtf' id)" ] \
        || die "Slice 11C restored log should keep Reference hidden under communications"

    [ "$(zone_log_value "$zones_before" right availability)" = "" ] \
        || die "Slice 11C before zones log should not have an active availability set"
    [ "$(zone_log_value "$zones_urgent" right style)" = "urgent" ] \
        || die "Slice 11C urgent zones log missing urgent style"
    [ "$(zone_log_value "$zones_urgent" right color)" = "#D3455B" ] \
        || die "Slice 11C urgent zones log missing urgent color"
    [ "$(zone_log_value "$zones_focus" left enabled)" = "false" ] \
        || die "Slice 11C focus-only zones log should disable left"
    [ "$(zone_log_value "$zones_focus" main enabled)" = "true" ] \
        || die "Slice 11C focus-only zones log should keep main enabled"
    [ "$(zone_log_value "$zones_focus" right enabled)" = "false" ] \
        || die "Slice 11C focus-only zones log should disable right"
    [ "$(zone_log_value "$zones_focus" main availability)" = "focus-only" ] \
        || die "Slice 11C focus-only zones log missing focus-only availability label"
    [ "$(zone_log_value "$zones_focus" right style)" = "urgent" ] \
        || die "Slice 11C focus-only zones log did not preserve hidden Comms style"
    [ "$(zone_log_value "$zones_restored" left enabled)" = "false" ] \
        || die "Slice 11C communications zones log should keep left hidden"
    [ "$(zone_log_value "$zones_restored" main enabled)" = "true" ] \
        || die "Slice 11C communications zones log should keep main enabled"
    [ "$(zone_log_value "$zones_restored" right enabled)" = "true" ] \
        || die "Slice 11C communications zones log should restore right"
    [ "$(zone_log_value "$zones_restored" main availability)" = "communications" ] \
        || die "Slice 11C restored zones log missing communications label on main"
    [ "$(zone_log_value "$zones_restored" right availability)" = "communications" ] \
        || die "Slice 11C restored zones log missing communications label on right"
    [ "$(zone_log_value "$zones_restored" right style)" = "urgent" ] \
        || die "Slice 11C restored zones log did not preserve Comms style"
    [ "$(zone_log_value "$zones_restored" right color)" = "#D3455B" ] \
        || die "Slice 11C restored zones log did not preserve Comms color"

    local before_main_width focus_main_width before_comms_id restored_comms_id before_comms_workspace restored_comms_workspace
    before_main_width="$(zone_log_value "$zones_urgent" main width)"
    focus_main_width="$(zone_log_value "$zones_focus" main width)"
    awk -v before="$before_main_width" -v focus="$focus_main_width" 'BEGIN { exit(focus > before ? 0 : 1) }' \
        || die "Slice 11C Work/main width did not expand after focus-only"
    before_comms_id="$(field_for_title "$windows_before" 'comms-availability-set.rtf' id)"
    restored_comms_id="$(field_for_title "$windows_restored" 'comms-availability-set.rtf' id)"
    [ -n "$before_comms_id" ] && [ "$before_comms_id" = "$restored_comms_id" ] \
        || die "Slice 11C Comms window id changed across availability sets: $before_comms_id -> $restored_comms_id"
    before_comms_workspace="$(field_for_title "$windows_before" 'comms-availability-set.rtf' workspace)"
    restored_comms_workspace="$(field_for_title "$windows_restored" 'comms-availability-set.rtf' workspace)"
    [ -n "$before_comms_workspace" ] && [ "$before_comms_workspace" = "$restored_comms_workspace" ] \
        || die "Slice 11C Comms workspace changed across availability sets: $before_comms_workspace -> $restored_comms_workspace"

    local urgent_offset focus_offset communications_offset
    urgent_offset="$(value_from_log urgent-command-offset-seconds "$timing_log")"
    focus_offset="$(value_from_log focus-only-command-offset-seconds "$timing_log")"
    communications_offset="$(value_from_log communications-command-offset-seconds "$timing_log")"
    [ -n "$urgent_offset" ] || die "Slice 11C timing log missing urgent command offset"
    [ -n "$focus_offset" ] || die "Slice 11C timing log missing focus-only command offset"
    [ -n "$communications_offset" ] || die "Slice 11C timing log missing communications command offset"
    assert_numeric_between_inclusive "$urgent_offset" 7 16 \
        "Slice 11C urgent command must happen while the urgent command caption is on screen"
    assert_numeric_between_inclusive "$focus_offset" 23 34 \
        "Slice 11C focus-only command must happen while the focus-only command caption is on screen"
    assert_numeric_between_inclusive "$communications_offset" 40 51 \
        "Slice 11C communications command must happen while the communications command caption is on screen"
    grep -F "urgent-command-offset-seconds=${urgent_offset}" "$proof" >/dev/null \
        || die "Slice 11C proof does not copy urgent command timing"
    grep -F "focus-only-command-offset-seconds=${focus_offset}" "$proof" >/dev/null \
        || die "Slice 11C proof does not copy focus-only command timing"
    grep -F "communications-command-offset-seconds=${communications_offset}" "$proof" >/dev/null \
        || die "Slice 11C proof does not copy communications command timing"

    for label in before-hide-urgent during-restore-urgent after-restore-urgent; do
        /usr/bin/awk -F'\t' -v label="$label" '$1 == "swatch" && $2 == label { found = 1 } END { exit(found ? 0 : 1) }' "$color_sentinel" \
            || die "Slice 11C color sentinel missing label: $label"
    done

    grep -F "Config: [[zone-availability-sets]]" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing availability-set config chip"
    grep -F "Run: winmux set-zone-style Comms urgent" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing urgent style command chip"
    grep -F "Action: Comms urgent before availability" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing before-hide urgent action chip"
    grep -F "Run: winmux use-zone-availability focus-only" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing focus-only command chip"
    grep -F "Action: focus-only enables main only" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing focus-only action chip"
    grep -F "Run: winmux use-zone-availability communications" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing communications command chip"
    grep -F "Action: communications restores Comms #D3455B" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing communications restore action chip"
    grep -F "Run: winmux list-zones && winmux list-windows" "$annotation_plan" >/dev/null \
        || die "Slice 11C annotations missing inspection command chip"
    awk -F '\t' '$5 == "Run: winmux set-zone-style Comms urgent" { found = 1; ok = (($1 + 0) <= 7 && ($2 + 0) >= 15) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 11C urgent command caption must cover the command/action interval"
    awk -F '\t' '$5 == "Run: winmux use-zone-availability focus-only" { found = 1; ok = (($1 + 0) <= 23 && ($2 + 0) >= 33) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 11C focus-only command caption must cover the command/action interval"
    awk -F '\t' '$5 == "Run: winmux use-zone-availability communications" { found = 1; ok = (($1 + 0) <= 40 && ($2 + 0) >= 50) } END { exit(found && ok ? 0 : 1) }' "$annotation_plan" \
        || die "Slice 11C communications command caption must cover the command/action interval"
}

require_mouse_snap_overlay_sentinel() {
    local manifest_path="$1"
    require_file "$manifest_path"

    sentinel_value() {
        local label="$1"
        local column="$2"
        /usr/bin/awk -F'\t' -v label="$label" -v column="$column" '$1 == label { print $column; exit }' "$manifest_path"
    }

    local rmse minimum target_semantics freeform_crop snap_crop target_label target_label_crop crop_geometry
    rmse="$(sentinel_value overlay-rmse-normalized 2)"
    minimum="$(sentinel_value overlay-rmse-normalized 3)"
    target_semantics="$(sentinel_value target-semantics 2)"
    freeform_crop="$(sentinel_value freeform-target-zone-crop 4)"
    snap_crop="$(sentinel_value snap-target-zone-crop 4)"
    target_label="$(sentinel_value target-label 2)"
    target_label_crop="$(sentinel_value target-label 4)"
    crop_geometry="$(sentinel_value target-zone-crop 2)"

    [ -n "$rmse" ] || die "Mouse snap overlay sentinel missing overlay-rmse-normalized value"
    [ -n "$minimum" ] || die "Mouse snap overlay sentinel missing overlay-rmse-normalized minimum"
    [ "$target_semantics" = whole-zone ] \
        || die "Mouse snap overlay sentinel must declare target-semantics=whole-zone"
    [ "$target_label" = "WHOLE ZONE TARGET: COMMS" ] \
        || die "Mouse snap overlay sentinel must provide a readable whole-zone target label"
    [ -n "$crop_geometry" ] || die "Mouse snap overlay sentinel missing target-zone crop geometry"
    case "$freeform_crop" in
        /*|*../*) die "Mouse snap freeform crop path must be run-relative: $freeform_crop" ;;
    esac
    case "$snap_crop" in
        /*|*../*) die "Mouse snap snap crop path must be run-relative: $snap_crop" ;;
    esac
    case "$target_label_crop" in
        screenshots/*.overlay-sentinel/*.png) ;;
        /*|*../*) die "Mouse snap target label crop path must be run-relative: $target_label_crop" ;;
        *) die "Mouse snap overlay sentinel missing labeled target crop path" ;;
    esac
    require_file "${RUN_DIR}/${freeform_crop}"
    require_file "${RUN_DIR}/${snap_crop}"
    require_file "${RUN_DIR}/${target_label_crop}"

    local crop_size expected_dimensions freeform_dimensions snap_dimensions target_label_dimensions
    crop_size="$(printf '%s\n' "$crop_geometry" | /usr/bin/sed -n 's/^\([0-9][0-9]*\)x\([0-9][0-9]*\)+[0-9][0-9]*+[0-9][0-9]*$/\1 \2/p')"
    [ -n "$crop_size" ] || die "Mouse snap overlay sentinel has invalid crop geometry: $crop_geometry"
    # shellcheck disable=SC2086
    set -- $crop_size
    expected_dimensions="${1}x${2}"
    freeform_dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${freeform_crop}")" \
        || die "Mouse snap freeform crop is not readable image media: ${RUN_DIR}/${freeform_crop}"
    snap_dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${snap_crop}")" \
        || die "Mouse snap snap crop is not readable image media: ${RUN_DIR}/${snap_crop}"
    target_label_dimensions="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0:s=x "${RUN_DIR}/${target_label_crop}")" \
        || die "Mouse snap target label crop is not readable image media: ${RUN_DIR}/${target_label_crop}"
    [ "$freeform_dimensions" = "$expected_dimensions" ] \
        || die "Mouse snap freeform crop dimensions ${freeform_dimensions} do not match ${expected_dimensions}"
    [ "$snap_dimensions" = "$expected_dimensions" ] \
        || die "Mouse snap snap crop dimensions ${snap_dimensions} do not match ${expected_dimensions}"
    [ "$target_label_dimensions" = "$expected_dimensions" ] \
        || die "Mouse snap target label crop dimensions ${target_label_dimensions} do not match ${expected_dimensions}"

    local slice_prefix source_freeform source_snap
    case "$recording_name" in
        slice-12-*) slice_prefix="slice-12" ;;
        slice-16-*) slice_prefix="slice-16" ;;
        slice-20-*) slice_prefix="slice-20" ;;
        slice-22-*) slice_prefix="slice-22" ;;
        slice-23-*) slice_prefix="slice-23" ;;
        slice-24-*) slice_prefix="slice-24" ;;
        *) slice_prefix="" ;;
    esac
    if [ -n "$slice_prefix" ]; then
        source_freeform="${SCREENSHOTS_DIR}/03-freeform-hover-no-overlay-${slice_prefix}.png"
        source_snap="${SCREENSHOTS_DIR}/07-snap-hover-comms-${slice_prefix}.png"
        require_file "$source_freeform"
        require_file "$source_snap"
        require_fresh_derived_file "${RUN_DIR}/${freeform_crop}" "$source_freeform" "Mouse snap freeform overlay crop"
        require_fresh_derived_file "${RUN_DIR}/${snap_crop}" "$source_snap" "Mouse snap snap overlay crop"
        require_fresh_derived_file "${RUN_DIR}/${target_label_crop}" "$source_snap" "Mouse snap labeled target crop"
        require_fresh_derived_file "$manifest_path" "$source_snap" "Mouse snap overlay sentinel"
    fi

    awk -v rmse="$rmse" -v minimum="$minimum" 'BEGIN { exit(rmse + 0 >= minimum + 0 ? 0 : 1) }' \
        || die "Mouse snap overlay RMSE ${rmse} is below required ${minimum}"
}

