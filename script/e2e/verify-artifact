    require_file "$(demo_recording_path)"
    require_file "$(demo_cut_manifest_path)"
    require_demo_cut_manifest "$recording_name" "$duration"
    require_slice_32_measurement_table "$measurements"
    require_drag_proof_manifest "$delegated_proof_manifest" 1

    grep -F 'PASS: dragging the Work|Comms divider, running save-zone-layout, and relaunching WinMux restores the dragged widths as configured layout widths without another resize command.' "$proof" >/dev/null \
        || die "Slice 32 proof does not contain the expected PASS claim"
    grep -F 'Action: drag Work|Comms divider, save-zone-layout, quit, relaunch, list-zones' "$setup_log" >/dev/null \
        || die "Slice 32 setup log missing command summary"
    [ "$(manifest_value "$delegated_proof_manifest" drag-target snap-target)" = zone-divider ] \
        || die "Slice 32 delegated proof must show a zone-divider drag target"
    [ "$(manifest_value "$delegated_proof_manifest" divider-policy target)" = adjacent-zone-boundary ] \
        || die "Slice 32 delegated proof must show an adjacent-zone-boundary divider policy"
    [ "$(manifest_value "$delegated_proof_manifest" divider-policy config-persistence)" = no-config-rewrite ] \
        || die "Slice 32 delegated proof must show divider drag did not rewrite config"

    require_exact_line_count "$save_log" '$ winmux save-zone-layout' 1 \
        "Slice 32 save log"
    require_no_command_variants "$save_log" '$ winmux save-zone-layout' '$ winmux save-zone-layout' \
        "Slice 32 save log"
    grep -F 'Saved zone layout' "$save_log" >/dev/null \
        || die "Slice 32 save log missing saved output"
    grep -F 'Backup:' "$save_log" >/dev/null \
        || die "Slice 32 save log missing backup path"
    require_exact_line_count "$relaunch_log" '$ launchctl bootout WinMux slice service' 1 \
        "Slice 32 relaunch log"
    require_no_command_variants "$relaunch_log" '$ launchctl bootout WinMux slice service' '$ launchctl bootout WinMux slice service' \
        "Slice 32 relaunch log"
    require_exact_line_count "$relaunch_log" '$ launchctl bootstrap WinMux slice service' 1 \
        "Slice 32 relaunch log"
    require_no_command_variants "$relaunch_log" '$ launchctl bootstrap WinMux slice service' '$ launchctl bootstrap WinMux slice service' \
        "Slice 32 relaunch log"
    grep -F 'stopped=yes' "$relaunch_log" >/dev/null \
        || die "Slice 32 relaunch log does not prove WinMux stopped"
    require_slice_31_startup_trace_loaded_relaunch_state "$startup_trace"
    if grep -F 'reload-config' "$relaunch_log" "$proof" "$cli_log" "$harness_setup_log" "$harness_run_log" >/dev/null; then
        die "Slice 32 relaunch proof must not use reload-config"
    fi
    if grep -F 'resize-zone' "$relaunch_log" "$cli_log" >/dev/null; then
        die "Slice 32 relaunch proof must not resize zones after launch"
    fi
    require_exact_line_count "$cli_log" '$ winmux save-zone-layout' 1 \
        "Slice 32 aggregate CLI log"
    require_exact_line_count "$cli_log" '$ launchctl bootout WinMux slice service' 1 \
        "Slice 32 aggregate CLI log"
    require_exact_line_count "$cli_log" '$ launchctl bootstrap WinMux slice service' 1 \
        "Slice 32 aggregate CLI log"

    local save_offset quit_offset relaunch_offset list_zones_offset
    save_offset="$(value_from_log save-command-offset-seconds "$timing_log")"
    quit_offset="$(value_from_log quit-command-offset-seconds "$timing_log")"
    relaunch_offset="$(value_from_log relaunch-command-offset-seconds "$timing_log")"
    list_zones_offset="$(value_from_log list-zones-after-relaunch-offset-seconds "$timing_log")"
    [ -n "$save_offset" ] || die "Slice 32 timing log missing save command offset"
    [ -n "$quit_offset" ] || die "Slice 32 timing log missing quit command offset"
    [ -n "$relaunch_offset" ] || die "Slice 32 timing log missing relaunch command offset"
    [ -n "$list_zones_offset" ] || die "Slice 32 timing log missing post-relaunch list-zones offset"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Run: winmux save-zone-layout" "$save_offset" \
        "Slice 32 save command must happen while its command caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Action: quit WinMux" "$quit_offset" \
        "Slice 32 quit action must happen while its quit caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Action: relaunch WinMux" "$relaunch_offset" \
        "Slice 32 relaunch action must happen while its relaunch caption is visible"
    require_annotation_chip_covers_offset "$annotation_plan" \
        "Run: winmux list-zones" "$list_zones_offset" \
        "Slice 32 post-relaunch list-zones command must happen while its command caption is visible"

    local before_left before_main before_right dragged_left dragged_main dragged_right
    local saved_left saved_main saved_right relaunched_left relaunched_main relaunched_right
    before_left="$(require_measurement_value "$measurements" before left effective)"
    before_main="$(require_measurement_value "$measurements" before main effective)"
    before_right="$(require_measurement_value "$measurements" before right effective)"
    dragged_left="$(require_measurement_value "$measurements" dragged left effective)"
    dragged_main="$(require_measurement_value "$measurements" dragged main effective)"
    dragged_right="$(require_measurement_value "$measurements" dragged right effective)"
    saved_left="$(require_measurement_value "$measurements" saved left effective)"
    saved_main="$(require_measurement_value "$measurements" saved main effective)"
    saved_right="$(require_measurement_value "$measurements" saved right effective)"
    relaunched_left="$(require_measurement_value "$measurements" relaunched left effective)"
    relaunched_main="$(require_measurement_value "$measurements" relaunched main effective)"
    relaunched_right="$(require_measurement_value "$measurements" relaunched right effective)"

    require_slice_32_measurements_match_zone_log "$measurements" before "$zones_before_drag"
    require_slice_32_measurements_match_zone_log "$measurements" dragged "$zones_after_drag"
    require_slice_32_measurements_match_zone_log "$measurements" saved "$zones_after_save"
    require_slice_32_measurements_match_zone_log "$measurements" relaunched "$zones_after_relaunch"

    assert_numeric_gt "$dragged_main" "$before_main" \
        "Slice 32 dragged Work/main width did not grow"
    assert_numeric_lt "$dragged_right" "$before_right" \
        "Slice 32 dragged Comms/right width did not shrink"
    assert_numeric_approximately_equal "$dragged_left" "$before_left" 0.001 \
        "Slice 32 dragged Reference/left width changed during adjacent divider drag"
    assert_numeric_approximately_equal "$saved_left" "$dragged_left" 0.000001 \
        "Slice 32 saved Reference effective width does not match dragged width"
    assert_numeric_approximately_equal "$saved_main" "$dragged_main" 0.000001 \
        "Slice 32 saved Work effective width does not match dragged width"
    assert_numeric_approximately_equal "$saved_right" "$dragged_right" 0.000001 \
        "Slice 32 saved Comms effective width does not match dragged width"
    assert_numeric_approximately_equal "$relaunched_left" "$dragged_left" 0.000001 \
        "Slice 32 relaunched Reference width does not match dragged saved width"
    assert_numeric_approximately_equal "$relaunched_main" "$dragged_main" 0.000001 \
        "Slice 32 relaunched Work width does not match dragged saved width"
    assert_numeric_approximately_equal "$relaunched_right" "$dragged_right" 0.000001 \
        "Slice 32 relaunched Comms width does not match dragged saved width"
    assert_numeric_approximately_equal "$(zone_log_value "$zones_after_relaunch" left configured)" "$dragged_left" 0.000001 \
        "Slice 32 relaunched Reference configured width does not match dragged width"
    assert_numeric_approximately_equal "$(zone_log_value "$zones_after_relaunch" main configured)" "$dragged_main" 0.000001 \
        "Slice 32 relaunched Work configured width does not match dragged width"
    assert_numeric_approximately_equal "$(zone_log_value "$zones_after_relaunch" right configured)" "$dragged_right" 0.000001 \
        "Slice 32 relaunched Comms configured width does not match dragged width"
    [ "$(zone_log_value "$zones_after_relaunch" left override-state)" = configured ] \
        || die "Slice 32 relaunched Reference should use configured width, not a runtime override"
    [ "$(zone_log_value "$zones_after_relaunch" main override-state)" = configured ] \
        || die "Slice 32 relaunched Work should use configured width, not a runtime override"
    [ "$(zone_log_value "$zones_after_relaunch" right override-state)" = configured ] \
        || die "Slice 32 relaunched Comms should use configured width, not a runtime override"
    require_zone_log_empty_or_none "$zones_after_relaunch" left override \
        "Slice 32 relaunched Reference runtime override value"
    require_zone_log_empty_or_none "$zones_after_relaunch" main override \
        "Slice 32 relaunched Work runtime override value"
    require_zone_log_empty_or_none "$zones_after_relaunch" right override \
        "Slice 32 relaunched Comms runtime override value"

    local before_chip dragged_chip saved_chip relaunched_chip
    before_chip="$(require_measurement_value "$measurements" before main chip)"
    dragged_chip="$(require_measurement_value "$measurements" dragged main chip)"
    saved_chip="$(require_measurement_value "$measurements" saved main chip)"
    relaunched_chip="$(require_measurement_value "$measurements" relaunched main chip)"
    [ "$before_chip" = 'Reference 25% | Work 50% | Comms 25%' ] \
        || die "Slice 32 before measurement chip is wrong: $before_chip"
    [ "$saved_chip" = "$dragged_chip" ] \
        || die "Slice 32 saved measurement chip does not match dragged chip"
    [ "$relaunched_chip" = "$dragged_chip" ] \
        || die "Slice 32 relaunched measurement chip does not match dragged chip"

    local before_sha save_sha backup_recorded_sha backup_copy_sha backup_path
    before_sha="$(cat "$config_sha_before_save")"
    save_sha="$(cat "$config_sha_after_save")"
    backup_recorded_sha="$(cat "$backup_sha")"
    backup_copy_sha="$(file_sha256 "$config_backup_copy")"
    backup_path="$(cat "$backup_path_log")"
    [ -n "$backup_path" ] || die "Slice 32 backup path log is empty"
    [ "$save_sha" != "$before_sha" ] \
        || die "Slice 32 save did not change config hash"
    [ "$backup_recorded_sha" = "$before_sha" ] && [ "$backup_copy_sha" = "$before_sha" ] \
        || die "Slice 32 backup does not match original config"
    [ "$(file_sha256 "$config_after_copy")" = "$save_sha" ] \
        || die "Slice 32 after config copy hash does not match saved hash"
    assert_numeric_approximately_equal "$(toml_width_for_zone "$config_after_copy" left)" "$dragged_left" 0.000001 \
        "Slice 32 saved config Reference width does not match dragged width"
    assert_numeric_approximately_equal "$(toml_width_for_zone "$config_after_copy" main)" "$dragged_main" 0.000001 \
        "Slice 32 saved config Work width does not match dragged width"
    assert_numeric_approximately_equal "$(toml_width_for_zone "$config_after_copy" right)" "$dragged_right" 0.000001 \
        "Slice 32 saved config Comms width does not match dragged width"

    [ "$(manifest_value "$proof_manifest" target layout-id)" = balanced ] \
        || die "Slice 32 proof manifest must record target layout id"
    [ "$(manifest_value "$proof_manifest" command drag)" = 'drag Work|Comms divider' ] \
        || die "Slice 32 proof manifest must record drag command"
    [ "$(manifest_value "$proof_manifest" command save)" = 'winmux save-zone-layout' ] \
        || die "Slice 32 proof manifest must record save command"
    [ "$(manifest_value "$proof_manifest" command relaunch)" = 'launchctl bootout/bootstrap WinMux slice service' ] \
        || die "Slice 32 proof manifest must record relaunch command"
    [ "$(manifest_value "$proof_manifest" command list-zones)" = 'winmux list-zones' ] \
        || die "Slice 32 proof manifest must record list-zones command"
    [ "$(manifest_value "$proof_manifest" timing save-command-offset-seconds)" = "$save_offset" ] \
        || die "Slice 32 proof manifest must copy save command offset"
    [ "$(manifest_value "$proof_manifest" timing quit-command-offset-seconds)" = "$quit_offset" ] \
        || die "Slice 32 proof manifest must copy quit command offset"
    [ "$(manifest_value "$proof_manifest" timing relaunch-command-offset-seconds)" = "$relaunch_offset" ] \
        || die "Slice 32 proof manifest must copy relaunch command offset"
    [ "$(manifest_value "$proof_manifest" timing list-zones-after-relaunch-offset-seconds)" = "$list_zones_offset" ] \
        || die "Slice 32 proof manifest must copy list-zones command offset"
    [ "$(manifest_value "$proof_manifest" safety backup-path)" = "$backup_path" ] \
        || die "Slice 32 proof manifest must copy backup path"
    [ "$(manifest_value "$proof_manifest" safety backup-matches-original)" = yes ] \
        || die "Slice 32 proof manifest must record backup-matches-original=yes"
    [ "$(manifest_value "$proof_manifest" drag source-proof)" = 'logs/slice-26-zone-divider-drag.proof-manifest.tsv' ] \
        || die "Slice 32 proof manifest must record delegated Slice 26 drag proof"
    [ "$(manifest_value "$proof_manifest" drag widths-changed)" = yes ] \
        || die "Slice 32 proof manifest must record widths-changed=yes"
    [ "$(manifest_value "$proof_manifest" save config-changed)" = yes ] \
        || die "Slice 32 proof manifest must record config-changed=yes"
    [ "$(manifest_value "$proof_manifest" relaunch app-stopped)" = yes ] \
        || die "Slice 32 proof manifest must record app-stopped=yes"
    [ "$(manifest_value "$proof_manifest" relaunch app-restarted)" = yes ] \
        || die "Slice 32 proof manifest must record app-restarted=yes"
    [ "$(manifest_value "$proof_manifest" relaunch dragged-widths-restored)" = yes ] \
        || die "Slice 32 proof manifest must record dragged-widths-restored=yes"
    [ "$(manifest_value "$proof_manifest" relaunch no-runtime-resize-after-launch)" = yes ] \
        || die "Slice 32 proof manifest must record no-runtime-resize-after-launch=yes"
    [ "$(manifest_value "$proof_manifest" relaunch runtime-override-values-cleared)" = yes ] \
        || die "Slice 32 proof manifest must record runtime-override-values-cleared=yes"
    [ "$(manifest_value "$proof_manifest" relaunch persisted-restart-state-loaded)" = yes ] \
        || die "Slice 32 proof manifest must record persisted-restart-state-loaded=yes"
    [ "$(manifest_value "$proof_manifest" continuity documents-in-same-zones)" = yes ] \
        || die "Slice 32 proof manifest must record documents-in-same-zones=yes"
    [ "$(manifest_value "$proof_manifest" measurement before)" = "$before_chip" ] \
        || die "Slice 32 proof manifest before measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" measurement dragged)" = "$dragged_chip" ] \
        || die "Slice 32 proof manifest dragged measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" measurement saved)" = "$saved_chip" ] \
        || die "Slice 32 proof manifest saved measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" measurement relaunched)" = "$relaunched_chip" ] \
        || die "Slice 32 proof manifest relaunched measurement does not match measurement TSV"
    [ "$(manifest_value "$proof_manifest" hash config-before-save)" = "$before_sha" ] \
        || die "Slice 32 proof manifest before-save config hash does not match copied hash"
    [ "$(manifest_value "$proof_manifest" hash config-after-save)" = "$save_sha" ] \
        || die "Slice 32 proof manifest after-save config hash does not match copied hash"
    [ "$(manifest_value "$proof_manifest" hash config-backup)" = "$backup_recorded_sha" ] \
        || die "Slice 32 proof manifest backup config hash does not match copied hash"

    local zone want_before want_dragged want_saved want_relaunched
    for zone in left main right; do
        case "$zone" in
            left)
                want_before="$before_left"
                want_dragged="$dragged_left"
                want_saved="$saved_left"
                want_relaunched="$relaunched_left"
                ;;
            main)
                want_before="$before_main"
                want_dragged="$dragged_main"
                want_saved="$saved_main"
                want_relaunched="$relaunched_main"
                ;;
            right)
                want_before="$before_right"
                want_dragged="$dragged_right"
                want_saved="$saved_right"
                want_relaunched="$relaunched_right"
                ;;
            *)
                die "Unexpected Slice 32 zone id in proof manifest loop: $zone"
                ;;
        esac
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-before "$zone")" "$want_before" 0.000001 \
            "Slice 32 proof manifest width-before/${zone} does not match measurement TSV"
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-dragged "$zone")" "$want_dragged" 0.000001 \
            "Slice 32 proof manifest width-dragged/${zone} does not match measurement TSV"
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-saved "$zone")" "$want_saved" 0.000001 \
            "Slice 32 proof manifest width-saved/${zone} does not match measurement TSV"
        assert_numeric_approximately_equal "$(require_manifest_value "$proof_manifest" width-relaunched "$zone")" "$want_relaunched" 0.000001 \
            "Slice 32 proof manifest width-relaunched/${zone} does not match measurement TSV"
    done

    local title expected_zone after_drag_zone after_relaunch_zone
    local extra_title_count
    extra_title_count="$(/usr/bin/awk 'NF { count++ } END { print count + 0 }' "$windows_after_relaunch")"
    [ "$extra_title_count" = "3" ] \
        || die "Slice 32 after-relaunch window log must list exactly three visible TextEdit task documents, got ${extra_title_count}: $windows_after_relaunch"
    for title in reference-divider.rtf work-divider.rtf comms-divider.rtf; do
        case "$title" in
            reference-divider.rtf) expected_zone=left ;;
            work-divider.rtf) expected_zone=main ;;
            comms-divider.rtf) expected_zone=right ;;
            *) expected_zone= ;;
        esac
        after_drag_zone="$(field_for_title "$windows_after_drag" "$title" zone)"
        after_relaunch_zone="$(field_for_title "$windows_after_relaunch" "$title" zone)"
        [ -n "$after_drag_zone" ] && [ -n "$after_relaunch_zone" ] \
            || die "Slice 32 missing title across drag/relaunch logs: $title"
        [ "$after_drag_zone" = "$expected_zone" ] && [ "$after_relaunch_zone" = "$expected_zone" ] \
            || die "Slice 32 zone changed for $title: $after_drag_zone -> $after_relaunch_zone"
    done

    for chip in \
        "Config: draggable divider + save-zone-layout" \
        "Action: drag Work|Comms divider" \
        "Result: dragged width overrides visible" \
        "Run: winmux save-zone-layout" \
        "Action: quit WinMux" \
        "Action: relaunch WinMux" \
        "Run: winmux list-zones" \
        "Result: dragged widths restored after relaunch"; do
        grep -F "$chip" "$annotation_plan" >/dev/null \
            || die "Slice 32 annotations missing chip: $chip"
    done

    grep -F "config-sha-before-save=${before_sha}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy before-save config hash"
    grep -F "config-sha-after-save=${save_sha}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy saved config hash"
    grep -F "config-backup-sha=${backup_recorded_sha}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy backup config hash"
    grep -F "backup-path=${backup_path}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy backup path"
    grep -F "measurement-before=${before_chip}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy before measurement chip"
    grep -F "measurement-dragged=${dragged_chip}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy dragged measurement chip"
    grep -F "measurement-relaunched=${relaunched_chip}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy relaunched measurement chip"
    grep -F "save-command-offset-seconds=${save_offset}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy save command offset"
    grep -F "quit-command-offset-seconds=${quit_offset}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy quit command offset"
    grep -F "relaunch-command-offset-seconds=${relaunch_offset}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy relaunch command offset"
    grep -F "list-zones-after-relaunch-offset-seconds=${list_zones_offset}" "$proof" >/dev/null \
        || die "Slice 32 proof does not copy post-relaunch list-zones offset"
}

