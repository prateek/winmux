    grep -F 'runtime-cycle-command=cycle-zone-snap-policy freeform snap-to-zone' "$action_log" >/dev/null \
        || die "Slice 20 action log missing cycle-zone-snap-policy command"
    grep -F 'runtime-policy-after-cycle=freeform' "$action_log" >/dev/null \
        || die "Slice 20 action log missing freeform cycle result"
    grep -F 'snap-target=whole-zone' "$action_log" >/dev/null \
        || die "Slice 20 action log missing whole-zone snap target"
    grep -F 'not-snap-target=window-within-zone' "$action_log" >/dev/null \
        || die "Slice 20 action log missing window-within-zone exclusion"
