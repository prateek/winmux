    if grep -F 'zone: Work' "$doc_content_log" >/dev/null || \
        grep -F 'zone: Comms' "$doc_content_log" >/dev/null || \
        grep -F 'right zone restored after toggle' "$doc_content_log" >/dev/null; then
        die "Slice 13 demo docs contain stale zone/future-state labels"
    fi

    for binding in \
        'binding=Alt-Z, L' \
        'binding=Alt-Z, Shift-L' \
        'binding=Alt-Z, Equal' \
        'binding=Alt-Z, 0' \
        'binding=Alt-Z, T'; do
        grep -F "$binding" "$action_log" >/dev/null || die "Slice 13 action log missing ${binding}"
    done
    for command in \
        'winmux-command=focus-zone next' \
        'winmux-command=move-node-to-zone --focus-follows-window next' \
        'winmux-command=resize-zone current width +10%' \
        'winmux-command=balance-zones' \
        'winmux-command=toggle-zone current'; do
        grep -F "$command" "$action_log" >/dev/null || die "Slice 13 action log missing ${command}"
    done
    grep -F '$ winmux trigger-binding --mode main alt-z' "$action_log" >/dev/null \
        || die "Slice 13 action log missing trigger-binding prefix command"
    grep -F '$ winmux trigger-binding --mode zone l' "$action_log" >/dev/null \
        || die "Slice 13 action log missing zone l trigger"
    grep -F '$ winmux trigger-binding --mode zone shift-l' "$action_log" >/dev/null \
        || die "Slice 13 action log missing zone shift-l trigger"
    grep -F '$ winmux trigger-binding --mode zone equal' "$action_log" >/dev/null \
        || die "Slice 13 action log missing zone equal trigger"
    grep -F '$ winmux trigger-binding --mode zone 0' "$action_log" >/dev/null \
        || die "Slice 13 action log missing zone 0 trigger"
    grep -F '$ winmux trigger-binding --mode zone t' "$action_log" >/dev/null \
        || die "Slice 13 action log missing zone t trigger"
    grep -F 'mode-after-alt-z=zone' "$action_log" >/dev/null \
        || die "Slice 13 action log does not prove Alt-Z enters zone mode"
    grep -F 'mode-after-binding=main' "$action_log" >/dev/null \
        || die "Slice 13 action log does not prove zone binding exits to main mode"

    local expected_action_log expected_action_diff
    expected_action_log="$(mktemp "${TMPDIR:-/tmp}/winmux-slice13-action-expected.XXXXXX")"
    expected_action_diff="$(mktemp "${TMPDIR:-/tmp}/winmux-slice13-action-diff.XXXXXX")"
    cat >"$expected_action_log" <<'EXPECTED_ACTION_LOG'
binding=Alt-Z, L
winmux-command=focus-zone next
$ winmux trigger-binding --mode main alt-z
mode-after-alt-z=zone
$ winmux trigger-binding --mode zone l
mode-after-binding=main
binding=Alt-Z, Shift-L
winmux-command=move-node-to-zone --focus-follows-window next
$ winmux trigger-binding --mode main alt-z
mode-after-alt-z=zone
$ winmux trigger-binding --mode zone shift-l
mode-after-binding=main
binding=Alt-Z, Equal
winmux-command=resize-zone current width +10%
$ winmux trigger-binding --mode main alt-z
mode-after-alt-z=zone
$ winmux trigger-binding --mode zone equal
Resized zone 'Comms' on monitor 1 by +10%
mode-after-binding=main
binding=Alt-Z, 0
winmux-command=balance-zones
$ winmux trigger-binding --mode main alt-z
mode-after-alt-z=zone
$ winmux trigger-binding --mode zone 0
Balanced zones on monitor 1
mode-after-binding=main
binding=Alt-Z, T
winmux-command=toggle-zone current
$ winmux trigger-binding --mode main alt-z
mode-after-alt-z=zone
$ winmux trigger-binding --mode zone t
Disabled zone 'Comms' on monitor 1
mode-after-binding=main
binding=Alt-Z, T
winmux-command=toggle-zone current
$ winmux trigger-binding --mode main alt-z
mode-after-alt-z=zone
$ winmux trigger-binding --mode zone t
Enabled zone 'Comms' on monitor 1
mode-after-binding=main
EXPECTED_ACTION_LOG
    if ! /usr/bin/diff -u "$expected_action_log" "$action_log" >"$expected_action_diff"; then
        cat "$expected_action_diff" >&2 || true
        rm -f "$expected_action_log" "$expected_action_diff"
        die "Slice 13 action log does not match the required ordered Alt-Z sequence"
    fi
    rm -f "$expected_action_log" "$expected_action_diff"

    for checkpoint in \
        before-focus-next \
        after-focus-next \
        after-move-next \
        after-resize-current \
        after-balance-zones \
        after-toggle-hidden \
        after-toggle-restored; do
        grep -F "checkpoint=${checkpoint}|" "$state_board_log" >/dev/null \
            || die "Slice 13 state board log missing checkpoint: ${checkpoint}"
        [ -n "$(state_board_field "$state_board_log" "$checkpoint" current-zone)" ] \
            || die "Slice 13 state board checkpoint ${checkpoint} missing current-zone"
        [ -n "$(state_board_field "$state_board_log" "$checkpoint" active-workspace)" ] \
            || die "Slice 13 state board checkpoint ${checkpoint} missing active-workspace"
        [ -n "$(state_board_field "$state_board_log" "$checkpoint" selected-window-id)" ] \
            || die "Slice 13 state board checkpoint ${checkpoint} missing selected-window-id"
        [ -n "$(state_board_field "$state_board_log" "$checkpoint" widths)" ] \
            || die "Slice 13 state board checkpoint ${checkpoint} missing widths"
        [ -n "$(state_board_field "$state_board_log" "$checkpoint" resolved-target)" ] \
            || die "Slice 13 state board checkpoint ${checkpoint} missing resolved-target"
    done
    [ "$(state_board_field "$state_board_log" before-focus-next current-zone)" = left ] \
        || die "Slice 13 before-focus-next state board should start in Reference/left"
    [ "$(state_board_field "$state_board_log" after-focus-next current-zone)" = main ] \
        || die "Slice 13 after-focus-next state board should show Work/main"
    [ "$(state_board_field "$state_board_log" after-move-next current-zone)" = right ] \
        || die "Slice 13 after-move-next state board should show Comms/right"
    [ "$(state_board_field "$state_board_log" before-focus-next resolved-target)" = main/Work ] \
        || die "Slice 13 before-focus-next should expose resolved target main/Work"
    [ "$(state_board_field "$state_board_log" after-focus-next resolved-target)" = main/Work ] \
        || die "Slice 13 after-focus-next should expose resolved target main/Work"
    [ "$(state_board_field "$state_board_log" after-move-next resolved-target)" = right/Comms ] \
        || die "Slice 13 after-move-next should expose resolved target right/Comms"
    [ "$(state_board_field "$state_board_log" after-resize-current resolved-target)" = right/Comms ] \
        || die "Slice 13 resize-current should expose resolved target right/Comms"
    [ "$(state_board_field "$state_board_log" after-balance-zones resolved-target)" = all-enabled-zones ] \
        || die "Slice 13 balance-zones should expose all-enabled-zones target"
    [ "$(state_board_field "$state_board_log" after-toggle-hidden resolved-target)" = right/Comms ] \
        || die "Slice 13 toggle-hidden should expose resolved target right/Comms"
    [ "$(state_board_field "$state_board_log" after-toggle-restored resolved-target)" = right/Comms ] \
        || die "Slice 13 toggle-restored should expose resolved target right/Comms"

    local work_alpha_id work_beta_id before_alpha_zone before_beta_zone after_move_alpha_zone after_move_beta_zone
    local restored_alpha_zone restored_beta_zone after_focus_zone
    work_alpha_id="$(value_from_log work-alpha-window-id "$setup_log")"
    work_beta_id="$(value_from_log work-beta-window-id "$setup_log")"
    [ -n "$work_alpha_id" ] && [ -n "$work_beta_id" ] || die "Slice 13 setup log missing Work window ids"

    before_alpha_zone="$(field_for_id "$windows_before" "$work_alpha_id" zone)"
    before_beta_zone="$(field_for_id "$windows_before" "$work_beta_id" zone)"
    after_focus_zone="$(field_for_id "$windows_after_focus" "$work_alpha_id" zone)"
    after_move_alpha_zone="$(field_for_id "$windows_after_move" "$work_alpha_id" zone)"
    after_move_beta_zone="$(field_for_id "$windows_after_move" "$work_beta_id" zone)"
    restored_alpha_zone="$(field_for_id "$windows_after_restored" "$work_alpha_id" zone)"
    restored_beta_zone="$(field_for_id "$windows_after_restored" "$work_beta_id" zone)"
    [ "$before_alpha_zone" = main ] || die "Slice 13 work alpha did not start in Work/main: ${before_alpha_zone:-missing}"
    [ "$before_beta_zone" = main ] || die "Slice 13 work beta did not start in Work/main: ${before_beta_zone:-missing}"
    [ "$after_focus_zone" = main ] || die "Slice 13 focus-next should focus Work/main before move"
    [ "$after_move_alpha_zone" = right ] || die "Slice 13 work alpha did not move to Comms/right: ${after_move_alpha_zone:-missing}"
    [ "$after_move_beta_zone" = right ] || die "Slice 13 work beta did not move to Comms/right: ${after_move_beta_zone:-missing}"
    [ "$restored_alpha_zone" = right ] || die "Slice 13 work alpha was not restored in Comms/right: ${restored_alpha_zone:-missing}"
    [ "$restored_beta_zone" = right ] || die "Slice 13 work beta was not restored in Comms/right: ${restored_beta_zone:-missing}"
    [[ "$(field_for_id "$windows_after_move" "$work_alpha_id" parent)" == *tab_group* ]] \
        || die "Slice 13 work alpha parent is not a tab group after move"
    [[ "$(field_for_id "$windows_after_move" "$work_beta_id" parent)" == *tab_group* ]] \
        || die "Slice 13 work beta parent is not a tab group after move"

    [ -z "$(field_for_id "$windows_after_hidden" "$work_alpha_id" title)" ] \
        || die "Slice 13 hidden window log should not show parked work alpha"
    [ -z "$(field_for_id "$windows_after_hidden" "$work_beta_id" title)" ] \
        || die "Slice 13 hidden window log should not show parked work beta"

    local right_width_before right_width_after_resize balanced_left balanced_main balanced_right hidden_right_enabled restored_right_enabled
    right_width_before="$(zone_log_value "$zones_after_move" right width)"
    right_width_after_resize="$(zone_log_value "$zones_after_resize" right width)"
    balanced_left="$(zone_log_value "$zones_after_balance" left width)"
    balanced_main="$(zone_log_value "$zones_after_balance" main width)"
    balanced_right="$(zone_log_value "$zones_after_balance" right width)"
    hidden_right_enabled="$(zone_log_value "$zones_after_hidden" right enabled)"
    restored_right_enabled="$(zone_log_value "$zones_after_restored" right enabled)"
    assert_numeric_gt "$right_width_after_resize" "$right_width_before" \
        "Slice 13 right zone did not grow after resize-zone current"
    assert_numeric_approximately_equal "$balanced_left" "$balanced_main" 3 \
        "Slice 13 balance-zones did not balance left/main widths"
    assert_numeric_approximately_equal "$balanced_main" "$balanced_right" 3 \
        "Slice 13 balance-zones did not balance main/right widths"
    if [ -n "$hidden_right_enabled" ]; then
        [ "$hidden_right_enabled" = false ] || die "Slice 13 hidden right zone should be disabled, got ${hidden_right_enabled}"
    fi
    [ "$restored_right_enabled" = true ] || die "Slice 13 restored right zone should be enabled"

    local focus_offset move_offset resize_offset balance_offset hide_offset restore_offset
    focus_offset="$(value_from_log focus-next-offset-seconds "$timing_log")"
    move_offset="$(value_from_log move-next-offset-seconds "$timing_log")"
    resize_offset="$(value_from_log resize-current-offset-seconds "$timing_log")"
    balance_offset="$(value_from_log balance-zones-offset-seconds "$timing_log")"
    hide_offset="$(value_from_log toggle-hidden-offset-seconds "$timing_log")"
    restore_offset="$(value_from_log toggle-restored-offset-seconds "$timing_log")"
    assert_numeric_between_inclusive "$focus_offset" 5 12 \
        "Slice 13 focus command must happen during the focus caption"
    assert_numeric_between_inclusive "$move_offset" 12 21 \
        "Slice 13 move command must happen during the move caption"
    assert_numeric_between_inclusive "$resize_offset" 21 30 \
        "Slice 13 resize command must happen during the resize caption"
    assert_numeric_between_inclusive "$balance_offset" 30 38 \
        "Slice 13 balance command must happen during the balance caption"
    assert_numeric_between_inclusive "$hide_offset" 38 47 \
        "Slice 13 hide command must happen during the hide caption"
    assert_numeric_between_inclusive "$restore_offset" 47 58 \
        "Slice 13 restore command must happen during the restore caption"

    grep -F "Config: alt-z = 'mode zone'" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing alt-z config chip"
    grep -F "Action: Alt-Z, L -> focus-zone next" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing focus-next chip"
    grep -F "Action: Alt-Z, Shift-L -> move-node-to-zone --focus-follows-window next" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing exact move-next chip"
    grep -F "Action: Alt-Z, Equal -> resize-zone current width +10%" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing exact resize-current chip"
    grep -F "Action: Alt-Z, 0 -> balance-zones" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing balance chip"
    grep -F "Action: Alt-Z, T -> toggle-zone current" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing toggle chip"
    local toggle_chip_count
    toggle_chip_count="$(grep -F -c "Action: Alt-Z, T -> toggle-zone current" "$annotation_plan" | tr -d ' ')"
    [ "$toggle_chip_count" -ge 2 ] \
        || die "Slice 13 annotations must show the actual toggle-zone current command for both hide and restore"
    grep -F "Run: winmux list-zones && winmux list-windows" "$annotation_plan" >/dev/null \
        || die "Slice 13 annotations missing final inspection chip"
    grep -F 'target right/Comms' "$sample_manifest" >/dev/null \
        || die "Slice 13 sample manifest must require visible resolved target right/Comms checks"

    if [ -f "$board_freshness_log" ]; then
        for checkpoint in \
            before-focus-next \
            after-focus-next \
            after-move-next \
            after-resize-current \
            after-balance-zones \
            after-toggle-hidden \
            after-toggle-restored; do
            grep -F "checkpoint=${checkpoint}|" "$board_freshness_log" | grep -F 'result=success' >/dev/null \
                || die "Slice 13 board freshness log missing success for checkpoint: ${checkpoint}"
        done
    fi
}

require_slice_14_zone_bindings_proof() {
    local proof="${RUN_DIR}/slice-14-zone-bindings-proof.txt"
    local done="${LOGS_DIR}/slice-14-zone-bindings.done"
    local setup_log="${LOGS_DIR}/slice-14-zone-bindings-setup.log"
    local before_bindings="${LOGS_DIR}/slice-14-bindings-before.log"
    local after_bindings="${LOGS_DIR}/slice-14-bindings-after.log"
    local before_windows="${LOGS_DIR}/slice-14-windows-before.log"
    local after_windows="${LOGS_DIR}/slice-14-windows-after.log"
    local apply_log="${LOGS_DIR}/slice-14-apply-zone-bindings.log"
    local timing_log="${LOGS_DIR}/slice-14-command-timing.log"
    local sample_dir="${SCREENSHOTS_DIR}/slice-14-zone-bindings.samples"

    require_file "$proof"
    require_success_marker "$done" "Slice 14"
    require_file "$setup_log"
    require_file "$before_bindings"
    require_file "$after_bindings"
    require_file "$before_windows"
    require_file "$after_windows"
    require_file "$apply_log"
    require_file "$timing_log"
    require_guest_transport_summary "${LOGS_DIR}/guest-transport-summary.tsv"
    require_file "${SCREENSHOTS_DIR}/01-ready-slice-14.png"

    grep -F 'PASS: apply-zone-bindings activated ReferenceDesk, WorkDesk, and CommsDesk in the left, main, and right zones without changing zone geometry.' "$proof" >/dev/null \
        || die "Slice 14 proof does not contain the expected PASS claim"
    grep -F '[[zone-bindings]]' "$CONFIG_PATH" >/dev/null \
        || die "Slice 14 config missing zone-bindings table"
    grep -F "workspace = 'ReferenceDesk'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 14 config missing ReferenceDesk binding"
    grep -F "workspace = 'WorkDesk'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 14 config missing WorkDesk binding"
    grep -F "workspace = 'CommsDesk'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 14 config missing CommsDesk binding"
    grep -F "alt-b = 'apply-zone-bindings'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 14 config missing apply-zone-bindings key binding"

    grep -F 'Config: [[zone-bindings]] ReferenceDesk + WorkDesk + CommsDesk' "$setup_log" >/dev/null \
        || die "Slice 14 setup log missing zone-bindings config summary"
    grep -F 'Command: apply-zone-bindings' "$setup_log" >/dev/null \
        || die "Slice 14 setup log missing apply-zone-bindings command summary"
    grep -F 'ready-state=unbound-before-documents-visible' "$setup_log" >/dev/null \
        || die "Slice 14 setup log does not prove the BEFORE documents were staged"
    grep -F '$ winmux apply-zone-bindings' "$apply_log" >/dev/null \
        || die "Slice 14 apply log missing exact command"
    grep -F 'Applied zone bindings on monitor 1: left=ReferenceDesk, main=WorkDesk, right=CommsDesk' "$apply_log" >/dev/null \
        || die "Slice 14 apply log missing expected success output"
    local apply_offset
    apply_offset="$(value_from_log apply-command-offset-seconds "$timing_log")"
    [ -n "$apply_offset" ] || die "Slice 14 timing log missing apply command offset"
    assert_numeric_between_inclusive "$apply_offset" 16 28 \
        "Slice 14 apply command must happen while the apply-zone-bindings command caption is on screen"
    grep -F "apply-command-offset-seconds=${apply_offset}" "$proof" >/dev/null \
        || die "Slice 14 proof does not copy apply command timing"

    local zone field before_value after_value
    for zone in left main right; do
        for field in name left width physical; do
            before_value="$(zone_log_value "$before_bindings" "$zone" "$field")"
            after_value="$(zone_log_value "$after_bindings" "$zone" "$field")"
            [ -n "$before_value" ] && [ -n "$after_value" ] \
                || die "Slice 14 missing ${field} for zone ${zone}"
            [ "$before_value" = "$after_value" ] \
                || die "Slice 14 changed ${field} for zone ${zone}: ${before_value} -> ${after_value}"
        done
    done

    [ "$(zone_log_value "$after_bindings" left workspace)" = ReferenceDesk ] \
        || die "Slice 14 after log should activate ReferenceDesk in left"
    [ "$(zone_log_value "$after_bindings" main workspace)" = WorkDesk ] \
        || die "Slice 14 after log should activate WorkDesk in main"
    [ "$(zone_log_value "$after_bindings" right workspace)" = CommsDesk ] \
        || die "Slice 14 after log should activate CommsDesk in right"
    [ "$(zone_log_value "$before_bindings" left workspace)" != ReferenceDesk ] \
        || die "Slice 14 before log already had ReferenceDesk active in left"
    [ "$(zone_log_value "$before_bindings" main workspace)" != WorkDesk ] \
        || die "Slice 14 before log already had WorkDesk active in main"
    [ "$(zone_log_value "$before_bindings" right workspace)" != CommsDesk ] \
        || die "Slice 14 before log already had CommsDesk active in right"

    local before_count after_count
    before_count="$(grep -c '^' "$before_windows" || true)"
    after_count="$(grep -c '^' "$after_windows" || true)"
    [ "$before_count" = 3 ] \
        || die "Slice 14 before visible TextEdit window count must be exactly 3, got ${before_count}"
    [ "$after_count" = 3 ] \
        || die "Slice 14 after visible TextEdit window count must be exactly 3, got ${after_count}"

    [ "$(field_for_title "$before_windows" 'before-reference-zone-binding.rtf' zone)" = left ] \
        || die "Slice 14 BEFORE REFERENCE document is not visible in left"
    [ "$(field_for_title "$before_windows" 'before-work-zone-binding.rtf' zone)" = main ] \
        || die "Slice 14 BEFORE WORK document is not visible in main"
    [ "$(field_for_title "$before_windows" 'before-comms-zone-binding.rtf' zone)" = right ] \
        || die "Slice 14 BEFORE COMMS document is not visible in right"
    [ -z "$(field_for_title "$before_windows" 'bound-reference-desk.rtf' id)" ] \
