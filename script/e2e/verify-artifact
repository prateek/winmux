    fi

    launch_arg_count="$(
        { /usr/libexec/PlistBuddy -c 'Print :ProgramArguments' "$launch_plist" 2>/dev/null || true; } \
            | /usr/bin/awk '/^    / { count++ } END { print count + 0 }'
