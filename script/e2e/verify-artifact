    local escaped_id rebind_id unbound_id stale_alpha_id stale_beta_id stale_key
    escaped_id="$(value_from_log ESCAPED_ID "$state_file")"
    rebind_id="$(value_from_log REBIND_ID "$state_file")"
    unbound_id="$(value_from_log UNBOUND_ID "$state_file")"
    stale_alpha_id="$(value_from_log STALE_ALPHA_ID "$state_file")"
    stale_beta_id="$(value_from_log STALE_BETA_ID "$state_file")"
    stale_key="$(value_from_log STALE_TAB_GROUP_KEY "$state_file")"
    [ -n "$escaped_id" ] || die "Slice 17 state file missing ESCAPED_ID"
    [ -n "$rebind_id" ] || die "Slice 17 state file missing REBIND_ID"
    [ -n "$unbound_id" ] || die "Slice 17 state file missing UNBOUND_ID"
    [ -n "$stale_alpha_id" ] || die "Slice 17 state file missing STALE_ALPHA_ID"
    [ -n "$stale_beta_id" ] || die "Slice 17 state file missing STALE_BETA_ID"
    [ -n "$stale_key" ] || die "Slice 17 state file missing STALE_TAB_GROUP_KEY"

    grep -F 'node-bindings=none' "$ready_bindings" >/dev/null \
        || die "Slice 17 ready bindings log must explicitly show zero node bindings"
    grep -F "checkpoint=ready" "$board_log" >/dev/null \
        || die "Slice 17 board log missing ready checkpoint"
    for checkpoint in ready-recording escaped-title rebind disabled-zone missing-unbind stale-prune final; do
        grep -F "checkpoint=${checkpoint}" "$board_log" >/dev/null \
            || die "Slice 17 board log missing checkpoint ${checkpoint}"
        grep -F "checkpoint=${checkpoint}|attempt=" "$board_freshness" >/dev/null \
            || die "Slice 17 board freshness log missing checkpoint ${checkpoint}"
    done

    grep -F "\$ winmux bind-node-to-zone --window-id ${escaped_id} Comms" "$escaped_command" >/dev/null \
        || die "Slice 17 escaped command log missing exact bind command"
    grep -F "Bound window:${escaped_id} to zone right on monitor 1" "$escaped_command" >/dev/null \
        || die "Slice 17 escaped command log missing success output"
    grep -F "node-id=window:${escaped_id}|" "$escaped_bindings" >/dev/null \
        || die "Slice 17 escaped bindings log missing expected window id"
    grep -F 'title=escaped\|equals\=guardrail.rtf' "$escaped_bindings" >/dev/null \
        || die "Slice 17 escaped bindings log missing escaped separator title"
    grep -F 'zone=right' "$escaped_bindings" >/dev/null \
        || die "Slice 17 escaped bindings row must target Comms/right"

    grep -F "\$ winmux bind-node-to-zone --window-id ${rebind_id} Reference" "$rebind_command" >/dev/null \
        || die "Slice 17 rebind log missing Reference bind command"
    grep -F "\$ winmux bind-node-to-zone --window-id ${rebind_id} Comms" "$rebind_command" >/dev/null \
        || die "Slice 17 rebind log missing Comms bind command"
    grep -F "node-id=window:${rebind_id}|" "$rebind_bindings" >/dev/null \
        || die "Slice 17 rebind bindings log missing expected window id"
    [ "$(grep -c '^node-id=' "$rebind_bindings" || true)" = 1 ] \
        || die "Slice 17 rebind must overwrite the existing binding, not create more rows"
    [ "$(binding_log_value "$rebind_bindings" zone)" = right ] \
        || die "Slice 17 rebind binding row must end in zone=right"
    [ "$(field_for_title "$windows_rebind" 'rebind-guardrail.rtf' zone)" = right ] \
        || die "Slice 17 rebind window is not visible in Comms/right after rebind"

    grep -F '$ winmux disable-zone Comms' "$disabled_command" >/dev/null \
        || die "Slice 17 disabled command log missing disable-zone command"
    grep -F "\$ winmux bind-node-to-zone --window-id ${unbound_id} Comms" "$disabled_command" >/dev/null \
        || die "Slice 17 disabled command log missing failed bind command"
    grep -F "Zone 'Comms' is disabled" "$disabled_command" >/dev/null \
        || die "Slice 17 disabled command log missing disabled-zone error"
    grep -F 'exit-code=1' "$disabled_command" >/dev/null \
        || die "Slice 17 disabled command log must include a failing exit code"
    grep -F 'node-bindings=none' "$disabled_bindings" >/dev/null \
        || die "Slice 17 disabled-zone failure must not create a binding"

    grep -F "\$ winmux unbind-node-zone-binding --window-id ${unbound_id}" "$missing_command" >/dev/null \
        || die "Slice 17 missing-unbind log missing exact command"
    grep -F "No node zone binding exists for window:${unbound_id}" "$missing_command" >/dev/null \
        || die "Slice 17 missing-unbind log missing expected error"
    grep -F 'exit-code=1' "$missing_command" >/dev/null \
        || die "Slice 17 missing-unbind log must include a failing exit code"
    grep -F 'node-bindings=none' "$missing_bindings" >/dev/null \
        || die "Slice 17 missing unbind must not create a binding"

    grep -F '$ winmux bind-node-to-zone Comms' "$stale_command" >/dev/null \
        || die "Slice 17 stale log missing bind-node-to-zone command"
    grep -F "\$ winmux close --window-id ${stale_beta_id}" "$stale_command" >/dev/null \
        || die "Slice 17 stale log missing close command"
    grep -F "node-id=${stale_key}|" "$stale_before_bindings" >/dev/null \
        || die "Slice 17 stale before bindings log missing tab-group key"
    grep -F 'node-type=tab-group' "$stale_before_bindings" >/dev/null \
        || die "Slice 17 stale before bindings log must be a tab-group binding"
    grep -F 'node-bindings=none' "$stale_after_bindings" >/dev/null \
        || die "Slice 17 stale after bindings log must show the binding was pruned"
    [ "$(field_for_title "$windows_stale_before" 'stale-alpha-guardrail.rtf' id)" = "$stale_alpha_id" ] \
        || die "Slice 17 stale alpha id missing before prune"
    [ "$(field_for_title "$windows_stale_before" 'stale-beta-guardrail.rtf' id)" = "$stale_beta_id" ] \
        || die "Slice 17 stale beta id missing before prune"
    [ "$(field_for_title "$windows_stale_after" 'stale-alpha-guardrail.rtf' zone)" = right ] \
        || die "Slice 17 stale alpha must remain in Comms/right after prune"
    [ -z "$(field_for_title "$windows_stale_after" 'stale-beta-guardrail.rtf' id)" ] \
        || die "Slice 17 stale beta should be closed before final stale-prune proof"
    grep -F 'node-bindings=none' "$final_bindings" >/dev/null \
        || die "Slice 17 final bindings log must show no runtime node bindings"

    local escaped_offset rebind_offset disabled_offset missing_offset stale_offset final_offset
    escaped_offset="$(value_from_log escaped-command-offset-seconds "$timing_log")"
    rebind_offset="$(value_from_log rebind-command-offset-seconds "$timing_log")"
    disabled_offset="$(value_from_log disabled-command-offset-seconds "$timing_log")"
    missing_offset="$(value_from_log missing-unbind-offset-seconds "$timing_log")"
    stale_offset="$(value_from_log stale-prune-offset-seconds "$timing_log")"
    final_offset="$(value_from_log final-count-offset-seconds "$timing_log")"
    assert_numeric_between_inclusive "$escaped_offset" 8 18 \
        "Slice 17 escaped title command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$rebind_offset" 18 28 \
        "Slice 17 rebind command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$disabled_offset" 28 38 \
        "Slice 17 disabled-zone command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$missing_offset" 38 48 \
        "Slice 17 missing-unbind command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$stale_offset" 48 62 \
        "Slice 17 stale-prune command must happen while its caption is on screen"
    assert_numeric_between_inclusive "$final_offset" 62 70 \
        "Slice 17 final count command must happen while its caption is on screen"

    for chip in \
        "Run: winmux list-zone-bindings --count" \
        "Run: winmux bind-node-to-zone --window-id \"\$ESCAPED_ID\" Comms" \
        "Run: winmux bind-node-to-zone --window-id \"\$REBIND_ID\" Reference" \
        "Run: winmux disable-zone Comms && bind-node-to-zone Comms" \
        "Run: winmux unbind-node-zone-binding --window-id \"\$UNBOUND_ID\"" \
        "Run: winmux close --window-id \"\$STALE_BETA_ID\""; do
        grep -F "$chip" "$annotation_plan" >/dev/null \
            || die "Slice 17 annotations missing chip: $chip"
    done
    grep -F 'no relaunch persistence is claimed' "$annotation_plan" >/dev/null \
        || die "Slice 17 annotations must explicitly avoid a relaunch-persistence claim"
}

