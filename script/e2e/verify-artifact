    require_file "${SCREENSHOTS_DIR}/01-ready-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/02-before-focus-next-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/03-after-focus-next-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/04-after-move-next-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/05-after-resize-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/06-after-balance-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/07-after-toggle-hidden-slice-13.png"
    require_file "${SCREENSHOTS_DIR}/08-after-toggle-restored-slice-13.png"

    grep -F 'PASS: Alt-Z zone mode bindings focus next zone, move a focused Work tab group to the next zone, resize current zone, balance zones, and toggle current zone hidden/restored with live state board proof.' "$proof" >/dev/null \
        || die "Slice 13 proof does not contain the expected PASS claim"
    grep -F "alt-z = 'mode zone'" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing alt-z zone mode binding"
    grep -F "[mode.zone.binding]" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing zone mode table"
    grep -F "l = ['focus-zone next', 'mode main']" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing L focus-next binding"
    grep -F "shift-l = ['move-node-to-zone --focus-follows-window next', 'mode main']" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing Shift-L move-next binding"
    grep -F "equal = ['resize-zone current width +10%', 'mode main']" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing Equal resize-current binding"
    grep -F "\"0\" = ['balance-zones', 'mode main']" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing 0 balance binding"
    grep -F "t = ['toggle-zone current', 'mode main']" "$CONFIG_PATH" >/dev/null \
        || die "Slice 13 config missing T toggle-current binding"
    grep -F 'role: tab group member A' "$doc_content_log" >/dev/null \
