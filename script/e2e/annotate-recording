#!/usr/bin/env bash
set -euo pipefail

INPUT_PATH="${1:-}"
CAPTIONS_PATH="${2:-}"
OUTPUT_PATH="${3:-}"

usage() {
    cat <<EOF
Usage: $(basename "$0") <input.mov> <captions.tsv> <output.mov>

captions.tsv format:
  start_seconds<TAB>end_seconds<TAB>title<TAB>subtitle<TAB>chip[<TAB>chip...]
EOF
}

die() {
    printf '[winmux-annotate] error: %s\n' "$*" >&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

[ -n "$INPUT_PATH" ] && [ -n "$CAPTIONS_PATH" ] && [ -n "$OUTPUT_PATH" ] || {
    usage >&2
    exit 1
}

require_cmd ffmpeg
require_cmd ffprobe
require_cmd magick

[ -s "$INPUT_PATH" ] || die "Missing or empty input video: $INPUT_PATH"
[ -s "$CAPTIONS_PATH" ] || die "Missing or empty captions file: $CAPTIONS_PATH"
mkdir -p "$(dirname "$OUTPUT_PATH")"

video_width="$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$INPUT_PATH")"
video_height="$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "$INPUT_PATH")"
duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$INPUT_PATH")"
[ -n "$video_width" ] && [ -n "$video_height" ] || die "Could not read video dimensions from $INPUT_PATH"

font="/System/Library/Fonts/SFNS.ttf"
if [ ! -f "$font" ]; then
    font="/System/Library/Fonts/Supplemental/Arial.ttf"
fi
[ -f "$font" ] || die "Could not find a usable caption font"
mono_font="/System/Library/Fonts/SFNSMono.ttf"
if [ ! -f "$mono_font" ]; then
    mono_font="$font"
fi

recording_name="$(basename "$OUTPUT_PATH" .mov)"
recordings_dir="$(cd "$(dirname "$OUTPUT_PATH")" && pwd -P)"
run_dir="$(cd "${recordings_dir}/.." && pwd -P)"
asset_dir="${run_dir}/logs/${recording_name}.annotation-assets"
mkdir -p "$asset_dir"
rm -f "${asset_dir}/"*.png

caption_footprint="${WINMUX_E2E_CAPTION_FOOTPRINT:-standard}"
caption_anchor="${WINMUX_E2E_CAPTION_ANCHOR:-bottom-left}"
case "$caption_footprint" in
    standard|compact) ;;
    *) die "Unsupported WINMUX_E2E_CAPTION_FOOTPRINT: $caption_footprint" ;;
esac
case "$caption_anchor" in
    bottom-left|bottom-right|top-left|top-right) ;;
    *) die "Unsupported WINMUX_E2E_CAPTION_ANCHOR: $caption_anchor" ;;
esac

margin=$((video_width / 34))
if [ "$margin" -lt 72 ]; then margin=72; fi
card_width=$((video_width * 54 / 100))
max_card_width=$((video_width - (margin * 2)))
if [ "$card_width" -gt "$max_card_width" ]; then card_width="$max_card_width"; fi
card_height=$((video_height * 18 / 100))
if [ "$card_height" -lt 190 ]; then card_height=190; fi
if [ "$card_height" -gt 260 ]; then card_height=260; fi
badge_size=$((video_width / 118))
title_size=$((video_width / 55))
subtitle_size=$((video_width / 92))
command_size=$((video_width / 110))
if [ "$badge_size" -lt 22 ]; then badge_size=22; fi
if [ "$title_size" -lt 40 ]; then title_size=40; fi
if [ "$subtitle_size" -lt 25 ]; then subtitle_size=25; fi
if [ "$command_size" -lt 22 ]; then command_size=22; fi
if [ "$caption_footprint" = compact ]; then
    margin=$((video_width / 44))
    if [ "$margin" -lt 52 ]; then margin=52; fi
    card_width=$((video_width * 42 / 100))
    max_card_width=$((video_width - (margin * 2)))
    if [ "$card_width" -gt "$max_card_width" ]; then card_width="$max_card_width"; fi
    card_height=$((video_height * 14 / 100))
    if [ "$card_height" -lt 200 ]; then card_height=200; fi
    if [ "$card_height" -gt 220 ]; then card_height=220; fi
    badge_size=$((video_width / 140))
    title_size=$((video_width / 68))
    subtitle_size=$((video_width / 112))
    command_size=$((video_width / 130))
    if [ "$badge_size" -lt 18 ]; then badge_size=18; fi
    if [ "$title_size" -lt 32 ]; then title_size=32; fi
    if [ "$subtitle_size" -lt 21 ]; then subtitle_size=21; fi
    if [ "$command_size" -lt 19 ]; then command_size=19; fi
fi
case "$caption_anchor" in
    bottom-left)
        card_x="$margin"
        card_y=$((video_height - margin - card_height))
        ;;
    bottom-right)
        card_x=$((video_width - margin - card_width))
        card_y=$((video_height - margin - card_height))
        ;;
    top-left)
        card_x="$margin"
        card_y="$margin"
        ;;
    top-right)
        card_x=$((video_width - margin - card_width))
        card_y="$margin"
        ;;
esac

render_card() {
    local title="$1"
    local subtitle="$2"
    local output="$3"
    shift 3
    local chips=("$@")
    local escaped_title escaped_subtitle
    local local_card_x=0
    local local_card_y=0
    local local_card_x2="$card_width"
    local local_card_y2="$card_height"
    local local_accent_x2=12
    local local_text_x=42
    local local_badge_y=46
    local local_title_y=105
    local local_subtitle_y=158
    local local_command_box_y1=$((card_height - 65))
    local local_command_box_y2=$((card_height - 20))
    local local_command_text_y=$((local_command_box_y1 + 31))
    local local_command_box_x1="$local_text_x"
    local local_command_box_x2=$((card_width - 32))
    local chip_count="${#chips[@]}"
    local local_chip_size="$command_size"
    local local_chip_line_height
    local local_command_box_height
    if [ "$caption_footprint" = compact ]; then
        local_accent_x2=10
        local_text_x=34
        local_badge_y=32
        local_title_y=76
        local_subtitle_y=108
        local_command_box_y1=$((card_height - 68))
        local_command_box_y2=$((card_height - 16))
        local_command_text_y=$((local_command_box_y1 + 32))
        local_command_box_x1="$local_text_x"
        local_command_box_x2=$((card_width - 28))
    fi
    if [ "$chip_count" -gt 2 ]; then
        local_chip_size=$((command_size * 85 / 100))
        if [ "$local_chip_size" -lt 18 ]; then
            local_chip_size=18
        fi
    fi
    local_chip_line_height=$((local_chip_size + 11))
    if [ "$chip_count" -gt 0 ]; then
        local_command_box_y2=$((card_height - 20))
        if [ "$caption_footprint" = compact ]; then
            local_command_box_y2=$((card_height - 16))
        fi
        local_command_box_height=$((local_chip_line_height * chip_count + 18))
        local_command_box_y1=$((local_command_box_y2 - local_command_box_height))
        local_command_text_y=$((local_command_box_y1 + local_chip_size + 8))
    fi
    escaped_title="$(magick_escape_text "$title")"
    escaped_subtitle="$(magick_escape_text "$subtitle")"

    magick \
        -size "${card_width}x${card_height}" xc:none \
        -fill 'rgba(10,12,18,0.80)' \
        -draw "roundrectangle ${local_card_x},${local_card_y} ${local_card_x2},${local_card_y2} 24,24" \
        -fill 'rgba(80,220,170,0.95)' \
        -draw "roundrectangle ${local_card_x},${local_card_y} ${local_accent_x2},${local_card_y2} 24,24" \
        -font "$font" \
        -fill '#93F2C7' \
        -pointsize "$badge_size" \
        -annotate +"${local_text_x}+${local_badge_y}" 'WINMUX COLUMN ZONES' \
        -fill '#FFFFFF' \
        -pointsize "$title_size" \
        -annotate +"${local_text_x}+${local_title_y}" "$escaped_title" \
        -fill '#D9DEE8' \
        -pointsize "$subtitle_size" \
        -annotate +"${local_text_x}+${local_subtitle_y}" "$escaped_subtitle" \
        "$output"

    if [ "$chip_count" -gt 0 ]; then
        magick "$output" \
            -fill 'rgba(255,255,255,0.10)' \
            -draw "roundrectangle ${local_command_box_x1},${local_command_box_y1} ${local_command_box_x2},${local_command_box_y2} 14,14" \
            "$output"
        local index chip escaped_chip chip_color chip_y
        for index in "${!chips[@]}"; do
            chip="${chips[$index]}"
            escaped_chip="$(magick_escape_text "$chip")"
            chip_color='#F4F7FA'
            case "$chip" in
                Result:*) chip_color='#C8FFE4' ;;
                Config:*) chip_color='#93F2C7' ;;
                Debug:*) chip_color='#D9DEE8' ;;
            esac
            chip_y=$((local_command_text_y + (index * local_chip_line_height)))
            magick "$output" \
                -font "$mono_font" \
                -fill "$chip_color" \
                -pointsize "$local_chip_size" \
                -annotate +"$((local_command_box_x1 + 18))+${chip_y}" "$escaped_chip" \
                "$output"
        done
    fi
}

magick_escape_text() {
    local text="$1"
    text="${text//\\/\\\\}"
    text="${text//%/\\%}"
    printf '%s\n' "$text"
}

input_args=(-hide_banner -loglevel error -y -i "$INPUT_PATH")
filter_parts=('[0:v]setpts=PTS-STARTPTS[base0]')
previous='[base0]'
caption_count=0

while IFS= read -r caption_line || [ -n "${caption_line:-}" ]; do
    case "${caption_line:-}" in
        ''|'#'*) continue ;;
    esac
    IFS=$'\t' read -r -a caption_fields <<<"$caption_line"
    [ "${#caption_fields[@]}" -ge 4 ] || die "Caption ${caption_count} has fewer than four TSV columns"
    start_time="${caption_fields[0]}"
    end_time="${caption_fields[1]}"
    title="${caption_fields[2]}"
    subtitle="${caption_fields[3]}"
    [ -n "${end_time:-}" ] || die "Caption ${caption_count} is missing end time"
    [ -n "${title:-}" ] || die "Caption ${caption_count} is missing title"
    subtitle="${subtitle:-}"
    chips=()
    if [ "${#caption_fields[@]}" -gt 4 ]; then
        for ((field_index = 4; field_index < ${#caption_fields[@]}; field_index++)); do
            if [ -n "${caption_fields[$field_index]:-}" ]; then
                chips+=("${caption_fields[$field_index]}")
            fi
        done
    fi

    caption_count=$((caption_count + 1))
    overlay_path="${asset_dir}/caption-${caption_count}.png"
    render_card "$title" "$subtitle" "$overlay_path" "${chips[@]}"
    input_args+=(-loop 1 -t "$duration" -i "$overlay_path")

    next="[v${caption_count}]"
    filter_parts+=("${previous}[${caption_count}:v]overlay=${card_x}:${card_y}:enable=between(t\\,${start_time}\\,${end_time})${next}")
    previous="$next"
done <"$CAPTIONS_PATH"

[ "$caption_count" -gt 0 ] || die "Captions file did not contain any captions: $CAPTIONS_PATH"

filter_complex="$(IFS=';'; printf '%s' "${filter_parts[*]}")"

ffmpeg "${input_args[@]}" \
    -filter_complex "$filter_complex" \
    -map "$previous" \
    -map 0:a? \
    -c:v h264_videotoolbox \
    -b:v 12M \
    -pix_fmt yuv420p \
    -c:a copy \
    -movflags +faststart \
    "$OUTPUT_PATH"

[ -s "$OUTPUT_PATH" ] || die "Annotated recording did not produce a non-empty file: $OUTPUT_PATH"
printf 'input=%s\n' "$INPUT_PATH"
printf 'output=%s\n' "$OUTPUT_PATH"
printf 'captions=%s\n' "$CAPTIONS_PATH"
printf 'caption_count=%s\n' "$caption_count"
printf 'width=%s\n' "$video_width"
printf 'height=%s\n' "$video_height"
printf 'caption_footprint=%s\n' "$caption_footprint"
printf 'caption_anchor=%s\n' "$caption_anchor"
printf 'card_width=%s\n' "$card_width"
printf 'card_height=%s\n' "$card_height"
printf 'result=success\n'
