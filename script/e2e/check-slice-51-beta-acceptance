#!/usr/bin/env bash
set -euo pipefail

RUN_DIR=""
REQUIRE_REVIEW=0
CLOSEOUT=0
SELF_TEST=0
SELF_TEST_TMP_DIR=""

usage() {
    cat <<EOF
Usage: $(basename "$0") [--require-review] [--closeout] <run-dir>
       $(basename "$0") --self-test

Validates a Slice 51 beta-acceptance artifact: package provenance, acceptance
path proof, stateful retry policy, blocker classification, support-bundle
evidence, review format, and closeout files.
EOF
}

die() {
    printf '[winmux-slice51] error: %s\n' "$*" >&2
    exit 1
}

sha256_file() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{ print $1 }'
}

sha256_path() {
    local path="$1"
    if [ -f "$path" ]; then
        sha256_file "$path"
        return
    fi
    [ -d "$path" ] || die "missing hash path: $path"
    (
        cd "$path"
        find . -type f -print0 | /usr/bin/sort -z | while IFS= read -r -d '' file; do
            /usr/bin/shasum -a 256 "$file"
        done
    ) | /usr/bin/shasum -a 256 | /usr/bin/awk '{ print $1 }'
}

first_nonblank_line() {
    /usr/bin/awk 'NF { print; exit }' "$1"
}

last_nonblank_line() {
    /usr/bin/awk 'NF { line = $0 } END { print line }' "$1"
}

env_value() {
    local key="$1"
    local file="$2"
    /usr/bin/awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$file"
}

require_env_value() {
    local key="$1"
    local file="$2"
    local value
    value="$(env_value "$key" "$file")"
    [ -n "$value" ] || die "missing ${file#"$RUN_DIR"/} key: $key"
    printf '%s\n' "$value"
}

require_file_under_run() {
    local path="$1"
    [ -s "${RUN_DIR}/${path}" ] || die "missing artifact file: ${path}"
}

require_dir_under_run() {
    local path="$1"
    [ -d "${RUN_DIR}/${path}" ] || die "missing artifact directory: ${path}"
}

require_slice_51_screenshot_sequence() {
    local screenshot
    for screenshot in \
        screenshots/02-package-provenance-slice-51.png \
        screenshots/03-fresh-install-slice-51.png \
        screenshots/04-permissions-setup-slice-51.png \
        screenshots/05-normal-launch-slice-51.png \
        screenshots/06-routing-keyboard-slice-51.png \
        screenshots/07-mouse-snap-slice-51.png \
        screenshots/08-profile-layout-slice-51.png \
        screenshots/09-save-relaunch-slice-51.png \
        screenshots/10-support-bundle-slice-51.png \
        screenshots/11-final-beta-acceptance-slice-51.png; do
        require_file_under_run "$screenshot"
        validate_image_media "$screenshot" exact
    done
}

required_record_seconds() {
    if [ "$SELF_TEST" -eq 1 ] || [ "${WINMUX_E2E_SLICE51_SELF_TEST_CONTRACT:-}" = "1" ]; then
        printf '1\n'
    else
        printf '180\n'
    fi
}

required_display_width() {
    if [ "$SELF_TEST" -eq 1 ] || [ "${WINMUX_E2E_SLICE51_SELF_TEST_CONTRACT:-}" = "1" ]; then
        printf '100\n'
    else
        printf '3440\n'
    fi
}

required_display_height() {
    if [ "$SELF_TEST" -eq 1 ] || [ "${WINMUX_E2E_SLICE51_SELF_TEST_CONTRACT:-}" = "1" ]; then
        printf '80\n'
    else
        printf '1440\n'
    fi
}

require_tool() {
    command -v "$1" >/dev/null 2>&1 || die "missing media validation tool: $1"
}

validate_image_media() {
    local path="$1"
    local mode="${2:-min}"
    local width height
    require_file_under_run "$path"
    width="$(/usr/bin/sips -g pixelWidth "${RUN_DIR}/${path}" 2>/dev/null | /usr/bin/awk '/pixelWidth:/ { print $2; exit }')" \
        || die "image is not readable media: ${path}"
    height="$(/usr/bin/sips -g pixelHeight "${RUN_DIR}/${path}" 2>/dev/null | /usr/bin/awk '/pixelHeight:/ { print $2; exit }')" \
        || die "image is not readable media: ${path}"
    [ -n "$width" ] && [ -n "$height" ] || die "image has no readable dimensions: ${path}"
    if [ "$mode" = "exact" ]; then
        [ "$width" = "$(required_display_width)" ] || die "${path} width ${width} does not match Slice 51 display width $(required_display_width)"
        [ "$height" = "$(required_display_height)" ] || die "${path} height ${height} does not match Slice 51 display height $(required_display_height)"
    else
        [ "$width" -ge 40 ] || die "${path} width is too small: ${width}"
        [ "$height" -ge 30 ] || die "${path} height is too small: ${height}"
    fi
}

validate_recording_media() {
    local path="$1"
    local duration width height frames codec
    require_file_under_run "$path"
    require_tool ffprobe
    duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "${RUN_DIR}/${path}")" \
        || die "recording is not playable: ${path}"
    width="$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "${RUN_DIR}/${path}")" \
        || die "recording has no readable width: ${path}"
    height="$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "${RUN_DIR}/${path}")" \
        || die "recording has no readable height: ${path}"
    codec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "${RUN_DIR}/${path}")" \
        || die "recording has no readable codec: ${path}"
    frames="$(ffprobe -v error -select_streams v:0 -count_frames -show_entries stream=nb_read_frames -of default=noprint_wrappers=1:nokey=1 "${RUN_DIR}/${path}")" \
        || die "recording has no readable frame count: ${path}"
    /usr/bin/awk -v duration="$duration" -v expected="$(required_record_seconds)" \
        'BEGIN { exit(duration + 0 >= expected * 0.80 ? 0 : 1) }' \
        || die "${path} duration ${duration}s is shorter than 80% of requested $(required_record_seconds)s"
    [ -n "$codec" ] || die "recording codec is missing: ${path}"
    [ "${frames:-0}" -gt 5 ] || die "recording frame count is too low for ${path}: ${frames:-0}"
    [ "$width" = "$(required_display_width)" ] || die "${path} width ${width} does not match Slice 51 display width $(required_display_width)"
    [ "$height" = "$(required_display_height)" ] || die "${path} height ${height} does not match Slice 51 display height $(required_display_height)"
}

require_text() {
    local path="$1"
    local text="$2"
    /usr/bin/grep -F -- "$text" "${RUN_DIR}/${path}" >/dev/null \
        || die "${path} missing required text: ${text}"
}

reject_text_regex() {
    local path="$1"
    local regex="$2"
    if /usr/bin/grep -Eiq "$regex" "${RUN_DIR}/${path}"; then
        die "${path} contains forbidden text matching: ${regex}"
    fi
}

summary_value() {
    local path="$1"
    local phase="$2"
    local column="$3"
    /usr/bin/awk -F'\t' -v phase="$phase" -v column="$column" '
        NR == 1 {
            for (i = 1; i <= NF; i++) {
                name = $i
                sub(/^# /, "", name)
                column_index[name] = i
            }
            next
        }
        $1 == phase {
            if (!(column in column_index)) {
                exit 2
            }
            print $(column_index[column])
            found = 1
            exit
        }
        END {
            if (!found) {
                exit 1
            }
        }
    ' "$path"
}

validate_manifest() {
    local manifest="${RUN_DIR}/logs/beta-acceptance-manifest.txt"
    [ -s "$manifest" ] || die "missing beta acceptance manifest: logs/beta-acceptance-manifest.txt"
    /usr/bin/grep -Fx 'kind=beta-acceptance' "$manifest" >/dev/null \
        || die "Slice 51 manifest must contain kind=beta-acceptance"
    /usr/bin/grep -Fx 'slice=51' "$manifest" >/dev/null \
        || die "Slice 51 manifest must contain slice=51"
}

validate_package_provenance() {
    local provenance="${RUN_DIR}/logs/package-provenance.env"
    local package_command package_path package_sha app_path app_sha cli_path cli_sha
    [ -s "$provenance" ] || die "missing package provenance: logs/package-provenance.env"
    package_command="$(require_env_value package_command "$provenance")"
    case "$package_command" in
        *PUBLISH=1*) die "package command must not publish: ${package_command}" ;;
    esac
    case "$package_command" in
        *PUBLISH=0*) ;;
        *) die "package command must make PUBLISH=0 explicit: ${package_command}" ;;
    esac
    package_path="$(require_env_value package_path "$provenance")"
    package_sha="$(require_env_value package_sha256 "$provenance")"
    app_path="$(require_env_value app_path "$provenance")"
    app_sha="$(require_env_value app_sha256 "$provenance")"
    cli_path="$(require_env_value cli_path "$provenance")"
    cli_sha="$(require_env_value cli_sha256 "$provenance")"
    require_file_under_run "$package_path"
    [ -e "${RUN_DIR}/${app_path}" ] || die "missing packaged app path: ${app_path}"
    require_file_under_run "$cli_path"
    [ "$(sha256_path "${RUN_DIR}/${package_path}")" = "$package_sha" ] \
        || die "package hash mismatch: ${package_path}"
    [ "$(sha256_path "${RUN_DIR}/${app_path}")" = "$app_sha" ] \
        || die "app hash mismatch: ${app_path}"
    [ "$(sha256_path "${RUN_DIR}/${cli_path}")" = "$cli_sha" ] \
        || die "CLI hash mismatch: ${cli_path}"
}

validate_preflight_media_contract() {
    local preflight="${RUN_DIR}/logs/preflight.log"
    local vm_display record_seconds capture_mode require_guest_control annotate_recording
    require_file_under_run "logs/preflight.log"
    vm_display="$(env_value vm_display "$preflight")"
    record_seconds="$(env_value record_seconds "$preflight")"
    capture_mode="$(env_value capture_mode "$preflight")"
    require_guest_control="$(env_value require_guest_control "$preflight")"
    annotate_recording="$(env_value annotate_recording "$preflight")"
    [ "$vm_display" = "$(required_display_width)x$(required_display_height)px" ] \
        || die "Slice 51 preflight must use $(required_display_width)x$(required_display_height)px display, got: ${vm_display:-missing}"
    [ "$record_seconds" = "$(required_record_seconds)" ] \
        || die "Slice 51 preflight must request $(required_record_seconds)s, got: ${record_seconds:-missing}"
    [ "$capture_mode" = "guest" ] || die "Slice 51 must use guest capture, got: ${capture_mode:-missing}"
    [ "$require_guest_control" = "1" ] || die "Slice 51 must require guest control"
    [ "$annotate_recording" = "1" ] || die "Slice 51 must annotate the recording"
}

manifest_path_column() {
    local manifest="$1"
    local column="$2"
    local context="$3"
    local col1 col5 col6 rest path
    while IFS=$'\t' read -r col1 _ _ _ col5 col6 rest; do
        [ -n "$col1" ] || continue
        case "$col1" in \#*) continue ;; esac
        if [ "$column" = "5" ]; then
            path="$col5"
        else
            path="$col6"
        fi
        [ -n "$path" ] || die "${context} has a row without a media path: ${col1}"
        require_file_under_run "$path"
        case "$path" in
            screenshots/*.png|screenshots/*.jpg|screenshots/*.jpeg)
                validate_image_media "$path"
                ;;
        esac
    done <"$manifest"
}

require_sample_manifest_entry() {
    local label="$1"
    local path="$2"
    local manifest="${RUN_DIR}/logs/slice-51-beta-acceptance.sample-manifest.tsv"
    /usr/bin/awk -F'\t' -v label="$label" -v path="$path" '
        $0 == "" || $1 ~ /^#/ { next }
        $2 == label && $5 == path { found = 1 }
        END { exit(found ? 0 : 1) }
    ' "$manifest" || die "sample manifest missing ${label}: ${path}"
}

require_event_manifest_entry() {
    local event_id="$1"
    local path="$2"
    local manifest="${RUN_DIR}/logs/slice-51-beta-acceptance.event-manifest.tsv"
    /usr/bin/awk -F'\t' -v event_id="$event_id" -v path="$path" '
        $0 == "" || $1 ~ /^#/ { next }
        $1 == event_id && $6 == path { found = 1 }
        END { exit(found ? 0 : 1) }
    ' "$manifest" || die "event manifest missing ${event_id}: ${path}"
}

