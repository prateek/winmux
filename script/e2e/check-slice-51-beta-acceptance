while [ "$#" -gt 0 ]; do
    case "$1" in
        --self-test)
            SELF_TEST=1
            shift
            ;;
        --require-review)
            REQUIRE_REVIEW=1
            shift
            ;;
        --closeout)
            CLOSEOUT=1
            REQUIRE_REVIEW=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            die "unknown option: $1"
            ;;
        *)
            [ -z "$RUN_DIR" ] || die "only one run directory is supported"
            RUN_DIR="$1"
            shift
            ;;
    esac
done

if [ "$SELF_TEST" -eq 1 ]; then
    [ -z "$RUN_DIR" ] || die "--self-test does not accept a run directory"
    run_self_test
    exit 0
fi

[ -n "$RUN_DIR" ] || die "missing run directory"
RUN_DIR="$(cd "$RUN_DIR" && pwd -P)"
validate_artifact
if [ "$REQUIRE_REVIEW" -eq 1 ]; then
    validate_review
fi
if [ "$CLOSEOUT" -eq 1 ]; then
    validate_closeout
fi
printf '[winmux-slice51] PASS: %s\n' "$RUN_DIR"
