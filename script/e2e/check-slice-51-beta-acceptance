validate_review() {
    local review="${RUN_DIR}/reviews/no-ctx-artifact-review.md"
    [ -s "$review" ] || die "missing Slice 51 no-context review"
    case "$(first_nonblank_line "$review")" in
        PASS:*|PASS_WITH_NOTES:*) ;;
        *) die "Slice 51 review must start with PASS: or PASS_WITH_NOTES:" ;;
    esac
    [ "$(last_nonblank_line "$review")" = "next slice allowed: yes" ] \
        || die "Slice 51 review final line must be: next slice allowed: yes"
    for text in \
        "Slice 51" \
        "recordings/slice-51-beta-acceptance.mov" \
        "recordings/raw/slice-51-beta-acceptance.raw.mov" \
        "screenshots/slice-51-beta-acceptance.contact-sheet.jpg" \
        "logs/slice-51-beta-acceptance.sample-manifest.tsv" \
        "logs/slice-51-beta-acceptance.event-manifest.tsv" \
        "logs/slice-51-beta-acceptance.annotations.tsv" \
        "logs/slice-51-beta-acceptance.expected-chips.txt" \
        "logs/slice-51-beta-acceptance.mouse-events.tsv" \
        "screenshots/07a-freeform-pickup-slice-51.png" \
        "screenshots/07b-freeform-hover-slice-51.png" \
        "screenshots/07c-reset-before-snap-slice-51.png" \
        "screenshots/07d-snap-pickup-slice-51.png" \
        "screenshots/07e-snap-path-slice-51.png" \
        "screenshots/07f-snap-hover-comms-slice-51.png" \
        "screenshots/07g-snap-release-slice-51.png" \
        "beta-acceptance-manifest.txt" \
        "package-provenance.env" \
        "beta-acceptance-proof.env" \
        "guest-script-retry-summary.tsv" \
        "PUBLISH=0" \
        "support bundle" \
        "dogfood blockers" \
        "beta blockers" \
        "known limitations" \
        "does not mean broad public release"; do
