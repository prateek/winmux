sha256_file() {
    /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{ print $1 }'
}

sha256_stdin() {
    /usr/bin/shasum -a 256 | /usr/bin/awk '{ print $1 }'
}

candidate_state_stream() {
    printf '[head]\n'
    git rev-parse HEAD 2>/dev/null || printf 'UNKNOWN\n'
    printf '[status]\n'
    git status --short
    printf '[diff]\n'
    git diff --no-ext-diff --binary
    printf '[cached-diff]\n'
    git diff --cached --no-ext-diff --binary
    printf '[untracked-file-sha256]\n'
    while IFS= read -r path; do
        [ -f "$path" ] || continue
        printf '%s\t%s\n' "$(sha256_file "$path")" "$path"
    done < <(git ls-files --others --exclude-standard)
}

candidate_state_sha256() {
    candidate_state_stream | sha256_stdin
}

git_status_sha256() {
    git status --short | sha256_stdin
}

manifest_value() {
    local manifest="$1"
    local key="$2"

    /usr/bin/awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2) }' "$manifest"
}

freshness_manifest_path() {
    local run_dir="$1"
    printf '%s/reviews/pre-tart/freshness.env\n' "$run_dir"
}

write_freshness_manifest() {
    local run_dir="$1"
    local slice_id="$2"
    local report_dir="${run_dir}/reviews/pre-tart"
    local pre_tart_log="${run_dir}/logs/pre-tart-checks.log"
    local manifest
    local head
    local candidate_hash
    local status_hash
    local pre_tart_hash

    configure_slice_requirements "$slice_id"
    [ -s "$pre_tart_log" ] || die "missing pre-Tart log for freshness manifest: $pre_tart_log"

    manifest="$(freshness_manifest_path "$run_dir")"
    mkdir -p "$report_dir"
    head="$(git rev-parse HEAD 2>/dev/null || printf 'UNKNOWN')"
    candidate_hash="$(candidate_state_sha256)"
    status_hash="$(git_status_sha256)"
    pre_tart_hash="$(sha256_file "$pre_tart_log")"

    {
        printf 'slice_id=%s\n' "$slice_id"
        printf 'candidate_head=%s\n' "$head"
        printf 'candidate_state_sha256=%s\n' "$candidate_hash"
        printf 'git_status_sha256=%s\n' "$status_hash"
        printf 'pre_tart_log_sha256=%s\n' "$pre_tart_hash"
        printf 'pre_tart_log_path=logs/pre-tart-checks.log\n'
    } >"$manifest"

    printf '[winmux-pre-tart-review] wrote freshness manifest: %s\n' "$manifest"
}

validate_freshness_manifest() {
    local run_dir="$1"
    local slice_id="$2"
    local manifest
    local pre_tart_log="${run_dir}/logs/pre-tart-checks.log"
    local manifest_slice
    local manifest_head
    local manifest_candidate_hash
    local manifest_status_hash
    local manifest_pre_tart_hash
    local current_head
    local current_candidate_hash
    local current_status_hash
    local current_pre_tart_hash

    manifest="$(freshness_manifest_path "$run_dir")"
    [ -s "$manifest" ] || die "missing pre-Tart freshness manifest: $manifest"
    [ -s "$pre_tart_log" ] || die "missing pre-Tart log: $pre_tart_log"

    manifest_slice="$(manifest_value "$manifest" slice_id)"
    manifest_head="$(manifest_value "$manifest" candidate_head)"
    manifest_candidate_hash="$(manifest_value "$manifest" candidate_state_sha256)"
    manifest_status_hash="$(manifest_value "$manifest" git_status_sha256)"
    manifest_pre_tart_hash="$(manifest_value "$manifest" pre_tart_log_sha256)"

    [ "$manifest_slice" = "$slice_id" ] \
        || die "freshness manifest slice mismatch: expected ${slice_id}, got ${manifest_slice:-missing}"

    current_head="$(git rev-parse HEAD 2>/dev/null || printf 'UNKNOWN')"
    current_candidate_hash="$(candidate_state_sha256)"
    current_status_hash="$(git_status_sha256)"
    current_pre_tart_hash="$(sha256_file "$pre_tart_log")"

    [ "$manifest_head" = "$current_head" ] \
        || die "freshness manifest HEAD is stale: expected ${current_head}, got ${manifest_head:-missing}"
    [ "$manifest_candidate_hash" = "$current_candidate_hash" ] \
        || die "freshness manifest candidate hash is stale: expected ${current_candidate_hash}, got ${manifest_candidate_hash:-missing}"
    [ "$manifest_status_hash" = "$current_status_hash" ] \
        || die "freshness manifest git status hash is stale: expected ${current_status_hash}, got ${manifest_status_hash:-missing}"
    [ "$manifest_pre_tart_hash" = "$current_pre_tart_hash" ] \
        || die "freshness manifest pre-Tart log hash is stale: expected ${current_pre_tart_hash}, got ${manifest_pre_tart_hash:-missing}"
}

validate_gate() {
    local run_dir="$1"
    local slice_id="$2"
    local report_dir="${run_dir}/reviews/pre-tart"
    local manifest
    local required_freshness_lines=()

    configure_slice_requirements "$slice_id"
    validate_freshness_manifest "$run_dir" "$slice_id"
    manifest="$(freshness_manifest_path "$run_dir")"

    required_freshness_lines=(
        "candidate_head=$(manifest_value "$manifest" candidate_head)"
        "candidate_state_sha256=$(manifest_value "$manifest" candidate_state_sha256)"
        "git_status_sha256=$(manifest_value "$manifest" git_status_sha256)"
        "pre_tart_log_sha256=$(manifest_value "$manifest" pre_tart_log_sha256)"
    )

    [ -d "$report_dir" ] || die "missing pre-Tart review directory: $report_dir"

    for report in "${required_reports[@]}"; do
        local path
        path="${report_dir}/${report}.md"
        [ -s "$path" ] || die "missing pre-Tart review report: $path"

        last_non_empty="$(
            /usr/bin/awk 'NF { line = $0 } END { print line }' "$path"
        )"
        [ "$last_non_empty" = "NO ACTIONABLE ISSUES" ] \
            || die "pre-Tart report must end with NO ACTIONABLE ISSUES: $path"

        if /usr/bin/grep -Eiq '^Verdict:[[:space:]]*BLOCKED\b' "$path"; then
            die "pre-Tart report is blocked: $path"
        fi
        /usr/bin/grep -Eiq '^Verdict:[[:space:]]*CLEAN\b' "$path" \
            || die "pre-Tart report must declare Verdict: CLEAN: $path"

        for mention in "${required_mentions[@]}"; do
            /usr/bin/grep -F "$mention" "$path" >/dev/null \
                || die "pre-Tart report ${path} must mention reviewed file or scope: ${mention}"
        done
        for freshness_line in "${required_freshness_lines[@]}"; do
            /usr/bin/grep -F "$freshness_line" "$path" >/dev/null \
                || die "pre-Tart report ${path} must cite freshness line: ${freshness_line}"
        done
    done

    printf '[winmux-pre-tart-review] clean pre-Tart review gate for %s: %s\n' "$slice_id" "$report_dir"
}

write_clean_self_test_reports() {
    local report_dir="$1"

    mkdir -p "$report_dir"
    for report in "${required_reports[@]}"; do
        {
            printf 'Verdict: CLEAN\n\n'
            printf 'Reviewed scope:\n'
            for mention in "${required_mentions[@]}"; do
                printf -- '- %s\n' "$mention"
            done
            if [ -n "${WINMUX_PRE_TART_SELF_TEST_FRESHNESS:-}" ]; then
                printf '\nFreshness:\n'
                /bin/cat "$WINMUX_PRE_TART_SELF_TEST_FRESHNESS"
            fi
            printf '\nNO ACTIONABLE ISSUES\n'
        } >"${report_dir}/${report}.md"
    done
}

