    WINMUX_PRE_TART_SELF_TEST_FRESHNESS="$(freshness_manifest_path "$run_dir")"
    write_clean_self_test_reports "$report_dir"
    validate_gate "$run_dir" slice-43 >/dev/null

    configure_slice_requirements slice-44
    write_freshness_manifest "$run_dir" slice-44 >/dev/null
    WINMUX_PRE_TART_SELF_TEST_FRESHNESS="$(freshness_manifest_path "$run_dir")"
