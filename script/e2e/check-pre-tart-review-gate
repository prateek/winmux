    validate_gate "$run_dir" slice-44 >/dev/null

    configure_slice_requirements slice-45
    write_freshness_manifest "$run_dir" slice-45 >/dev/null
    WINMUX_PRE_TART_SELF_TEST_FRESHNESS="$(freshness_manifest_path "$run_dir")"
    write_clean_self_test_reports "$report_dir"
    validate_gate "$run_dir" slice-45 >/dev/null

    configure_slice_requirements slice-46
    write_freshness_manifest "$run_dir" slice-46 >/dev/null
    WINMUX_PRE_TART_SELF_TEST_FRESHNESS="$(freshness_manifest_path "$run_dir")"
    write_clean_self_test_reports "$report_dir"
    validate_gate "$run_dir" slice-46 >/dev/null

    configure_slice_requirements slice-34
    write_freshness_manifest "$run_dir" slice-34 >/dev/null
    WINMUX_PRE_TART_SELF_TEST_FRESHNESS="$(freshness_manifest_path "$run_dir")"
    write_clean_self_test_reports "$report_dir"

    printf 'Verdict: CLEAN\n\nNO ACTIONABLE ISSUES\n' >"${report_dir}/code-harness.md"
    if bash "$script_path" "$run_dir" slice-34 >/dev/null 2>&1; then
        die "self-test expected missing required mention to fail"
    fi

    write_clean_self_test_reports "$report_dir"
    {
        printf 'Verdict: BLOCKED\n\n'
        for mention in "${required_mentions[@]}"; do
            printf -- '- %s\n' "$mention"
        done
        printf '\nFreshness:\n'
        /bin/cat "$WINMUX_PRE_TART_SELF_TEST_FRESHNESS"
        printf '\nNO ACTIONABLE ISSUES\n'
    } >"${report_dir}/artifact-product.md"
    if bash "$script_path" "$run_dir" slice-34 >/dev/null 2>&1; then
        die "self-test expected blocked verdict to fail"
    fi

    write_clean_self_test_reports "$report_dir"
    {
        printf 'Verdict: CLEAN\n\n'
        for mention in "${required_mentions[@]}"; do
            printf -- '- %s\n' "$mention"
        done
        printf '\nFreshness:\n'
        /bin/cat "$WINMUX_PRE_TART_SELF_TEST_FRESHNESS"
        printf '\nACTIONABLE ISSUES FOUND\n'
    } >"${report_dir}/process-plan.md"
    if bash "$script_path" "$run_dir" slice-34 >/dev/null 2>&1; then
        die "self-test expected bad final line to fail"
    fi

    write_clean_self_test_reports "$report_dir"
    if bash "$script_path" "$run_dir" slice-99 >/dev/null 2>&1; then
        die "self-test expected unregistered slice to fail"
    fi

    write_clean_self_test_reports "$report_dir"
    printf 'mutated\n' >>"${run_dir}/logs/pre-tart-checks.log"
    if bash "$script_path" "$run_dir" slice-34 >/dev/null 2>&1; then
        die "self-test expected stale pre-Tart log hash to fail"
    fi

    printf '[winmux-pre-tart-review] self-test PASS\n'
}

