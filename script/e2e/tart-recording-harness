guest_transport_warmup_satisfied() {
    local total_successes="$1"
    local consecutive_successes="$2"
    [ "$total_successes" -ge 3 ] && [ "$consecutive_successes" -ge 2 ]
}

simulate_guest_transport_warmup() {
    local max_attempts="$1"
    shift
    local consecutive_successes=0
    local total_successes=0
    local attempt=1
    local outcome

    for outcome in "$@"; do
        [ "$attempt" -le "$max_attempts" ] || break
        case "$outcome" in
            success)
                consecutive_successes=$((consecutive_successes + 1))
                total_successes=$((total_successes + 1))
                if guest_transport_warmup_satisfied "$total_successes" "$consecutive_successes"; then
                    printf 'result=success attempt=%s total_successes=%s consecutive_successes=%s\n' \
                        "$attempt" "$total_successes" "$consecutive_successes"
                    return 0
                fi
                ;;
            failure)
                consecutive_successes=0
                ;;
            *)
                die "Unknown warm-up simulation outcome: $outcome"
                ;;
        esac
        attempt=$((attempt + 1))
    done

    printf 'result=failure attempts=%s total_successes=%s consecutive_successes=%s\n' \
        $((attempt - 1)) "$total_successes" "$consecutive_successes"
    return 1
}

assert_warmup_policy_pass() {
    local label="$1"
    shift
    simulate_guest_transport_warmup "$@" >/dev/null \
        || die "Warm-up policy self-test expected pass but failed: $label"
}

assert_warmup_policy_fail() {
    local label="$1"
    shift
    if simulate_guest_transport_warmup "$@" >/dev/null; then
        die "Warm-up policy self-test expected failure but passed: $label"
    fi
}

simulate_guest_action_retry_policy() {
    local max_attempts="$1"
    local semantic_exit="$2"
    shift 2
    local attempt=1
    local failures=0
    local status status_token mutated

    for status_token in "$@"; do
        [ "$attempt" -le "$max_attempts" ] || break
        mutated=no
        case "$status_token" in
            *:mutated)
                status="${status_token%%:*}"
                mutated=yes
                ;;
            *)
                status="$status_token"
                ;;
        esac
        if [ "$status" -eq 0 ]; then
            printf 'final_result=success attempts=%s failure_count=%s\n' "$attempt" "$failures"
            return 0
        fi
        failures=$((failures + 1))
        if [ "$status" -eq "$semantic_exit" ]; then
            printf 'final_result=semantic_failure attempts=%s failure_count=%s\n' "$attempt" "$failures"
            return 0
        fi
        if [ "$mutated" = yes ]; then
            printf 'final_result=mutation_failure attempts=%s failure_count=%s\n' "$attempt" "$failures"
            return 0
        fi
        attempt=$((attempt + 1))
    done

    printf 'final_result=failure attempts=%s failure_count=%s\n' $((attempt - 1)) "$failures"
}

assert_guest_retry_policy_result() {
    local label="$1"
    local expected_result="$2"
    local expected_attempts="$3"
    shift 3
    local output
    output="$(simulate_guest_action_retry_policy "$@")"
    grep -F "final_result=${expected_result}" <<<"$output" >/dev/null \
        || die "Guest retry policy self-test expected ${expected_result} for ${label}, got: ${output}"
    grep -F "attempts=${expected_attempts}" <<<"$output" >/dev/null \
        || die "Guest retry policy self-test expected ${expected_attempts} attempts for ${label}, got: ${output}"
}

retry_summary_fields_self_test() {
    local tmp_dir
    tmp_dir="$(mktemp -d)"
    local retry_log="${tmp_dir}/retry.log"
    {
        printf 'attempt=1\n'
        printf 'ssh: connect to host 127.0.0.1 port 22: Connection refused\n'
        printf 'probe_result=failure\n'
        printf 'attempt=2\n'
        printf 'probe_result=success\n'
        printf 'attempt=3\n'
        printf 'TCC database is locked\n'
        printf 'probe_result=failure\n'
        printf '%s\n' "$GUEST_ACTION_MUTATION_MARKER"
        printf 'attempt=4\n'
        printf 'probe_result=success\n'
        printf 'result=success\n'
        printf 'failure_count=2\n'
    } >"$retry_log"

    local statuses first_reason last_reason mutation_started mutation_line
    statuses="$(log_attempt_statuses "$retry_log")"
    first_reason="$(compact_failure_reason "$retry_log" first)"
    last_reason="$(compact_failure_reason "$retry_log" last)"
    mutation_started="$(log_mutation_started "$retry_log")"
    mutation_line="$(first_mutation_line "$retry_log")"

    local old_logs_dir old_guest_recording_active
    old_logs_dir="$LOGS_DIR"
    old_guest_recording_active="${GUEST_RECORDING_ACTIVE:-0}"
    LOGS_DIR="${tmp_dir}/logs"
    GUEST_RECORDING_ACTIVE=1
    mkdir -p "$LOGS_DIR"
    append_guest_script_retry_summary "$retry_log" success
    grep -F $'last_failure_reason\tmutation_started\tfirst_mutation_line' "${LOGS_DIR}/guest-script-retry-summary.tsv" >/dev/null \
        || die "Retry summary self-test expected mutation metadata header"
    grep -F $'\tyes\t9' "${LOGS_DIR}/guest-script-retry-summary.tsv" >/dev/null \
        || die "Retry summary self-test expected mutation metadata row"
    LOGS_DIR="$old_logs_dir"
    GUEST_RECORDING_ACTIVE="$old_guest_recording_active"
    rm -rf "$tmp_dir"

    [ "$statuses" = "failure,success,failure,success" ] \
        || die "Retry summary self-test expected attempt statuses, got: $statuses"
    [ "$first_reason" = "ssh: connect to host 127.0.0.1 port 22: Connection refused" ] \
        || die "Retry summary self-test expected first failure reason, got: $first_reason"
    [ "$last_reason" = "TCC database is locked" ] \
        || die "Retry summary self-test expected last failure reason, got: $last_reason"
    [ "$mutation_started" = "yes" ] \
        || die "Retry summary self-test expected mutation_started=yes, got: $mutation_started"
    [ "$mutation_line" = "9" ] \
        || die "Retry summary self-test expected first mutation line 9, got: $mutation_line"
}

warmup_policy_self_test() {
