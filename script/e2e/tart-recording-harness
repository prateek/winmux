caption_seconds_for_time_source() {
    local name="$1"
    local caption_label="$2"
    local time_source="$3"
    local normalized="$time_source"
    local base offset

    normalized="${normalized#mouse-}"
    case "$normalized" in
        caption-start)
            caption_start_for_label "$name" "$caption_label"
            ;;
        caption-end)
            caption_end_for_label "$name" "$caption_label"
            ;;
        caption-start+*)
            offset="${normalized#caption-start+}"
            base="$(caption_start_for_label "$name" "$caption_label")" \
                || die "Could not resolve caption start for ${caption_label}"
            /usr/bin/awk -v base="$base" -v offset="$offset" 'BEGIN { printf "%.3f\n", base + offset }'
            ;;
        caption-end+*)
            offset="${normalized#caption-end+}"
            base="$(caption_end_for_label "$name" "$caption_label")" \
                || die "Could not resolve caption end for ${caption_label}"
            /usr/bin/awk -v base="$base" -v offset="$offset" 'BEGIN { printf "%.3f\n", base + offset }'
            ;;
        *) die "Unknown mouse drag time source: $time_source" ;;
    esac
}

mouse_drag_event_seconds() {
    local name="$1"
    local event_id="$2"
    local time_source="$3"
    local caption_label="$4"
    local fallback

    fallback="$(caption_seconds_for_time_source "$name" "$caption_label" "$time_source")"
    case "$time_source" in
        mouse-*) mouse_event_seconds "$name" "$event_id" "$fallback" ;;
        *) printf '%s\n' "$fallback" ;;
    esac
}

mouse_drag_event_path() {
    local slice="$1"
    local name="$2"
    local caption_label="$3"
    local path_kind="$4"
    local path_value="$5"
    local filename

    case "$path_kind" in
        none)
            printf '%s\n' "-"
            ;;
        sample-start)
            printf 'screenshots/%s.samples/%s-boundary-start.png\n' "$name" "$caption_label"
            ;;
        sample-end)
            printf 'screenshots/%s.samples/%s-boundary-end.png\n' "$name" "$caption_label"
            ;;
        screenshot)
            filename="${path_value//\{slice\}/$slice}"
            printf 'screenshots/%s\n' "$filename"
            ;;
        *) die "Unknown mouse drag event path kind: $path_kind" ;;
    esac
}

write_mouse_drag_event_manifest() {
    local slice="$1"
    local name="$2"
    local manifest_path="${LOGS_DIR}/${name}.event-manifest.tsv"
    local _slice event_id kind time_source caption_key sample_label path_kind path_value expected _after_events
    local caption_label seconds relative_path row_count=0

    : >"$manifest_path"
    printf '# event-id\tkind\tseconds\tcaption-label\tsample-label\tpath\texpected\n' >>"$manifest_path"
    while IFS=$'\t' read -r _slice event_id kind time_source caption_key sample_label path_kind path_value expected _after_events; do
        caption_label="$(mouse_drag_caption_label "$slice" "$name" "$caption_key")"
        seconds="$(mouse_drag_event_seconds "$name" "$event_id" "$time_source" "$caption_label")"
        relative_path="$(mouse_drag_event_path "$slice" "$name" "$caption_label" "$path_kind" "$path_value")"
        append_event_manifest_row "$manifest_path" "$event_id" "$kind" "$seconds" "$caption_label" "$sample_label" "$relative_path" "$expected"
        row_count=$((row_count + 1))
    done < <(mouse_drag_event_spec_rows "$slice")
    [ "$row_count" -gt 0 ] || die "Mouse drag event spec has no rows for $slice"
    [ -s "$manifest_path" ] || die "Event manifest did not produce a non-empty file: $manifest_path"
}

