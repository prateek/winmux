append_guest_script_retry_summary() {
    local log_path="$1"
    local final_result="$2"
    local summary_path="${LOGS_DIR}/guest-script-retry-summary.tsv"
    local relative_log_path
    relative_log_path="logs/$(basename "$log_path")"
    local phase
    phase="$(basename "$log_path" .log)"
    local before_recording="yes"
    if [ "${GUEST_RECORDING_ACTIVE:-0}" = "1" ]; then
        before_recording="no"
    fi

    local attempts failures
    attempts="$(count_log_attempts "$log_path")"
    failures="$(last_log_value "$log_path" failure_count)"
    if [ "$failures" = "unknown" ]; then
        failures="$(count_log_key_value "$log_path" result failure)"
    fi

    if [ ! -s "$summary_path" ]; then
        printf '# phase\tlog\tattempts\tfailures\tfinal_result\tbefore_recording\tattempt_statuses\tfirst_failure_reason\tlast_failure_reason\tmutation_started\tfirst_mutation_line\n' >"$summary_path"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$phase" "$relative_log_path" "$attempts" "$failures" "$final_result" "$before_recording" \
        "$(log_attempt_statuses "$log_path")" \
        "$(compact_failure_reason "$log_path" first)" \
        "$(compact_failure_reason "$log_path" last)" \
        "$(log_mutation_started "$log_path")" \
        "$(first_mutation_line "$log_path")" >>"$summary_path"
}

guest_script_retry() {
    local script="$1"
    local log_path="$2"
    local attempt=1
    local failure_count=0

    : >"$log_path"
    while [ "$attempt" -le "$GUEST_ACTION_ATTEMPTS" ]; do
        local status=0
        {
            printf 'attempt=%s\n' "$attempt"
            guest_script "$script"
        } >>"$log_path" 2>&1 || status=$?
        if [ "$status" -eq 0 ]; then
            {
                printf 'result=success\n'
                printf 'failure_count=%s\n' "$failure_count"
                printf 'final_result=success\n'
            } >>"$log_path"
            append_guest_script_retry_summary "$log_path" success
            return
        fi
        failure_count=$((failure_count + 1))
        if [ "$status" -eq "$GUEST_ACTION_SEMANTIC_FAILURE_EXIT" ]; then
            log "Guest action attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} hit a semantic scenario failure; see $log_path"
            {
                printf 'result=semantic_failure\n'
                printf 'failure_count=%s\n' "$failure_count"
                printf 'final_result=semantic_failure\n'
            } >>"$log_path"
            append_guest_script_retry_summary "$log_path" semantic_failure
            write_run_abort_status "$(basename "$log_path" .log)" "$status" semantic_failure "$log_path" "guest scenario returned semantic failure"
            return "$status"
        fi
        if grep -F "$GUEST_ACTION_MUTATION_MARKER" "$log_path" >/dev/null 2>&1; then
            log "Guest action attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} failed after product mutation; not retrying; see $log_path"
            {
                printf 'result=mutation_failure\n'
                printf 'failure_count=%s\n' "$failure_count"
                printf 'final_result=mutation_failure\n'
            } >>"$log_path"
            append_guest_script_retry_summary "$log_path" mutation_failure
            write_run_abort_status "$(basename "$log_path" .log)" "$status" mutation_failure "$log_path" "guest action failed after mutation marker"
            return "$status"
        fi

        log "Guest action attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} failed; see $log_path"
        printf 'result=failure\n' >>"$log_path"
        attempt=$((attempt + 1))
        if [ "$attempt" -le "$GUEST_ACTION_ATTEMPTS" ]; then
            sleep "$GUEST_ACTION_RETRY_SECONDS"
        fi
    done

    {
        printf 'failure_count=%s\n' "$failure_count"
        printf 'final_result=failure\n'
    } >>"$log_path"
    append_guest_script_retry_summary "$log_path" failure
    write_run_abort_status "$(basename "$log_path" .log)" 1 failure "$log_path" "guest action retries exhausted"
    return 1
}

warm_guest_transport() {
    local label="$1"
    local log_path="${LOGS_DIR}/guest-control-warmup-${label}.log"
    local consecutive_successes=0
    local total_successes=0
    local attempt=1
    local max_attempts="${WINMUX_E2E_GUEST_TRANSPORT_WARMUP_ATTEMPTS:-10}"

    : >"$log_path"
    while [ "$attempt" -le "$max_attempts" ]; do
        local status=0
        {
            printf 'attempt=%s\n' "$attempt"
            guest_script "true"
        } >>"$log_path" 2>&1 || status=$?
        if [ "$status" -eq 0 ]; then
            consecutive_successes=$((consecutive_successes + 1))
            total_successes=$((total_successes + 1))
            {
                printf 'probe_result=success\n'
                printf 'total_successes=%s\n' "$total_successes"
                printf 'consecutive_successes=%s\n' "$consecutive_successes"
            } >>"$log_path"
            if guest_transport_warmup_satisfied "$total_successes" "$consecutive_successes"; then
                {
                    printf 'result=success\n'
                    printf 'total_successes=%s\n' "$total_successes"
                    printf 'consecutive_successes=%s\n' "$consecutive_successes"
                } >>"$log_path"
                return
            fi
        else
            consecutive_successes=0
            {
                printf 'probe_result=failure\n'
                printf 'total_successes=%s\n' "$total_successes"
                printf 'consecutive_successes=0\n'
            } >>"$log_path"
            log "Guest transport warm-up ${label} attempt ${attempt}/${max_attempts} failed; see $log_path"
            sleep "$GUEST_ACTION_RETRY_SECONDS"
        fi
        attempt=$((attempt + 1))
    done

    printf 'result=failure\n' >>"$log_path"
    return 1
}

wait_for_guest_control() {
    local check_log="${LOGS_DIR}/guest-control-check.log"
    local deadline=$((SECONDS + GUEST_CONTROL_WAIT_SECONDS))
    local script
    # shellcheck disable=SC2016 # This command runs inside the guest.
    script='set -euo pipefail
echo guest_control_ready
printf "user=%s\n" "$(/usr/bin/whoami)"
printf "host=%s\n" "$(/bin/hostname)"
printf "date_utc=%s\n" "$(/bin/date -u +"%Y-%m-%dT%H:%M:%SZ")"
/usr/bin/sw_vers'

    log "Waiting for guest control via $CONTROL_MODE"
    while [ "$SECONDS" -le "$deadline" ]; do
        if guest_script "$script" >"$check_log" 2>&1; then
            printf 'control_mode=%s\n' "$CONTROL_MODE" >>"$check_log"
            printf 'result=success\n' >>"$check_log"
            log "Guest control is ready via $CONTROL_MODE"
            return
        fi
        sleep 5
    done

    log "Guest control is not ready via $CONTROL_MODE; last check is in $check_log"
    return 1
}

