    run_cmd tart stop "$VM_NAME" --timeout 20 || true
    if [ -n "${TART_RUN_PID:-}" ]; then
        wait "$TART_RUN_PID" 2>/dev/null || true
    fi
    if [ "$KEEP_VM" != "1" ] && vm_exists "$VM_NAME"; then
        run_cmd tart delete "$VM_NAME" || true
    fi
