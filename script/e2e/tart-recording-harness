    focus_only_start="$(timing_value_from_log availability-focus-only-command-start-offset-seconds "$timing_log")"
    communications_start="$(timing_value_from_log availability-communications-command-start-offset-seconds "$timing_log")"
    style_start="$(timing_value_from_log style-cycle-command-start-offset-seconds "$timing_log")"
    if [ -z "$snap_start" ] || [ -z "$layout_start" ] || [ -z "$focus_only_start" ] || [ -z "$communications_start" ] || [ -z "$style_start" ]; then
        write_static_slice_21_annotation_plan "$captions_path"
        return 0
    fi

    /usr/bin/awk \
        -v snap_start="$snap_start" \
        -v layout_start="$layout_start" \
        -v focus_only_start="$focus_only_start" \
        -v communications_start="$communications_start" \
        -v style_start="$style_start" '
        function max(a, b) { return a > b ? a : b }
        function midpoint(a, b) { return a + ((b - a) / 2) }
        function emit(start, end, title, body, chip) {
            if (end <= start) {
                end = start + 1
            }
            printf "%.3f\t%.3f\t%s\t%s\t%s\n", start, end, title, body, chip
        }
        BEGIN {
            ready_end = max(4, snap_start)
            snap_result_start = midpoint(snap_start, layout_start)
            layout_result_start = midpoint(layout_start, focus_only_start)
            focus_result_start = midpoint(focus_only_start, communications_start)
            communications_result_start = midpoint(communications_start, style_start)

            emit(0, ready_end, "Zone mode V2 ready", "Alt-Z enters zone mode; S, Tab, A, and Y are bound to compact zone controls.", "Config: [mode.zone.binding] s/tab/a/y ergonomic zone mode")
            emit(snap_start, snap_result_start, "Snap policy key", "Alt-Z, S cycles the runtime mouse snap policy without a config rewrite.", "Run: winmux cycle-zone-snap-policy freeform snap-to-zone")
            emit(snap_result_start, layout_start, "Snap policy result", "The board shows snap-to-zone as command output while zone geometry stays stable.", "Action: snap policy is snap-to-zone")
            emit(layout_start, layout_result_start, "Layout key", "Alt-Z, Tab cycles the physical monitor from balanced to focus layout.", "Run: winmux cycle-zone-layout balanced focus")
            emit(layout_result_start, focus_only_start, "Layout result", "Work/main widens while Reference and Comms remain named zones.", "Action: layout focus widens Work/main")
            emit(focus_only_start, focus_result_start, "Focus-only key", "Alt-Z, A applies the focus-only availability set.", "Run: winmux cycle-zone-availability focus-only communications full-dashboard")
            emit(focus_result_start, communications_start, "Focus-only result", "Only Work/main remains available for deep work.", "Action: focus-only hides Reference and Comms")
            emit(communications_start, communications_result_start, "Communications key", "Alt-Z, A again moves to the communications availability set.", "Run: winmux cycle-zone-availability focus-only communications full-dashboard")
            emit(communications_result_start, style_start, "Communications result", "Comms/right returns while Reference stays hidden.", "Action: communications restores Comms/right")
            emit(style_start, style_start + 7, "Style key", "Alt-Z, Y styles the current Work zone with the urgent token.", "Run: winmux cycle-zone-style current urgent calm")
            emit(style_start + 7, style_start + 16, "Style result", "The current zone chrome reports urgent red without moving windows.", "Action: Work/current style urgent #D3455B")
        }
    ' >"$captions_path"
}

caption_label_for_chip() {
    local name="$1"
    local chip="$2"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    [ -s "$captions_path" ] || return 1
    /usr/bin/awk -F'\t' -v chip="$chip" '
        $0 == "" || $1 ~ /^#/ { next }
        {
            caption_index += 1
            if ($5 == chip) {
                printf "caption-%02d\n", caption_index
                found = 1
                exit
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$captions_path"
}

caption_start_for_label() {
    local name="$1"
    local label="$2"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local index
    index="$(printf '%s\n' "$label" | /usr/bin/sed -n 's/^caption-0*\([0-9][0-9]*\)$/\1/p')"
    [ -n "$index" ] || return 1
    [ -s "$captions_path" ] || return 1
    /usr/bin/awk -F'\t' -v wanted="$index" '
        $0 == "" || $1 ~ /^#/ { next }
        {
            caption_index += 1
            if (caption_index == wanted) {
                printf "%.3f\n", $1 + 0.100
                found = 1
                exit
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$captions_path"
}

caption_end_for_label() {
    local name="$1"
    local label="$2"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local index
    index="$(printf '%s\n' "$label" | /usr/bin/sed -n 's/^caption-0*\([0-9][0-9]*\)$/\1/p')"
    [ -n "$index" ] || return 1
    [ -s "$captions_path" ] || return 1
    /usr/bin/awk -F'\t' -v wanted="$index" '
        $0 == "" || $1 ~ /^#/ { next }
        {
            caption_index += 1
            if (caption_index == wanted) {
                printf "%.3f\n", $2 - 0.100
                found = 1
                exit
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$captions_path"
}

last_caption_label_for_chip() {
    local name="$1"
    local chip="$2"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    [ -s "$captions_path" ] || return 1
    /usr/bin/awk -F'\t' -v chip="$chip" '
        $0 == "" || $1 ~ /^#/ { next }
        {
            caption_index += 1
            if ($5 == chip) {
                found = caption_index
            }
        }
        END {
            if (found) {
                printf "caption-%02d\n", found
                exit 0
            }
            exit 1
        }
    ' "$captions_path"
}

append_event_manifest_row() {
    local manifest_path="$1"
    local event_id="$2"
    local kind="$3"
    local seconds="$4"
    local caption_label="$5"
    local sample_label="$6"
    local relative_path="$7"
    local expected="$8"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$event_id" "$kind" "$seconds" "$caption_label" "$sample_label" "$relative_path" "$expected" >>"$manifest_path"
}

event_manifest_field() {
    local manifest_path="$1"
    local event_id="$2"
    local field="$3"
    [ -s "$manifest_path" ] || return 1
    /usr/bin/awk -F'\t' -v event_id="$event_id" -v field="$field" '
        BEGIN {
            column["kind"] = 2
            column["seconds"] = 3
            column["caption-label"] = 4
            column["sample-label"] = 5
            column["path"] = 6
            column["expected"] = 7
        }
        $0 == "" || $1 ~ /^#/ { next }
        $1 == event_id && column[field] {
            print $column[field]
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$manifest_path"
}

mouse_event_seconds() {
    local name="$1"
    local event_id="$2"
    local fallback="$3"
    local event_log="${LOGS_DIR}/${name}.mouse-events.tsv"
    if [ -s "$event_log" ]; then
        local seconds
        seconds="$(/usr/bin/awk -F'\t' -v event_id="$event_id" '
            $0 == "" || $1 ~ /^#/ { next }
            $1 == event_id {
                print $3
                found = 1
                exit
            }
            END { exit(found ? 0 : 1) }
        ' "$event_log" || true)"
        if [ -n "$seconds" ]; then
            printf '%s\n' "$seconds"
            return 0
        fi
    fi
    printf '%s\n' "$fallback"
}

mouse_drag_event_spec_rows() {
    local slice="$1"
    [ -s "$MOUSE_DRAG_EVENT_SPEC" ] || die "Mouse drag event spec is missing: $MOUSE_DRAG_EVENT_SPEC"
    /usr/bin/awk -F'\t' -v slice="$slice" '$0 == "" || $1 ~ /^#/ { next } $1 == slice { print }' "$MOUSE_DRAG_EVENT_SPEC"
}

