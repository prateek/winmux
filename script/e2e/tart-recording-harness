}

annotate_recording() {
    local name="$1"
    local path="${RECORDINGS_DIR}/${name}.mov"
    [ "$ANNOTATE_RECORDING" = "1" ] || return

    local raw_dir="${RECORDINGS_DIR}/raw"
    local raw_path="${raw_dir}/${name}.raw.mov"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local annotation_log="${LOGS_DIR}/${name}.annotation.log"

    mkdir -p "$raw_dir"
    write_annotation_plan "$name" "$captions_path"
    write_expected_caption_chips "$name"
    write_event_manifest "$name"
    mv "$path" "$raw_path"
    local caption_footprint caption_anchor
    caption_footprint="${WINMUX_E2E_CAPTION_FOOTPRINT:-$(caption_footprint_for_recording "$name")}"
    caption_anchor="${WINMUX_E2E_CAPTION_ANCHOR:-bottom-left}"
    if ! WINMUX_E2E_CAPTION_FOOTPRINT="$caption_footprint" \
        WINMUX_E2E_CAPTION_ANCHOR="$caption_anchor" \
        "${SCRIPT_DIR}/annotate-recording" "$raw_path" "$captions_path" "$path" >"$annotation_log" 2>&1; then
        cat "$annotation_log" >&2 || true
        die "Recording annotation failed for $name"
    fi
    [ -s "$path" ] || die "Annotated recording did not produce a non-empty file: $path"
    [ -s "$raw_path" ] || die "Raw recording was not preserved: $raw_path"
}

write_expected_caption_chips() {
    local name="$1"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local expected_chips_path="${LOGS_DIR}/${name}.expected-chips.txt"
    [ -s "$captions_path" ] || return 0
    /usr/bin/awk -F'\t' '
        $0 == "" || $1 ~ /^#/ { next }
        {
            for (i = 5; i <= NF; i++) {
                if ($i != "") {
                    print $i
                }
            }
        }
    ' "$captions_path" >"$expected_chips_path"
}

annotation_preflight() {
    require_cmd ffmpeg
    require_cmd ffprobe
    require_cmd magick
    [ -x "${SCRIPT_DIR}/annotate-recording" ] || die "Missing executable annotator: ${SCRIPT_DIR}/annotate-recording"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' RETURN
    mkdir -p "${tmp_dir}/recordings" "${tmp_dir}/logs"
    local LOGS_DIR="${tmp_dir}/logs"
    local input="${tmp_dir}/recordings/raw.mov"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -f lavfi \
        -i 'color=c=black:s=1280x720:r=10' \
        -t 1 \
        -pix_fmt yuv420p \
        "$input"

    local name captions output render_log caption_footprint caption_anchor
    for name in \
        harness-smoke \
        slice-1-zone-spike \
        slice-2-config-zones \
        slice-3-stable-identity \
        slice-4-zone-commands \
        slice-5-sidebar-drag \
        slice-6-zone-layout-presets \
        slice-6b-zone-scenes \
        slice-8-window-routing \
        slice-10-zone-availability \
        slice-11a-zone-width-controls \
        slice-11b-zone-style-controls \
        slice-11c-zone-availability-sets \
        slice-12-mouse-zone-snap-drag \
        slice-13-zone-mode-bindings \
        slice-14-zone-bindings \
        slice-15-node-zone-binding \
        slice-16-mouse-snap-affordance \
        slice-17-node-binding-guardrails \
        slice-18-zone-affinity-routing \
        slice-19-zone-style-cycle \
        slice-20-zone-snap-policy-switch \
        slice-21-zone-mode-v2 \
        slice-22-float-unless-snap \
        slice-23-product-snap-overlay-label \
        slice-24-secondary-button-snap \
        slice-25-mouse-demo-contract \
        slice-26-zone-divider-drag \
        slice-27-window-slot-snap \
        slice-28-export-zone-layout \
        slice-29-save-zone-layout \
        slice-31-relaunch-saved-layout \
        slice-32-divider-save-relaunch \
        slice-33-cycle-zone-scene \
        slice-34-zone-mode-scene \
        slice-35-starter-ultrawide-template \
        slice-37-starter-onboarding \
        slice-38-user-readiness \
        slice-39-dogfood-install-permissions
    do
        captions="${tmp_dir}/logs/${name}.annotations.tsv"
        output="${tmp_dir}/recordings/${name}.mov"
        render_log="${tmp_dir}/logs/${name}.annotation.log"
        write_annotation_plan "$name" "$captions"
        case "$name" in
            slice-20-zone-snap-policy-switch|slice-21-zone-mode-v2|slice-22-float-unless-snap|slice-23-product-snap-overlay-label|slice-24-secondary-button-snap|slice-25-mouse-demo-contract|slice-26-zone-divider-drag|slice-27-window-slot-snap|slice-28-export-zone-layout|slice-29-save-zone-layout|slice-31-relaunch-saved-layout|slice-32-divider-save-relaunch|slice-33-cycle-zone-scene|slice-34-zone-mode-scene|slice-35-starter-ultrawide-template|slice-37-starter-onboarding|slice-38-user-readiness|slice-39-dogfood-install-permissions)
                write_event_manifest "$name"
                [ -s "${LOGS_DIR}/${name}.event-manifest.tsv" ] \
                    || die "Annotation preflight did not produce the required event manifest for ${name}"
                ;;
        esac
        awk -F '\t' '
            $0 == "" || $1 ~ /^#/ { next }
            {
                chip_count = 0
                for (i = 5; i <= NF; i++) {
                    if ($i == "") {
                        continue
                    }
                    chip_count++
                    if ($i !~ /^(Run|Config|Edit|Debug|Action|Result|Input):/) {
                        printf("Caption chip %d is missing a user-facing prefix: %s\n", i - 4, $i) > "/dev/stderr"
                        exit 1
                    }
                    if ($i ~ /\.\.\.|<[^>]*>|winmux <command>/) {
                        printf("Caption chip %d uses a placeholder command/config/action/result: %s\n", i - 4, $i) > "/dev/stderr"
                        exit 1
                    }
                    if (length($i) > 100) {
                        printf("Caption chip %d is too long for preflight (%d chars): %s\n", i - 4, length($i), $i) > "/dev/stderr"
                        exit 1
                    }
                }
                if (chip_count == 0) {
                    printf("Caption row %d has no user-facing command/config/action/result chip: %s\n", NR, $0) > "/dev/stderr"
                    exit 1
                }
            }
        ' "$captions" || die "Annotation preflight rejected a caption chip in $name"
        caption_footprint="${WINMUX_E2E_CAPTION_FOOTPRINT:-$(caption_footprint_for_recording "$name")}"
        caption_anchor="${WINMUX_E2E_CAPTION_ANCHOR:-bottom-left}"
        if ! WINMUX_E2E_CAPTION_FOOTPRINT="$caption_footprint" \
            WINMUX_E2E_CAPTION_ANCHOR="$caption_anchor" \
            "${SCRIPT_DIR}/annotate-recording" "$input" "$captions" "$output" >"$render_log" 2>&1; then
            cat "$render_log" >&2 || true
            die "Annotation preflight failed for $name"
        fi
        grep -F 'result=success' "$render_log" >/dev/null || die "Annotation preflight did not report success for $name"
        grep -F "caption_footprint=${caption_footprint}" "$render_log" >/dev/null \
            || die "Annotation preflight did not render ${name} with ${caption_footprint} captions"
        grep -F "caption_anchor=${caption_anchor}" "$render_log" >/dev/null \
            || die "Annotation preflight did not render ${name} with ${caption_anchor} captions"
    done
    log "Annotation preflight rendered all caption plans"
}

clamp_sample_time() {
    local requested="$1"
    local duration="$2"
    awk -v requested="$requested" -v duration="$duration" 'BEGIN {
        if (duration <= 0) {
            printf "0.000"
            exit
        }
        t = requested + 0
        if (t < 0.250) {
            t = 0.250
        }
        max = duration - 0.250
        if (max < 0) {
            max = 0
        }
        if (t > max) {
            t = max
        }
        printf "%.3f", t
    }'
}

sample_recording_frame() {
    local path="$1"
    local duration="$2"
    local requested="$3"
    local output="$4"
    local seconds
    seconds="$(clamp_sample_time "$requested" "$duration")"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -ss "$seconds" \
        -i "$path" \
        -frames:v 1 \
        "$output"
    [ -s "$output" ] || die "Sample frame did not produce a non-empty file: $output"
}

append_sample_manifest_row() {
    local manifest_path="$1"
    local kind="$2"
    local label="$3"
    local caption="$4"
    local timestamp="$5"
    local relative_path="$6"
    local expected="$7"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$kind" "$label" "$caption" "$timestamp" "$relative_path" "$expected" >>"$manifest_path"
}

