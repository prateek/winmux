pre_tart_gate_self_test() {
    local tmp_dir
    local log_path

    tmp_dir="$(mktemp -d)"
    log_path="${tmp_dir}/direct-slice-39.log"
    if WINMUX_E2E_RUN_ID=pre-tart-gate-self-test \
        WINMUX_E2E_RUN_DIR="${tmp_dir}/run" \
        WINMUX_E2E_SLICE=slice-39 \
        "${SCRIPT_DIR}/tart-recording-harness" slice-39 >"$log_path" 2>&1; then
        cat "$log_path" >&2
        rm -rf "$tmp_dir"
        die "Pre-Tart gate self-test expected direct slice-39 recording to fail without reviewer reports"
    fi

    if ! grep -F 'missing pre-Tart freshness manifest' "$log_path" >/dev/null; then
        cat "$log_path" >&2
        rm -rf "$tmp_dir"
        die "Pre-Tart gate self-test did not fail through the review gate"
    fi
    grep -F 'phase=pre-tart-review-gate' "${tmp_dir}/run/logs/run-abort-status.txt" >/dev/null \
        || {
            cat "$log_path" >&2
            rm -rf "$tmp_dir"
            die "Pre-Tart gate self-test missing abort status"
        }
    if grep -F 'TART_HOME must be set' "$log_path" >/dev/null; then
        cat "$log_path" >&2
        rm -rf "$tmp_dir"
        die "Pre-Tart gate self-test reached Tart preflight before the review gate"
    fi

    rm -rf "$tmp_dir"
    log "Pre-Tart gate self-test passed"
}

