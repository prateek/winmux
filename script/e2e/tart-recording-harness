grep -F 'focused-zone=main' \"\${FOCUS_LOG}\" >/dev/null
grep -F 'focused-zone=right' \"\${FOCUS_LOG}\" >/dev/null
grep -F 'zone=left' \"\${WORKSPACE_LOG}\" >/dev/null
grep -F 'zone=main' \"\${WORKSPACE_LOG}\" >/dev/null
grep -F 'zone=right' \"\${WORKSPACE_LOG}\" >/dev/null

{
    echo 'WinMux Slice 2: config-backed column zones'
    echo
    echo 'The copied config defines three named columns: left/Reference, main/Work, and right/Comms.'
    echo
    echo 'Configured zone viewports:'
    cat \"\${MONITOR_LOG}\"
    echo
    echo 'TextEdit windows placed into configured zones:'
    cat \"\${WINDOW_LOG}\"
    echo
    echo 'Focus traversal across configured zone names:'
    cat \"\${FOCUS_LOG}\"
    echo
    echo 'PASS: config-backed zones are visible through the real WinMux CLI and contain live windows.'
} >\"\${PROOF}\"

echo
cat \"\${PROOF}\"
sleep 4
touch \"\${DONE}\"
SLICE2
chmod +x ${scenario_path_quoted}
echo slice_2_scenario_installed=${scenario_path_quoted}"

