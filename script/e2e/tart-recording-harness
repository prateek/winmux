    append_guest_retry_rows_to_transport_summary "$summary_path"
    [ -s "$summary_path" ] || die "Guest transport summary did not produce a non-empty file: $summary_path"
}

zone_log_field() {
    local log_path="$1"
    local zone_id="$2"
    local key="$3"
    /usr/bin/awk -F'|' -v zone="zone=${zone_id}" -v key="$key" '$1 == zone {
        for (i = 1; i <= NF; i++) {
            if (index($i, key "=") == 1) {
                print substr($i, length(key) + 2)
                exit
            }
        }
    }' "$log_path"
}

write_mouse_snap_overlay_sentinel() {
    local name="$1"
    case "$name" in
        slice-12-mouse-zone-snap-drag|slice-16-mouse-snap-affordance|slice-20-zone-snap-policy-switch|slice-22-float-unless-snap|slice-23-product-snap-overlay-label|slice-24-secondary-button-snap|slice-25-mouse-demo-contract) ;;
        *) return 0 ;;
    esac
    command -v magick >/dev/null 2>&1 || die "Mouse snap overlay sentinel requires ImageMagick: magick"
    command -v compare >/dev/null 2>&1 || die "Mouse snap overlay sentinel requires ImageMagick: compare"

    local slice_prefix="slice-12"
    local modifier_label="Alt"
    if [ "$name" = "slice-16-mouse-snap-affordance" ]; then
        slice_prefix="slice-16"
        modifier_label="Option"
    elif [ "$name" = "slice-20-zone-snap-policy-switch" ]; then
        slice_prefix="slice-20"
        modifier_label="runtime-policy"
    elif [ "$name" = "slice-22-float-unless-snap" ]; then
        slice_prefix="slice-22"
        modifier_label="Alt"
    elif [ "$name" = "slice-23-product-snap-overlay-label" ]; then
        slice_prefix="slice-23"
        modifier_label="Alt"
    elif [ "$name" = "slice-24-secondary-button-snap" ] || [ "$name" = "slice-25-mouse-demo-contract" ]; then
        if [ "$name" = "slice-25-mouse-demo-contract" ]; then
            slice_prefix="slice-25"
        else
            slice_prefix="slice-24"
        fi
        modifier_label="secondary-button"
    fi
    local zones_log="${LOGS_DIR}/${slice_prefix}-zones.log"
    local freeform="${SCREENSHOTS_DIR}/03-freeform-hover-no-overlay-${slice_prefix}.png"
    local snap="${SCREENSHOTS_DIR}/07-snap-hover-comms-${slice_prefix}.png"
    [ -s "$zones_log" ] || die "Mouse snap overlay sentinel missing zones log: $zones_log"
    [ -s "$freeform" ] || die "Mouse snap overlay sentinel missing freeform hover screenshot: $freeform"
    [ -s "$snap" ] || die "Mouse snap overlay sentinel missing snap hover screenshot: $snap"

    local left top width height crop crop_width crop_height diff_raw diff_norm
    left="$(zone_log_field "$zones_log" right left)"
    top="$(zone_log_field "$zones_log" right top)"
    width="$(zone_log_field "$zones_log" right width)"
    height="$(zone_log_field "$zones_log" right height)"
    [ -n "$left" ] && [ -n "$top" ] && [ -n "$width" ] && [ -n "$height" ] \
        || die "Mouse snap overlay sentinel could not derive right/Comms crop from $zones_log"
    crop="$(awk -v w="$width" -v h="$height" -v x="$left" -v y="$top" 'BEGIN { printf "%dx%d+%d+%d", w + 0, h + 0, x + 0, y + 0 }')"
    crop_width="$(awk -v w="$width" 'BEGIN { printf "%d", w + 0 }')"
    crop_height="$(awk -v h="$height" 'BEGIN { printf "%d", h + 0 }')"

    local crop_dir="${SCREENSHOTS_DIR}/${name}.overlay-sentinel"
    local manifest="${LOGS_DIR}/${name}.overlay-sentinel.tsv"
    rm -rf "$crop_dir"
    mkdir -p "$crop_dir"
    magick "$freeform" -crop "$crop" +repage "${crop_dir}/freeform-target-zone.png"
    magick "$snap" -crop "$crop" +repage "${crop_dir}/snap-target-zone.png"
    local label_font="${WINMUX_E2E_OVERLAY_SENTINEL_FONT:-/System/Library/Fonts/Supplemental/Arial.ttf}"
    [ -f "$label_font" ] || label_font="/System/Library/Fonts/Helvetica.ttc"
    local border_right border_bottom label_right
    border_right=$((crop_width - 10))
    border_bottom=$((crop_height - 10))
    label_right="$(awk -v w="$crop_width" 'BEGIN { max = w - 24; printf "%d\n", (max < 780 ? max : 780) }')"
    magick "$snap" -crop "$crop" +repage \
        -fill '#D3455B33' -stroke '#D3455B' -strokewidth 8 \
        -draw "rectangle 8,8 ${border_right},${border_bottom}" \
        -fill '#101820' -stroke '#101820' -strokewidth 1 \
        -draw "roundrectangle 24,24 ${label_right},100 8,8" \
        -font "$label_font" -pointsize 38 -fill '#FFFFFF' -stroke none \
        -annotate +42+73 'WHOLE ZONE TARGET: COMMS' \
        "${crop_dir}/snap-target-zone-labeled.png"
    diff_raw="$(compare -metric RMSE "${crop_dir}/freeform-target-zone.png" "${crop_dir}/snap-target-zone.png" null: 2>&1 || true)"
    diff_norm="$(printf '%s\n' "$diff_raw" | sed -n 's/.*(\([0-9.][0-9.]*\)).*/\1/p')"
    [ -n "$diff_norm" ] || die "Could not compute mouse snap overlay RMSE for $name: $diff_raw"
    {
        printf '# label\tvalue\tminimum\tpath\tnote\n'
        printf 'target-zone-crop\t%s\t\tlogs/%s-zones.log\tright/Comms crop derived from list-zones\n' "$crop" "$slice_prefix"
        printf 'freeform-target-zone-crop\t\t\tscreenshots/%s.overlay-sentinel/freeform-target-zone.png\tno-%s hover target-zone crop\n' "$name" "$modifier_label"
        printf 'snap-target-zone-crop\t\t\tscreenshots/%s.overlay-sentinel/snap-target-zone.png\t%s-held hover target-zone crop\n' "$name" "$modifier_label"
        printf 'target-label\tWHOLE ZONE TARGET: COMMS\t\tscreenshots/%s.overlay-sentinel/snap-target-zone-labeled.png\tlabeled whole-zone target crop for reviewer-visible proof\n' "$name"
        printf 'overlay-rmse-normalized\t%s\t0.025\t\t%s-held target-zone hover must visibly differ from no-%s hover\n' "$diff_norm" "$modifier_label" "$modifier_label"
        printf 'target-semantics\twhole-zone\t\tscreenshots/%s\tsnap target is the whole Comms zone, not a window or slot\n' "$(basename "$snap")"
    } >"$manifest"
    [ -s "$manifest" ] || die "Mouse snap overlay sentinel did not produce a non-empty file: $manifest"
}

