write_timed_slice_20_annotation_plan() {
    local captions_path="$1"
    local timing_log="${LOGS_DIR}/slice-20-command-timing.log"
    if [ ! -s "$timing_log" ]; then
        write_static_slice_20_annotation_plan "$captions_path"
        return 0
    fi

    local freeform_start_offset freeform_end_offset snap_start_offset snap_end_offset cycle_start_offset
    freeform_start_offset="$(timing_value_from_log freeform-drag-start-offset-seconds "$timing_log")"
    freeform_end_offset="$(timing_value_from_log freeform-drag-end-offset-seconds "$timing_log")"
    snap_start_offset="$(timing_value_from_log snap-drag-start-offset-seconds "$timing_log")"
    snap_end_offset="$(timing_value_from_log snap-drag-end-offset-seconds "$timing_log")"
    cycle_start_offset="$(timing_value_from_log cycle-command-start-offset-seconds "$timing_log")"
    if [ -z "$freeform_start_offset" ] || [ -z "$freeform_end_offset" ] || [ -z "$snap_start_offset" ] || [ -z "$snap_end_offset" ] || [ -z "$cycle_start_offset" ]; then
        write_static_slice_20_annotation_plan "$captions_path"
        return 0
    fi

    /usr/bin/awk \
        -v base=8 \
        -v freeform_start_offset="$freeform_start_offset" \
        -v freeform_end_offset="$freeform_end_offset" \
        -v snap_start_offset="$snap_start_offset" \
        -v snap_end_offset="$snap_end_offset" \
        -v cycle_start_offset="$cycle_start_offset" '
        function max(a, b) { return a > b ? a : b }
        function min(a, b) { return a < b ? a : b }
        function emit(start, end, title, body, chip) {
            if (end <= start) {
                end = start + 1
            }
            printf "%.3f\t%.3f\t%s\t%s\t%s\n", start, end, title, body, chip
        }
        BEGIN {
            freeform_start = base + freeform_start_offset
            freeform_end = base + freeform_end_offset
            snap_start = base + snap_start_offset
            snap_end = base + snap_end_offset
            cycle_start = base + cycle_start_offset

            first_freeform_end = min(freeform_start + 6, max(freeform_start + 1, freeform_end - 5))
            freeform_hover_end = min(freeform_end - 1, snap_start - 6)
            if (freeform_hover_end <= first_freeform_end) {
                freeform_hover_end = first_freeform_end + 1
            }
            result_end = max(freeform_end, freeform_hover_end + 1)
            enable_end = max(snap_start, result_end + 3)
            drag_again_end = min(snap_start + 8, snap_end - 8)
            if (drag_again_end <= snap_start) {
                drag_again_end = snap_start + 4
            }
            drag_again_end = min(drag_again_end, snap_start + 4)
            target_end = min(snap_start + 8, cycle_start - 8)
            if (target_end <= drag_again_end) {
                target_end = drag_again_end + 4
            }
            final_end = max(cycle_start, snap_end + 2)
            release_start = target_end

            emit(0, base, "Policy-switch ready", "The configured mouse policy starts freeform on the zone monitor.", "Config: policy='\''freeform'\''; alt-z='\''set-zone-snap-policy snap-to-zone'\''")
            emit(freeform_start, first_freeform_end, "Freeform pickup", "Pick up snap-demo.rtf with no modifier under the configured freeform policy.", "Action: drag snap-demo.rtf with no modifier")
            emit(first_freeform_end, freeform_hover_end, "No snap overlay", "The pointer crosses the Comms area without a zone affordance or zone move.", "Action: freeform hover has no whole-zone overlay")
            emit(freeform_hover_end, result_end, "Freeform result", "The same window remains bound to Work after the freeform drag.", "Run: winmux list-windows --monitor all")
            emit(result_end, enable_end, "Enable snapping", "Runtime policy changes before the next drag starts.", "Run: winmux set-zone-snap-policy snap-to-zone")
            emit(snap_start, drag_again_end, "Drag again", "The second no-modifier drag now uses the runtime snap policy.", "Action: drag snap-demo.rtf with snap-to-zone active")
            emit(drag_again_end, target_end, "Whole-zone target", "The overlay targets the Comms zone itself, not a window or slot.", "Action: target = whole Comms zone")
            emit(release_start, final_end, "Release into Comms", "Drop to move the same window to Comms active workspace and leave it visible.", "Action: release on Comms zone")
            emit(cycle_start, cycle_start + 8, "Cycle back", "One binding-friendly command toggles runtime policy back to freeform.", "Run: winmux cycle-zone-snap-policy freeform snap-to-zone")
            emit(cycle_start + 8, cycle_start + 14, "Inspect placement", "The window log proves the same id moved from Work/main to Comms/right.", "Run: winmux list-windows --monitor all")
        }
    ' >"$captions_path"
}

