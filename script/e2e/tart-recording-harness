last_log_value() {
    local path="$1"
    local key="$2"
    [ -s "$path" ] || {
        printf 'missing\n'
        return
    }
    /usr/bin/awk -F= -v key="$key" '$1 == key { value = substr($0, length(key) + 2) } END { if (value != "") print value; else print "unknown" }' "$path"
}

count_log_key_value() {
    local path="$1"
    local key="$2"
    local value="$3"
    [ -s "$path" ] || {
        printf '0\n'
        return
    }
    /usr/bin/awk -F= -v key="$key" -v value="$value" '$1 == key && substr($0, length(key) + 2) == value { count += 1 } END { print count + 0 }' "$path"
}

count_log_attempts() {
    local path="$1"
    [ -s "$path" ] || {
        printf '0\n'
        return
    }
    /usr/bin/awk -F= '$1 == "attempt" { count += 1 } END { print count + 0 }' "$path"
}

write_transport_summary_row() {
    local summary_path="$1"
    local phase="$2"
    local log_path="$3"
    local before_recording="$4"
    local relative_log_path
    relative_log_path="logs/$(basename "$log_path")"
    local attempts=0
    local failures=0
    local final_result="missing"

    if [ -s "$log_path" ]; then
        attempts="$(count_log_attempts "$log_path")"
        failures="$(count_log_key_value "$log_path" probe_result failure)"
        if [ "$failures" = "0" ]; then
            failures="$(count_log_key_value "$log_path" result failure)"
        fi
        final_result="$(last_log_value "$log_path" final_result)"
        if [ "$final_result" = "unknown" ]; then
            final_result="$(last_log_value "$log_path" result)"
        fi
        if [ "$final_result" = "unknown" ] && /usr/bin/grep -F 'capture_probe_done' "$log_path" >/dev/null 2>&1; then
            final_result=success
        fi
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$phase" "$relative_log_path" "$attempts" "$failures" "$final_result" "$before_recording" >>"$summary_path"
}

