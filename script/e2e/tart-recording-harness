refresh_annotation_artifact() {
    [ -n "${WINMUX_E2E_RUN_DIR:-}" ] || die "WINMUX_E2E_RUN_DIR is required for refresh-annotation-artifact"
    require_cmd ffmpeg
    require_cmd ffprobe
    require_cmd magick
    [ -x "${SCRIPT_DIR}/annotate-recording" ] || die "Missing executable annotator: ${SCRIPT_DIR}/annotate-recording"
    [ -x "${SCRIPT_DIR}/write-review-packet" ] || die "Missing executable review packet writer: ${SCRIPT_DIR}/write-review-packet"
    ensure_artifact_dirs

    local raw_dir="${RECORDINGS_DIR}/raw"
    [ -d "$raw_dir" ] || die "Raw recording directory is missing: $raw_dir"

    local name="${WINMUX_E2E_RECORDING_NAME:-}"
    local raw_path
    if [ -n "$name" ]; then
        raw_path="${raw_dir}/${name}.raw.mov"
    else
        local raw_count
        raw_count="$(find "$raw_dir" -maxdepth 1 -type f -name '*.raw.mov' | wc -l | tr -d ' ')"
        [ "$raw_count" = 1 ] || die "Expected one raw recording in $raw_dir, found $raw_count. Set WINMUX_E2E_RECORDING_NAME."
        raw_path="$(find "$raw_dir" -maxdepth 1 -type f -name '*.raw.mov' | head -1)"
        name="$(basename "$raw_path" .raw.mov)"
    fi
    [ -s "$raw_path" ] || die "Raw recording is missing or empty: $raw_path"

    local output_path="${RECORDINGS_DIR}/${name}.mov"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local annotation_log="${LOGS_DIR}/${name}.annotation.log"
    write_annotation_plan "$name" "$captions_path"
    write_expected_caption_chips "$name"
    write_event_manifest "$name"
    local caption_footprint caption_anchor
    caption_footprint="${WINMUX_E2E_CAPTION_FOOTPRINT:-$(caption_footprint_for_recording "$name")}"
    caption_anchor="${WINMUX_E2E_CAPTION_ANCHOR:-bottom-left}"
    if ! WINMUX_E2E_CAPTION_FOOTPRINT="$caption_footprint" \
        WINMUX_E2E_CAPTION_ANCHOR="$caption_anchor" \
        "${SCRIPT_DIR}/annotate-recording" "$raw_path" "$captions_path" "$output_path" >"$annotation_log" 2>&1; then
        cat "$annotation_log" >&2 || true
        die "Recording annotation refresh failed for $name"
    fi
    grep -F 'result=success' "$annotation_log" >/dev/null || die "Annotation refresh did not report success for $name"

    local duration
    duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$output_path")"
    printf '%s\n' "$duration" >"${LOGS_DIR}/${name}.duration.txt"
    if [ -s "${LOGS_DIR}/guest-control-check.log" ] || [ -s "${LOGS_DIR}/${name}.guest-screencapture.log" ]; then
        write_guest_transport_summary "$name"
    fi
    write_mouse_snap_overlay_sentinel "$name"
    write_window_slot_overlay_sentinel "$name"
    write_caption_tail_manifest "$name" "$duration"
    generate_demo_cut "$name"
    generate_recording_samples "$name" "$duration"
    generate_final_edge_crops "$name"
    archive_existing_no_context_review
    write_review_packet "$name"
    log "Refreshed annotated artifact for $name in $RUN_DIR"
}

write_review_packet() {
    local name="$1"
    local packet_log="${LOGS_DIR}/${name}.review-packet.log"

    if ! "${SCRIPT_DIR}/write-review-packet" "$RUN_DIR" >"$packet_log" 2>&1; then
        cat "$packet_log" >&2 || true
        die "Review packet generation failed for $name"
    fi
}

wait_for_recording() {
    local name="$1"
    local pid
    pid="$(cat "${LOGS_DIR}/${name}.recording.pid")"
    wait "$pid"
    GUEST_RECORDING_ACTIVE=0
    local path="${RECORDINGS_DIR}/${name}.mov"
    [ -s "$path" ] || die "Recording did not produce a non-empty file: $path"
    local duration
    duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$path")"
    awk -v duration="$duration" -v expected="$RECORD_SECONDS" 'BEGIN { min = expected * 0.80; exit(duration + 0 >= min ? 0 : 1) }' \
        || die "Recording is shorter than expected: ${duration}s for ${RECORD_SECONDS}s request"

    annotate_recording "$name"
    duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$path")"
    printf '%s\n' "$duration" >"${LOGS_DIR}/${name}.duration.txt"
    if [ "$CAPTURE_MODE" = "guest" ]; then
        {
            printf 'host_output_path=%s\n' "$path"
            printf 'host_decoded_duration=%s\n' "$duration"
            ffprobe -v error -show_entries stream=codec_name,width,height,avg_frame_rate -show_entries format=duration,size -of default=noprint_wrappers=1 "$path"
        } >>"${LOGS_DIR}/${name}.guest-screencapture.log"
    fi
    write_guest_transport_summary "$name"
    write_mouse_snap_overlay_sentinel "$name"
    write_window_slot_overlay_sentinel "$name"
    write_caption_tail_manifest "$name" "$duration"
    generate_demo_cut "$name"
    generate_recording_samples "$name" "$duration"
    generate_final_edge_crops "$name"
    write_review_packet "$name"
}

