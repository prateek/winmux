wait_for_guest_capture_ready() {
    local log_path="${LOGS_DIR}/guest-capture-ready.log"
    local probe_path="/tmp/winmux-e2e-capture-probe.png"
    local probe_path_quoted
    probe_path_quoted="$(shell_quote "$probe_path")"
    local script="set -euo pipefail
echo capture_probe_start
rm -f ${probe_path_quoted}
if /usr/sbin/screencapture -x -D${GUEST_DISPLAY_ID} ${probe_path_quoted}; then
    echo capture_display=-D${GUEST_DISPLAY_ID}
else
    rm -f ${probe_path_quoted}
    /usr/sbin/screencapture -x ${probe_path_quoted}
    echo capture_display=default
fi
test -s ${probe_path_quoted}
/usr/bin/stat -f 'probe_bytes=%z' ${probe_path_quoted}
/usr/bin/file ${probe_path_quoted}
rm -f ${probe_path_quoted}
echo capture_probe_done"

    : >"$log_path"
    local attempt=1
    while [ "$attempt" -le "$GUEST_CAPTURE_READY_ATTEMPTS" ]; do
        {
            printf 'attempt=%s\n' "$attempt"
            guest_script "$script"
        } >>"$log_path" 2>&1 && {
            log "Guest screencapture is ready"
            return
        }
        log "Guest screencapture probe ${attempt}/${GUEST_CAPTURE_READY_ATTEMPTS} failed; see $log_path"
        attempt=$((attempt + 1))
        sleep "$GUEST_CAPTURE_READY_RETRY_SECONDS"
    done

    {
        echo diagnostics_start
        guest_script 'set +e
date
/usr/bin/sw_vers
/usr/sbin/system_profiler SPDisplaysDataType
/usr/bin/pgrep -x Dock >/dev/null 2>&1 && echo dock_running=yes || echo dock_running=no
/usr/bin/pgrep -x WindowServer >/dev/null 2>&1 && echo windowserver_running=yes || echo windowserver_running=no
/usr/bin/ps -axo pid,comm | /usr/bin/grep -E "WindowServer|Dock|SystemUIServer|screencapture" | /usr/bin/grep -v grep
exit 0'
        echo diagnostics_done
    } >>"$log_path" 2>&1 || true

    cat "$log_path" >&2 || true
    write_run_abort_status guest-capture-ready 1 failure "$log_path" "Guest screencapture did not become ready"
    die "Guest screencapture did not become ready"
}

stop_vm() {
