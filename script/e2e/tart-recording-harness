wait_for_recording() {
    local name="$1"
    local pid
    pid="$(cat "${LOGS_DIR}/${name}.recording.pid")"
    wait "$pid"
    local path="${RECORDINGS_DIR}/${name}.mov"
    [ -s "$path" ] || die "Recording did not produce a non-empty file: $path"
    local duration
    duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$path")"
    awk -v duration="$duration" -v expected="$RECORD_SECONDS" 'BEGIN { min = expected * 0.80; exit(duration + 0 >= min ? 0 : 1) }' \
        || die "Recording is shorter than expected: ${duration}s for ${RECORD_SECONDS}s request"

    annotate_recording "$name"
    duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$path")"
    printf '%s\n' "$duration" >"${LOGS_DIR}/${name}.duration.txt"
    if [ "$CAPTURE_MODE" = "guest" ]; then
        {
            printf 'host_output_path=%s\n' "$path"
            printf 'host_decoded_duration=%s\n' "$duration"
            ffprobe -v error -show_entries stream=codec_name,width,height,avg_frame_rate -show_entries format=duration,size -of default=noprint_wrappers=1 "$path"
        } >>"${LOGS_DIR}/${name}.guest-screencapture.log"
    fi
    generate_recording_samples "$name" "$duration"
    write_guest_transport_summary "$name"
    write_review_packet "$name"
}

