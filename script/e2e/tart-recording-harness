annotate_recording() {
    local name="$1"
    local path="${RECORDINGS_DIR}/${name}.mov"
    [ "$ANNOTATE_RECORDING" = "1" ] || return

    local raw_dir="${RECORDINGS_DIR}/raw"
    local raw_path="${raw_dir}/${name}.raw.mov"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    local annotation_log="${LOGS_DIR}/${name}.annotation.log"

    mkdir -p "$raw_dir"
    write_annotation_plan "$name" "$captions_path"
    mv "$path" "$raw_path"
    if ! "${SCRIPT_DIR}/annotate-recording" "$raw_path" "$captions_path" "$path" >"$annotation_log" 2>&1; then
        cat "$annotation_log" >&2 || true
        die "Recording annotation failed for $name"
    fi
    [ -s "$path" ] || die "Annotated recording did not produce a non-empty file: $path"
    [ -s "$raw_path" ] || die "Raw recording was not preserved: $raw_path"
}

annotation_preflight() {
    require_cmd ffmpeg
    require_cmd ffprobe
    require_cmd magick
    [ -x "${SCRIPT_DIR}/annotate-recording" ] || die "Missing executable annotator: ${SCRIPT_DIR}/annotate-recording"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' RETURN
    mkdir -p "${tmp_dir}/recordings" "${tmp_dir}/logs"
    local input="${tmp_dir}/recordings/raw.mov"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -f lavfi \
        -i 'color=c=black:s=1280x720:r=10' \
        -t 1 \
        -pix_fmt yuv420p \
        "$input"

    local name captions output render_log
    for name in \
        harness-smoke \
        slice-1-zone-spike \
        slice-2-config-zones \
        slice-3-stable-identity \
        slice-4-zone-commands \
        slice-5-sidebar-drag \
        slice-6-zone-layout-presets \
        slice-6b-zone-scenes \
        slice-8-window-routing \
        slice-10-zone-availability \
        slice-11a-zone-width-controls \
        slice-11b-zone-style-controls
    do
        captions="${tmp_dir}/logs/${name}.annotations.tsv"
        output="${tmp_dir}/recordings/${name}.mov"
        render_log="${tmp_dir}/logs/${name}.annotation.log"
        write_annotation_plan "$name" "$captions"
        awk -F '\t' '
            $0 == "" || $1 ~ /^#/ { next }
            length($5) > 100 {
                printf("Caption command/action chip is too long for preflight (%d chars): %s\n", length($5), $5) > "/dev/stderr"
                exit 1
            }
        ' "$captions" || die "Annotation preflight found an overlong chip in $name"
        if ! "${SCRIPT_DIR}/annotate-recording" "$input" "$captions" "$output" >"$render_log" 2>&1; then
            cat "$render_log" >&2 || true
            die "Annotation preflight failed for $name"
        fi
        grep -F 'result=success' "$render_log" >/dev/null || die "Annotation preflight did not report success for $name"
    done
    log "Annotation preflight rendered all caption plans"
}

clamp_sample_time() {
    local requested="$1"
    local duration="$2"
    awk -v requested="$requested" -v duration="$duration" 'BEGIN {
        if (duration <= 0) {
            printf "0.000"
            exit
        }
        t = requested + 0
        if (t < 0.250) {
            t = 0.250
        }
        max = duration - 0.250
        if (max < 0) {
            max = 0
        }
        if (t > max) {
            t = max
        }
        printf "%.3f", t
    }'
}

sample_recording_frame() {
    local path="$1"
    local duration="$2"
    local requested="$3"
    local output="$4"
    local seconds
    seconds="$(clamp_sample_time "$requested" "$duration")"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -ss "$seconds" \
        -i "$path" \
        -frames:v 1 \
        "$output"
    [ -s "$output" ] || die "Sample frame did not produce a non-empty file: $output"
}

