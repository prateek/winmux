#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd -P)"

ACTION="${1:-preflight}"
SLICE_ID="${WINMUX_E2E_SLICE:-slice-0}"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_ID="${WINMUX_E2E_RUN_ID:-${SLICE_ID}-${TIMESTAMP}}"
ARTIFACT_ROOT="${WINMUX_E2E_ARTIFACT_ROOT:-${REPO_ROOT}/artifacts/e2e}"
RUN_DIR="${WINMUX_E2E_RUN_DIR:-${ARTIFACT_ROOT}/${RUN_ID}}"
SCREENSHOTS_DIR="${RUN_DIR}/screenshots"
RECORDINGS_DIR="${RUN_DIR}/recordings"
LOGS_DIR="${RUN_DIR}/logs"
CONFIG_OUT_DIR="${RUN_DIR}/config"

BASE_VM="${WINMUX_E2E_BASE_VM:-ghcr.io/cirruslabs/macos-tahoe-base:latest}"
VM_NAME="${WINMUX_E2E_VM_NAME:-winmux-e2e-${RUN_ID}}"
VM_DISPLAY="${WINMUX_E2E_VM_DISPLAY:-3440x1440px}"
DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/harness-smoke.toml"
if [ "$ACTION" = "slice-2" ] || [ "$ACTION" = "slice-3" ] || [ "$ACTION" = "slice-4" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/column-zones.toml"
fi
if [ "$ACTION" = "slice-5" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/column-zones-sidebar.toml"
fi
if [ "$ACTION" = "slice-6" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/zone-layout-presets.toml"
fi
if [ "$ACTION" = "slice-6b" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/zone-scenes.toml"
fi
if [ "$ACTION" = "slice-8" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/zone-window-routing.toml"
fi
if [ "$ACTION" = "slice-10" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/zone-availability.toml"
fi
if [ "$ACTION" = "slice-11a" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/zone-width-controls.toml"
fi
if [ "$ACTION" = "slice-11b" ]; then
    DEFAULT_CONFIG_PATH="${SCRIPT_DIR}/configs/zone-style-controls.toml"
fi
CONFIG_PATH="${WINMUX_E2E_CONFIG:-${DEFAULT_CONFIG_PATH}}"
RELOAD_CONFIG_PATH="${WINMUX_E2E_RELOAD_CONFIG:-${SCRIPT_DIR}/configs/column-zones-shifted.toml}"
BUILD_PATH="${WINMUX_E2E_BUILD_PATH:-${REPO_ROOT}/.debug/WinMuxApp}"
DISPLAY_ID="${WINMUX_E2E_DISPLAY_ID:-1}"
GUEST_DISPLAY_ID="${WINMUX_E2E_GUEST_DISPLAY_ID:-$DISPLAY_ID}"
RECORD_SECONDS="${WINMUX_E2E_RECORD_SECONDS:-12}"
VIDEO_FPS="${WINMUX_E2E_VIDEO_FPS:-10}"
FFMPEG_SCREEN_DEVICE="${WINMUX_E2E_FFMPEG_SCREEN_DEVICE:-Capture screen 0}"
FFMPEG_ENCODER="${WINMUX_E2E_FFMPEG_ENCODER:-h264_videotoolbox}"
ANNOTATE_RECORDING="${WINMUX_E2E_ANNOTATE_RECORDING:-1}"
IP_RESOLVER="${WINMUX_E2E_IP_RESOLVER:-dhcp}"
FALLBACK_IP_RESOLVER="${WINMUX_E2E_FALLBACK_IP_RESOLVER:-}"
BOOT_WAIT_SECONDS="${WINMUX_E2E_BOOT_WAIT_SECONDS:-180}"
CONTROL_MODE="${WINMUX_E2E_CONTROL_MODE:-ssh}"
REQUIRE_GUEST_CONTROL="${WINMUX_E2E_REQUIRE_GUEST_CONTROL:-${WINMUX_E2E_REQUIRE_GUEST_AGENT:-0}}"
DEFAULT_GUEST_CONTROL_WAIT_SECONDS=15
if [ "$REQUIRE_GUEST_CONTROL" = "1" ]; then
    DEFAULT_GUEST_CONTROL_WAIT_SECONDS=90
fi
GUEST_CONTROL_WAIT_SECONDS="${WINMUX_E2E_GUEST_CONTROL_WAIT_SECONDS:-${WINMUX_E2E_GUEST_AGENT_WAIT_SECONDS:-$DEFAULT_GUEST_CONTROL_WAIT_SECONDS}}"
SSH_USER="${WINMUX_E2E_SSH_USER:-admin}"
SSH_PASSWORD="${WINMUX_E2E_SSH_PASSWORD:-admin}"
GUEST_ACTION_ATTEMPTS="${WINMUX_E2E_GUEST_ACTION_ATTEMPTS:-5}"
GUEST_ACTION_RETRY_SECONDS="${WINMUX_E2E_GUEST_ACTION_RETRY_SECONDS:-3}"
GUEST_ACTION_SEMANTIC_FAILURE_EXIT="${WINMUX_E2E_GUEST_ACTION_SEMANTIC_FAILURE_EXIT:-86}"
GUEST_CAPTURE_READY_ATTEMPTS="${WINMUX_E2E_GUEST_CAPTURE_READY_ATTEMPTS:-30}"
GUEST_CAPTURE_READY_RETRY_SECONDS="${WINMUX_E2E_GUEST_CAPTURE_READY_RETRY_SECONDS:-2}"
CAPTURE_MODE="${WINMUX_E2E_CAPTURE_MODE:-}"
if [ -z "$CAPTURE_MODE" ]; then
    if [ "$REQUIRE_GUEST_CONTROL" = "1" ]; then
        CAPTURE_MODE="guest"
    else
        CAPTURE_MODE="host"
    fi
fi
GUEST_ARTIFACTS_DIR="${WINMUX_E2E_GUEST_ARTIFACTS_DIR:-/Volumes/My Shared Files/artifacts}"
GUEST_REPO_DIR="${WINMUX_E2E_GUEST_REPO_DIR:-/Volumes/My Shared Files/repo}"
MIN_FREE_GB="${WINMUX_E2E_MIN_FREE_GB:-80}"
ALLOW_INTERNAL_DISK="${WINMUX_E2E_ALLOW_INTERNAL_DISK:-0}"
SKIP_BUILD="${WINMUX_E2E_SKIP_BUILD:-0}"
REUSE_BUILD="${WINMUX_E2E_REUSE_BUILD:-0}"
KEEP_VM="${WINMUX_E2E_KEEP_VM:-0}"
RECREATE_VM="${WINMUX_E2E_RECREATE_VM:-1}"

TART_RUN_PID=""
VM_IP=""

usage() {
    cat <<EOF
Usage: $(basename "$0") <preflight|annotation-preflight|warmup-policy-self-test|smoke|slice-0|slice-1|slice-2|slice-3|slice-4|slice-5|slice-6|slice-6b|slice-8|slice-10|slice-11a|slice-11b>

Environment:
  TART_HOME                         Required. Must point at the external SSD-backed Tart home.
  WINMUX_E2E_ALLOW_INTERNAL_DISK=1  Allow non-/Volumes TART_HOME for local dry-run checks.
  WINMUX_E2E_MIN_FREE_GB=80         Minimum free space required in TART_HOME.
  WINMUX_E2E_BASE_VM=...            Base VM or OCI image to clone.
  WINMUX_E2E_VM_NAME=...            VM name. Defaults to a run-specific name.
  WINMUX_E2E_VM_DISPLAY=3440x1440px Guest display resolution. Empty string skips tart set.
  WINMUX_E2E_CONFIG=...             Config copied into the artifact run.
  WINMUX_E2E_RELOAD_CONFIG=...      Second config staged for slice-3 reload validation.
  WINMUX_E2E_RECORD_SECONDS=12      Video length for smoke recordings.
  WINMUX_E2E_ANNOTATE_RECORDING=1   Add polished caption overlays to final videos.
  WINMUX_E2E_FFMPEG_SCREEN_DEVICE=  ffmpeg avfoundation screen device.
  WINMUX_E2E_IP_RESOLVER=dhcp       Tart IP resolver used after boot.
  WINMUX_E2E_CONTROL_MODE=ssh       Guest control backend: ssh or tart-exec.
  WINMUX_E2E_GUEST_CONTROL_WAIT_SECONDS=90  Seconds to wait for guest control.
  WINMUX_E2E_REQUIRE_GUEST_CONTROL=1  Fail if guest control is unavailable.
  WINMUX_E2E_SSH_USER=admin         SSH user for ssh guest control.
  WINMUX_E2E_SSH_PASSWORD=admin     SSH password for ssh guest control.
  WINMUX_E2E_GUEST_ACTION_ATTEMPTS=5  Retries for guest artifact actions.
  WINMUX_E2E_GUEST_ACTION_SEMANTIC_FAILURE_EXIT=86  Guest exit code that stops retries.
  WINMUX_E2E_GUEST_CAPTURE_READY_ATTEMPTS=30  Screenshot probes before guest capture starts.
  WINMUX_E2E_CAPTURE_MODE=host|guest  Capture from the host display or the guest display.
  WINMUX_E2E_GUEST_ARTIFACTS_DIR=...  Guest path for the shared artifacts mount.
  WINMUX_E2E_GUEST_REPO_DIR=...       Guest path for the shared read-only repo mount.
  WINMUX_E2E_DISPLAY_ID=1           Host display captured by screencapture.
  WINMUX_E2E_GUEST_DISPLAY_ID=1     Guest display captured by guest screencapture.
  WINMUX_E2E_SKIP_BUILD=1           Skip building WinMux before VM actions.
  WINMUX_E2E_REUSE_BUILD=1          Use an existing .debug build instead of rebuilding.
  WINMUX_E2E_KEEP_VM=1              Do not delete the VM at the end.

Artifacts are written to:
  ${RUN_DIR}
EOF
}

log() {
    printf '[winmux-e2e] %s\n' "$*"
}

die() {
    printf '[winmux-e2e] error: %s\n' "$*" >&2
    exit 1
}

run_cmd() {
    log "+ $*"
    "$@"
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

build_exists() {
    [ -d "$BUILD_PATH" ] || [ -x "$BUILD_PATH" ]
}

ensure_artifact_dirs() {
    mkdir -p "$SCREENSHOTS_DIR" "$RECORDINGS_DIR" "$LOGS_DIR" "$CONFIG_OUT_DIR"
}

ensure_tart_home() {
    [ -n "${TART_HOME:-}" ] || die "TART_HOME must be set to the external SSD-backed Tart home"
    [ -d "$TART_HOME" ] || die "TART_HOME does not exist: $TART_HOME"
    [ -w "$TART_HOME" ] || die "TART_HOME is not writable: $TART_HOME"

    local physical_tart_home
    physical_tart_home="$(cd "$TART_HOME" && pwd -P)"
    if [ "$ALLOW_INTERNAL_DISK" != "1" ]; then
        case "$physical_tart_home" in
            /Volumes/*) ;;
            *) die "TART_HOME must live under /Volumes for e2e runs. Set WINMUX_E2E_ALLOW_INTERNAL_DISK=1 only for local dry-run checks." ;;
        esac
    fi

    local available_kb
    available_kb="$(df -Pk "$physical_tart_home" | awk 'NR == 2 { print $4 }')"
    [ -n "$available_kb" ] || die "Could not read free space for TART_HOME: $physical_tart_home"
    if [ "$available_kb" -lt $((MIN_FREE_GB * 1024 * 1024)) ]; then
        die "TART_HOME has less than ${MIN_FREE_GB}GB free: $physical_tart_home"
    fi
}

ensure_tools() {
    require_cmd tart
    require_cmd ffmpeg
    require_cmd ffprobe
    if [ "$ANNOTATE_RECORDING" = "1" ]; then
        require_cmd magick
        [ -x "${SCRIPT_DIR}/annotate-recording" ] || die "Missing executable annotator: ${SCRIPT_DIR}/annotate-recording"
    fi
    [ -x "${SCRIPT_DIR}/write-review-packet" ] || die "Missing executable review packet writer: ${SCRIPT_DIR}/write-review-packet"
    require_cmd screencapture
    require_cmd osascript
    require_cmd make
    case "$CONTROL_MODE" in
        ssh)
            require_cmd ssh
            require_cmd sshpass
            ;;
        tart-exec) ;;
        *) die "Unsupported WINMUX_E2E_CONTROL_MODE: $CONTROL_MODE" ;;
    esac
    case "$CAPTURE_MODE" in
        host|guest) ;;
        *) die "Unsupported WINMUX_E2E_CAPTURE_MODE: $CAPTURE_MODE" ;;
    esac
    case "$ANNOTATE_RECORDING" in
        0|1) ;;
        *) die "Unsupported WINMUX_E2E_ANNOTATE_RECORDING: $ANNOTATE_RECORDING" ;;
    esac
}

shell_quote() {
    local value="$1"
    printf "'"
    printf '%s' "$value" | sed "s/'/'\\\\''/g"
    printf "'"
}

file_sha256() {
    shasum -a 256 "$1" | awk '{ print $1 }'
}

guest_transport_warmup_satisfied() {
    local total_successes="$1"
    local consecutive_successes="$2"
    [ "$total_successes" -ge 3 ] && [ "$consecutive_successes" -ge 2 ]
}

simulate_guest_transport_warmup() {
    local max_attempts="$1"
    shift
    local consecutive_successes=0
    local total_successes=0
    local attempt=1
    local outcome

    for outcome in "$@"; do
        [ "$attempt" -le "$max_attempts" ] || break
        case "$outcome" in
            success)
                consecutive_successes=$((consecutive_successes + 1))
                total_successes=$((total_successes + 1))
                if guest_transport_warmup_satisfied "$total_successes" "$consecutive_successes"; then
                    printf 'result=success attempt=%s total_successes=%s consecutive_successes=%s\n' \
                        "$attempt" "$total_successes" "$consecutive_successes"
                    return 0
                fi
                ;;
            failure)
                consecutive_successes=0
                ;;
            *)
                die "Unknown warm-up simulation outcome: $outcome"
                ;;
        esac
        attempt=$((attempt + 1))
    done

    printf 'result=failure attempts=%s total_successes=%s consecutive_successes=%s\n' \
        $((attempt - 1)) "$total_successes" "$consecutive_successes"
    return 1
}

assert_warmup_policy_pass() {
    local label="$1"
    shift
    simulate_guest_transport_warmup "$@" >/dev/null \
        || die "Warm-up policy self-test expected pass but failed: $label"
}

assert_warmup_policy_fail() {
    local label="$1"
    shift
    if simulate_guest_transport_warmup "$@" >/dev/null; then
        die "Warm-up policy self-test expected failure but passed: $label"
    fi
}

warmup_policy_self_test() {
    assert_warmup_policy_pass "observed transient auth miss" 10 success failure success success
    assert_warmup_policy_pass "late adjacent recovery" 10 success success failure success success
    assert_warmup_policy_fail "only two total successes" 10 success failure success failure failure
    assert_warmup_policy_fail "three successes without adjacent pair" 10 success failure success failure success
    assert_warmup_policy_fail "max attempts exhausted before adjacent recovery" 3 success failure success success
    log "Warm-up policy self-test passed"
}

vm_exists() {
    tart get "$1" >/dev/null 2>&1
}

base_vm_is_local_name() {
    case "$BASE_VM" in
        *://*|*/*:*|*@sha256:*) return 1 ;;
        *) return 0 ;;
    esac
}

ensure_base_vm_available() {
    if base_vm_is_local_name && ! vm_exists "$BASE_VM"; then
        die "Base VM '$BASE_VM' is not available in TART_HOME=$TART_HOME"
    fi
}

write_preflight_log() {
    {
        printf 'repo_root=%s\n' "$REPO_ROOT"
        printf 'tart_version=%s\n' "$(tart --version)"
        printf 'tart_home=%s\n' "$(cd "$TART_HOME" && pwd -P)"
        printf 'base_vm=%s\n' "$BASE_VM"
        printf 'vm_name=%s\n' "$VM_NAME"
        printf 'vm_display=%s\n' "$VM_DISPLAY"
        printf 'build_path=%s\n' "$BUILD_PATH"
        printf 'reuse_build=%s\n' "$REUSE_BUILD"
        printf 'config_path=%s\n' "$CONFIG_PATH"
        printf 'config_sha256=%s\n' "$(file_sha256 "$CONFIG_PATH")"
        printf 'reload_config_path=%s\n' "$RELOAD_CONFIG_PATH"
        if [ "$ACTION" = "slice-3" ] && [ -f "$RELOAD_CONFIG_PATH" ]; then
            printf 'reload_config_sha256=%s\n' "$(file_sha256 "$RELOAD_CONFIG_PATH")"
        fi
        printf 'artifact_dir=%s\n' "$RUN_DIR"
        printf 'display_id=%s\n' "$DISPLAY_ID"
        printf 'guest_display_id=%s\n' "$GUEST_DISPLAY_ID"
        printf 'record_seconds=%s\n' "$RECORD_SECONDS"
        printf 'annotate_recording=%s\n' "$ANNOTATE_RECORDING"
        printf 'video_fps=%s\n' "$VIDEO_FPS"
        printf 'ffmpeg_screen_device=%s\n' "$FFMPEG_SCREEN_DEVICE"
        printf 'ffmpeg_encoder=%s\n' "$FFMPEG_ENCODER"
        printf 'ip_resolver=%s\n' "$IP_RESOLVER"
        printf 'fallback_ip_resolver=%s\n' "$FALLBACK_IP_RESOLVER"
        printf 'control_mode=%s\n' "$CONTROL_MODE"
        printf 'guest_control_wait_seconds=%s\n' "$GUEST_CONTROL_WAIT_SECONDS"
        printf 'require_guest_control=%s\n' "$REQUIRE_GUEST_CONTROL"
        printf 'ssh_user=%s\n' "$SSH_USER"
        printf 'guest_action_attempts=%s\n' "$GUEST_ACTION_ATTEMPTS"
        printf 'guest_action_retry_seconds=%s\n' "$GUEST_ACTION_RETRY_SECONDS"
        printf 'guest_action_semantic_failure_exit=%s\n' "$GUEST_ACTION_SEMANTIC_FAILURE_EXIT"
        printf 'guest_capture_ready_attempts=%s\n' "$GUEST_CAPTURE_READY_ATTEMPTS"
        printf 'guest_capture_ready_retry_seconds=%s\n' "$GUEST_CAPTURE_READY_RETRY_SECONDS"
        printf 'capture_mode=%s\n' "$CAPTURE_MODE"
        printf 'guest_artifacts_dir=%s\n' "$GUEST_ARTIFACTS_DIR"
        printf 'guest_repo_dir=%s\n' "$GUEST_REPO_DIR"
        printf 'free_space=\n'
        df -h "$TART_HOME"
        printf '\ntart_list=\n'
        tart list || true
    } | tee "$LOGS_DIR/preflight.log"
}

preflight() {
    ensure_artifact_dirs
    ensure_tools
    ensure_tart_home
    [ -f "$CONFIG_PATH" ] || die "Missing WinMux e2e config: $CONFIG_PATH"
    cp "$CONFIG_PATH" "$CONFIG_OUT_DIR/winmux.toml"
    if [ "$ACTION" = "slice-3" ]; then
        [ -f "$RELOAD_CONFIG_PATH" ] || die "Missing WinMux e2e reload config: $RELOAD_CONFIG_PATH"
        cp "$RELOAD_CONFIG_PATH" "$CONFIG_OUT_DIR/winmux-shifted.toml"
    fi
    ensure_base_vm_available
    write_preflight_log
}

ensure_host_build() {
    if [ "$SKIP_BUILD" = "1" ]; then
        log "Skipping host build because WINMUX_E2E_SKIP_BUILD=1"
        return
    fi
    if [ "$REUSE_BUILD" = "1" ] && build_exists; then
        log "Using existing WinMux build: $BUILD_PATH"
        return
    fi
    run_cmd make -C "$REPO_ROOT" build
    build_exists || die "WinMux build did not produce expected app or executable: $BUILD_PATH"
}

prepare_vm() {
    if vm_exists "$VM_NAME"; then
        if [ "$RECREATE_VM" = "1" ]; then
            run_cmd tart stop "$VM_NAME" --timeout 10 || true
            run_cmd tart delete "$VM_NAME"
        else
            log "Using existing VM: $VM_NAME"
            return
        fi
    fi
    run_cmd tart clone "$BASE_VM" "$VM_NAME"
    if [ -n "$VM_DISPLAY" ]; then
        run_cmd tart set "$VM_NAME" --display "$VM_DISPLAY" --no-display-refit
    fi
}

start_vm() {
    local tart_run_log="${LOGS_DIR}/tart-run.log"
    log "Starting VM: $VM_NAME"
    tart run \
        --no-audio \
        --dir="repo:${REPO_ROOT}:ro" \
        --dir="artifacts:${RUN_DIR}" \
        "$VM_NAME" >"$tart_run_log" 2>&1 &
    TART_RUN_PID="$!"
    printf '%s\n' "$TART_RUN_PID" >"${LOGS_DIR}/tart-run.pid"

    if tart ip "$VM_NAME" --resolver "$IP_RESOLVER" --wait "$BOOT_WAIT_SECONDS" >"${LOGS_DIR}/vm-ip.log" 2>&1; then
        VM_IP="$(cat "${LOGS_DIR}/vm-ip.log")"
        printf '%s\n' "$VM_IP"
        return
    fi

    [ -n "$FALLBACK_IP_RESOLVER" ] || return 1
    log "$IP_RESOLVER IP resolver failed; trying $FALLBACK_IP_RESOLVER resolver"
    tart ip "$VM_NAME" --resolver "$FALLBACK_IP_RESOLVER" --wait 30 >"${LOGS_DIR}/vm-ip.log" 2>&1
    VM_IP="$(cat "${LOGS_DIR}/vm-ip.log")"
    printf '%s\n' "$VM_IP"
}

ssh_guest_command() {
    [ -n "$VM_IP" ] || die "VM IP is not available for SSH guest control"
    SSHPASS="$SSH_PASSWORD" sshpass -e ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=5 \
        -o ConnectionAttempts=1 \
        -o PreferredAuthentications=password \
        -o PubkeyAuthentication=no \
        -o LogLevel=ERROR \
        "${SSH_USER}@${VM_IP}" \
        "$@"
}

guest_command() {
    case "$CONTROL_MODE" in
        ssh)
            ssh_guest_command "$@"
            ;;
        tart-exec)
            tart exec "$VM_NAME" "$@"
            ;;
        *)
            die "Unsupported WINMUX_E2E_CONTROL_MODE: $CONTROL_MODE"
            ;;
    esac
}

guest_script() {
    local script="$1"
    case "$CONTROL_MODE" in
        ssh)
            printf '%s\n' "$script" | ssh_guest_command /bin/bash -s
            ;;
        tart-exec)
            tart exec "$VM_NAME" /bin/bash -lc "$script"
            ;;
        *)
            die "Unsupported WINMUX_E2E_CONTROL_MODE: $CONTROL_MODE"
            ;;
    esac
}

guest_script_retry() {
    local script="$1"
    local log_path="$2"
    local attempt=1
    local failure_count=0

    : >"$log_path"
    while [ "$attempt" -le "$GUEST_ACTION_ATTEMPTS" ]; do
        local status=0
        {
            printf 'attempt=%s\n' "$attempt"
            guest_script "$script"
        } >>"$log_path" 2>&1 || status=$?
        if [ "$status" -eq 0 ]; then
            {
                printf 'result=success\n'
                printf 'failure_count=%s\n' "$failure_count"
                printf 'final_result=success\n'
            } >>"$log_path"
            return
        fi
        failure_count=$((failure_count + 1))
        if [ "$status" -eq "$GUEST_ACTION_SEMANTIC_FAILURE_EXIT" ]; then
            log "Guest action attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} hit a semantic scenario failure; see $log_path"
            {
                printf 'result=semantic_failure\n'
                printf 'failure_count=%s\n' "$failure_count"
                printf 'final_result=semantic_failure\n'
            } >>"$log_path"
            return "$status"
        fi

        log "Guest action attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} failed; see $log_path"
        printf 'result=failure\n' >>"$log_path"
        attempt=$((attempt + 1))
        if [ "$attempt" -le "$GUEST_ACTION_ATTEMPTS" ]; then
            sleep "$GUEST_ACTION_RETRY_SECONDS"
        fi
    done

    {
        printf 'failure_count=%s\n' "$failure_count"
        printf 'final_result=failure\n'
    } >>"$log_path"
    return 1
}

warm_guest_transport() {
    local label="$1"
    local log_path="${LOGS_DIR}/guest-control-warmup-${label}.log"
    local consecutive_successes=0
    local total_successes=0
    local attempt=1
    local max_attempts="${WINMUX_E2E_GUEST_TRANSPORT_WARMUP_ATTEMPTS:-10}"

    : >"$log_path"
    while [ "$attempt" -le "$max_attempts" ]; do
        local status=0
        {
            printf 'attempt=%s\n' "$attempt"
            guest_script "true"
        } >>"$log_path" 2>&1 || status=$?
        if [ "$status" -eq 0 ]; then
            consecutive_successes=$((consecutive_successes + 1))
            total_successes=$((total_successes + 1))
            {
                printf 'probe_result=success\n'
                printf 'total_successes=%s\n' "$total_successes"
                printf 'consecutive_successes=%s\n' "$consecutive_successes"
            } >>"$log_path"
            if guest_transport_warmup_satisfied "$total_successes" "$consecutive_successes"; then
                {
                    printf 'result=success\n'
                    printf 'total_successes=%s\n' "$total_successes"
                    printf 'consecutive_successes=%s\n' "$consecutive_successes"
                } >>"$log_path"
                return
            fi
        else
            consecutive_successes=0
            {
                printf 'probe_result=failure\n'
                printf 'total_successes=%s\n' "$total_successes"
                printf 'consecutive_successes=0\n'
            } >>"$log_path"
            log "Guest transport warm-up ${label} attempt ${attempt}/${max_attempts} failed; see $log_path"
            sleep "$GUEST_ACTION_RETRY_SECONDS"
        fi
        attempt=$((attempt + 1))
    done

    printf 'result=failure\n' >>"$log_path"
    return 1
}

wait_for_guest_control() {
    local check_log="${LOGS_DIR}/guest-control-check.log"
    local deadline=$((SECONDS + GUEST_CONTROL_WAIT_SECONDS))
    local script
    # shellcheck disable=SC2016 # This command runs inside the guest.
    script='set -euo pipefail
echo guest_control_ready
printf "user=%s\n" "$(/usr/bin/whoami)"
printf "host=%s\n" "$(/bin/hostname)"
printf "date_utc=%s\n" "$(/bin/date -u +"%Y-%m-%dT%H:%M:%SZ")"
/usr/bin/sw_vers'

    log "Waiting for guest control via $CONTROL_MODE"
    while [ "$SECONDS" -le "$deadline" ]; do
        if guest_script "$script" >"$check_log" 2>&1; then
            printf 'control_mode=%s\n' "$CONTROL_MODE" >>"$check_log"
            printf 'result=success\n' >>"$check_log"
            log "Guest control is ready via $CONTROL_MODE"
            return
        fi
        sleep 5
    done

    log "Guest control is not ready via $CONTROL_MODE; last check is in $check_log"
    return 1
}

