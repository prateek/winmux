run_recorded_scenario() {
    local recording_name="$1"
    local before_name="$2"
    local after_name="$3"
    local scenario_fn="$4"
    local setup_fn="${5:-}"
    local ready_name="${6:-}"

    require_pre_tart_review_gate_for_action
    RUN_PHASE="preflight"
    trap recorded_scenario_exit EXIT
    preflight
    local generated_version_snapshot="${LOGS_DIR}/host-build-generated-version-snapshot"
    RUN_PHASE="host-build"
    snapshot_generated_version_files "$generated_version_snapshot"
    GENERATED_VERSION_SNAPSHOT_DIR="$generated_version_snapshot"
    ensure_host_build
    restore_pending_generated_version_snapshot
    RUN_PHASE="host-build-generated-clean"
    local generated_clean_log="${LOGS_DIR}/host-build-generated-clean.log"
    local generated_clean_rc=0
    "${SCRIPT_DIR}/check-generated-version-clean" >"$generated_clean_log" 2>&1 || generated_clean_rc=$?
    if [ "$generated_clean_rc" -ne 0 ]; then
        cat "$generated_clean_log" >&2 || true
        write_run_abort_status "$RUN_PHASE" "$generated_clean_rc" failure "$generated_clean_log" \
            "generated version files were dirty after host build"
        return "$generated_clean_rc"
    fi
    RUN_PHASE="prepare-vm"
    prepare_vm
    RUN_PHASE="start-vm"
    start_vm
    RUN_PHASE="guest-control"
    local guest_control_ready=0
    if wait_for_guest_control; then
        guest_control_ready=1
    elif [ "$REQUIRE_GUEST_CONTROL" = "1" ]; then
        cat "${LOGS_DIR}/guest-control-check.log" >&2 || true
        die "Guest control via $CONTROL_MODE did not become available within ${GUEST_CONTROL_WAIT_SECONDS}s"
    fi
    if [ "$CAPTURE_MODE" = "guest" ] && [ "$guest_control_ready" != "1" ]; then
        die "Guest capture requires working guest control. Set WINMUX_E2E_CAPTURE_MODE=host for host-side capture."
    fi
    if [ "$CAPTURE_MODE" = "guest" ]; then
        RUN_PHASE="guest-artifact-mount"
        ensure_guest_artifact_mount
        RUN_PHASE="guest-transport-before-privacy"
        warm_guest_transport "before-privacy"
        RUN_PHASE="guest-privacy"
        prepare_guest_privacy_permissions
    fi
    if [ "$guest_control_ready" = "1" ]; then
        RUN_PHASE="guest-desktop"
        wait_for_guest_desktop
        RUN_PHASE="guest-clean-slate"
        prepare_guest_clean_slate
    fi
    if [ "$CAPTURE_MODE" = "guest" ]; then
        RUN_PHASE="guest-capture-ready"
        wait_for_guest_capture_ready
    fi

    RUN_PHASE="before-screenshot"
    capture_screenshot "$before_name"
    if [ -n "$setup_fn" ]; then
        if [ "$guest_control_ready" = "1" ]; then
            RUN_PHASE="setup"
            "$setup_fn"
            if [ -n "$ready_name" ]; then
                RUN_PHASE="ready-screenshot"
                capture_screenshot "$ready_name"
            fi
        else
            die "Prepared recording requires guest control"
        fi
    fi
    if [ "$guest_control_ready" = "1" ]; then
        RUN_PHASE="guest-transport-before-recording"
        warm_guest_transport "before-recording"
    fi
    RUN_PHASE="recording"
    start_recording "$recording_name"
    if [ "$guest_control_ready" = "1" ]; then
        RUN_PHASE="scenario"
        "$scenario_fn"
    else
        log "Skipping guest scenario because guest control is unavailable"
        printf 'skipped: guest control unavailable\n' >"${LOGS_DIR}/${recording_name}.scenario.log"
    fi
    RUN_PHASE="after-screenshot"
    capture_screenshot "$after_name"
    RUN_PHASE="wait-recording"
    wait_for_recording "$recording_name"
    RUN_PHASE="postprocess"
    scrub_finder_metadata
    RUN_PHASE="complete"
    log "Scenario artifacts: $RUN_DIR"
}

