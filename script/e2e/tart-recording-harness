generate_semantic_summary_contact_sheet() {
    local name="$1"
    local sample_manifest="$2"
    local contact_sheet="$3"
    local contact_sheet_manifest="${LOGS_DIR}/${name}.contact-sheet-manifest.tsv"

    write_contact_sheet_summary_manifest "$sample_manifest" "$contact_sheet_manifest" || {
        rm -f "$contact_sheet_manifest"
        return 1
    }
    append_overlay_crop_contact_sheet_rows "$name" "$contact_sheet_manifest"
    command -v magick >/dev/null 2>&1 || die "Semantic summary contact sheet requires ImageMagick: magick"

    local tmp_dir="${SCREENSHOTS_DIR}/${name}.contact-sheet.tmp"
    rm -rf "$tmp_dir"
    mkdir -p "$tmp_dir"

    local index=0 _kind label _caption _timestamp relative_path _expected
    while IFS=$'\t' read -r _kind label _caption _timestamp relative_path _expected; do
        case "${_kind:-}" in
            ""|\#*) continue ;;
        esac
        case "${label:-}" in
            "") continue ;;
        esac
        index=$((index + 1))
        append_summary_contact_sheet_image "$tmp_dir" "$index" "$label" "$relative_path"
    done <"$contact_sheet_manifest"

    local images=()
    local image_path
    while IFS= read -r image_path; do
        images+=("$image_path")
    done < <(find "$tmp_dir" -maxdepth 1 -type f -name '*.png' | sort)
    [ "${#images[@]}" -gt 0 ] || die "Semantic summary contact sheet has no image rows: $contact_sheet_manifest"
    local label_font="${WINMUX_E2E_EVENT_CONTACT_SHEET_FONT:-/System/Library/Fonts/Supplemental/Arial.ttf}"
    [ -f "$label_font" ] || label_font="/System/Library/Fonts/Helvetica.ttc"
    magick montage \
        -font "$label_font" \
        -pointsize 22 \
        -label '%t' \
        "${images[@]}" \
        -thumbnail '720x405>' \
        -geometry '720x405+16+48' \
        -tile 3x \
        -background '#F4F2ED' \
        -fill '#101820' \
        "$contact_sheet"
    [ -s "$contact_sheet" ] || die "Semantic summary contact sheet did not produce a non-empty file: $contact_sheet"
    rm -rf "$tmp_dir"
    return 0
}

