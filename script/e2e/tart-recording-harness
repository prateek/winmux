sample_manifest_has_label() {
    local manifest_path="$1"
    local label="$2"
    /usr/bin/awk -F'\t' -v label="$label" '$1 == "semantic" && $2 == label { found = 1 } END { exit(found ? 0 : 1) }' "$manifest_path"
}

append_sample_manifest_row_for_label() {
    local source_manifest="$1"
    local output_manifest="$2"
    local label="$3"
    /usr/bin/awk -F'\t' -v label="$label" '
        $1 == "semantic" && $2 == label {
            print
            found = 1
            exit
        }
        END { exit(found ? 0 : 1) }
    ' "$source_manifest" >>"$output_manifest"
}

write_contact_sheet_summary_manifest() {
    local sample_manifest="$1"
    local output_manifest="$2"
    : >"$output_manifest"
    printf '# kind\tlabel\tcaption\ttimestamp\tpath\texpected\n' >>"$output_manifest"

    local label_source=contact_sheet_summary_label_order
    if sample_manifest_has_label "$sample_manifest" slot-hover-right &&
        sample_manifest_has_label "$sample_manifest" slot-release &&
        sample_manifest_has_label "$sample_manifest" slot-final-placement; then
        label_source=window_slot_contact_sheet_summary_label_order
    elif ! sample_manifest_has_label "$sample_manifest" snap-hover-comms ||
        ! sample_manifest_has_label "$sample_manifest" snap-release ||
        ! sample_manifest_has_label "$sample_manifest" snap-final-placement; then
        return 1
    fi

    local label row_count=0
    while IFS= read -r label; do
        [ -n "$label" ] || continue
        if sample_manifest_has_label "$sample_manifest" "$label"; then
            append_sample_manifest_row_for_label "$sample_manifest" "$output_manifest" "$label"
            row_count=$((row_count + 1))
        fi
    done < <("$label_source")

    [ "$row_count" -ge 3 ] || return 1
}

append_overlay_crop_contact_sheet_rows() {
    local name="$1"
    local output_manifest="$2"
    local overlay_manifest="${LOGS_DIR}/${name}.overlay-sentinel.tsv"
    [ -s "$overlay_manifest" ] || return 0

    /usr/bin/awk -F'\t' '
        $1 == "target-semantics" { semantics = $2 }
        $1 == "target-label" && $4 ~ /^screenshots\// {
            target_label_path = $4
        }
        END {
            if (target_label_path == "") {
                exit 1
            }
            note = semantics == "window-slot" ? "zoomed labeled window-slot target crop" : "zoomed labeled whole-zone target crop"
            printf "proof-crop\ttarget-zone-crop\tcrop\tcrop\t%s\t%s\n", target_label_path, note
        }
    ' "$overlay_manifest" >>"$output_manifest" || true
}

