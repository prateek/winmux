echo privacy_setup_start
printf 'user_db=%s\n' \"\$user_db\"
printf 'system_db=%s\n' \"\$system_db\"

mkdir -p \"\$(/usr/bin/dirname \"\$user_db\")\"
test -f \"\$user_db\"

for db in \"\$user_db\"; do
