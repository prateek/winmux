ensure_tart_home() {
    [ -n "${TART_HOME:-}" ] || die "TART_HOME must be set to the external SSD-backed Tart home"
    [ -d "$TART_HOME" ] || die "TART_HOME does not exist: $TART_HOME"
    [ -w "$TART_HOME" ] || die "TART_HOME is not writable: $TART_HOME"

    local physical_tart_home
    physical_tart_home="$(cd "$TART_HOME" && pwd -P)"
    if [ "$ALLOW_INTERNAL_DISK" != "1" ]; then
        case "$physical_tart_home" in
            /Volumes/*) ;;
            *) die "TART_HOME must live under /Volumes for e2e runs. Set WINMUX_E2E_ALLOW_INTERNAL_DISK=1 only for local dry-run checks." ;;
        esac
    fi

    local available_kb
    available_kb="$(df -Pk "$physical_tart_home" | awk 'NR == 2 { print $4 }')"
    [ -n "$available_kb" ] || die "Could not read free space for TART_HOME: $physical_tart_home"
    if [ "$available_kb" -lt $((MIN_FREE_GB * 1024 * 1024)) ]; then
        die "TART_HOME has less than ${MIN_FREE_GB}GB free: $physical_tart_home"
    fi
}

