last_log_value() {
    local path="$1"
    local key="$2"
    [ -s "$path" ] || {
        printf 'missing\n'
        return
    }
    /usr/bin/awk -F= -v key="$key" '$1 == key { value = substr($0, length(key) + 2) } END { if (value != "") print value; else print "unknown" }' "$path"
}

count_log_key_value() {
    local path="$1"
    local key="$2"
    local value="$3"
    [ -s "$path" ] || {
        printf '0\n'
        return
    }
    /usr/bin/awk -F= -v key="$key" -v value="$value" '$1 == key && substr($0, length(key) + 2) == value { count += 1 } END { print count + 0 }' "$path"
}

count_log_attempts() {
    local path="$1"
    [ -s "$path" ] || {
        printf '0\n'
        return
    }
    /usr/bin/awk -F= '$1 == "attempt" { count += 1 } END { print count + 0 }' "$path"
}

log_attempt_statuses() {
    local path="$1"
    [ -s "$path" ] || {
        printf -- '-\n'
        return
    }
    /usr/bin/awk '
        function emit() {
            if (!seen_attempt) {
                return
            }
            if (status == "") {
                status = "unknown"
            }
            if (statuses != "") {
                statuses = statuses ","
            }
            statuses = statuses status
        }
        /^attempt=/ {
            emit()
            seen_attempt = 1
            status = ""
            next
        }
        /^(probe_result|result)=/ {
            value = $0
            sub(/^[^=]*=/, "", value)
            if (seen_attempt) {
                status = value
            }
            next
        }
        END {
            emit()
            if (statuses == "") {
                statuses = "-"
            }
            print statuses
        }
    ' "$path"
}

log_mutation_started() {
    local path="$1"
    if [ -s "$path" ] && /usr/bin/grep -F "$GUEST_ACTION_MUTATION_MARKER" "$path" >/dev/null 2>&1; then
        printf 'yes\n'
    else
        printf 'no\n'
    fi
}

first_mutation_line() {
    local path="$1"
    [ -s "$path" ] || {
        printf -- '-\n'
        return
    }
    /usr/bin/awk -v marker="$GUEST_ACTION_MUTATION_MARKER" '
        index($0, marker) {
            print NR
            found = 1
            exit
        }
        END {
            if (!found) {
                print "-"
            }
        }
    ' "$path"
}

compact_failure_reason() {
    local path="$1"
    local which="$2"
    [ -s "$path" ] || {
        printf -- '-\n'
        return
    }
    /usr/bin/awk -v which="$which" '
        function trim(text) {
            gsub(/\r/, "", text)
            gsub(/\t/, " ", text)
            sub(/^[[:space:]]+/, "", text)
            sub(/[[:space:]]+$/, "", text)
            if (length(text) > 120) {
                text = substr(text, 1, 117) "..."
            }
            return text
        }
        function note_failure(marker) {
            reason = trim(candidate)
            if (reason == "") {
                reason = trim(marker)
            }
            if (first == "") {
                first = reason
            }
            last = reason
        }
        /^attempt=/ {
            candidate = ""
            next
        }
        /^(probe_result|result)=(failure|semantic_failure|mutation_failure)$/ {
            note_failure($0)
            candidate = ""
            next
        }
        /^[[:alnum:]_.-]+=/ {
            next
        }
        {
            line = trim($0)
            if (line != "") {
                candidate = line
            }
        }
        END {
            value = which == "first" ? first : last
            if (value == "") {
                value = "-"
            }
            print value
        }
    ' "$path"
}

write_transport_summary_row() {
    local summary_path="$1"
    local phase="$2"
    local log_path="$3"
    local before_recording="$4"
    local relative_log_path
    relative_log_path="logs/$(basename "$log_path")"
    local attempts=0
    local failures=0
    local final_result="missing"

    if [ -s "$log_path" ]; then
        attempts="$(count_log_attempts "$log_path")"
        failures="$(count_log_key_value "$log_path" probe_result failure)"
        if [ "$failures" = "0" ]; then
            failures="$(count_log_key_value "$log_path" result failure)"
        fi
        final_result="$(last_log_value "$log_path" final_result)"
        if [ "$final_result" = "unknown" ]; then
            final_result="$(last_log_value "$log_path" result)"
        fi
        if [ "$final_result" = "unknown" ] && /usr/bin/grep -F 'capture_probe_done' "$log_path" >/dev/null 2>&1; then
            final_result=success
        fi
    fi

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$phase" "$relative_log_path" "$attempts" "$failures" "$final_result" "$before_recording" \
        "$(log_attempt_statuses "$log_path")" \
        "$(compact_failure_reason "$log_path" first)" \
        "$(compact_failure_reason "$log_path" last)" >>"$summary_path"
}

transport_summary_has_log_path() {
    local summary_path="$1"
    local relative_log_path="$2"
    /usr/bin/awk -F'\t' -v log_path="$relative_log_path" '
        $0 == "" || $1 ~ /^#/ { next }
        $2 == log_path { found = 1 }
        END { exit(found ? 0 : 1) }
    ' "$summary_path"
}

append_guest_retry_rows_to_transport_summary() {
    local summary_path="$1"
    local retry_summary="${LOGS_DIR}/guest-script-retry-summary.tsv"
    [ -s "$retry_summary" ] || return 0

    local phase relative_log_path attempts failures final_result before_recording attempt_statuses first_failure_reason last_failure_reason _mutation_started _first_mutation_line
    while IFS=$'\t' read -r phase relative_log_path attempts failures final_result before_recording attempt_statuses first_failure_reason last_failure_reason _mutation_started _first_mutation_line; do
        case "${phase:-}" in
            ""|\#*) continue ;;
        esac
        [ -n "${relative_log_path:-}" ] || continue
        if transport_summary_has_log_path "$summary_path" "$relative_log_path"; then
            continue
        fi
        local retry_log_path="${RUN_DIR}/${relative_log_path}"
        [ -n "${attempt_statuses:-}" ] || attempt_statuses="$(log_attempt_statuses "$retry_log_path")"
        [ -n "${first_failure_reason:-}" ] || first_failure_reason="$(compact_failure_reason "$retry_log_path" first)"
        [ -n "${last_failure_reason:-}" ] || last_failure_reason="$(compact_failure_reason "$retry_log_path" last)"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$phase" "$relative_log_path" "$attempts" "$failures" "$final_result" "$before_recording" \
            "$attempt_statuses" "$first_failure_reason" "$last_failure_reason" >>"$summary_path"
    done <"$retry_summary"
}

