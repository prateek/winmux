start_recording() {
    local name="$1"
    local path="${RECORDINGS_DIR}/${name}.mov"
    local log_path
    if [ "$CAPTURE_MODE" = "guest" ]; then
        local guest_path="${GUEST_ARTIFACTS_DIR}/recordings/${name}.mov"
        local guest_path_quoted
        guest_path_quoted="$(shell_quote "$guest_path")"
        log_path="${LOGS_DIR}/${name}.guest-screencapture.log"
        log "Recording ${RECORD_SECONDS}s guest video: $path"
        local script="set -euo pipefail
echo capture_kind=video
echo capture_mode=guest
echo requested_seconds=${RECORD_SECONDS}
echo guest_output_path=${guest_path_quoted}
/usr/sbin/screencapture -x -D${GUEST_DISPLAY_ID} -v -V${RECORD_SECONDS} ${guest_path_quoted}
test -s ${guest_path_quoted}
/usr/bin/stat -f 'guest_output_bytes=%z' ${guest_path_quoted}
/usr/bin/file ${guest_path_quoted}
echo result=success"
        local attempt=1
        : >"$log_path"
        while [ "$attempt" -le "$GUEST_ACTION_ATTEMPTS" ]; do
            {
                printf 'attempt=%s\n' "$attempt"
                guest_script "$script"
            } >>"$log_path" 2>&1 &
            local pid="$!"
            printf '%s\n' "$pid" >"${LOGS_DIR}/${name}.recording.pid"
            sleep 1
            if kill -0 "$pid" 2>/dev/null; then
                return
            fi
            if wait "$pid"; then
                log "Guest recording attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} exited before it could be observed"
            else
                log "Guest recording attempt ${attempt}/${GUEST_ACTION_ATTEMPTS} failed; see $log_path"
            fi
            attempt=$((attempt + 1))
            if [ "$attempt" -le "$GUEST_ACTION_ATTEMPTS" ]; then
                sleep "$GUEST_ACTION_RETRY_SECONDS"
            fi
        done
        die "Guest recording did not start; see $log_path"
    else
        log_path="${LOGS_DIR}/${name}.ffmpeg.log"
        log "Recording ${RECORD_SECONDS}s host video: $path"
        ffmpeg \
            -hide_banner \
            -loglevel warning \
            -y \
            -f avfoundation \
            -framerate "$VIDEO_FPS" \
            -capture_cursor 1 \
            -capture_mouse_clicks 1 \
            -pixel_format nv12 \
            -i "$FFMPEG_SCREEN_DEVICE" \
            -t "$RECORD_SECONDS" \
            -c:v "$FFMPEG_ENCODER" \
            -pix_fmt yuv420p \
            "$path" >"$log_path" 2>&1 &
        printf '%s\n' "$!" >"${LOGS_DIR}/${name}.recording.pid"
    fi
}

