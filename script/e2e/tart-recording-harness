                '\${GUEST_REPO_DIR}/.debug/WinMuxApp',
                '\${GUEST_REPO_DIR}/.debug/winmux',
                '\${HOME}/winmux-e2e/bin/WinMuxApp',
                '\${HOME}/winmux-e2e/bin/winmux',
