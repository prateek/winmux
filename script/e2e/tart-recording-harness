    diff_raw="$(compare -metric RMSE "${crop_dir}/ordinary-target-window-area.png" "${crop_dir}/slot-target-window-area.png" null: 2>&1 || true)"
    diff_norm="$(printf '%s\n' "$diff_raw" | sed -n 's/.*(\([0-9.][0-9.]*\)).*/\1/p')"
