generated_version_files() {
    cat <<'EOF'
Sources/Common/gitHashGenerated.swift
Sources/Common/versionGenerated.swift
EOF
}

snapshot_generated_version_files() {
    local snapshot_dir="$1"
    local relative_path target_path

    mkdir -p "$snapshot_dir"
    while IFS= read -r relative_path; do
        [ -n "$relative_path" ] || continue
        target_path="${snapshot_dir}/${relative_path}"
        mkdir -p "$(dirname "$target_path")"
        if [ -e "${REPO_ROOT}/${relative_path}" ]; then
            cp "${REPO_ROOT}/${relative_path}" "$target_path"
        else
            : >"${target_path}.missing"
        fi
    done < <(generated_version_files)
}

restore_generated_version_files() {
    local snapshot_dir="$1"
    local relative_path

    [ -n "$snapshot_dir" ] || return
    [ -d "$snapshot_dir" ] || return
    while IFS= read -r relative_path; do
        [ -n "$relative_path" ] || continue
        if [ -e "${snapshot_dir}/${relative_path}.missing" ]; then
            rm -f "${REPO_ROOT}/${relative_path}"
        elif [ -e "${snapshot_dir}/${relative_path}" ]; then
            cp "${snapshot_dir}/${relative_path}" "${REPO_ROOT}/${relative_path}"
        fi
    done < <(generated_version_files)
}

restore_pending_generated_version_snapshot() {
    if [ -n "${GENERATED_VERSION_SNAPSHOT_DIR:-}" ]; then
        restore_generated_version_files "$GENERATED_VERSION_SNAPSHOT_DIR"
        GENERATED_VERSION_SNAPSHOT_DIR=""
    fi
}

