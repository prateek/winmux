log() {
    printf '[winmux-e2e] %s\n' "$*"
}

write_run_abort_status() {
    local phase="$1"
    local exit_code="$2"
    local final_result="$3"
    local primary_log="$4"
    local reason="$5"
    local recording_started="no"
    local setup_completed="no"

    mkdir -p "$LOGS_DIR"
    if [ -d "$LOGS_DIR" ] && [ -n "$(find "$LOGS_DIR" -maxdepth 1 -type f -name '*.recording.pid' -print -quit)" ]; then
        recording_started="yes"
    fi
    if [ -d "$SCREENSHOTS_DIR" ] && [ -n "$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '01-ready-*.png' -print -quit)" ]; then
        setup_completed="yes"
    fi
    {
        printf 'phase=%s\n' "$phase"
        printf 'exit_code=%s\n' "$exit_code"
        printf 'final_result=%s\n' "$final_result"
        printf 'primary_log=%s\n' "$primary_log"
        printf 'recording_started=%s\n' "$recording_started"
        printf 'setup_completed=%s\n' "$setup_completed"
        printf 'reason=%s\n' "$reason"
    } >"$RUN_ABORT_STATUS"
}

mark_superseded_artifact() {
    local reason="${WINMUX_E2E_SUPERSEDED_REASON:-}"
    local superseded_by="${WINMUX_E2E_SUPERSEDED_BY:-}"
    [ -n "$reason" ] || die "WINMUX_E2E_SUPERSEDED_REASON is required for mark-superseded"
    ensure_artifact_dirs
    mkdir -p "${RUN_DIR}/reviews"

    local review_path="${RUN_DIR}/reviews/superseded.md"
    {
        printf '# Superseded Artifact\n\n'
        printf '%s\n' "- artifact: \`${RUN_DIR}\`"
        if [ -n "$superseded_by" ]; then
            printf '%s\n' "- superseded by: \`${superseded_by}\`"
        fi
        printf '%s\n' "- reason: ${reason}"
    } >"$review_path"
    write_run_abort_status superseded 0 superseded "$review_path" "$reason"
    log "Marked artifact superseded: $RUN_DIR"
}

abort_status_self_test() {
    local test_dir old_logs_dir old_screenshots_dir old_run_abort_status
    test_dir="$(mktemp -d)"
    old_logs_dir="$LOGS_DIR"
    old_screenshots_dir="$SCREENSHOTS_DIR"
    old_run_abort_status="$RUN_ABORT_STATUS"
    LOGS_DIR="${test_dir}/logs"
    SCREENSHOTS_DIR="${test_dir}/screenshots"
    RUN_ABORT_STATUS="${LOGS_DIR}/run-abort-status.txt"
    mkdir -p "$LOGS_DIR" "$SCREENSHOTS_DIR"
    rm -f "$RUN_ABORT_STATUS"
    write_run_abort_status self-test 42 failure "${LOGS_DIR}/self-test.log" "forced abort status self-test"
    grep -F 'phase=self-test' "$RUN_ABORT_STATUS" >/dev/null || die "Abort status self-test missing phase"
    grep -F 'exit_code=42' "$RUN_ABORT_STATUS" >/dev/null || die "Abort status self-test missing exit code"
    grep -F 'final_result=failure' "$RUN_ABORT_STATUS" >/dev/null || die "Abort status self-test missing result"
    grep -F "primary_log=${LOGS_DIR}/self-test.log" "$RUN_ABORT_STATUS" >/dev/null || die "Abort status self-test missing primary log"
    LOGS_DIR="$old_logs_dir"
    SCREENSHOTS_DIR="$old_screenshots_dir"
    RUN_ABORT_STATUS="$old_run_abort_status"
    rm -rf "$test_dir"
    log "Abort status self-test passed"
}

