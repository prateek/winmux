GUEST_REPO_DIR=${guest_repo_quoted}
INSTALLED_WINMUX_APP='/Applications/WinMux.app/Contents/MacOS/WinMuxApp'
USER_INSTALLED_WINMUX_APP=\"\$HOME/Applications/WinMux.app/Contents/MacOS/WinMuxApp\"
WINMUX_BUNDLE_ID='com.zimengxiong.winmux'

sql_quote() {
    printf '%s' \"\$1\" | /usr/bin/sed \"s/'/''/g\"
}

grant_tcc() {
    local db=\"\$1\"
    local service=\"\$2\"
    local client=\"\$3\"
    local client_type=\"\$4\"
    local now
    now=\"\$(/bin/date +%s)\"
    local service_sql client_sql
    service_sql=\"\$(sql_quote \"\$service\")\"
    client_sql=\"\$(sql_quote \"\$client\")\"
    /usr/bin/sqlite3 \"\$db\" \"insert or replace into access
        (service, client, client_type, auth_value, auth_reason, auth_version, csreq, policy_id,
         indirect_object_identifier_type, indirect_object_identifier, indirect_object_code_identity,
         flags, last_modified, pid, pid_version, boot_uuid, last_reminded)
        values
        ('\${service_sql}', '\${client_sql}', \${client_type}, 2, 4, 1, null, null,
         0, 'UNUSED', null, 0, \${now}, null, null, 'UNUSED', \${now});\"
}

grant_client_set() {
    local db=\"\$1\"
    local client=\"\$2\"
    local client_type=\"\$3\"
    grant_tcc \"\$db\" kTCCServiceScreenCapture \"\$client\" \"\$client_type\"
