                "$path" \
                "$duration" \
                "$sample_seconds" \
                "${samples_dir}/caption-${caption_label}.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}" "caption-${caption_label}" "$sample_seconds" \
                "screenshots/${name}.samples/caption-${caption_label}.png" \
                "caption midpoint sample"
            local before_seconds
            before_seconds="$(awk -v start="$start_seconds" 'BEGIN {
                sample = start - 0.500
                if (sample < 0) {
                    sample = 0
                }
                printf "%.3f", sample
            }')"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$before_seconds" \
                "${samples_dir}/caption-${caption_label}-boundary-before.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}-boundary-before" "caption-${caption_label}" "$before_seconds" \
                "screenshots/${name}.samples/caption-${caption_label}-boundary-before.png" \
                "frame before caption start"
            local start_boundary_seconds
            start_boundary_seconds="$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start + 0.100 }')"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$start_boundary_seconds" \
                "${samples_dir}/caption-${caption_label}-boundary-start.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}-boundary-start" "caption-${caption_label}" "$start_boundary_seconds" \
                "screenshots/${name}.samples/caption-${caption_label}-boundary-start.png" \
                "frame immediately after caption start"
            local end_boundary_seconds
            end_boundary_seconds="$(awk -v end="$end_seconds" 'BEGIN {
                sample = end - 0.100
                if (sample < 0) {
                    sample = 0
                }
                printf "%.3f", sample
            }')"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$end_boundary_seconds" \
                "${samples_dir}/caption-${caption_label}-boundary-end.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}-boundary-end" "caption-${caption_label}" "$end_boundary_seconds" \
                "screenshots/${name}.samples/caption-${caption_label}-boundary-end.png" \
                "frame immediately before caption end"
        done < <(awk -F '\t' '$0 != "" && $1 !~ /^#/ { print $1 "\t" $2 }' "$captions_path")
    fi
    write_semantic_sample_manifest "$name" "$sample_manifest"
    [ -s "$sample_manifest" ] || die "Sample manifest did not produce a non-empty file: $sample_manifest"

    if ! generate_semantic_summary_contact_sheet "$name" "$sample_manifest" "$contact_sheet"; then
        ffmpeg \
            -hide_banner \
            -loglevel error \
            -y \
            -framerate 1 \
            -pattern_type glob \
            -i "${samples_dir}/standard-*.png" \
            -vf "scale=860:-1,tile=3x2" \
            -frames:v 1 \
            "$contact_sheet"
    fi
    [ -s "$contact_sheet" ] || die "Contact sheet did not produce a non-empty file: $contact_sheet"
    generate_event_manifest_contact_sheet "$name"
}

write_caption_tail_manifest() {
    local name="$1"
    local duration="$2"
    local captions_path="${LOGS_DIR}/${name}.annotations.tsv"
    [ -s "$captions_path" ] || return 0

    local manifest="${LOGS_DIR}/${name}.caption-tail.tsv"
    local last_caption_end tail_seconds intentional reason
    last_caption_end="$(/usr/bin/awk -F'\t' '$0 != "" && $1 !~ /^#/ { if (($2 + 0) > max) max = $2 + 0 } END { printf "%.3f", max + 0 }' "$captions_path")"
    tail_seconds="$(/usr/bin/awk -v duration="$duration" -v last_end="$last_caption_end" 'BEGIN {
        tail = duration - last_end
        if (tail < 0) {
            tail = 0
        }
        printf "%.3f", tail
    }')"
    intentional=no
    reason=""
    if /usr/bin/awk -v tail="$tail_seconds" -v max="$CAPTION_TAIL_MAX_SECONDS" 'BEGIN { exit(tail + 0 > max + 0 ? 0 : 1) }'; then
        intentional=yes
        reason="$UNCAPTIONED_TAIL_REASON"
    fi
    {
        printf 'recording\t%s\n' "$name"
        printf 'duration-seconds\t%s\n' "$duration"
        printf 'last-caption-end-seconds\t%s\n' "$last_caption_end"
        printf 'tail-seconds\t%s\n' "$tail_seconds"
        printf 'max-tail-seconds\t%s\n' "$CAPTION_TAIL_MAX_SECONDS"
        printf 'intentional-uncaptioned-tail\t%s\n' "$intentional"
        printf 'reason\t%s\n' "$reason"
    } >"$manifest"
    [ -s "$manifest" ] || die "Caption tail manifest did not produce a non-empty file: $manifest"
}

caption_tail_manifest_value() {
    local path="$1"
    local key="$2"
    /usr/bin/awk -F'\t' -v key="$key" '$1 == key { print $2; exit }' "$path"
}

generate_demo_cut() {
    local name="$1"
    local source_path="${RECORDINGS_DIR}/${name}.mov"
    local caption_tail="${LOGS_DIR}/${name}.caption-tail.tsv"
    [ -s "$source_path" ] || return 0
    [ -s "$caption_tail" ] || return 0

    local intentional tail_seconds last_caption_end duration trim_end demo_path manifest_path reason
    intentional="$(caption_tail_manifest_value "$caption_tail" intentional-uncaptioned-tail)"
    [ "$intentional" = "yes" ] || return 0
    tail_seconds="$(caption_tail_manifest_value "$caption_tail" tail-seconds)"
    last_caption_end="$(caption_tail_manifest_value "$caption_tail" last-caption-end-seconds)"
    duration="$(caption_tail_manifest_value "$caption_tail" duration-seconds)"
    reason="$(caption_tail_manifest_value "$caption_tail" reason)"
    [[ "$tail_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail seconds are not numeric for demo cut: $tail_seconds"
    [[ "$last_caption_end" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail last-caption-end is not numeric for demo cut: $last_caption_end"
    [[ "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "Caption tail duration is not numeric for demo cut: $duration"

    trim_end="$(/usr/bin/awk -v last="$last_caption_end" -v duration="$duration" 'BEGIN {
        end = last + 2.000
        if (end > duration) {
            end = duration
        }
        printf "%.3f", end
    }')"
    if /usr/bin/awk -v trim="$trim_end" -v duration="$duration" 'BEGIN { exit(trim + 0 >= duration - 0.500 ? 0 : 1) }'; then
        return 0
    fi

    demo_path="${RECORDINGS_DIR}/${name}.demo.mov"
    manifest_path="${LOGS_DIR}/${name}.demo-cut.tsv"
    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -i "$source_path" \
        -t "$trim_end" \
        -map 0 \
        -c copy \
        -movflags +faststart \
        "$demo_path"
    [ -s "$demo_path" ] || die "Demo cut did not produce a non-empty file: $demo_path"
    {
        printf 'recording\t%s\n' "$name"
        printf 'source-recording\trecordings/%s.mov\n' "$name"
        printf 'demo-recording\trecordings/%s.demo.mov\n' "$name"
        printf 'source-duration-seconds\t%s\n' "$duration"
        printf 'last-caption-end-seconds\t%s\n' "$last_caption_end"
        printf 'trim-end-seconds\t%s\n' "$trim_end"
        printf 'tail-seconds\t%s\n' "$tail_seconds"
        printf 'reason\t%s\n' "$reason"
    } >"$manifest_path"
    [ -s "$manifest_path" ] || die "Demo cut manifest did not produce a non-empty file: $manifest_path"
}

generate_final_edge_crops() {
    local name="$1"
    local after_screenshot
    after_screenshot="$(find "$SCREENSHOTS_DIR" -maxdepth 1 -type f -name '99-after-*.png' | sort | head -1)"
    [ -s "$after_screenshot" ] || return 0
    command -v magick >/dev/null 2>&1 || return 0

    local crop_dir="${SCREENSHOTS_DIR}/${name}.edge-crops"
    local manifest="${LOGS_DIR}/${name}.edge-crops.tsv"
    local width height edge_w edge_h corner_w corner_h bottom_y right_x
    read -r width height < <(magick identify -format '%w %h\n' "$after_screenshot")
    [ -n "$width" ] && [ -n "$height" ] || die "Could not read final screenshot size: $after_screenshot"

    edge_w=$((width < 240 ? width : 240))
    edge_h=$((height < 180 ? height : 180))
    corner_w=$((width < 360 ? width : 360))
    corner_h=$((height < 240 ? height : 240))
    bottom_y=$((height - edge_h))
    right_x=$((width - edge_w))

    rm -rf "$crop_dir"
    mkdir -p "$crop_dir"
    {
        printf '# label\tpath\tdescription\n'
        printf 'final-top\tscreenshots/%s.edge-crops/final-top.png\tfinal screenshot top edge\n' "$name"
        printf 'final-bottom\tscreenshots/%s.edge-crops/final-bottom.png\tfinal screenshot bottom edge\n' "$name"
        printf 'final-left\tscreenshots/%s.edge-crops/final-left.png\tfinal screenshot left edge\n' "$name"
        printf 'final-right\tscreenshots/%s.edge-crops/final-right.png\tfinal screenshot right edge\n' "$name"
        printf 'final-bottom-right\tscreenshots/%s.edge-crops/final-bottom-right.png\tfinal screenshot bottom-right corner\n' "$name"
    } >"$manifest"

    magick "$after_screenshot" -crop "${width}x${edge_h}+0+0" "${crop_dir}/final-top.png"
    magick "$after_screenshot" -crop "${width}x${edge_h}+0+${bottom_y}" "${crop_dir}/final-bottom.png"
    magick "$after_screenshot" -crop "${edge_w}x${height}+0+0" "${crop_dir}/final-left.png"
    magick "$after_screenshot" -crop "${edge_w}x${height}+${right_x}+0" "${crop_dir}/final-right.png"
    magick "$after_screenshot" -crop "${corner_w}x${corner_h}+$((width - corner_w))+$((height - corner_h))" "${crop_dir}/final-bottom-right.png"

    local near_end_sample="${SCREENSHOTS_DIR}/${name}.samples/standard-05-near-end.png"
    if [ -s "$near_end_sample" ]; then
        local video_width video_height video_edge_w video_edge_h video_corner_w video_corner_h video_bottom_y video_right_x
        read -r video_width video_height < <(magick identify -format '%w %h\n' "$near_end_sample")
        [ -n "$video_width" ] && [ -n "$video_height" ] || die "Could not read near-end video sample size: $near_end_sample"
        video_edge_w=$((video_width < 240 ? video_width : 240))
        video_edge_h=$((video_height < 180 ? video_height : 180))
        video_corner_w=$((video_width < 360 ? video_width : 360))
        video_corner_h=$((video_height < 240 ? video_height : 240))
        video_bottom_y=$((video_height - video_edge_h))
        video_right_x=$((video_width - video_edge_w))
        {
            printf 'video-near-end-top\tscreenshots/%s.edge-crops/video-near-end-top.png\tnear-end video frame top edge\n' "$name"
            printf 'video-near-end-bottom\tscreenshots/%s.edge-crops/video-near-end-bottom.png\tnear-end video frame bottom edge\n' "$name"
            printf 'video-near-end-left\tscreenshots/%s.edge-crops/video-near-end-left.png\tnear-end video frame left edge\n' "$name"
            printf 'video-near-end-right\tscreenshots/%s.edge-crops/video-near-end-right.png\tnear-end video frame right edge\n' "$name"
            printf 'video-near-end-bottom-right\tscreenshots/%s.edge-crops/video-near-end-bottom-right.png\tnear-end video frame bottom-right corner\n' "$name"
        } >>"$manifest"
        magick "$near_end_sample" -crop "${video_width}x${video_edge_h}+0+0" "${crop_dir}/video-near-end-top.png"
        magick "$near_end_sample" -crop "${video_width}x${video_edge_h}+0+${video_bottom_y}" "${crop_dir}/video-near-end-bottom.png"
        magick "$near_end_sample" -crop "${video_edge_w}x${video_height}+0+0" "${crop_dir}/video-near-end-left.png"
        magick "$near_end_sample" -crop "${video_edge_w}x${video_height}+${video_right_x}+0" "${crop_dir}/video-near-end-right.png"
        magick "$near_end_sample" -crop "${video_corner_w}x${video_corner_h}+$((video_width - video_corner_w))+$((video_height - video_corner_h))" "${crop_dir}/video-near-end-bottom-right.png"
    fi
    [ -s "$manifest" ] || die "Edge crop manifest did not produce a non-empty file: $manifest"
}

