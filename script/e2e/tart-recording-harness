    rm -rf "$samples_dir"
    mkdir -p "$samples_dir"
    : >"$sample_manifest"

    sample_recording_frame "$path" "$duration" 0.500 "${samples_dir}/standard-00-start.png"
    append_sample_manifest_row "$sample_manifest" standard standard-start standard 0.500 \
        "screenshots/${name}.samples/standard-00-start.png" \
        "standard start frame"
    sample_recording_frame "$path" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.10 }')" "${samples_dir}/standard-01-10pct.png"
    append_sample_manifest_row "$sample_manifest" standard standard-10pct standard 10pct \
        "screenshots/${name}.samples/standard-01-10pct.png" \
        "standard 10 percent frame"
    sample_recording_frame "$path" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.25 }')" "${samples_dir}/standard-02-25pct.png"
    append_sample_manifest_row "$sample_manifest" standard standard-25pct standard 25pct \
        "screenshots/${name}.samples/standard-02-25pct.png" \
        "standard 25 percent frame"
    sample_recording_frame "$path" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.50 }')" "${samples_dir}/standard-03-50pct.png"
    append_sample_manifest_row "$sample_manifest" standard standard-50pct standard 50pct \
        "screenshots/${name}.samples/standard-03-50pct.png" \
        "standard 50 percent frame"
    sample_recording_frame "$path" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d * 0.75 }')" "${samples_dir}/standard-04-75pct.png"
    append_sample_manifest_row "$sample_manifest" standard standard-75pct standard 75pct \
        "screenshots/${name}.samples/standard-04-75pct.png" \
        "standard 75 percent frame"
    sample_recording_frame "$path" "$duration" "$(awk -v d="$duration" 'BEGIN { printf "%.3f", d - 1.0 }')" "${samples_dir}/standard-05-near-end.png"
    append_sample_manifest_row "$sample_manifest" standard standard-near-end standard near-end \
        "screenshots/${name}.samples/standard-05-near-end.png" \
        "standard near-end frame"

    if [ -s "$captions_path" ]; then
        local caption_index=0
        local start_seconds
        local end_seconds
        while IFS=$'\t' read -r start_seconds end_seconds; do
            caption_index=$((caption_index + 1))
            local caption_label
            caption_label="$(printf '%02d' "$caption_index")"
            local sample_seconds
            sample_seconds="$(awk -v start="$start_seconds" -v end="$end_seconds" 'BEGIN {
                midpoint = (start + end) / 2
                offset = start + 0.500
                sample = offset
                if (midpoint > offset) {
                    sample = midpoint
                }
                printf "%.3f", sample
            }')"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$sample_seconds" \
                "${samples_dir}/caption-${caption_label}.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}" "caption-${caption_label}" "$sample_seconds" \
                "screenshots/${name}.samples/caption-${caption_label}.png" \
                "caption midpoint sample"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start - 0.500 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-before.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}-boundary-before" "caption-${caption_label}" "$start_seconds-0.500" \
                "screenshots/${name}.samples/caption-${caption_label}-boundary-before.png" \
                "frame before caption start"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$(awk -v start="$start_seconds" 'BEGIN { printf "%.3f", start + 0.100 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-start.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}-boundary-start" "caption-${caption_label}" "$start_seconds+0.100" \
                "screenshots/${name}.samples/caption-${caption_label}-boundary-start.png" \
                "frame immediately after caption start"
            sample_recording_frame \
                "$path" \
                "$duration" \
                "$(awk -v end="$end_seconds" 'BEGIN { printf "%.3f", end - 0.100 }')" \
                "${samples_dir}/caption-${caption_label}-boundary-end.png"
            append_sample_manifest_row "$sample_manifest" caption "caption-${caption_label}-boundary-end" "caption-${caption_label}" "$end_seconds-0.100" \
                "screenshots/${name}.samples/caption-${caption_label}-boundary-end.png" \
                "frame immediately before caption end"
        done < <(awk -F '\t' '$0 != "" && $1 !~ /^#/ { print $1 "\t" $2 }' "$captions_path")
    fi
    write_semantic_sample_manifest "$name" "$sample_manifest"
    [ -s "$sample_manifest" ] || die "Sample manifest did not produce a non-empty file: $sample_manifest"

    ffmpeg \
        -hide_banner \
        -loglevel error \
        -y \
        -framerate 1 \
        -pattern_type glob \
        -i "${samples_dir}/standard-*.png" \
        -vf "scale=860:-1,tile=3x2" \
        -frames:v 1 \
        "$contact_sheet"
    [ -s "$contact_sheet" ] || die "Contact sheet did not produce a non-empty file: $contact_sheet"
}

