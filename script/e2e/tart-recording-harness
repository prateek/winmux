write_timed_slice_22_annotation_plan() {
    local captions_path="$1"
    local slice_prefix="${2:-slice-22}"
    local static_writer="${3:-write_static_slice_22_annotation_plan}"
    local target_title="${4:-Whole-zone target}"
    local target_body="${5:-The overlay targets the Comms zone itself, not a window or slot.}"
    local timing_log="${LOGS_DIR}/${slice_prefix}-command-timing.log"
    if [ ! -s "$timing_log" ]; then
        "$static_writer" "$captions_path"
        return 0
    fi

    local freeform_start_offset freeform_end_offset snap_start_offset snap_end_offset
    freeform_start_offset="$(timing_value_from_log freeform-drag-start-offset-seconds "$timing_log")"
    freeform_end_offset="$(timing_value_from_log freeform-drag-end-offset-seconds "$timing_log")"
    snap_start_offset="$(timing_value_from_log snap-drag-start-offset-seconds "$timing_log")"
    snap_end_offset="$(timing_value_from_log snap-drag-end-offset-seconds "$timing_log")"
    if [ -z "$freeform_start_offset" ] || [ -z "$freeform_end_offset" ] || [ -z "$snap_start_offset" ] || [ -z "$snap_end_offset" ]; then
        "$static_writer" "$captions_path"
        return 0
    fi

    /usr/bin/awk \
        -v base=8 \
        -v freeform_start_offset="$freeform_start_offset" \
        -v freeform_end_offset="$freeform_end_offset" \
        -v snap_start_offset="$snap_start_offset" \
        -v snap_end_offset="$snap_end_offset" \
        -v target_title="$target_title" \
        -v target_body="$target_body" '
        function max(a, b) { return a > b ? a : b }
        function min(a, b) { return a < b ? a : b }
        function emit(start, end, title, body, chip, result) {
            if (end <= start) {
                end = start + 1
            }
            if (result != "") {
                printf "%.3f\t%.3f\t%s\t%s\t%s\t%s\n", start, end, title, body, chip, result
            } else {
                printf "%.3f\t%.3f\t%s\t%s\t%s\n", start, end, title, body, chip
            }
        }
        BEGIN {
            freeform_start = base + freeform_start_offset
            freeform_end = base + freeform_end_offset
            snap_start = base + snap_start_offset
            snap_end = base + snap_end_offset

            freeform_pickup_end = min(freeform_start + 5, max(freeform_start + 1, freeform_end - 4))
            float_result_end = min(max(freeform_end + 3, freeform_pickup_end + 1), snap_start - 3)
            if (float_result_end <= freeform_pickup_end) {
                float_result_end = freeform_pickup_end + 1
            }
            reset_end = max(snap_start, float_result_end + 1)
            snap_pickup_end = min(snap_start + 5, snap_end - 5)
            if (snap_pickup_end <= snap_start) {
                snap_pickup_end = snap_start + 3
            }
            target_start = snap_pickup_end
            release_start = min(snap_end - 1, target_start + 7)
            if (release_start <= target_start) {
                release_start = target_start + 2
            }

            emit(0, base, "Float-unless-snap ready", "The mouse policy starts in float-unless-snap mode on the zone monitor.", "Config: policy='\''float-unless-snap'\''; modifier='\''alt'\''; target='\''zone'\''")
            emit(freeform_start, freeform_pickup_end, "Drag without Alt", "Pick up snap-demo.rtf with no modifier; this should not show a snap overlay.", "Action: drag snap-demo.rtf with no modifier")
            emit(freeform_pickup_end, float_result_end, "Floating result", "The same window is now floating/freeform rather than tiled.", "Run: winmux list-windows --monitor all")
            emit(float_result_end, reset_end, "Reset source", "Return the same window to Work/main before proving the snap branch.", "Action: reset snap-demo.rtf to Work/main tiling")
            emit(snap_start, snap_pickup_end, "Hold Alt and drag", "The configured modifier keeps the drag on the whole-zone snap path.", "Action: hold Alt while dragging snap-demo.rtf", "Input: Alt held")
            emit(target_start, release_start, target_title, target_body, "Action: target = whole Comms zone")
            emit(release_start, snap_end + 3, "Release into Comms", "Drop to move the same window to Comms active workspace.", "Action: release on Comms zone")
            emit(snap_end + 3, snap_end + 10, "Inspect snap", "The window log proves the same id snapped from Work/main to Comms/right.", "Run: winmux list-windows --monitor all")
        }
    ' >"$captions_path"
}

