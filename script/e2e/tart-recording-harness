        for service in kTCCServiceScreenCapture kTCCServiceAudioCapture kTCCServiceAccessibility kTCCServicePostEvent kTCCServiceListenEvent kTCCServiceAppleEvents; do
            client_sql=\"\$(sql_quote \"\$client\")\"
            service_sql=\"\$(sql_quote \"\$service\")\"
            now=\"\$(/bin/date +%s)\"
            printf \"insert or replace into access (service, client, client_type, auth_value, auth_reason, auth_version, csreq, policy_id, indirect_object_identifier_type, indirect_object_identifier, indirect_object_code_identity, flags, last_modified, pid, pid_version, boot_uuid, last_reminded) values ('%s', '%s', 1, 2, 4, 1, null, null, 0, 'UNUSED', null, 0, %s, null, null, 'UNUSED', %s);\\n\" \"\$service_sql\" \"\$client_sql\" \"\$now\" \"\$now\" >>\"\$tmp_sql\"
        done
    done
    for service in kTCCServiceScreenCapture kTCCServiceAudioCapture kTCCServiceAccessibility kTCCServicePostEvent kTCCServiceListenEvent kTCCServiceAppleEvents; do
        now=\"\$(/bin/date +%s)\"
        printf \"insert or replace into access (service, client, client_type, auth_value, auth_reason, auth_version, csreq, policy_id, indirect_object_identifier_type, indirect_object_identifier, indirect_object_code_identity, flags, last_modified, pid, pid_version, boot_uuid, last_reminded) values ('%s', 'com.apple.sshd-session', 0, 2, 4, 1, null, null, 0, 'UNUSED', null, 0, %s, null, null, 'UNUSED', %s);\\n\" \"\$service\" \"\$now\" \"\$now\" >>\"\$tmp_sql\"
    done
    if /usr/bin/sudo -n /usr/bin/sqlite3 \"\$system_db\" <\"\$tmp_sql\"; then
        echo system_db_update=success
    else
        echo system_db_update=failure
    fi
    /bin/rm -f \"\$tmp_sql\"
else
    echo system_db_update=skipped
fi

/usr/bin/killall tccd >/dev/null 2>&1 || true
/usr/bin/sudo -n /usr/bin/killall tccd >/dev/null 2>&1 || true

echo user_tcc_rows
dump_relevant_tcc \"\$user_db\"
if /usr/bin/sudo -n /bin/test -f \"\$system_db\"; then
    echo system_tcc_rows
    /usr/bin/sudo -n /usr/bin/sqlite3 \"\$system_db\" \"select service, client, client_type, auth_value, auth_reason, last_modified
        from access
        where service in (
            'kTCCServiceScreenCapture',
            'kTCCServiceAudioCapture',
            'kTCCServiceAccessibility',
            'kTCCServicePostEvent',
            'kTCCServiceListenEvent',
            'kTCCServiceAppleEvents'
        )
        and (
            client like '%ssh%' or
            client in (
                '/usr/bin/osascript',
                '/usr/sbin/screencapture',
                '\${GUEST_REPO_DIR}/.debug/WinMuxApp',
                '\${GUEST_REPO_DIR}/.debug/winmux',
                '\${HOME}/winmux-e2e/bin/WinMuxApp',
                '\${HOME}/winmux-e2e/bin/winmux',
                'com.apple.sshd-session'
            )
        )
        order by client, service;\" || true
fi
echo privacy_setup_done"

    if guest_script_retry "$script" "$setup_log"; then
        log "Guest privacy permissions are prepared"
        return
    fi

    cat "$setup_log" >&2 || true
    die "Guest privacy permissions could not be prepared"
}

