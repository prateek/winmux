refresh_window_log() {
    \"\${CLI}\" list-windows --monitor all --app-bundle-id com.apple.TextEdit \\
        --format '%{window-id}|%{window-title}|zone=%{monitor-zone-id}|workspace=%{workspace}|monitor=%{monitor-name}' \\
        >\"\${WINDOW_LOG}\" 2>>\"\${WAIT_ERR}\"
}

wait_for_textedit_windows() {
    local expected=\"\$1\"
    for attempt in \$(seq 1 60); do
        if refresh_window_log; then
            local count
            count=\"\$(/usr/bin/grep -c '^' \"\${WINDOW_LOG}\" || true)\"
            if [ \"\${count}\" -ge \"\${expected}\" ]; then
                return 0
            fi
        fi
        sleep 1
    done
    return 1
}

window_id_for_title() {
    local title=\"\$1\"
    /usr/bin/awk -F'|' -v title=\"\${title}\" '\$2 == title { print \$1; exit }' \"\${WINDOW_LOG}\"
}

zone_for_title() {
    local title=\"\$1\"
    /usr/bin/awk -F'|' -v title=\"\${title}\" '\$2 == title {
        sub(/^zone=/, \"\", \$3)
        print \$3
        exit
    }' \"\${WINDOW_LOG}\"
}

assert_window_zone() {
    local title=\"\$1\"
    local expected_zone=\"\$2\"
    refresh_window_log
    local actual_zone
    actual_zone=\"\$(zone_for_title \"\${title}\")\"
    if [ \"\${actual_zone}\" != \"\${expected_zone}\" ]; then
        echo \"Expected \${title} in zone \${expected_zone}, got \${actual_zone:-missing}\" >&2
        cat \"\${WINDOW_LOG}\" >&2 || true
        exit 1
    fi
}

setup_window_zone() {
    local id=\"\$1\"
    local title=\"\$2\"
    local target=\"\$3\"
    local expected_zone=\"\$4\"
    refresh_window_log
    if [ \"\$(zone_for_title \"\${title}\")\" = \"\${expected_zone}\" ]; then
        echo \"setup: \${title} already in zone \${expected_zone}; no setup move needed\" | tee -a \"\${MOVE_LOG}\"
        return
    fi
    {
        echo \"setup: move \${title} to \${target}\"
        echo \"\$ winmux move-node-to-monitor --window-id \${id} \${target}\"
        \"\${CLI}\" move-node-to-monitor --window-id \"\${id}\" \"\${target}\"
    } | tee -a \"\${MOVE_LOG}\"
    assert_window_zone \"\${title}\" \"\${expected_zone}\"
}

strict_move_window_zone() {
    local id=\"\$1\"
    local title=\"\$2\"
    local target=\"\$3\"
    local expected_before=\"\$4\"
    local expected_after=\"\$5\"
    assert_window_zone \"\${title}\" \"\${expected_before}\"
    {
        echo \"proof: move \${title} from \${expected_before} to \${expected_after} via named target \${target}\"
        echo \"\$ winmux move-node-to-monitor --fail-if-noop --window-id \${id} \${target}\"
        \"\${CLI}\" move-node-to-monitor --fail-if-noop --window-id \"\${id}\" \"\${target}\"
    } | tee -a \"\${MOVE_LOG}\"
    assert_window_zone \"\${title}\" \"\${expected_after}\"
}

