while [ "$#" -gt 0 ]; do
    case "$1" in
        --require-review)
            REQUIRE_REVIEW=1
            ;;
        --closeout)
            CLOSEOUT=1
            REQUIRE_REVIEW=1
            ;;
        --self-test)
            SELF_TEST=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            [ -z "$RUN_DIR" ] || die "multiple run directories specified"
            RUN_DIR="$1"
            ;;
    esac
    shift
done

if [ "$SELF_TEST" -eq 1 ]; then
    [ -z "$RUN_DIR" ] || die "--self-test does not accept a run directory"
    run_self_test
    exit 0
fi

[ -n "$RUN_DIR" ] || die "missing run directory"
RUN_DIR="$(cd "$(dirname "$RUN_DIR")" && pwd -P)/$(basename "$RUN_DIR")"

validate_package_artifact
[ "$REQUIRE_REVIEW" -eq 0 ] || validate_review
[ "$CLOSEOUT" -eq 0 ] || validate_closeout

printf 'result=success\n'
