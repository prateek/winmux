  "lenses": {
    "app-windows": {
      "accessory-window": "enlarged",
      "badges": true,
      "enabled": true,
      "entries": "window",
      "filter": "lenses.app-windows.filter",
      "frozen-thumbnail": "dimmed",
      "grid": {
        "sections-arrangement": "flow",
        "tile-size": "real"
      },
      "hints": "held",
      "hints-key": "alt",
      "miniatures": {
        "arrow-keys": "nearest",
        "backdrop": {
          "blur": true,
          "darkness": 0.6
