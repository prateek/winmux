      "priority": 0
    },
    "search": {
      "bindings": {
        "alt-enter": [
          "lens summon",
          "mode main"
        ],
        "alt-shift-o": [
          "lens close",
          "mode main"
        ],
        "alt-slash": [
          "lens close",
          "mode main"
