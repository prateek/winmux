        "alt-shift-j": "move down",
        "alt-shift-k": "move up",
        "alt-shift-l": "move right",
        "alt-shift-m": "fullscreen",
        "alt-shift-o": "mode overview-hold",
        "alt-shift-semicolon": "mode window-once",
        "alt-shift-t": "layout floating tiling",
        "alt-slash": "mode search-hold",
        "ctrl-1": "workspace 1",
        "ctrl-2": "workspace 2",
        "ctrl-3": "workspace 3",
        "ctrl-4": "workspace 4",
        "ctrl-5": "workspace 5",
        "ctrl-6": "workspace 6",
        "ctrl-7": "workspace 7",
        "ctrl-8": "workspace 8",
        "ctrl-9": "workspace 9"
