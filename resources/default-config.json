{
  "auto-add-new-windows-to-tab-group": true,
  "automatically-tile-new-windows": true,
  "automatically-unhide-macos-hidden-apps": false,
  "columns": {
    "count": "off",
    "width-presets": [
      0.3333333333333333,
      0.5,
      0.6666666666666666
    ]
  },
  "default-root-container-layout": "tiles",
  "default-root-container-orientation": "auto",
  "enable-normalization-flatten-containers": true,
  "enable-normalization-opposite-orientation-for-nested-containers": true,
  "enable-shake-to-toggle-tiling": true,
  "filters": {},
  "gaps": {
    "inner": {
      "horizontal": 8,
      "vertical": 8
    },
    "outer": {
      "bottom": 12,
      "left": 12,
      "right": 12,
      "top": 12
    }
  },
  "key-mapping": {
    "preset": "qwerty"
  },
  "lenses": {
    "app-windows": {
      "accessory-window": "enlarged",
      "badges": true,
      "enabled": true,
      "entries": "window",
      "filter": "lenses.app-windows.filter",
      "frozen-thumbnail": "dimmed",
      "grid": {
        "sections-arrangement": "flow",
        "tile-size": "same-height"
      },
      "keys": {
        "alt-enter": "summon",
        "cmd-1": "move-node-to-workspace 1",
        "cmd-2": "move-node-to-workspace 2",
        "cmd-3": "move-node-to-workspace 3",
        "cmd-4": "move-node-to-workspace 4",
        "cmd-5": "move-node-to-workspace 5",
        "cmd-6": "move-node-to-workspace 6",
        "cmd-7": "move-node-to-workspace 7",
        "cmd-8": "move-node-to-workspace 8",
        "cmd-9": "move-node-to-workspace 9",
        "cmd-g": "sections next",
        "cmd-w": "close",
        "enter": "focus",
        "shift-enter": "summon"
      },
      "miniatures": {
        "arrow-keys": "nearest",
        "backdrop": {
          "blur": true,
          "darkness": 0.6
        },
        "current-workspace": "highlight",
        "fit": "page"
      },
      "popups": [],
      "presentation": "strip",
      "sections": "workspace",
      "sort": [
        "mru"
      ],
      "summon-hints": [
        "label",
        "landing-spot"
      ],
      "tile": "picture"
    },
    "floating": {
