        "ctrl-2": "workspace 2",
        "ctrl-3": "workspace 3",
        "ctrl-4": "workspace 4",
        "ctrl-5": "workspace 5",
        "ctrl-6": "workspace 6",
        "ctrl-7": "workspace 7",
        "ctrl-8": "workspace 8",
        "ctrl-9": "workspace 9"
      }
    },
    "window": {
      "binding": {
        "1": "workspace 1",
        "2": "workspace 2",
        "3": "workspace 3",
        "4": "workspace 4",
        "5": "workspace 5",
        "6": "workspace 6",
        "7": "workspace 7",
        "8": "workspace 8",
        "9": "workspace 9",
        "a": [
          "mode main",
          "lens app-windows --presentation list --tile text"
        ],
        "alt-semicolon": "mode main",
        "ctrl-h": "join-with left",
        "ctrl-j": "join-with down",
        "ctrl-k": "join-with up",
        "ctrl-l": "join-with right",
        "esc": "mode main",
        "f": [
          "mode main",
          "lens floating"
        ],
        "h": "focus left",
        "j": "focus down",
        "k": "focus up",
        "l": "focus right",
        "leftSquareBracket": "project prev",
        "m": "fullscreen",
        "n": "focus tab-next",
        "o": [
          "mode main",
          "lens overview"
        ],
        "p": "focus tab-prev",
        "r": [
          "mode main",
          "lens recent --presentation list --tile text"
        ],
        "rightSquareBracket": "project next",
        "s": [
          "mode main",
          "lens search"
        ],
        "shift-1": "move-node-to-workspace 1",
        "shift-2": "move-node-to-workspace 2",
        "shift-3": "move-node-to-workspace 3",
        "shift-4": "move-node-to-workspace 4",
