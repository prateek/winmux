{
  "auto-add-new-windows-to-tab-group": true,
  "automatically-tile-new-windows": true,
  "automatically-unhide-macos-hidden-apps": false,
  "columns": {
    "count": "off",
    "width-presets": [
      0.3333333333333333,
      0.5,
      0.6666666666666666
    ]
  },
  "default-root-container-layout": "tiles",
  "default-root-container-orientation": "auto",
  "enable-normalization-flatten-containers": true,
  "enable-normalization-opposite-orientation-for-nested-containers": true,
  "enable-shake-to-toggle-tiling": true,
  "filters": {},
  "gaps": {
    "inner": {
      "horizontal": 8,
      "vertical": 8
    },
    "outer": {
      "bottom": 12,
      "left": 12,
      "right": 12,
      "top": 12
    }
  },
  "key-mapping": {
    "preset": "qwerty"
  },
  "keymap": {
    "browse": {
      "bindings": {
        "alt-enter": [
          "lens summon",
          "mode main"
        ],
        "alt-shift-o": [
          "lens close",
          "mode main"
        ],
        "alt-slash": [
          "lens close",
          "mode main"
        ],
        "cmd-1": "lens run move-node-to-workspace 1",
        "cmd-2": "lens run move-node-to-workspace 2",
        "cmd-3": "lens run move-node-to-workspace 3",
        "cmd-4": "lens run move-node-to-workspace 4",
        "cmd-5": "lens run move-node-to-workspace 5",
        "cmd-6": "lens run move-node-to-workspace 6",
        "cmd-7": "lens run move-node-to-workspace 7",
        "cmd-8": "lens run move-node-to-workspace 8",
        "cmd-9": "lens run move-node-to-workspace 9",
        "cmd-g": "lens sections next",
        "cmd-w": "lens close-window",
        "cmd-y": "lens peek",
        "down": "lens step down",
        "enter": [
          "lens focus",
          "mode main"
        ],
        "esc": [
          "lens close",
          "mode main"
        ],
        "g": "lens sections next",
        "h": "lens step left",
        "j": "lens step down",
        "k": "lens step up",
        "l": "lens step right",
        "left": "lens step left",
        "right": "lens step right",
        "shift-enter": [
          "lens summon",
          "mode main"
        ],
        "slash": [
          "lens presentation list",
          "mode search"
        ],
        "space": "lens peek",
        "tab": "lens mark",
        "up": "lens step up",
        "y": "lens peek"
      },
      "context": "mode == browse",
      "priority": 0
    },
    "list-browse": {
      "bindings": {
        "h": [],
        "l": []
      },
      "context": "presentation == list && mode == browse",
      "priority": 0
    },
    "list-search": {
      "bindings": {
        "left": "lens caret left",
        "right": "lens caret right"
      },
      "context": "presentation == list && mode == search",
      "priority": 0
    },
    "main": {
      "bindings": {
        "alt-1": "focus --tab-index 1",
        "alt-2": "focus --tab-index 2",
        "alt-3": "focus --tab-index 3",
        "alt-4": "focus --tab-index 4",
        "alt-5": "focus --tab-index 5",
        "alt-6": "focus --tab-index 6",
        "alt-7": "focus --tab-index 7",
        "alt-8": "focus --tab-index 8",
        "alt-9": "focus --tab-index last",
        "alt-h": "focus left",
        "alt-j": "focus down",
        "alt-k": "focus up",
        "alt-l": "focus right",
        "alt-semicolon": "mode window",
        "alt-shift-1": "move-node-to-workspace 1",
        "alt-shift-2": "move-node-to-workspace 2",
        "alt-shift-3": "move-node-to-workspace 3",
        "alt-shift-4": "move-node-to-workspace 4",
