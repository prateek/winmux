          "lens focus",
          "mode main"
        ],
        "esc": "mode browse",
        "left": "lens step left",
        "right": "lens step right",
        "shift-enter": [
          "lens summon",
          "mode main"
        ],
        "tab": "lens mark",
        "up": "lens step up"
      },
      "context": "mode == search",
      "priority": 0
    },
    "strip": {
      "bindings": {
        "down": "lens step next",
        "j": "lens step next",
        "k": "lens step prev",
        "up": "lens step prev"
      },
      "context": "presentation == strip && (mode == browse || mode == cmd-tab || mode == cmd-backtick)",
      "priority": 0
    },
    "window": {
      "bindings": {
        "1": "workspace 1",
        "2": "workspace 2",
        "3": "workspace 3",
        "4": "workspace 4",
        "5": "workspace 5",
        "6": "workspace 6",
        "7": "workspace 7",
        "8": "workspace 8",
        "9": "workspace 9",
