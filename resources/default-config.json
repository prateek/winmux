  "on-focused-monitor-changed": [
    "move-mouse monitor-lazy-center"
  ],
  "on-mode-changed": [],
  "persistent-workspaces": [],
  "reload-on-save": true,
  "shortcuts-preset": "none",
  "start-at-login": false,
  "tab-group-padding": 30,
  "window-tabs": {
    "enabled": true,
    "height": 36
  },
  "workspace-sidebar": {
    "always-expanded": false,
    "auto-hide": false,
    "chrome-style": "liquid-glass",
    "collapsed-width": 50,
    "enabled": true,
    "menu-bar-reserve-height": 28,
    "project-colors": {
      "default": "#C4B5FD"
    },
    "project-deletion-action": "close-windows",
    "project-labels": {
      "default": "Default"
    },
    "show-clock": false,
    "show-date": false,
    "show-seconds": true,
    "show-status-pills": true,
    "show-weekday": true,
    "solid-chrome-color": "midnight",
    "solid-chrome-custom-color": "#191B20",
    "width": 280
  }
}
