#!/bin/sh
# The ACP agent for the relay's builder: Codex on GPT-6.1 Sol at medium effort, with full access.
# codex-acp 1.12 rejects this model, so 2.0.1 is pinned. The adapter takes its approval and sandbox
# policy from INITIAL_AGENT_MODE and ignores CODEX_CONFIG's sandbox_mode and approval_policy keys:
# without the variable every turn runs as "Auto review", workspace-write with no network and a
# reviewer on each escalated command. `codex-policy` reads the policy a pass actually got.
exec env -u CODEX_PATH -u MODEL_PROVIDER -u CODEX_API_KEY -u OPENAI_API_KEY \
  INITIAL_AGENT_MODE=agent-full-access \
  CODEX_CONFIG='{"model":"gpt-6.1-sol","model_reasoning_effort":"medium","service_tier":"default"}' \
  npx -y @agentclientprotocol/codex-acp@2.0.1 "$@"
