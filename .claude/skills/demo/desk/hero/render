#!/usr/bin/env python3
import json
from pathlib import Path
import subprocess
import sys
import tempfile

args = sys.argv[1:]
renderer = Path(__file__).resolve().parents[2] / "render"
if "--events" not in args:
    sys.exit(subprocess.call([str(renderer), *args]))
index = args.index("--events") + 1
events = json.loads(Path(args[index]).read_text())
# SFNS has no Return-arrow glyph in the card renderer; name the actual key.
for event in events:
    event["keys"] = event["keys"].replace("↩", "Return")
with tempfile.NamedTemporaryFile(mode="w", suffix=".json") as copy:
    json.dump(events, copy)
    copy.flush()
    args[index] = copy.name
    sys.exit(subprocess.call([str(renderer), *args]))
