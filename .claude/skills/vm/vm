#!/bin/bash
# vm: a Tart guest as WinMux's desktop. See SKILL.md.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
golden=${VM_GOLDEN:-winmux-golden}
base=${VM_BASE_IMAGE:-ghcr.io/cirruslabs/macos-tahoe-xcode:26.3}
# `admin`/`admin` is the Cirrus images' published login; the guest holds nothing of ours.
ssh_opts=(-o PreferredAuthentications=password -o PubkeyAuthentication=no -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=10)

die() { echo "vm: $*" >&2; exit 1; }
# sshpass now and then fails to answer the password prompt; ssh then exits 255 before running
# anything, so trying again is safe.
retry_auth() {
  local status=0
  for _ in 1 2 3; do
    "$@" && return 0 || status=$?
    [ "$status" -eq 255 ] || return "$status"
    sleep 2
  done
  return "$status"
}
guest() { local vm=$1; shift; retry_auth sshpass -p admin ssh "${ssh_opts[@]}" "admin@$(tart ip "$vm")" "$@"; }
exists() { tart list --format json | jq -e --arg n "$1" 'any(.[]; .Name == $n)' >/dev/null; }
running() { tart list --format json | jq -e --arg n "$1" 'any(.[]; .Name == $n and .State == "running")' >/dev/null; }

check_host() {
  case "${TART_HOME:-}" in
    "") die "TART_HOME is unset; guests must not land on the boot disk" ;;
    /Users/*/Library/*|/System/*) die "TART_HOME is on the boot disk: $TART_HOME" ;;
  esac
  for tool in tart sshpass jq rsync nc python3; do command -v "$tool" >/dev/null || die "missing on the host: $tool"; done
}

requested_size() {
  cpu=${VM_CPU:-3}
  memory=${VM_MEMORY:-5120}
  [[ "$cpu" =~ ^[1-9][0-9]*$ && "$memory" =~ ^[1-9][0-9]*$ ]] || die "VM_CPU and VM_MEMORY must be positive integers (cores and MB)"
  # Bound the inputs before bash arithmetic to avoid overflow.
  [ "${#cpu}" -le 9 ] && [ "${#memory}" -le 9 ] || die "VM_CPU and VM_MEMORY are too large"
}

admit() {
  local names name config cores mb count=0 used_cpu=0 used_memory=0 sizes=""
  local host_cpu host_memory cap_cpu cap_memory
  host_cpu=$(sysctl -n hw.ncpu)
  host_memory=$(sysctl -n hw.memsize)
  [[ "$host_cpu" =~ ^[1-9][0-9]*$ && "$host_memory" =~ ^[1-9][0-9]*$ ]] || die "cannot read host size"
  cap_cpu=$((host_cpu * 70 / 100))
  cap_memory=$((host_memory * 70 / 100 / 1073741824 * 1024))
  names=$(tart list --format json | jq -er '[.[] | select(.State == "running") | .Name] | join("\n")') || die "cannot list running guests"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    config=$(tart get "$name" --format json) || die "cannot read size of $name"
    cores=$(jq -er '.CPU | select(type == "number" and . > 0 and . == floor)' <<<"$config") || die "cannot read cores of $name"
    mb=$(jq -er '.Memory | select(type == "number" and . > 0 and . == floor)' <<<"$config") || die "cannot read memory of $name"
    count=$((count + 1))
    used_cpu=$((used_cpu + cores))
    used_memory=$((used_memory + mb))
    sizes="$sizes\n  $name: $cores cores, $mb MB"
  done <<<"$names"
  local detail="cap: $cap_cpu cores, $cap_memory MB (70% of host); requested: $cpu cores, $memory MB; running:$sizes"
  [ "$count" -lt 2 ] || { printf 'vm: two-guest limit; %b\n' "$detail" >&2; exit 1; }
  if [ "$((used_cpu + cpu))" -gt "$cap_cpu" ] || [ "$((used_memory + memory))" -gt "$cap_memory" ]; then
    printf 'vm: resource cap exceeded; %b\n' "$detail" >&2
    exit 1
  fi
}

boot() {
  local vm=$1 log
  log=$(mktemp -t "vm-$vm")
  # softnet sometimes fails to create its vmnet network right after a stop: wait, and retry.
  for _ in 1 2 3; do
    sleep 10
    nohup tart run --no-graphics --no-audio --no-clipboard "$vm" 9>&- >"$log" 2>&1 &
    disown
    for _ in $(seq 1 40); do
      if tart exec "$vm" true 2>/dev/null; then
        # Resolve again on each probe: softnet can report an old address during boot.
        local deadline=$((SECONDS + 60))
        for _ in $(seq 1 20); do
          [ "$SECONDS" -lt "$deadline" ] || break
          local ip
          ip=$(tart ip "$vm" 2>/dev/null) || ip=""
          if [ -n "$ip" ] && nc -z -G 1 -w 1 "$ip" 22 2>/dev/null && sshpass -p admin ssh -o ConnectTimeout=1 "${ssh_opts[@]}" "admin@$ip" true 2>/dev/null; then
            rm -f "$log"
            return 0
          fi
          sleep 2
        done
        echo "vm: rebooting unreachable guest $vm (ssh did not answer)" >&2
        break
      fi
      grep -q RuntimeFailed "$log" && break
      sleep 5
    done
    tart stop "$vm"
  done
  die "$vm did not boot; see $log"
}

# `tart stop` cuts the guest off before its preference writes reach the disk.
shut_down() {
  local vm=$1
  guest "$vm" 'sync; sudo shutdown -h now' || true
  for _ in $(seq 1 30); do running "$vm" || return 0; sleep 2; done
  tart stop "$vm"
}

cmd_build_image() {
  check_host
  requested_size
  exists "$golden" && die "$golden exists; delete it first: tart delete $golden"
  local build=$golden-build
  # A build guest left running by a failed provision is picked up where it stopped.
  if ! running "$build"; then
    admit
    exists "$build" && tart delete "$build"
    tart clone "$base" "$build"
    tart set "$build" --cpu "$cpu" --memory "$memory" --display 1280x720
    boot "$build"
  fi
  exec 9>&-
  guest "$build" 'mkdir -p ~/vm ~/takes'
  retry_auth sshpass -p admin scp "${ssh_opts[@]}" "$here"/guest/* "admin@$(tart ip "$build"):vm/"
  guest "$build" "bash ~/vm/provision.sh"
  shut_down "$build"
  tart rename "$build" "$golden"
  echo "built $golden from $base"
}

cmd_up() {
  check_host
  requested_size
  local vm=${1:?usage: vm up <name> [WxH]} size=${2:-1280x720}
  exists "$golden" || die "$golden is missing; run: vm build-image"
  running "$vm" && die "$vm is already running"
  admit
  exists "$vm" || tart clone "$golden" "$vm"
  tart set "$vm" --cpu "$cpu" --memory "$memory" --display "$size"
  boot "$vm"
  exec 9>&-
  # The image opens Terminal at login.
  guest "$vm" "pkill -x Terminal; sleep 1; ~/vm/display ${size%x*} ${size#*x} 1"
  cmd_preflight "$vm"
}

cmd_sync() {
  local vm=${1:?usage: vm sync <name> <worktree>} worktree=${2:?usage: vm sync <name> <worktree>}
  # A worktree's `.git` is a file that points at a path on the host, so it stays behind. The
  # guest's copy gets a repository of its own: `make check` ends on a `git diff`.
  retry_auth rsync -a --delete --exclude .git --exclude .build --exclude target --exclude .deps \
    -e "sshpass -p admin ssh ${ssh_opts[*]}" "$worktree/" "admin@$(tart ip "$vm"):winmux/"
  guest "$vm" 'cd ~/winmux && { [ ! -f .git ] || rm .git; } && { [ -d .git ] || git init -q; } && git add -A && git -c user.name=vm -c user.email=vm@example.invalid commit -q --allow-empty -m sync'
}

cmd_build() {
  local vm=${1:?usage: vm build <name>}
  guest "$vm" 'export PATH=$HOME/.cargo/bin:/opt/homebrew/bin:$PATH; cd ~/winmux && make helper && source ./script/setup.sh && swift build'
}

cmd_check() {
  local vm=${1:?usage: vm check <name>}
  guest "$vm" 'export PATH=$HOME/.cargo/bin:/opt/homebrew/bin:$PATH; cd ~/winmux && make check'
}

cmd_ssh() { local vm=${1:?usage: vm ssh <name> <command>}; shift; guest "$vm" "$@"; }

cmd_preflight() {
  local vm=${1:?usage: vm preflight <name>}
  guest "$vm" '~/vm/preflight && swift --version 2>&1 | head -1'
}

cmd_pull() {
  local vm=${1:?usage: vm pull <name> <guest-dir> <host-dir>} from=${2:?} to=${3:?}
  mkdir -p "$to"
  retry_auth rsync -a -e "sshpass -p admin ssh ${ssh_opts[*]}" "admin@$(tart ip "$vm"):$from/" "$to/"
}

cmd_push() {
  local vm=${1:?usage: vm push <name> <host-dir> <guest-dir>} from=${2:?} to=${3:?}
  retry_auth rsync -a -e "sshpass -p admin ssh ${ssh_opts[*]}" "$from/" "admin@$(tart ip "$vm"):$to/"
}

cmd_down() {
  local vm=${1:?usage: vm down <name>}
  [ "$vm" = "$golden" ] && die "refusing to delete the golden image"
  exists "$vm" || return 0
  running "$vm" && tart stop "$vm"
  tart delete "$vm"
}

if [ "${1:-}" = --start-locked ]; then
  shift
else
  case "${1:-}" in
    up|build-image)
      check_host
      exec python3 "$here/start_locked.py" "$0" "$@"
      ;;
  esac
fi

verb=${1:-}; [ -n "$verb" ] || die "usage: vm <build-image|up|sync|build|check|ssh|preflight|push|pull|down> …"
shift
case "$verb" in
  build-image) cmd_build_image "$@" ;;
  up|sync|build|check|ssh|preflight|push|pull|down) "cmd_$verb" "$@" ;;
  *) die "unknown verb: $verb" ;;
esac
