# The settings and bindings WinMux starts with. A config merges its own settings over these:
#
#   let W = import "winmux/winmux.ncl" in
#   ((import "winmux/defaults.ncl") & { gaps.inner.horizontal = 0 }) | W.Config
#
# Every value is marked `default`, so a config overrides one by setting the same field. A config
# that does not import this file gets none of it.
{
  auto-add-new-windows-to-tab-group | default = true,
  automatically-tile-new-windows | default = true,
  automatically-unhide-macos-hidden-apps | default = false,
  config-version | default = 2,
  default-root-container-layout | default = "tiles",
  default-root-container-orientation | default = "auto",
  enable-normalization-flatten-containers | default = true,
  enable-normalization-opposite-orientation-for-nested-containers | default = true,
  enable-shake-to-toggle-tiling | default = true,
  gaps = {
    inner = {
      horizontal | default = 8,
      vertical | default = 8,
    },
    outer = {
      bottom | default = 12,
      left | default = 12,
      right | default = 12,
      top | default = 12,
    },
  },
  key-mapping = {
    preset | default = "qwerty",
  },
  mode = {
    main = {
      binding = {
        alt-0 | default = "focus --tab-index 10",
        alt-1 | default = "focus --tab-index 1",
        alt-2 | default = "focus --tab-index 2",
        alt-3 | default = "focus --tab-index 3",
        alt-4 | default = "focus --tab-index 4",
        alt-5 | default = "focus --tab-index 5",
        alt-6 | default = "focus --tab-index 6",
        alt-7 | default = "focus --tab-index 7",
        alt-8 | default = "focus --tab-index 8",
        alt-9 | default = "focus --tab-index 9",
        alt-cmd-1 | default = "project 1",
        alt-cmd-2 | default = "project 2",
        alt-cmd-3 | default = "project 3",
        alt-cmd-4 | default = "project 4",
        alt-cmd-5 | default = "project 5",
        alt-cmd-6 | default = "project 6",
        alt-cmd-7 | default = "project 7",
        alt-cmd-8 | default = "project 8",
        alt-cmd-9 | default = "project 9",
        alt-cmd-h | default = "project prev",
        alt-cmd-j | default = "swap down",
        alt-cmd-k | default = "swap up",
        alt-cmd-l | default = "project next",
        alt-cmd-shift-1 | default = "move-node-to-project 1",
        alt-cmd-shift-2 | default = "move-node-to-project 2",
        alt-cmd-shift-3 | default = "move-node-to-project 3",
        alt-cmd-shift-4 | default = "move-node-to-project 4",
        alt-cmd-shift-5 | default = "move-node-to-project 5",
        alt-cmd-shift-6 | default = "move-node-to-project 6",
        alt-cmd-shift-7 | default = "move-node-to-project 7",
        alt-cmd-shift-8 | default = "move-node-to-project 8",
        alt-cmd-shift-9 | default = "move-node-to-project 9",
        alt-cmd-shift-h | default = "move-node-to-project prev",
        alt-cmd-shift-l | default = "move-node-to-project next",
        alt-h | default = "focus left",
        alt-j | default = "focus down",
        alt-k | default = "focus up",
        alt-l | default = "focus right",
        alt-n | default = "focus dfs-next",
        alt-p | default = "focus dfs-prev",
        alt-shift-1 | default = "move-node-to-workspace 1",
        alt-shift-2 | default = "move-node-to-workspace 2",
        alt-shift-3 | default = "move-node-to-workspace 3",
        alt-shift-4 | default = "move-node-to-workspace 4",
        alt-shift-5 | default = "move-node-to-workspace 5",
        alt-shift-6 | default = "move-node-to-workspace 6",
        alt-shift-7 | default = "move-node-to-workspace 7",
        alt-shift-8 | default = "move-node-to-workspace 8",
        alt-shift-9 | default = "move-node-to-workspace 9",
        alt-shift-h | default = "move left",
        alt-shift-j | default = "move down",
        alt-shift-k | default = "move up",
        alt-shift-l | default = "move right",
        alt-shift-m | default = "fullscreen",
        alt-shift-t | default = "layout floating tiling",
        alt-shift-tab | default = "focus tab-prev",
        alt-space | default = "layout horizontal vertical",
        alt-tab | default = "focus tab-next",
        cmd-ctrl-h | default = "workspace prev",
        cmd-ctrl-l | default = "workspace next",
        cmd-shift-h | default = "join-with left",
        cmd-shift-i | default = "balance-sizes",
        cmd-shift-j | default = "join-with down",
        cmd-shift-k | default = "join-with up",
        cmd-shift-l | default = "join-with right",
        ctrl-0 | default = "workspace 10",
        ctrl-1 | default = "workspace 1",
        ctrl-2 | default = "workspace 2",
        ctrl-3 | default = "workspace 3",
        ctrl-4 | default = "workspace 4",
        ctrl-5 | default = "workspace 5",
        ctrl-6 | default = "workspace 6",
        ctrl-7 | default = "workspace 7",
        ctrl-8 | default = "workspace 8",
        ctrl-9 | default = "workspace 9",
        ctrl-cmd-shift-h | default = "stack-with left",
        ctrl-cmd-shift-j | default = "stack-with down",
        ctrl-cmd-shift-k | default = "stack-with up",
        ctrl-cmd-shift-l | default = "stack-with right",
        ctrl-e | default = "workspace 13",
        ctrl-f | default = "open-sidebar",
        ctrl-h | default = "workspace prev",
        ctrl-l | default = "workspace next",
        ctrl-q | default = "workspace 11",
        ctrl-r | default = "workspace 14",
        ctrl-shift-0 | default = "move-node-to-workspace 10",
        ctrl-shift-h | default = "move-node-to-workspace --focus-follows-window prev",
        ctrl-shift-l | default = "move-node-to-workspace --focus-follows-window next",
        ctrl-t | default = "workspace 15",
        ctrl-w | default = "workspace 12",
      },
    },
  },
  on-focused-monitor-changed | default = ["move-mouse monitor-lazy-center"],
  on-mode-changed | default = [],
  persistent-workspaces | default = [],
  reload-on-save | default = true,
  shortcuts-preset | default = "none",
  lenses.search = {},
  start-at-login | default = false,
  tab-group-padding | default = 30,
  window-tabs = {
    enabled | default = true,
    height | default = 36,
  },
  workspace-sidebar = {
    always-expanded | default = false,
    auto-hide | default = false,
    chrome-style | default = "liquid-glass",
    collapsed-width | default = 50,
    enabled | default = true,
    menu-bar-reserve-height | default = 28,
    project-colors = {
      "default" | default = "#C4B5FD",
    },
    project-deletion-action | default = "close-windows",
    project-labels = {
      "default" | default = "Default",
    },
    show-clock | default = false,
    show-date | default = false,
    show-seconds | default = true,
    show-status-pills | default = true,
    show-weekday | default = true,
    solid-chrome-color | default = "midnight",
    solid-chrome-custom-color | default = "#191B20",
    width | default = 280,
  },
}
